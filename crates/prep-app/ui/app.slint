// Font incorporati (necessari nel browser, che non ha font di sistema)
import "../fonts/Roboto-Regular.ttf";
import "../fonts/Roboto-Medium.ttf";
import "../fonts/Roboto-SemiBold.ttf";
import "../fonts/Roboto-Bold.ttf";
import "../fonts/DejaVuSans.ttf";
import "../fonts/DejaVuSans-Bold.ttf";
import { M3, Icons, Type } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { AppState } from "state.slint";
import { NavItem, M3Button, Scroller, FabMenu, SessionBar, WavyProgress, Icon, OutlinedField } from "components.slint";
import { CropDialog } from "crop.slint";
import { HomePage, StudyPage, UnitPage, QuizPage, ResultsPage, CardsPage, DecksPage, QuizHubPage, SettingsPage, ReaderPage, FeedbackPage, GoalsPage, PeriodicPage, GroupPage, ContentsPage, PdfToolsPage, CreatorPage, SimLogPage, TuPage } from "pages.slint";

export { AppState, M3 }

export component AppWindow inherits Window {
    title: "Tremendous Preparator";
    preferred-width: 412px;
    preferred-height: 900px;
    background: M3.surface;
    default-font-size: 14px;

    // schermi larghi (desktop, browser): il contenuto sta in una colonna centrata, come su un
    // telefono; la tavola periodica ha più spazio
    property <length> column-max: AppState.page == 12 ? 1240px : 720px;
    property <length> side: max(0px, (root.width - root.column-max) / 2);
    // senza barra quando il foglio della concentrazione è aperto: arriva fino in fondo allo schermo
    property <bool> show-nav: !AppState.focus-open && (AppState.page == 0 || AppState.page == 1 || AppState.page == 2 || AppState.page == 6 || AppState.page == 8 || AppState.page == 11 || AppState.page == 13 || AppState.page == 18);
    // «Studia ora»: esteso in Oggi, solo simbolo nelle altre schede principali
    // durante lo studio di gruppo i comandi della sessione stanno in basso: niente pulsante
    property <bool> show-fab: root.show-nav && AppState.page != 18 && AppState.car-sel == "" && !AppState.sheet-open && !AppState.profile-open && !AppState.focus-open;
    property <bool> show-bar: root.show-nav && AppState.paused-title != "";

    fs := FocusScope {
        // l'app passa in secondo piano (la finestra perde il fuoco): un quiz in corso va in pausa
        focus-lost(reason) => {
            if (reason == FocusReason.window-activation) {
                AppState.app-hidden();
            }
        }
        key-pressed(e) => {
            if (e.text == Key.Back || e.text == Key.Escape) {
                if (AppState.back()) {
                    return accept;
                }
            }
            return reject;
        }

        // Oggi: la barra di stato ha il colore della fascia della preparazione (più immersiva,
        // e la fascia compatta scorrendo resta attaccata in alto senza stacchi)
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.safe-area-insets.top;
            background: AppState.page == 0 && !AppState.exam-menu ? M3.primary-container : M3.surface;
        }

        // colonna centrata con posizione e larghezza esplicite: con il margine come padding la
        // larghezza minima della finestra dipenderebbe da sé stessa (ciclo di binding)
        VerticalLayout {
            x: root.side;
            width: root.width - 2 * root.side;
            padding-top: root.safe-area-insets.top;
            padding-bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
            Rectangle {
                vertical-stretch: 1;
                // Oggi: sotto la pagina, il colore della fascia. Durante l'ingresso animato la pagina
                // scende di qualche pixel: così non si vede uno stacco tra barra di stato e fascia
                if AppState.page == 0 && !AppState.exam-menu: Rectangle {
                    x: 0px;
                    y: 0px;
                    // sotto la parte dritta della fascia, mai dietro i suoi angoli tondi
                    height: 48px;
                    background: M3.primary-container;
                }
                if AppState.page == 0: HomePage { }
                if AppState.page == 1: StudyPage { }
                if AppState.page == 2: UnitPage { }
                if AppState.page == 3: QuizPage { }
                if AppState.page == 4: ResultsPage { }
                if AppState.page == 5: CardsPage { }
                if AppState.page == 6: QuizHubPage { }
                if AppState.page == 7: SettingsPage { }
                if AppState.page == 8: DecksPage { }
                if AppState.page == 9: ReaderPage { }
                if AppState.page == 10: FeedbackPage { }
                if AppState.page == 11: GoalsPage { }
                if AppState.page == 12: PeriodicPage { }
                if AppState.page == 13: GroupPage { }
                if AppState.page == 14: ContentsPage { }
                if AppState.page == 15: PdfToolsPage { }
                if AppState.page == 16: CreatorPage { }
                if AppState.page == 17: SimLogPage { }
                if AppState.page == 18: TuPage { }
                if root.show-fab && AppState.fab-open: Rectangle {
                    background: #000000.with-alpha(0.32);
                    TouchArea {
                        clicked => {
                            AppState.fab-open = false;
                        }
                    }
                }
                // sessione in pausa (da Notturno): sempre sopra la barra, si riprende con un tocco
                if root.show-bar: SessionBar {
                    x: 8px;
                    width: parent.width - 16px;
                    y: parent.height - self.height - 8px;
                }
                if root.show-fab: FabMenu {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px - (root.show-bar ? 72px : 0px);
                    // scorrendo in giù si riduce al solo simbolo
                    extended: (AppState.page == 0 || AppState.page == 13) && !AppState.fab-mini;
                    race: AppState.page == 13;
                }
            }

            // concentrazione attiva: il tempo che manca, su ogni pagina
            if AppState.focus-active: Rectangle {
                height: 30px;
                background: M3.primary-container;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: "Concentrazione";
                        font-weight: 700;
                        color: M3.on-primary-container;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: AppState.focus-left != "" ? "mancano " + AppState.focus-left : "fino a «Termina»";
                        font-weight: 800;
                        color: M3.on-primary-container;
                        vertical-alignment: center;
                    }
                }
            }

            // barra di navigazione flessibile (Material 3 Expressive)
            if root.show-nav && root.virtual-keyboard-size.height == 0: Rectangle {
                height: 72px;
                background: M3.surface-container;
                HorizontalLayout {
                    NavItem {
                        icon: Icons.today;
                        label: "Oggi";
                        active: AppState.tab == 0;
                        clicked => {
                            AppState.fab-open = false;
                            AppState.go-tab(0);
                        }
                    }

                    NavItem {
                        icon: Icons.school;
                        label: "Studia";
                        active: AppState.tab == 1;
                        badge: AppState.due-count;
                        clicked => {
                            AppState.fab-open = false;
                            AppState.go-tab(1);
                        }
                    }

                    NavItem {
                        icon: Icons.groups;
                        label: "Squadra";
                        active: AppState.tab == 2;
                        badge: AppState.study-state == 1 ? 1 : 0;
                        clicked => {
                            AppState.fab-open = false;
                            AppState.go-tab(2);
                        }
                    }

                    NavItem {
                        icon: Icons.person;
                        label: "Tu";
                        active: AppState.tab == 3;
                        clicked => {
                            AppState.fab-open = false;
                            AppState.go-tab(3);
                        }
                    }
                }
            }
        }
    }

    // snackbar
    if AppState.toast != "": Rectangle {
        property <float> enter: 0;
        init => {
            enter = 1;
        }
        animate enter {
            duration: 350ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        opacity: self.enter;
        x: root.side + 16px;
        width: root.width - 2 * root.side - 32px;
        y: root.height - max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height) - (root.show-nav ? 80px : 72px) - self.height - 8px + (1 - self.enter) * 40px;
        height: max(48px, tt.preferred-height + 24px);
        border-radius: 8px;
        background: M3.inverse-surface;
        drop-shadow-blur: 6px;
        drop-shadow-color: #0005;
        tt := Text {
            x: 16px;
            width: parent.width - 32px;
            text: AppState.toast;
            color: M3.inverse-on-surface;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                AppState.toast = "";
            }
        }
    }

    // note legali (al primo avvio vanno accettate per usare l'app)
    if AppState.legal-visible: Rectangle {
        background: M3.scrim.with-alpha(0.6);
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 560px);
            height: min(root.height - 64px, 760px);
            border-radius: 28px;
            background: M3.surface-container-high;
            VerticalLayout {
                padding-top: 24px;
                padding-bottom: 16px;
                spacing: 12px;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    text: AppState.legal-required ? "Prima di iniziare" : "Note legali";
                    font-size: Type.headline;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                Scroller {
                    vertical-stretch: 1;
                    pad: 24px;
                    pad-top: 0px;
                    Text {
                        text: AppState.legal-text;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: end;
                    M3Button {
                        text: AppState.legal-required ? "Ho letto e accetto" : "Chiudi";
                        clicked => {
                            AppState.legal-accept();
                        }
                    }
                }
            }
        }
    }

    if AppState.crop-visible: CropDialog { }

    // novità dopo un aggiornamento
    // pacchetto importato: salvarlo in un ramo nuovo del repository dei progressi?
    if AppState.offer-branch: Rectangle {
        background: M3.scrim;
        TouchArea {
            clicked => {
                AppState.offer-branch = false;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, 420px);
            height: ob.preferred-height;
            border-radius: 28px;
            background: M3.surface-container-high;
            TouchArea { }
            ob := VerticalLayout {
                padding: 24px;
                padding-bottom: 16px;
                spacing: 14px;
                Icon {
                    height: 24px;
                    width: 24px;
                    source: Icons.branch;
                    tint: M3.primary;
                }
                Text {
                    text: "Salvarlo in un ramo nuovo?";
                    font-size: Type.headline;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                Text {
                    text: "Il pacchetto è installato su questo dispositivo. Mettilo in un ramo del tuo repository: i progressi si sincronizzano e l'AI può rivederli.";
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                OutlinedField {
                    label: "Nome del ramo";
                    text <=> AppState.offer-branch-name;
                    pencil: false;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    M3Button {
                        kind: 3;
                        text: "Non ora";
                        clicked => {
                            AppState.offer-branch = false;
                        }
                    }
                    M3Button {
                        text: "Salva nel ramo";
                        clicked => {
                            AppState.offer-branch-save(AppState.offer-branch-name);
                        }
                    }
                }
            }
        }
    }
    if AppState.news-visible: Rectangle {
        property <float> enter: 0;
        init => {
            enter = 1;
        }
        animate enter {
            duration: 300ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        background: M3.scrim.with-alpha(0.6 * self.enter);
        TouchArea {
            clicked => {
                AppState.news-visible = false;
            }
        }
        Rectangle {
            opacity: parent.enter;
            transform-scale-x: 85% + 15% * parent.enter;
            transform-scale-y: 85% + 15% * parent.enter;
            width: min(root.width - 32px, 480px);
            height: min(root.height - 96px, body.preferred-height + 190px);
            border-radius: 28px;
            background: M3.surface-container-high;
            clip: true;
            TouchArea { }
            nl := VerticalLayout {
                padding: 24px;
                padding-bottom: 16px;
                spacing: 12px;
                Text {
                    text: AppState.news-title;
                    font-size: Type.headline;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }

                fl := Flickable {
                    vertical-stretch: 1;
                    content-height: body.preferred-height + 24px;
                    body := VerticalLayout {
                        width: nl.width - 48px;
                        spacing: 16px;
                        for sec in AppState.news-rows: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: sec.date;
                                font-size: Type.label;
                                font-weight: 600;
                                color: M3.primary;
                            }

                            // larghezza esplicita: con il testo a capo in una riga orizzontale
                            // l'altezza veniva sottostimata e la novità restava tagliata
                            for it in sec.items: Text {
                                width: nl.width - 48px;
                                text: "•  " + it;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    M3Button {
                        kind: 3;
                        text: "Ok";
                        clicked => {
                            AppState.news-visible = false;
                        }
                    }
                }
            }
        }
    }

    // dialogo di conferma

    // aggiornamento obbligatorio: copre tutta l'app finché non è installato (tutti sulla stessa
    // versione: regole dei gruppi e formati restano compatibili). Avanzamento con la barra ondulata.
    if AppState.update-required && AppState.update-version != "": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: M3.primary-container;
        TouchArea { }
        VerticalLayout {
            x: max(24px, (parent.width - 460px) / 2);
            width: min(parent.width - 48px, 460px);
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 22px;
                    background: M3.primary;
                    Icon {
                        x: 16px;
                        y: 16px;
                        width: 32px;
                        height: 32px;
                        source: Icons.update;
                        tint: M3.on-primary;
                    }
                }
            }
            Text {
                text: "Nuova versione " + AppState.update-version;
                font-size: 32px;
                font-weight: 900;
                color: M3.on-primary-container;
                wrap: word-wrap;
            }
            Text {
                text: "Per continuare serve aggiornare: così tutti nel gruppo hanno le stesse regole e le novità arrivano subito. Il quiz in corso resta in pausa e i progressi non si toccano.";
                font-size: 15px;
                color: M3.on-primary-container;
                wrap: word-wrap;
            }
            if AppState.update-busy || AppState.update-frac > 0: VerticalLayout {
                spacing: 8px;
                padding-top: 8px;
                WavyProgress {
                    intro: false;
                    moving: true;
                    value: max(0.03, AppState.update-frac);
                    fill: M3.primary;
                    track: M3.surface.with-alpha(0.7);
                    amp: 4px;
                    wavelength: 26px;
                    thickness: 6px;
                }
                HorizontalLayout {
                    Text {
                        text: AppState.update-phase;
                        font-size: 13px;
                        color: M3.on-primary-container;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Text {
                        text: round(AppState.update-frac * 100) + "%";
                        font-size: 15px;
                        font-weight: 900;
                        color: M3.on-primary-container;
                    }
                }
            }
            if AppState.update-error != "": Text {
                text: AppState.update-error;
                font-size: 13px;
                color: M3.error;
                wrap: word-wrap;
            }
            if !AppState.update-busy: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                M3Button {
                    text: AppState.update-error != "" ? "Riprova" : "Aggiorna ora";
                    has-icon: true;
                    icon: Icons.update;
                    clicked => {
                        AppState.update-install();
                    }
                }
                // solo dopo un errore: per non restare bloccati se l'aggiornamento non riesce
                if AppState.update-error != "": M3Button {
                    text: "Più tardi";
                    kind: 3;
                    clicked => {
                        AppState.update-required = false;
                    }
                }
            }
        }
    }

    if AppState.dialog-visible: Rectangle {
        property <float> enter: 0;
        init => {
            enter = 1;
        }
        animate enter {
            duration: 300ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        background: M3.scrim.with-alpha(0.6 * self.enter);
        TouchArea { }
        Rectangle {
            opacity: parent.enter;
            transform-scale-x: 85% + 15% * parent.enter;
            transform-scale-y: 85% + 15% * parent.enter;
            width: min(root.width - 48px, 360px);
            height: dl.preferred-height;
            border-radius: 28px;
            background: M3.surface-container-high;
            dl := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: AppState.dialog-title;
                    font-size: Type.headline;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }

                Text {
                    text: AppState.dialog-text;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    M3Button {
                        kind: 3;
                        text: "Annulla";
                        clicked => {
                            AppState.dialog-cancel();
                        }
                    }

                    if AppState.dialog-alt != "": M3Button {
                        kind: 3;
                        text: AppState.dialog-alt;
                        clicked => {
                            AppState.dialog-alt-clicked();
                        }
                    }

                    M3Button {
                        kind: 3;
                        text: AppState.dialog-confirm;
                        clicked => {
                            AppState.dialog-ok();
                        }
                    }
                }
            }
        }
    }

    // chiaro / scuro scelto in Opzioni › Tu e l'aspetto (0 = come il sistema). Con «sistema» lo
    // schema non si tocca: assegnarlo, anche a «unknown», smette di seguire il telefono (che
    // restava chiaro); tornando a «sistema» si rimette quello letto all'avvio
    property <int> theme-mode: AppState.theme-mode;
    property <ColorScheme> sys-scheme;
    property <bool> mode-touched: false;
    changed theme-mode => {
        root.apply-mode();
    }
    function apply-mode() {
        if (root.theme-mode == 1) {
            Palette.color-scheme = ColorScheme.light;
            root.mode-touched = true;
        } else if (root.theme-mode == 2) {
            Palette.color-scheme = ColorScheme.dark;
            root.mode-touched = true;
        } else if (root.mode-touched) {
            Palette.color-scheme = root.sys-scheme;
        }
    }

    init => {
        fs.focus();
        root.sys-scheme = Palette.color-scheme;
        if (root.theme-mode != 0) {
            root.apply-mode();
        }
    }
}
