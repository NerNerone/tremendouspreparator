// Componenti Material 3 Expressive riutilizzabili: forme ampie che cambiano alla pressione,
// movimento a molla (curve "expressive spatial/effects"), indicatori ondulati.
import { ScrollView } from "std-widgets.slint";
import { M3, Icons, Type, Shape, Motion } from "theme.slint";
import { AppState, SubjectVM } from "state.slint";

export component Icon inherits Image {
    in property <color> tint: M3.on-surface;
    colorize: tint;
    width: 24px;
    height: 24px;
    image-fit: contain;
}

// Pagina: entra con dissolvenza e leggero scivolamento verso l'alto
export component Page inherits Rectangle {
    property <float> enter: 0;
    init => {
        enter = 1;
    }
    animate enter {
        duration: Motion.spatial;
        easing: cubic-bezier(0.38, 1.21, 0.22, 1.0);
    }
    opacity: min(1, enter * 1.4);
    y: (1 - enter) * 40px;
}

// Contenuto che si anima ogni volta che `key` cambia (nuova domanda, nuova sezione…)
// Contenitore di una pagina che cambia (lettore, quiz, flashcard). Il cambio è istantaneo: la
// dissolvenza mostrava la pagina nuova, la spegneva e la riaccendeva (un lampo a ogni pagina).
export component Swap inherits Rectangle {
    in property <string> key;
    @children
}

// Increspatura Material al tocco
export component Ripple inherits Rectangle {
    in property <bool> pressed;
    in property <length> px;
    in property <length> py;
    in property <color> tint: M3.on-surface;
    clip: true;
    property <float> alpha: root.pressed ? 1 : 0;
    animate alpha { duration: 280ms; }
    property <float> grow: root.pressed || root.alpha > 0.02 ? 1 : 0;
    animate grow {
        duration: root.pressed ? 450ms : 0ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    Rectangle {
        property <length> d: max(root.width, root.height) * 2.3 * root.grow;
        x: root.px - self.width / 2;
        y: root.py - self.height / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: root.tint.with-alpha(0.16 * root.alpha);
    }
}

export component VIcon inherits VerticalLayout {
    in property <image> source;
    in property <color> tint: M3.on-surface;
    in property <length> size: 24px;
    alignment: center;
    Icon {
        source: root.source;
        tint: root.tint;
        width: root.size;
        height: root.size;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: M3.on-surface-variant;
    in property <bool> enabled: true;
    in property <bool> filled: false;
    callback clicked;
    width: 48px;
    height: 48px;
    Rectangle {
        width: 40px;
        height: 40px;
        // pressione: da cerchio a quadrato arrotondato (shape morph)
        border-radius: ta.pressed ? 12px : 20px;
        background: root.filled ? M3.secondary-container : ta.pressed ? root.tint.with-alpha(0.12) : root.tint.with-alpha(0);
        animate background { duration: Motion.fast-effects; }
        animate border-radius {
            duration: Motion.fast-spatial;
            easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
        }
        Icon {
            source: root.icon;
            tint: root.enabled ? root.tint : M3.on-surface.with-alpha(0.38);
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// kind: 0 filled, 1 tonal, 2 outlined, 3 text, 4 errore
export component M3Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    // pulsanti affiancati su schermi stretti: margini interni ridotti
    in property <bool> compact: false;
    /// variante minimale (azioni secondarie dentro un riquadro): più bassa, testo piccolo, senza rimpicciolirsi alla pressione
    in property <bool> small: false;
    callback clicked;
    property <color> fg: !root.enabled ? M3.on-surface.with-alpha(0.38) : root.kind == 0 ? M3.on-primary : root.kind == 1 ? M3.on-secondary-container : root.kind == 4 ? M3.on-error : M3.primary;
    min-height: root.small ? 34px : 48px;
    min-width: root.small ? 0px : 64px;
    // pillola che alla pressione diventa un quadrato arrotondato (Expressive)
    border-radius: ta.pressed ? Shape.md : self.height / 2;
    animate border-radius {
        duration: Motion.fast-spatial;
        easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
    }
    background: !root.enabled && (root.kind <= 1 || root.kind == 4) ? M3.on-surface.with-alpha(0.12) : root.kind == 0 ? M3.primary : root.kind == 1 ? M3.secondary-container : root.kind == 4 ? M3.error : transparent;
    border-width: root.kind == 2 ? 1px : 0px;
    border-color: M3.outline;
    HorizontalLayout {
        padding-left: root.compact ? 4px : root.small ? 10px : root.kind == 3 ? 12px : 24px;
        padding-right: root.compact ? 4px : root.small ? 12px : root.kind == 3 ? 12px : 24px;
        spacing: root.small ? 6px : 8px;
        alignment: center;
        if root.has-icon: VIcon {
            source: root.icon;
            tint: root.fg;
            size: root.small ? 16px : 18px;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.small ? Type.label : root.compact ? Type.body : Type.body-large;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Ripple {
        border-radius: root.border-radius;
        pressed: ta.pressed;
        px: ta.pressed-x;
        py: ta.pressed-y;
        tint: root.fg;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    transform-scale-x: ta.pressed && !root.small ? 95% : 100%;
    transform-scale-y: ta.pressed && !root.small ? 95% : 100%;
    animate transform-scale-x, transform-scale-y {
        duration: Motion.fast-spatial;
        easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
    }
    animate background { duration: Motion.effects; }
}

// Icona di una materia: il simbolo (o le iniziali) del pacchetto su un riquadro tenue del suo colore.
export component SubjectIcon inherits Rectangle {
    in property <SubjectVM> s;
    in property <color> tint: root.s.own-color ? root.s.color : M3.subject(root.s.n);
    in property <bool> filled;
    width: 36px;
    height: self.width;
    border-radius: self.width * 0.34;
    background: root.filled ? root.tint : root.tint.with-alpha(0.16);
    if root.s.glyph != "": Path {
        x: parent.width * 0.18;
        y: parent.height * 0.18;
        width: parent.width * 0.64;
        height: parent.height * 0.64;
        viewbox-x: root.s.vbx;
        viewbox-y: root.s.vby;
        viewbox-width: root.s.vbw;
        viewbox-height: root.s.vbh;
        commands: root.s.glyph;
        fill: root.filled ? M3.surface : root.tint;
    }
    if root.s.glyph == "": Text {
        width: parent.width;
        height: parent.height;
        text: root.s.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: parent.width * 0.42;
        font-weight: 800;
        color: root.filled ? M3.surface : root.tint;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> accent: M3.on-secondary-container;
    callback clicked;
    height: 36px;
    border-radius: root.selected ? 18px : Shape.sm;
    animate border-radius {
        duration: Motion.fast-spatial;
        easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
    }
    background: root.selected ? M3.secondary-container : transparent;
    border-width: root.selected ? 0px : 1px;
    border-color: M3.outline;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: VIcon {
            source: root.icon;
            tint: root.selected ? root.accent : M3.on-surface-variant;
            size: 18px;
        }
        // eventuale icona propria (es. quella della materia)
        @children
        Text {
            text: root.text;
            color: root.selected ? M3.on-secondary-container : M3.on-surface-variant;
            font-size: Type.body;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    animate background, border-width { duration: 200ms; }
    Ripple {
        border-radius: root.border-radius;
        pressed: ta.pressed;
        px: ta.pressed-x;
        py: ta.pressed-y;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Indicatore lineare Material 3 Expressive: parte attiva, spazio, binario e punto finale.
export component LinearProgress inherits Rectangle {
    in property <float> value;
    in property <color> fill: M3.primary;
    in property <color> track: M3.secondary-container;
    height: 8px;
    property <float> enter: 0;
    init => {
        enter = 1;
    }
    animate enter {
        duration: 900ms;
        delay: 120ms;
        easing: cubic-bezier(0.38, 1.21, 0.22, 1.0);
    }
    property <float> v: max(0, min(1, root.value)) * root.enter;
    property <length> active: root.width * root.v;
    property <length> gap: root.v > 0.005 && root.v < 0.995 ? 4px : 0px;
    Rectangle {
        x: root.active + root.gap;
        width: max(0px, root.width - self.x);
        height: root.height;
        border-radius: root.height / 2;
        background: root.track;
    }

    // punto finale (stop indicator)
    if root.v < 0.97: Rectangle {
        x: root.width - root.height;
        width: root.height;
        height: root.height;
        border-radius: root.height / 2;
        background: root.fill.with-alpha(0.8);
        transform-scale-x: 50%;
        transform-scale-y: 50%;
    }
    Rectangle {
        x: 0px;
        width: root.active;
        height: root.height;
        border-radius: root.height / 2;
        background: root.fill;
    }
}

// Indicatore ondulato Material 3 Expressive (come nel lettore multimediale di Android):
// la parte completata è un'onda che scorre, il resto un binario piatto con punto finale.
export component WavyProgress inherits Rectangle {
    in property <float> value;
    in property <color> fill: M3.primary;
    in property <color> track: M3.secondary-container;
    in property <length> amp: 4px;
    in property <length> wavelength: 40px;
    in property <length> thickness: 5px;
    /// l'onda scorre in continuazione (come l'indicatore ondulato di Material 3 Expressive)
    in property <bool> moving: true;
    /// animazione d'ingresso (riempimento da zero); se false compare già al suo valore
    in property <bool> intro: true;
    /// millisecondi per far scorrere l'onda di una lunghezza d'onda
    in property <float> period: 1800;
    height: root.amp * 2 + root.thickness + 2px;
    property <float> enter: root.intro ? 0 : 1;
    init => {
        if (root.intro) {
            enter = 1;
        }
    }
    animate enter {
        duration: 1100ms;
        delay: 150ms;
        easing: cubic-bezier(0.38, 1.21, 0.22, 1.0);
    }
    property <float> v: max(0, min(1, root.value)) * root.enter;
    property <length> r: root.thickness / 2;
    // fine della parte completata (compreso il cappuccio tondo)
    property <length> active: max(root.thickness, root.width * root.v);
    property <length> gap: root.v < 0.995 ? 6px : 0px;
    // fase continua: animation-tick() ridisegna a ogni fotogramma finché la barra è visibile
    property <float> phase: root.moving ? mod(animation-tick() / 1ms, root.period) / root.period : 0;

    // binario piatto
    Rectangle {
        x: root.active + root.gap;
        y: (root.height - root.thickness) / 2;
        width: max(0px, root.width - self.x);
        height: root.thickness;
        border-radius: root.r;
        background: root.track;
    }

    // punto finale (stop indicator)
    if root.v < 0.97: Rectangle {
        x: root.width - root.thickness;
        y: (root.height - root.thickness) / 2;
        width: root.thickness;
        height: root.thickness;
        border-radius: root.r;
        background: root.fill;
    }

    // onda: un solo tracciato, lungo esattamente quanto la parte completata, con estremi arrotondati
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        // coordinate del tracciato = pixel logici dell'elemento (senza adattamento: con
        // l'adattamento predefinito Slint toglie lo spessore del tratto e rimpicciolisce l'onda)
        fit: ImageFit.preserve;
        stroke: root.fill;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: AppState.wave-path(root.r / 1px, (root.active - root.r) / 1px, root.height / 2px, root.amp / 1px, root.wavelength / 1px, root.phase);
    }
}

// Indicatore di caricamento Expressive: una forma "a biscotto" che ruota e pulsa.
export component MorphLoader inherits Rectangle {
    in property <color> fill: M3.primary;
    width: 28px;
    height: 28px;
    property <float> t: 0;
    init => {
        t = 1;
    }
    animate t {
        duration: 1400ms;
        iteration-count: -1;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.fill;
        transform-rotation: root.t * 360deg;
        transform-scale-x: 85% + 15% * abs(sin(root.t * 360deg));
        transform-scale-y: 85% + 15% * abs(sin(root.t * 360deg));
        commands: "M50 4 Q61 4 66 13 Q76 9 83 17 Q91 24 87 34 Q96 39 96 50 Q96 61 87 66 Q91 76 83 83 Q76 91 66 87 Q61 96 50 96 Q39 96 34 87 Q24 91 17 83 Q9 76 13 66 Q4 61 4 50 Q4 39 13 34 Q9 24 17 17 Q24 9 34 13 Q39 4 50 4 Z";
    }
}

// Anello di avanzamento (valore 0..1)
export component RingProgress inherits Rectangle {
    in property <float> value;
    in property <color> fill: M3.primary;
    in property <color> track: M3.secondary-container;
    in property <length> thickness: 10px;
    out property <float> shown: max(0, min(0.9999, root.value)) * root.enter;
    property <float> enter: 0;
    init => {
        enter = 1;
    }
    animate enter {
        duration: 1200ms;
        delay: 150ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    property <float> v: root.shown;
    property <float> r: 50 - root.thickness / root.width * 100 / 2;
    property <angle> a: 360deg * root.v;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.track;
        stroke-width: root.thickness;
        commands: "M 50 " + (50 - root.r) + " A " + root.r + " " + root.r + " 0 1 1 " + (49.99) + " " + (50 - root.r);
    }

    if root.v > 0.001: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.fill;
        stroke-width: root.thickness;
        commands: "M 50 " + (50 - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.v > 0.5 ? "1" : "0") + " 1 " + (50 + root.r * sin(root.a)) + " " + (50 - root.r * cos(root.a));
    }
    @children
}

// Traguardo: superfici tonali piatte (niente ombre), angoli larghi, un solo linguaggio in tutta l'app
export component Card inherits Rectangle {
    in property <color> bg: M3.surface-container;
    in property <bool> clickable: false;
    in property <int> stagger: 0;
    callback clicked;
    property <float> enter: 0;
    init => {
        enter = 1;
    }
    animate enter {
        duration: Motion.spatial;
        delay: min(root.stagger, 8) * 50ms;
        easing: cubic-bezier(0.38, 1.21, 0.22, 1.0);
    }
    opacity: min(1, root.enter * 1.4);
    transform-scale-x: 92% + 8% * root.enter;
    transform-scale-y: 92% + 8% * root.enter;
    background: root.bg;
    animate background { duration: Motion.effects; }
    border-radius: 28px;
    // sotto ai figli: i pulsanti interni (es. "Apri") ricevono il tocco
    ta := TouchArea {
        enabled: root.clickable;
        clicked => {
            root.clicked();
        }
    }

    @children
    if root.clickable: Ripple {
        border-radius: root.border-radius;
        pressed: ta.pressed;
        px: ta.pressed-x;
        py: ta.pressed-y;
    }
}

// Pulsante «i»: mostra o nasconde la spiegazione di una sezione
export component InfoButton inherits Rectangle {
    in-out property <bool> open;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: root.open ? M3.secondary-container : transparent;
    animate background { duration: Motion.effects; }
    Icon {
        x: 8px;
        y: 8px;
        source: Icons.info;
        tint: root.open ? M3.on-secondary-container : M3.on-surface-variant;
    }
    TouchArea {
        clicked => {
            root.open = !root.open;
        }
    }
}

// Suggerimento: una riga breve con «i»; al tocco mostra la spiegazione completa
export component Hint inherits Rectangle {
    in property <string> short;
    in property <string> full;
    in property <bool> open: false;
    property <bool> shown: root.open;
    min-height: hint-col.preferred-height;
    hint-col := VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: start;
                Icon {
                    width: 16px;
                    height: 16px;
                    source: Icons.info;
                    tint: M3.on-surface-variant;
                }
            }
            Text {
                text: root.short;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.shown && root.full != "": Text {
            text: root.full;
            font-size: Type.label;
            color: M3.on-surface-variant;
            wrap: word-wrap;
        }
    }
    TouchArea {
        clicked => {
            root.shown = !root.shown;
        }
    }
}

// Sezione delle impostazioni: titolo, riassunto di una riga e, dietro la «i», la
// spiegazione completa; sotto, il contenuto
export component Section inherits Card {
    in property <string> title;
    in property <string> summary;
    in property <string> info;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> active: false;
    in-out property <bool> info-open: false;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            if root.has-icon: VIcon {
                source: root.icon;
                tint: root.active ? M3.primary : M3.on-surface-variant;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.title;
                    font-size: Type.title;
                    font-weight: 700;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                if root.summary != "": Text {
                    text: root.summary;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }
            if root.info != "": VerticalLayout {
                alignment: start;
                InfoButton {
                    open <=> root.info-open;
                }
            }
        }
        if root.info-open: Rectangle {
            border-radius: 12px;
            background: M3.surface-container;
            min-height: info-text.preferred-height + 20px;
            info-text := Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                text: root.info;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
        @children
    }
}

export component SectionTitle inherits Text {
    color: M3.on-surface-variant;
    font-size: Type.body;
    font-weight: 700;
}

export component TopBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> can-back;
    in property <color> bg: M3.surface;
    callback back;
    height: 64px;
    background: root.bg;
    HorizontalLayout {
        padding-left: root.can-back ? 4px : 16px;
        padding-right: 4px;
        spacing: 4px;
        if root.can-back: IconButton {
            icon: Icons.back;
            tint: M3.on-surface;
            clicked => {
                root.back();
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Type.title-large;
                font-weight: 600;
                color: M3.on-surface;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Type.label;
                color: M3.on-surface-variant;
                overflow: elide;
            }
        }

        @children
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Rectangle {
            height: 32px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 56px;
                    Rectangle {
                        width: root.active ? 56px : ta.pressed ? 40px : 0px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 16px;
                        background: root.active ? M3.secondary-container : M3.on-surface.with-alpha(0.08);
                        animate width {
                            duration: Motion.fast-spatial;
                            easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
                        }
                    }

                    Icon {
                        source: root.icon;
                        tint: root.active ? M3.on-secondary-container : M3.on-surface-variant;
                        transform-scale-x: root.active ? 108% : 100%;
                        transform-scale-y: root.active ? 108% : 100%;
                        animate transform-scale-x, transform-scale-y {
                            duration: Motion.fast-spatial;
                            easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
                        }
                    }

                    if root.badge > 0: Rectangle {
                        x: 38px;
                        y: 0px;
                        height: 16px;
                        width: max(16px, bt.preferred-width + 8px);
                        border-radius: 8px;
                        background: M3.error;
                        transform-scale-x: root.badge > 0 ? 100% : 0%;
                        transform-scale-y: root.badge > 0 ? 100% : 0%;
                        animate transform-scale-x, transform-scale-y { duration: 250ms; easing: ease-out-back; }
                        bt := Text {
                            text: root.badge > 99 ? "99+" : root.badge;
                            color: M3.on-error;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }
            }
        }

        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: Type.label;
            font-weight: root.active ? 700 : 500;
            color: root.active ? M3.on-surface : M3.on-surface-variant;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> trailing;
    in property <float> value: -1;
    in property <color> accent: M3.primary;
    in property <bool> chevron: true;
    callback clicked;
    // l'altezza segue il contenuto: titolo e sottotitolo possono andare a capo
    min-height: max(64px, row.preferred-height);
    border-radius: ta.pressed ? Shape.xl : Shape.lg;
    animate border-radius {
        duration: Motion.fast-spatial;
        easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
    }
    Ripple {
        border-radius: root.border-radius;
        pressed: ta.pressed;
        px: ta.pressed-x;
        py: ta.pressed-y;
    }
    row := HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            // larghezza esplicita: Slint calcola l'altezza dei testi a capo dentro una riga
            // orizzontale come se avessero tutta la larghezza, e la riga risultava più bassa
            width: root.width - 24px - (root.trailing != "" ? 60px : 0px) - (root.chevron ? 36px : 0px);
            spacing: 4px;
            alignment: center;
            Text {
                text: root.title;
                color: M3.on-surface;
                font-size: Type.body-large;
                wrap: word-wrap;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: M3.on-surface-variant;
                font-size: Type.label;
                wrap: word-wrap;
            }
            if root.value >= 0: LinearProgress {
                value: root.value;
                fill: root.accent;
                height: 6px;
            }
        }

        if root.trailing != "": Text {
            text: root.trailing;
            color: M3.on-surface;
            font-size: Type.title;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.chevron: VIcon {
            source: Icons.chevron;
            tint: M3.on-surface-variant;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// state: 0 normale, 1 selezionata, 2 corretta, 3 sbagliata (scelta), 4 disabilitata
export component OptionTile inherits Rectangle {
    in property <string> letter;
    in property <string> text;
    in property <string> note;
    // 0 libera, 1 scelta, 2 giusta, 3 sbagliata (la tua), 4 altre dopo la conferma
    in property <int> state;
    // nella giusta, dopo la conferma: spiegazione e rimando al libro (Traguardo)
    in property <string> detail;
    in property <string> ref-label;
    callback open-ref;
    callback clicked;
    property <color> bg: root.state == 1 ? M3.primary-container : root.state == 2 ? M3.success-container : root.state == 3 ? M3.error-container : M3.surface-container;
    property <color> fg: root.state == 2 ? M3.on-success-container : root.state == 3 ? M3.on-error-container : root.state == 1 ? M3.on-primary-container : M3.on-surface;
    min-height: max(60px, opt-row.preferred-height);
    border-radius: 20px;
    background: root.bg;
    animate background { duration: 150ms; }
    opacity: root.state == 4 ? 0.6 : 1;
    opt-row := VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: root.state == 2 || root.state == 3 ? 18px : 12px;
                animate border-radius {
                    duration: Motion.fast-spatial;
                    easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
                }
                background: root.state == 1 ? M3.primary : root.state == 2 ? M3.success : root.state == 3 ? M3.error : M3.surface-container-highest;
                if root.state != 2 && root.state != 3: Text {
                    text: root.letter;
                    font-size: 15px;
                    font-weight: 800;
                    color: root.state == 1 ? M3.on-primary : M3.on-surface;
                }
                if root.state == 2 || root.state == 3: Icon {
                    x: 7px;
                    y: 7px;
                    width: 22px;
                    height: 22px;
                    source: root.state == 2 ? Icons.check : Icons.close;
                    tint: M3.surface;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 6px;
                Text {
                    text: root.text;
                    color: root.fg;
                    font-size: 17px;
                    font-weight: root.state == 2 || root.state == 3 ? 700 : 400;
                    wrap: word-wrap;
                }
                if root.note != "" && root.state != 2: Text {
                    text: root.note;
                    color: root.state == 4 ? M3.on-surface-variant : root.fg.with-alpha(0.85);
                    font-size: Type.body;
                    wrap: word-wrap;
                }
            }
            if root.state == 2 || root.state == 3: VerticalLayout {
                alignment: center;
                Text {
                    text: root.state == 2 ? "giusta" : "la tua";
                    font-size: 12px;
                    font-weight: 700;
                    color: root.fg;
                }
            }
        }
        if root.state == 2 && (root.detail != "" || root.note != ""): Text {
            text: root.detail != "" ? root.detail : root.note;
            color: root.fg;
            font-size: 14.5px;
            wrap: word-wrap;
        }
        if root.state == 2 && root.ref-label != "": TouchArea {
            height: refl.preferred-height;
            clicked => {
                root.open-ref();
            }
            refl := HorizontalLayout {
                spacing: 8px;
                VIcon {
                    source: Icons.book;
                    tint: root.fg;
                    size: 18px;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Se vuoi approfondire: " + root.ref-label;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.fg;
                    wrap: word-wrap;
                }
            }
        }
    }

    Ripple {
        border-radius: root.border-radius;
        pressed: ta.pressed;
        px: ta.pressed-x;
        py: ta.pressed-y;
    }

    property <float> pop: 0;
    changed state => {
        if (root.state == 2 || root.state == 3 || root.state == 1) {
            pop = floor(pop) + 1;
        }
    }
    animate pop {
        duration: Motion.spatial;
        easing: cubic-bezier(0.38, 1.21, 0.22, 1.0);
    }
    property <float> pf: pop - floor(pop);
    transform-scale-x: pf == 0 ? 100% : 100% + 3% * sin(pf * 180deg);
    transform-scale-y: pf == 0 ? 100% : 100% + 3% * sin(pf * 180deg);

    // dopo la conferma (giusta/sbagliata/altre) il riquadro non risponde più: resta attivo il
    // rimando al libro dentro la giusta
    ta := TouchArea {
        enabled: root.state <= 1;
        clicked => {
            root.clicked();
        }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> bg: M3.secondary-container;
    in property <color> fg: M3.on-secondary-container;
    height: 24px;
    border-radius: 12px;
    background: root.bg;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.fg;
            font-size: Type.label;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component RefBox inherits Rectangle {
    in property <string> label;
    callback open;
    border-radius: Shape.lg-inc;
    background: M3.surface.with-alpha(0.55);
    border-width: 1px;
    border-color: M3.outline-variant;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VIcon {
            source: Icons.book;
            tint: M3.primary;
            size: 22px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: "Se vuoi approfondire";
                font-size: Type.label;
                font-weight: 700;
                color: M3.primary;
            }

            Text {
                text: root.label;
                font-size: Type.body;
                color: M3.on-surface;
                wrap: word-wrap;
            }
        }

        M3Button {
            kind: 3;
            text: "Apri";
            clicked => {
                root.open();
            }
        }
    }
}

export component StarRating inherits HorizontalLayout {
    in-out property <int> value;
    spacing: 0px;
    for i in 5: IconButton {
        icon: i < root.value ? Icons.star : Icons.star-outline;
        tint: i < root.value ? #F2A900 : M3.on-surface-variant;
        clicked => {
            root.value = root.value == i + 1 ? 0 : i + 1;
        }
    }
}

// Area scorrevole verticale che è essa stessa il layout del contenuto (padding, spacing,
// alignment come un VerticalLayout). Il segnaposto di fine sta nello stesso layout dei figli:
// preferred-height di Slint sottostima i testi a capo dentro righe orizzontali (i figli
// «sbordano» ma restano nelle posizioni giuste), quindi l'altezza scorrevole si prende dalla
// posizione reale di scroller-end e non da preferred-height. Prima lo scroll si fermava prima
// della fine (schede Studio, tabelle del lettore).
export component Scroller inherits ScrollView {
    in property <length> pad: 0px;
    in property <length> pad-top: root.pad;
    in property <length> pad-bottom: root.pad;
    in property <length> pad-left: root.pad;
    in property <length> pad-right: root.pad;
    in property <length> gap: 0px;
    in property <LayoutAlignment> align: LayoutAlignment.start;
    mouse-drag-pan-enabled: AppState.drag-pan;
    content-width: self.visible-width;
    // + margine di sicurezza: se un testo a capo resta comunque sottostimato, il fondo è raggiungibile
    content-height: max(self.visible-height, scroller-end.y + root.pad-bottom + 32px);
    Rectangle {
        width: root.visible-width;
        VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.visible-width;
            height: max(root.visible-height, self.preferred-height);
            padding-top: root.pad-top;
            padding-left: root.pad-left;
            padding-right: root.pad-right;
            padding-bottom: 0px;
            spacing: root.gap;
            alignment: root.align;
            @children
            scroller-end := Rectangle {
                height: 0px;
            }
        }
    }
}

// riquadro «guida per un'AI»: copia o condivide un testo lungo senza mostrarlo
export component LlmCopy inherits Rectangle {
    in property <string> text;
    in property <string> title: "Tutta la guida per un'AI";
    in property <string> body: "Un solo testo con regole severe, formati e prompt: incollalo in una chat con un'AI, scrivi il compito e allega il tuo materiale.";
    callback copied;
    callback share;
    background: M3.tertiary-container;
    border-radius: 12px;
    min-height: lay.preferred-height;
    // testo nascosto: serve solo a copiare
    buf := TextInput {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        text: root.text;
        read-only: true;
        single-line: false;
        enabled: false;
        opacity: 0;
    }
    lay := VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: root.title;
            font-weight: 700;
            font-size: Type.body;
            color: M3.on-tertiary-container;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            font-size: Type.label;
            color: M3.on-tertiary-container;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 4px;
            M3Button {
                text: "Copia";
                kind: 2;
                clicked => {
                    buf.select-all();
                    buf.copy();
                    buf.clear-selection();
                    root.copied();
                }
            }
            M3Button {
                text: "Condividi";
                kind: 2;
                clicked => {
                    root.share();
                }
            }
        }
    }
}

// Traguardo: una voce del menu di «Studia ora» (pillola tonale con simbolo, titolo e riga sotto)
component FabMenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> sub;
    callback clicked;
    height: 56px;
    border-radius: 28px;
    background: ta.pressed ? M3.primary-container.darker(8%) : M3.primary-container;
    drop-shadow-blur: 6px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000030;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 22px;
        spacing: 12px;
        alignment: start;
        Icon {
            source: root.icon;
            tint: M3.on-primary-container;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
                color: M3.on-primary-container;
            }
            Text {
                text: root.sub;
                font-size: Type.label;
                color: M3.on-primary-container;
                visible: root.sub != "";
            }
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Traguardo: pulsante d'azione «Studia ora» con il suo menu (quiz, ripasso, simulazione,
// concentrazione). Esteso nella Home, solo simbolo nelle altre schede.
export component FabMenu inherits Rectangle {
    in property <bool> extended: true;
    VerticalLayout {
        alignment: end;
        spacing: 8px;
        if AppState.fab-open: HorizontalLayout {
            alignment: end;
            FabMenuItem {
                icon: Icons.quiz;
                title: "Quiz";
                sub: "scegli argomenti e quante domande";
                clicked => {
                    AppState.fab-open = false;
                    AppState.open-sub(6);
                }
            }
        }
        if AppState.fab-open: HorizontalLayout {
            alignment: end;
            FabMenuItem {
                icon: Icons.cards;
                title: "Ripasso flashcard";
                sub: AppState.due-count > 0 ? AppState.due-count + " da ripassare oggi" : "le carte da ripassare";
                clicked => {
                    AppState.fab-open = false;
                    AppState.start-cards("all", "");
                }
            }
        }
        if AppState.fab-open && AppState.exam-rules != "": HorizontalLayout {
            alignment: end;
            FabMenuItem {
                icon: Icons.timer;
                title: "Simulazione d'esame";
                sub: "come il giorno della prova";
                clicked => {
                    AppState.fab-open = false;
                    AppState.start-exam(AppState.current-subject);
                }
            }
        }
        if AppState.fab-open: HorizontalLayout {
            alignment: end;
            FabMenuItem {
                icon: Icons.focus;
                title: "Concentrazione";
                sub: "blocca le distrazioni";
                clicked => {
                    AppState.fab-open = false;
                    AppState.go-tab(2);
                    AppState.focus-setup(true);
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            fab := Rectangle {
                // misura della scritta, fuori dal layout (una scritta nascosta occupa comunque spazio)
                measure := Text {
                    visible: false;
                    text: "Studia ora";
                    font-size: 17px;
                    font-weight: 700;
                }
                property <bool> wide: root.extended && !AppState.fab-open;
                height: AppState.fab-open ? 56px : 64px;
                width: AppState.fab-open ? 56px : self.wide ? measure.preferred-width + 20px + 28px + 12px + 24px : 64px;
                border-radius: AppState.fab-open ? 28px : 20px;
                background: fta.pressed ? M3.primary.darker(10%) : M3.primary;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: M3.primary.with-alpha(0.35);
                animate width, height, border-radius {
                    duration: Motion.fast-spatial;
                    easing: cubic-bezier(0.42, 1.67, 0.21, 0.9);
                }
                // chiuso nella Home: simbolo e scritta; aperto (o nelle altre schede): solo il
                // simbolo, al centro esatto del cerchio
                if !fab.wide: Icon {
                    source: AppState.fab-open ? Icons.close : Icons.play-arrow;
                    tint: M3.on-primary;
                    width: AppState.fab-open ? 24px : 28px;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if fab.wide: HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 24px;
                    spacing: 12px;
                    Icon {
                        source: Icons.play-arrow;
                        tint: M3.on-primary;
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Studia ora";
                        font-size: 17px;
                        font-weight: 700;
                        color: M3.on-primary;
                        vertical-alignment: center;
                    }
                }
                fta := TouchArea {
                    clicked => {
                        AppState.fab-open = !AppState.fab-open;
                    }
                }
            }
        }
    }
}

// Traguardo (da Notturno): barra della sessione in pausa, sopra la navigazione. Toccandola si
// riprende il quiz da dove era rimasto; la X lo scarta.
export component SessionBar inherits Rectangle {
    height: 64px;
    border-radius: 20px;
    background: bta.pressed ? M3.tertiary-container.darker(6%) : M3.tertiary-container;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000038;
    bta := TouchArea {
        clicked => {
            AppState.resume-quiz();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 12px;
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            RingProgress {
                width: 44px;
                height: 44px;
                value: AppState.paused-frac;
                thickness: 5px;
                fill: M3.on-tertiary-container;
                track: M3.on-tertiary-container.with-alpha(0.2);
            }
            Text {
                text: AppState.paused-n;
                font-size: 14px;
                font-weight: 800;
                color: M3.on-tertiary-container;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "In pausa · " + AppState.paused-title;
                font-size: 14.5px;
                font-weight: 700;
                color: M3.on-tertiary-container;
                overflow: elide;
            }
            Text {
                text: AppState.paused-short;
                font-size: Type.label;
                color: M3.on-tertiary-container;
                overflow: elide;
            }
        }
        Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: 24px;
            background: pta.pressed ? M3.on-tertiary-container.with-alpha(0.12) : transparent;
            Icon {
                source: Icons.play-arrow;
                tint: M3.on-tertiary-container;
                width: 28px;
                height: 28px;
            }
            pta := TouchArea {
                clicked => {
                    AppState.resume-quiz();
                }
            }
        }
        Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: 24px;
            background: xta.pressed ? M3.on-tertiary-container.with-alpha(0.12) : transparent;
            Icon {
                source: Icons.close;
                tint: M3.on-tertiary-container;
                width: 22px;
                height: 22px;
            }
            xta := TouchArea {
                clicked => {
                    AppState.discard-paused();
                }
            }
        }
    }
}
