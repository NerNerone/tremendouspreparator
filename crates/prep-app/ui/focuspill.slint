// Concentrazione sul computer: pillola flottante in basso a destra dello schermo, sempre in
// primo piano, con il tempo che manca, la gara e le app permesse. Sopra, quando si apre
// un'app non permessa, l'avviso con il conto alla rovescia prima della chiusura.
import { M3, Icons } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { RingProgress, Icon } from "components.slint";

export component FocusPill inherits Window {
    // il titolo serve anche a KWin per riconoscerla (vedi deskfocus::kwin_place)
    title: "Tremendous · Concentrazione";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <string> time;
    in property <float> frac;
    in property <string> sub;
    in property <string> apps;
    in property <string> warn;
    in property <int> warn-left;
    in property <bool> pit;
    // tema come nell'app: 0 sistema, 1 chiaro, 2 scuro (i colori arrivano da M3, copiati
    // dall'app: accento di sistema o quello scelto in Aspetto)
    in property <int> mode;
    property <ColorScheme> sys-scheme;
    init => {
        root.sys-scheme = Palette.color-scheme;
        root.apply-mode();
    }
    changed mode => {
        root.apply-mode();
    }
    function apply-mode() {
        if (root.mode == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.mode == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = root.sys-scheme;
        }
    }
    callback open-app();
    callback toggle-pit();
    // trascinata con il mouse (la sposta il sistema) e ridotta a icona
    callback drag();
    callback minimize();
    width: 380px;
    // altezza fissa: la pillola resta in basso, l'avviso compare sopra
    height: 212px;
    VerticalLayout {
        spacing: 6px;
        alignment: end;
        if root.warn != "": Rectangle {
            height: 82px;
            border-radius: 22px;
            background: M3.error-container;
            VerticalLayout {
                padding: 14px;
                padding-left: 18px;
                spacing: 4px;
                Text {
                    text: root.warn + " non è tra le app permesse";
                    font-size: 15px;
                    font-weight: 800;
                    color: M3.on-error-container;
                    overflow: elide;
                }
                Text {
                    text: root.warn-left > 0 ? "Lo chiudo tra " + root.warn-left + " s · torna allo studio o aggiungila la prossima volta" : "Lo sto chiudendo";
                    font-size: 12.5px;
                    color: M3.on-error-container;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: M3.on-error-container.with-alpha(0.15);
                    Rectangle {
                        x: 0px;
                        width: parent.width * max(0, root.warn-left / 10);
                        border-radius: 2px;
                        background: M3.error;
                    }
                }
            }
        }
        Rectangle {
            height: 118px;
            border-radius: 30px;
            background: M3.surface-container-high;
            border-width: 1px;
            border-color: M3.outline-variant;
            drop-shadow-blur: 0px;
            // si sposta trascinandola dove non ci sono pulsanti: il sistema prende il
            // trascinamento solo dopo qualche pixel di movimento, così un clic resta un clic
            TouchArea {
                mouse-cursor: move;
                moved => {
                    if (self.pressed && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                        root.drag();
                    }
                }
            }
            HorizontalLayout {
                padding: 14px;
                padding-right: 16px;
                spacing: 14px;
                Rectangle {
                    width: 88px;
                    RingProgress {
                        width: 88px;
                        height: 88px;
                        y: (parent.height - self.height) / 2;
                        value: root.frac;
                        thickness: 8px;
                        fill: M3.primary;
                        track: M3.primary.with-alpha(0.16);
                    }
                    Text {
                        text: root.time;
                        font-size: root.time.character-count > 5 ? 15px : 19px;
                        font-weight: 900;
                        color: M3.on-surface;
                    }
                    TouchArea {
                        clicked => {
                            root.open-app();
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: "Concentrazione";
                        font-size: 18px;
                        font-weight: 800;
                        color: M3.on-surface;
                    }
                    Text {
                        text: root.sub;
                        font-size: 12.5px;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    if root.apps != "": Text {
                        text: root.apps;
                        font-size: 12.5px;
                        color: M3.primary;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        x: 7px;
                        border-radius: 15px;
                        background: mta.pressed ? M3.surface-container-highest : transparent;
                        Rectangle {
                            x: 9px;
                            y: 14px;
                            width: 12px;
                            height: 2px;
                            border-radius: 1px;
                            background: M3.on-surface-variant;
                        }
                        mta := TouchArea {
                            clicked => {
                                root.minimize();
                            }
                        }
                    }
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: pta.pressed ? M3.primary : M3.primary-container;
                        Icon {
                            x: 12px;
                            y: 12px;
                            width: 20px;
                            height: 20px;
                            source: root.pit ? Icons.play : Icons.pause;
                            tint: pta.pressed ? M3.on-primary : M3.on-primary-container;
                        }
                        pta := TouchArea {
                            clicked => {
                                root.toggle-pit();
                            }
                        }
                    }
                }
            }
        }
    }
}
