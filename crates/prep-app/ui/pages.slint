import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "theme.slint";
import { AppState, CarVM, CrewVM, RankVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller } from "components.slint";

component SubjectCard inherits Card {
    in property <SubjectVM> s;
    clickable: true;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: M3.subject(root.s.id);
                }
            }

            Text {
                text: root.s.name;
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: round(root.s.mastery * 100) + "%";
                font-size: Type.title;
                font-weight: 700;
                color: M3.subject(root.s.id);
            }
        }

        WavyProgress {
            intro: !AppState.home-intro-done;
            value: root.s.mastery;
            fill: M3.subject(root.s.id);
            amp: 3px;
            wavelength: 28px;
            thickness: 4px;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Punteggio atteso " + root.s.predicted + (root.s.pace != "" ? "\n" + root.s.pace : "");
                wrap: word-wrap;
                color: M3.on-surface-variant;
                font-size: Type.label;
                horizontal-stretch: 1;
            }

            if root.s.flagged > 0: Pill {
                text: root.s.flagged + " insicure";
                bg: M3.tertiary-container;
                fg: M3.on-tertiary-container;
            }
        }
    }
}

export component HomePage inherits Page {
    // intestazione grande che si comprime scorrendo (0 = aperta, 1 = compatta)
    property <length> hero-max: 288px;
    property <length> hero-min: 140px;
    property <float> t: max(0, min(1, -sv.content-y / (root.hero-max - root.hero-min)));
    property <length> hero-h: root.hero-max - (root.hero-max - root.hero-min) * root.t;
    // l'ingresso animato delle barre si vede solo la prima volta: tornando alla Home
    // (la pagina viene ricreata) le barre compaiono già piene, senza svuotarsi e ripartire
    Timer {
        interval: 1500ms;
        running: !AppState.home-intro-done;
        triggered => {
            AppState.home-intro-done = true;
        }
    }

    sv := Scroller {
        width: 100%;
        height: 100%;
        content-y <=> AppState.home-scroll;
        align: start;
        pad: 16px;
        pad-top: root.hero-max + 4px;
        gap: 14px;
        // sincronizzazione, sotto la preparazione (solo se GitHub è configurato in Impostazioni)
        if AppState.sync-configured: HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: AppState.sync-status;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }

            if AppState.syncing: Rectangle {
                width: 48px;
                MorphLoader { }
            }
            if !AppState.syncing: M3Button {
                text: "Sincronizza";
                kind: 1;
                has-icon: true;
                icon: Icons.sync;
                clicked => {
                    AppState.sync-now();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            for d in AppState.exam-dates: Pill {
                text: d.label + ": " + (d.days > 0 ? "tra " + d.days + " giorni" : d.days == 0 ? "OGGI" : "passato");
                bg: d.days >= 0 && d.days <= 7 ? M3.error-container : M3.tertiary-container;
                fg: d.days >= 0 && d.days <= 7 ? M3.on-error-container : M3.on-tertiary-container;
            }
        }

            if AppState.paused-title != "": Card {
                bg: M3.tertiary-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VIcon {
                            source: Icons.pause;
                            tint: M3.on-tertiary-container;
                            size: 20px;
                        }

                        Text {
                            text: "In pausa: " + AppState.paused-title;
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-tertiary-container;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: AppState.paused-info;
                        font-size: Type.label;
                        color: M3.on-tertiary-container;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        M3Button {
                            text: "Scarta";
                            kind: 3;
                            clicked => {
                                AppState.discard-paused();
                            }
                        }

                        M3Button {
                            text: "Riprendi";
                            has-icon: true;
                            icon: Icons.play;
                            clicked => {
                                AppState.resume-quiz();
                            }
                        }
                    }
                }
            }

            if AppState.goals.length > 0: Card {
                clickable: true;
                bg: M3.secondary-container;
                clicked => {
                    AppState.open-goals();
                }
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VIcon {
                        source: Icons.target;
                        tint: M3.on-secondary-container;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: AppState.goals-confirmed ? "Obiettivi di oggi" : "Scegli gli obiettivi di oggi";
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-secondary-container;
                        }

                        Text {
                            text: AppState.goals-confirmed ? AppState.goals-status : "Una proposta è pronta nella scheda Obiettivi";
                            font-size: Type.label;
                            color: M3.on-secondary-container;
                            wrap: word-wrap;
                        }
                    }

                    VIcon {
                        source: Icons.chevron;
                        tint: M3.on-secondary-container;
                    }
                }
            }

            for s[i] in AppState.subjects: SubjectCard {
                s: s;
                stagger: i + 1;
                clicked => {
                    AppState.select-subject(s.id);
                    AppState.go-tab(1);
                }
            }

            HorizontalLayout {
                spacing: 10px;
                M3Button {
                    kind: 1;
                    has-icon: true;
                    icon: Icons.flag;
                    text: "Ripasso (" + (AppState.flagged-count + AppState.wrong-count) + ")";
                    enabled: AppState.flagged-count + AppState.wrong-count > 0;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.start-review("");
                    }
                }

                M3Button {
                    kind: 1;
                    has-icon: true;
                    icon: Icons.cards;
                    text: "Flashcard (" + AppState.due-count + ")";
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.start-cards("all", "");
                    }
                }
            }

            if AppState.ai-summary != "": Card {
                bg: M3.surface-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            source: Icons.ai;
                            tint: M3.primary;
                            width: 20px;
                            height: 20px;
                        }

                        Text {
                            text: "Revisione AI";
                            font-weight: 700;
                            font-size: Type.title;
                            color: M3.on-surface;
                        }
                    }

                    Text {
                        text: AppState.ai-summary;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }

                    for p in AppState.ai-priorities: Text {
                        text: "• " + p;
                        wrap: word-wrap;
                        color: M3.on-surface-variant;
                        font-size: Type.body;
                    }
                }
            }

            Text {
                text: AppState.content-info;
                color: M3.on-surface-variant;
                font-size: Type.label;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

    // intestazione: titolo, impostazioni, percentuale grande e barra ondulata
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.hero-h;
        background: M3.surface;
        Rectangle {
            x: 12px;
            y: 56px;
            width: parent.width - 24px;
            height: parent.height - 64px;
            border-radius: Shape.xl - 8px * root.t;
            background: M3.primary-container;
            clip: true;
            // percentuale: grande e a sinistra, poi piccola a destra; «Preparazione» resta sempre
            // allineato a sinistra (prima scivolava a destra accanto alla percentuale)
            pct := Text {
                x: 20px + (parent.width - 40px - self.width) * root.t;
                y: 14px - 4px * root.t;
                text: round(AppState.overall * 100) + "%";
                font-size: Type.display-large * (1 - root.t) + 26px * root.t;
                font-weight: 800;
                color: M3.on-primary-container;
            }

            Text {
                x: 20px;
                y: 104px - 88px * root.t;
                width: parent.width - 40px - (pct.width + 12px) * root.t;
                text: "Preparazione";
                font-size: Type.title-large * (1 - root.t) + Type.title * root.t;
                font-weight: 700;
                color: M3.on-primary-container;
                overflow: elide;
            }

            Text {
                x: 20px;
                y: 134px;
                width: parent.width - 40px;
                text: AppState.overall-label + (AppState.total-time != "" ? "\n" + AppState.total-time : "");
                font-size: Type.label;
                color: M3.on-primary-container;
                opacity: max(0, 1 - root.t * 2.2);
                wrap: word-wrap;
            }

            WavyProgress {
                intro: !AppState.home-intro-done;
                x: 20px;
                y: parent.height - self.height - 18px + 4px * root.t;
                width: parent.width - 40px;
                value: AppState.overall;
                fill: M3.primary;
                track: M3.surface.with-alpha(0.7);
                amp: 6px - 3px * root.t;
                wavelength: 44px - 12px * root.t;
                thickness: 7px - 2px * root.t;
            }
        }

        // riga del titolo
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 56px;
            padding-left: 20px;
            padding-right: 4px;
            // selettore dell'esame: nome dell'esame attivo, tocca per cambiarlo o aggiungerne uno
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        border-radius: 20px;
                        background: sel-ta.pressed || AppState.exam-menu ? M3.surface-container-high : transparent;
                        animate background { duration: 150ms; }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text {
                                text: AppState.exam-name;
                                font-size: Type.title-large;
                                font-weight: 700;
                                color: M3.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: root.width - 140px;
                            }
                            Rectangle {
                                width: 16px;
                                Path {
                                    width: 14px;
                                    height: 8px;
                                    viewbox-width: 14;
                                    viewbox-height: 8;
                                    commands: AppState.exam-menu ? "M 1 7 L 7 1 L 13 7" : "M 1 1 L 7 7 L 13 1";
                                    stroke: M3.on-surface;
                                    stroke-width: 2px;
                                }
                            }
                        }
                        sel-ta := TouchArea {
                            clicked => {
                                AppState.exam-menu = !AppState.exam-menu;
                            }
                        }
                    }
                }
            }

            IconButton {
                icon: Icons.tune;
                tint: M3.on-surface;
                clicked => {
                    AppState.open-settings();
                }
            }
        }
    }

    // menu degli esami installati (sopra a tutto)
    if AppState.exam-menu: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000033;
        TouchArea {
            clicked => {
                AppState.exam-menu = false;
            }
        }
        Rectangle {
            x: 12px;
            y: 52px;
            width: min(root.width - 24px, 520px);
            height: menu.preferred-height;
            border-radius: Shape.lg;
            background: M3.surface-container;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0000004d;
            drop-shadow-offset-y: 4px;
            TouchArea { }
            menu := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: "Esami installati";
                    font-size: Type.label;
                    font-weight: 700;
                    color: M3.on-surface-variant;
                    height: 28px;
                    vertical-alignment: center;
                    x: 12px;
                }
                for e in AppState.exams: Rectangle {
                    min-height: 56px;
                    border-radius: 12px;
                    background: e.active ? M3.secondary-container : row-ta.pressed ? M3.surface-container-high : transparent;
                    row-ta := TouchArea {
                        clicked => {
                            AppState.select-exam(e.id);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        spacing: 10px;
                        Rectangle {
                            width: 22px;
                            if e.active: VIcon {
                                source: Icons.check;
                                tint: M3.on-secondary-container;
                                size: 20px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: e.name;
                                font-weight: 700;
                                color: M3.on-surface;
                                wrap: word-wrap;
                            }
                            Text {
                                text: e.info;
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                        IconButton {
                            icon: Icons.close;
                            tint: M3.on-surface-variant;
                            clicked => {
                                AppState.remove-exam(e.id);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: M3.outline-variant;
                }
                Rectangle {
                    min-height: 52px;
                    border-radius: 12px;
                    background: add-ta.pressed ? M3.surface-container-high : transparent;
                    add-ta := TouchArea {
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.import-pack();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        VIcon {
                            source: Icons.add;
                            tint: M3.primary;
                            size: 22px;
                        }
                        Text {
                            text: AppState.pack-busy ? "Importazione…" : "Importa un pacchetto (nuovo esame o aggiornamento)";
                            color: M3.primary;
                            font-weight: 700;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Text {
                    text: "Ogni esame ha contenuti e progressi suoi. Un pacchetto va all'esame indicato nel suo syllabus: se è nuovo viene aggiunto qui.";
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component GoalsPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Obiettivi";
            subtitle: "Argomenti di oggi: proposti in base ai progressi, o scelti da te";
            can-back: true;
            back => {
                AppState.back();
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 14px;
            if AppState.goals.length > 0: Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    VIcon {
                        source: Icons.check;
                        tint: M3.primary;
                        size: 20px;
                    }

                    Text {
                        text: AppState.goals-confirmed ? "Obiettivi di oggi" : "Proposta per oggi";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: AppState.goals-confirmed ? AppState.goals-status : AppState.goals-note;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }

                for g[i] in AppState.goals: Rectangle {
                    border-radius: 12px;
                    background: g.selected || AppState.goals-confirmed ? M3.secondary-container : M3.surface-container-high;
                    animate background { duration: 180ms; }
                    TouchArea {
                        clicked => {
                            AppState.goals-open = AppState.goals-open == "g:" + g.topic ? "" : "g:" + g.topic;
                        }
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            if !AppState.goals-confirmed: Switch {
                                checked: g.selected;
                                toggled => {
                                    AppState.goals-toggle(i);
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: g.name;
                                    font-weight: 600;
                                    color: M3.on-secondary-container;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: g.info;
                                    font-size: Type.label;
                                    color: M3.on-secondary-container.with-alpha(0.8);
                                    wrap: word-wrap;
                                }
                            }

                            if AppState.goals-confirmed: IconButton {
                                icon: Icons.remove;
                                tint: M3.on-secondary-container;
                                clicked => {
                                    AppState.goals-remove(i);
                                }
                            }
                        }

                        if AppState.goals-open == "g:" + g.topic: HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            M3Button {
                                text: "Studia";
                                kind: 3;
                                small: true;
                                has-icon: true;
                                icon: Icons.book;
                                clicked => {
                                    AppState.goals-study(g.topic);
                                }
                            }

                            if AppState.goals-confirmed: M3Button {
                                text: g.done >= g.target ? "Fatto" : "Allenati";
                                kind: g.done >= g.target ? 3 : 1;
                                small: true;
                                has-icon: true;
                                icon: g.done >= g.target ? Icons.check : Icons.play;
                                clicked => {
                                    AppState.goals-train(g.topic);
                                }
                            }
                        }

                        if AppState.goals-confirmed: LinearProgress {
                            value: g.target > 0 ? min(1, g.done / g.target) : 0;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if AppState.goals-confirmed: M3Button {
                        text: "Nuova proposta";
                        kind: 3;
                        clicked => {
                            AppState.goals-edit();
                        }
                    }
                    if !AppState.goals-confirmed: M3Button {
                        text: "Conferma obiettivi";
                        has-icon: true;
                        icon: Icons.check;
                        clicked => {
                            AppState.goals-confirm();
                        }
                    }
                }
            }
            }


            if AppState.review-goals.length > 0: Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    VIcon {
                        source: Icons.sync;
                        tint: M3.on-tertiary-container;
                        size: 20px;
                    }

                    Text {
                        text: "Obiettivi di ripasso";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: "Argomenti che non tocchi da qualche giorno: un breve ripasso con domande già viste e nuove li fissa nella memoria.";
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }

                for r in AppState.review-goals: Rectangle {
                    border-radius: 12px;
                    background: M3.tertiary-container;
                    TouchArea {
                        clicked => {
                            AppState.goals-open = AppState.goals-open == "r:" + r.topic ? "" : "r:" + r.topic;
                        }
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: r.name;
                            font-weight: 600;
                            color: M3.on-tertiary-container;
                            wrap: word-wrap;
                        }

                        Text {
                            text: r.info;
                            font-size: Type.label;
                            color: M3.on-tertiary-container.with-alpha(0.8);
                            wrap: word-wrap;
                        }

                        if AppState.goals-open == "r:" + r.topic: HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            M3Button {
                                text: "Studia";
                                kind: 3;
                                small: true;
                                has-icon: true;
                                icon: Icons.book;
                                clicked => {
                                    AppState.goals-study(r.topic);
                                }
                            }

                            M3Button {
                                text: "Ripassa";
                                kind: 1;
                                small: true;
                                has-icon: true;
                                icon: Icons.sync;
                                clicked => {
                                    AppState.goals-review(r.topic);
                                }
                            }
                        }
                    }
                }
            }
            }

            SectionTitle {
            text: "Aggiungi un argomento";
            }

            HorizontalLayout {
            spacing: 8px;
            for s in AppState.subjects: Chip {
                text: s.id == "chi" ? "Chimica" : s.name;
                selected: AppState.goal-subject == s.id;
                clicked => {
                    AppState.goals-pick-subject(s.id);
                }
            }
            }

            for t in AppState.goal-topics: Rectangle {
            min-height: max(56px, gt-row.preferred-height);
            border-radius: Shape.lg;
            background: t.selected ? M3.secondary-container : M3.surface-container-low;
            animate background { duration: 200ms; }
            gt-row := HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: t.name;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }

                    Text {
                        text: t.info;
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                }

                IconButton {
                    icon: t.selected ? Icons.check : Icons.add;
                    filled: !t.selected;
                    tint: t.selected ? M3.primary : M3.on-secondary-container;
                    clicked => {
                        AppState.goals-add(t.topic);
                    }
                }
            }
            }
        }
    }
}

export component StudyPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Studio";
            subtitle: "Allenamento per unità e simulazioni d'esame";
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            spacing: 8px;
            for s in AppState.subjects: Chip {
                text: s.id == "chi" ? "Chimica" : s.name;
                selected: AppState.current-subject == s.id;
                clicked => {
                    AppState.select-subject(s.id);
                }
            }
        }

        // lo scroll verticale sta fuori, lo swipe orizzontale dentro: il Flickable vede per primo il
        // dito e scorre in verticale; i gesti orizzontali passano allo swipe (materia prec./succ.).
        // Al contrario (swipe fuori) lo SwipeGestureHandler tratteneva la pressione e lo scroll non partiva.
        Scroller {
            vertical-stretch: 1;
            swipe := SwipeGestureHandler {
                handle-swipe-left: true;
                handle-swipe-right: true;
                property <length> dx: self.swiping ? self.current-position.x - self.pressed-position.x : 0px;
                height: content-end.y + 16px;
                swiped => {
                    if (self.current-position.x - self.pressed-position.x < -60px) {
                        AppState.step-subject(1);
                    } else if (self.current-position.x - self.pressed-position.x > 60px) {
                        AppState.step-subject(-1);
                    }
                }
                content := VerticalLayout {
                    x: swipe.dx * 0.35;
                    width: parent.width;
                    // preferred-height sottostima i testi a capo nelle righe orizzontali: i figli
                    // «sbordano» ma restano nelle posizioni giuste, quindi la fine reale è content-end.y
                    height: self.preferred-height;
                    // niente opacity qui: un elemento trasparente viene disegnato in una texture
                    // grande quanto lui e oltre il limite della GPU sparisce tutto
                    animate x { duration: 180ms; easing: ease-out; }
                    alignment: start;
                    padding: 16px;
                    padding-top: 4px;
                    spacing: 12px;
                    if AppState.current-subject == "chi": Card {
                        bg: M3.surface-container;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "Strumenti di chimica";
                                font-size: Type.title;
                                font-weight: 700;
                                color: M3.on-surface;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                M3Button {
                                    text: "Tavola periodica";
                                    kind: 1;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.open-periodic();
                                    }
                                }
                                if AppState.has-nomenclature: M3Button {
                                    text: "Nomenclatura";
                                    kind: 1;
                                    has-icon: true;
                                    icon: Icons.book;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.open-nomenclature();
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        bg: M3.surface-container;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "Simulazione d'esame";
                                font-size: Type.title;
                                font-weight: 700;
                                color: M3.on-surface;
                            }

                            Text {
                                text: AppState.exam-rules;
                                wrap: word-wrap;
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                M3Button {
                                    text: "Simula esame";
                                    has-icon: true;
                                    icon: Icons.timer;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.start-exam(AppState.current-subject);
                                    }
                                }

                                M3Button {
                                    text: "Quiz misto";
                                    kind: 2;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.start-practice("subject", AppState.current-subject);
                                    }
                                }
                            }

                            Text {
                                text: "Prove ufficiali 2025 (domande reali, ordine originale):";
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                M3Button {
                                    text: "1° appello";
                                    kind: 1;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.start-official(AppState.current-subject, "e25a1");
                                    }
                                }

                                M3Button {
                                    text: "2° appello";
                                    kind: 1;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        AppState.start-official(AppState.current-subject, "e25a2");
                                    }
                                }
                            }
                        }
                    }

                    if AppState.books.length > 0: SectionTitle {
                        text: "Libri";
                    }
                    for b[i] in AppState.books: Card {
                        clickable: true;
                        stagger: i + 1;
                        clicked => {
                            AppState.open-book(b.id);
                        }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VIcon {
                                source: Icons.book;
                                tint: M3.subject(AppState.current-subject);
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: b.title;
                                    font-size: Type.body-large;
                                    font-weight: 600;
                                    color: M3.on-surface;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: (b.author != "" ? b.author + " · " : "") + b.chapters + " capitoli" + (b.available ? "" : " · da scaricare (sincronizza)");
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }

                            VIcon {
                                source: Icons.chevron;
                                tint: M3.on-surface-variant;
                            }
                        }
                    }

                    SectionTitle {
                        text: "Unità didattiche";
                    }

                    for u[i] in AppState.units: uc := Card {
                        clickable: true;
                        stagger: i + 1;
                        clicked => {
                            AppState.open-unit(u.id);
                        }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 10px;
                                    background: M3.subject(AppState.current-subject).with-alpha(0.16);
                                    Text {
                                        text: u.n;
                                        font-weight: 800;
                                        color: M3.subject(AppState.current-subject);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    // larghezza esplicita: così l'altezza del titolo a capo è calcolata
                                    // sulla larghezza vera e la scheda non viene tagliata
                                    width: uc.width - 28px - 32px - 20px - 48px;
                                    Text {
                                        text: u.name;
                                        font-size: Type.body-large;
                                        font-weight: 600;
                                        color: M3.on-surface;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: "CFU " + u.cfu + " · " + u.questions + " domande · " + u.cards + " flashcard" + (u.flagged > 0 ? " · " + u.flagged + " insicure" : "") + (u.time != "" ? "\nTempo: " + u.time : "");
                                        font-size: Type.label;
                                        color: M3.on-surface-variant;
                                        wrap: word-wrap;
                                    }
                                }

                                Text {
                                    text: round(u.mastery * 100) + "%";
                                    font-weight: 700;
                                    font-size: Type.title;
                                    color: M3.level(u.mastery);
                                    vertical-alignment: center;
                                }
                            }

                            LinearProgress {
                                value: u.mastery;
                                fill: M3.subject(AppState.current-subject);
                                height: 6px;
                            }
                        }
                    }
                    content-end := Rectangle {
                        height: 0px;
                    }
                }
            }
        }
    }
}

export component UnitPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Unità " + AppState.unit.n;
            subtitle: AppState.unit.name;
            can-back: true;
            back => {
                AppState.back();
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;
            Card {
                bg: M3.surface-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: AppState.unit.name;
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-surface;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: round(AppState.unit.mastery * 100) + "%";
                            font-size: Type.headline;
                            font-weight: 800;
                            color: M3.level(AppState.unit.mastery);
                        }
                    }

                    LinearProgress {
                        value: AppState.unit.mastery;
                        fill: M3.subject(AppState.current-subject);
                    }

                    Text {
                        text: "CFU " + AppState.unit.cfu + " · " + AppState.unit.questions + " domande · " + AppState.unit.cards + " flashcard · argomenti affrontati " + round(AppState.unit.touched * 100) + "%" + (AppState.unit.time != "" ? "\nTempo: " + AppState.unit.time : "");
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }

                    if AppState.unit.note != "": Text {
                        text: "AI: " + AppState.unit.note;
                        font-size: Type.body;
                        color: M3.on-surface;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "Quiz";
                            has-icon: true;
                            icon: Icons.play;
                            horizontal-stretch: 1;
                            enabled: AppState.unit.questions > 0;
                            clicked => {
                                AppState.start-practice("unit", AppState.unit.id);
                            }
                        }

                        M3Button {
                            text: "Flashcard";
                            kind: 1;
                            has-icon: true;
                            icon: Icons.cards;
                            horizontal-stretch: 1;
                            enabled: AppState.unit.cards > 0;
                            clicked => {
                                AppState.start-cards("unit", AppState.unit.id);
                            }
                        }
                    }
                }
            }

            SectionTitle {
                text: "Argomenti del syllabus";
            }

            for t in AppState.topics: VerticalLayout {
                ListRow {
                    title: t.name;
                    subtitle: t.detail + (t.has-ai ? " · " + t.ai-text : "");
                    value: t.mastery;
                    accent: M3.level(t.mastery);
                    trailing: round(t.mastery * 100) + "%";
                    chevron: t.questions > 0;
                    clicked => {
                        if (t.questions > 0) {
                            AppState.start-practice("topic", t.id);
                        }
                    }
                }

                if t.note != "": Text {
                    text: "AI: " + t.note;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component NavCell inherits Rectangle {
    in property <int> n;
    in property <bool> answered;
    in property <bool> unsure;
    in property <bool> current;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.current ? M3.primary : root.answered ? M3.secondary-container : transparent;
    border-width: root.unsure ? 2px : 1px;
    border-color: root.unsure ? M3.error : M3.outline-variant;
    Text {
        text: root.n;
        font-size: Type.label;
        font-weight: 700;
        color: root.current ? M3.on-primary : M3.on-surface;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component QuizPage inherits Page {
    // dopo la conferma la spiegazione compare in fondo: scorre fino a mostrarla tutta
    property <bool> answered-now: AppState.q-answered;
    property <length> scroll-goal;
    property <bool> scrolling;
    property <int> settle;
    changed answered-now => {
        if (answered-now && AppState.quiz-mode != 1) {
            root.settle = 0;
            root.scrolling = true;
        }
    }
    Timer {
        interval: 16ms;
        running: root.scrolling;
        triggered => {
            // l'obiettivo si ricalcola a ogni passo: la scheda può finire di impaginarsi dopo
            root.settle += 1;
            root.scroll-goal = max(0px, min(
                fbtop.y + 4px,
                fbend.y + 16px - qsv.visible-height,
                qsv.content-height - qsv.visible-height));
            if (root.settle > 60 || (root.settle > 4 && abs(root.scroll-goal + qsv.content-y) < 1px)) {
                qsv.content-y = -max(root.scroll-goal, -qsv.content-y);
                root.scrolling = false;
            } else if (root.scroll-goal > -qsv.content-y) {
                qsv.content-y += (-root.scroll-goal - qsv.content-y) * 0.22;
            }
        }
    }
    VerticalLayout {
        TopBar {
            title: AppState.quiz-title;
            subtitle: "Domanda " + (AppState.q-index + 1) + " di " + AppState.q-total + (AppState.quiz-mode == 1 ? " · risposte " + AppState.answered-count : "");
            can-back: true;
            back => {
                AppState.back();
            }
            IconButton {
                icon: Icons.pause;
                clicked => {
                    AppState.pause-quiz();
                }
            }
            if AppState.quiz-mode == 1: Rectangle {
                width: 100px;
                Pill {
                    text: AppState.time-left;
                    bg: AppState.time-warning ? M3.error-container : M3.secondary-container;
                    fg: AppState.time-warning ? M3.on-error-container : M3.on-secondary-container;
                }
            }
        }

        LinearProgress {
            height: 4px;
            border-radius: 0px;
            value: AppState.q-total > 0 ? (AppState.q-index + 1) / AppState.q-total : 0;
        }

        Swap {
            key: "" + AppState.q-index;
            vertical-stretch: 1;
        qsv := ScrollView {
            mouse-drag-pan-enabled: AppState.drag-pan;
            // il layout stima un'altezza minore del reale con testo a capo (spiegazioni lunghe su
            // schermi stretti): l'area scorrevole arriva fino all'ultimo elemento effettivo
            content-height: max(self.visible-height, qend.y + 16px);
            Rectangle {
            VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Pill {
                        text: AppState.q-is-mcq ? "Risposta multipla" : "Completamento";
                    }

                    Text {
                        text: AppState.q-topic;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: AppState.q-slow ? M3.warn-container : M3.surface-container-high;
                        animate background { duration: 400ms; }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 4px;
                            VIcon {
                                source: Icons.timer;
                                size: 14px;
                                tint: AppState.q-slow ? M3.on-warn-container : M3.on-surface-variant;
                            }

                            Text {
                                text: AppState.q-elapsed;
                                font-size: Type.label;
                                font-weight: 600;
                                vertical-alignment: center;
                                color: AppState.q-slow ? M3.on-warn-container : M3.on-surface-variant;
                            }
                        }
                    }
                }

                Text {
                    text: AppState.q-text;
                    font-size: 18px;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }

                // segnaposto (altezza 0) dove inizia la parte con la spiegazione, per lo scroll automatico
                fbtop := Rectangle {
                    height: 0px;
                }

                if AppState.q-is-mcq: VerticalLayout {
                    spacing: 10px;
                    for o[i] in AppState.q-options: OptionTile {
                        letter: o.letter;
                        text: o.text;
                        note: o.note;
                        state: o.state;
                        clicked => {
                            AppState.select-option(i);
                        }
                    }
                }

                if !AppState.q-is-mcq: LineEdit {
                    text <=> AppState.q-fill;
                    placeholder-text: "Scrivi la risposta (parola o numero)";
                    enabled: !AppState.q-answered;
                    font-size: 18px;
                    edited(t) => {
                        AppState.fill-edited(t);
                    }
                    accepted => {
                        if (AppState.quiz-mode == 1) {
                            AppState.next();
                        } else if (AppState.q-can-confirm) {
                            AppState.confirm();
                        }
                    }
                }

                if AppState.q-answered && AppState.quiz-mode != 1: Card {
                    bg: AppState.q-correct ? M3.success-container : M3.error-container;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Icon {
                                source: AppState.q-correct ? Icons.check : Icons.close;
                                tint: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                            }

                            Text {
                                text: AppState.q-correct ? "Corretto" : "Sbagliato";
                                font-size: Type.title;
                                font-weight: 700;
                                vertical-alignment: center;
                                color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                            }
                        }

                        Text {
                            text: "Risposta: " + AppState.q-correct-text;
                            wrap: word-wrap;
                            font-weight: 600;
                            color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                        }

                        if AppState.q-explanation != "": Text {
                            text: AppState.q-explanation;
                            wrap: word-wrap;
                            color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                        }
                        if AppState.q-ref != "": RefBox {
                            label: AppState.q-ref;
                            open => {
                                AppState.open-ref-quiz();
                            }
                        }
                    }
                }

                fbend := Rectangle {
                    height: 0px;
                }

                if AppState.q-source != "": Text {
                    text: "Fonte: " + AppState.q-source;
                    wrap: word-wrap;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    opacity: 0.85;
                }

                if AppState.quiz-mode == 1: VerticalLayout {
                    spacing: 6px;
                    padding-top: 8px;
                    SectionTitle {
                        text: "Vai alla domanda";
                    }

                    for row in AppState.nav-rows: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c in row.cells: NavCell {
                            n: c.n;
                            answered: c.answered;
                            unsure: c.unsure;
                            current: c.current;
                            clicked => {
                                AppState.goto(c.n - 1);
                            }
                        }
                    }
                }

                // fine reale del contenuto: l'altezza stimata dal layout con testo a capo può essere minore
                qend := Rectangle {
                    height: 0px;
                }
            }
        }
        }
        }

        Rectangle {
            background: M3.surface-container;
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Chip {
                    text: "Insicura";
                    has-icon: true;
                    icon: AppState.q-unsure ? Icons.flag : Icons.flag-outline;
                    accent: M3.error;
                    selected: AppState.q-unsure;
                    clicked => {
                        AppState.toggle-unsure();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if AppState.quiz-mode == 1: IconButton {
                    icon: Icons.chevron-left;
                    enabled: AppState.q-index > 0;
                    clicked => {
                        AppState.prev();
                    }
                }
                if AppState.quiz-mode == 1 && AppState.q-index + 1 < AppState.q-total: IconButton {
                    icon: Icons.chevron;
                    filled: true;
                    clicked => {
                        AppState.next();
                    }
                }
                if AppState.quiz-mode == 1: M3Button {
                    text: "Consegna";
                    clicked => {
                        AppState.finish();
                    }
                }
                if AppState.quiz-mode != 1 && !AppState.q-answered: M3Button {
                    text: "Salta";
                    kind: 3;
                    clicked => {
                        AppState.skip();
                    }
                }
                if AppState.quiz-mode != 1 && !AppState.q-answered: M3Button {
                    text: "Conferma";
                    enabled: AppState.q-can-confirm;
                    clicked => {
                        AppState.confirm();
                    }
                }
                if AppState.quiz-mode != 1 && AppState.q-answered: M3Button {
                    text: AppState.q-index + 1 < AppState.q-total ? "Avanti" : "Fine";
                    clicked => {
                        AppState.next();
                    }
                }
            }
        }
    }
}

component ResultTile inherits Rectangle {
    in property <ResultItemVM> item;
    callback toggle-flag;
    callback open-ref;
    callback report;
    property <bool> expanded: false;
    border-radius: 14px;
    background: M3.surface-container-low;
    TouchArea {
        clicked => {
            root.expanded = !root.expanded;
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.item.status == 0 ? M3.success : root.item.status == 1 ? M3.error : root.item.status == 2 ? M3.outline : M3.primary;
                Text {
                    text: root.item.n;
                    color: M3.surface;
                    font-weight: 700;
                    font-size: Type.label;
                }
            }

            Text {
                text: root.item.text;
                color: M3.on-surface;
                wrap: word-wrap;
                overflow: elide;
                // chiusa: al massimo tre righe circa, senza lasciare spazio vuoto sotto
                height: root.expanded ? self.preferred-height : min(self.preferred-height, 60px);
                horizontal-stretch: 1;
            }

            IconButton {
                icon: root.item.unsure ? Icons.flag : Icons.flag-outline;
                tint: root.item.unsure ? M3.error : M3.on-surface-variant;
                clicked => {
                    root.toggle-flag();
                }
            }
        }

        Text {
            text: (root.item.status == 3 ? "" : "Tua: " + (root.item.given == "" ? "—" : root.item.given) + " · ") + "Corretta: " + root.item.correct-text + (root.item.secs != "" ? " · " + root.item.secs + (root.item.slow ? " (lenta)" : "") : "");
            color: M3.on-surface-variant;
            font-size: Type.label;
            wrap: word-wrap;
        }

        if root.expanded && root.item.explanation != "": Text {
            text: root.item.explanation;
            color: M3.on-surface;
            font-size: Type.body;
            wrap: word-wrap;
        }
        if root.expanded && root.item.ref-label != "": RefBox {
            label: root.item.ref-label;
            open => {
                root.open-ref();
            }
        }
        if root.expanded && AppState.sync-configured: HorizontalLayout {
            alignment: end;
            M3Button {
                kind: 3;
                text: "Segnala un problema";
                has-icon: true;
                icon: Icons.report;
                clicked => {
                    root.report();
                }
            }
        }
    }
}

export component ResultsPage inherits Page {
    VerticalLayout {
        TopBar {
            title: AppState.r-title;
            subtitle: AppState.r-sync;
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 10px;
            Card {
                bg: AppState.r-is-exam ? (AppState.r-passed ? M3.success-container : M3.error-container) : M3.primary-container;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    Text {
                        text: AppState.r-points;
                        font-size: Type.display;
                        font-weight: 800;
                        horizontal-alignment: center;
                        color: M3.on-surface;
                    }

                    if AppState.r-is-exam: Text {
                        text: AppState.r-passed ? "Prova superata (≥ 18)" : "Sotto la soglia di 18";
                        horizontal-alignment: center;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: AppState.r-summary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }
                }
            }

            // feedback per Claude: solo con GitHub configurato (finisce nel repository)
            if AppState.sync-configured: Card {
                bg: M3.surface-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: AppState.r-feedback-sent ? "Grazie, feedback inviato!" : "Ti ha soddisfatto questo quiz?";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    if !AppState.r-feedback-sent: StarRating {
                        value <=> AppState.r-rating;
                    }
                    if !AppState.r-feedback-sent: TextEdit {
                        text <=> AppState.r-feedback;
                        placeholder-text: "Proposte o modifiche (domande poco chiare, troppo facili/difficili, argomenti da aggiungere…)";
                        wrap: word-wrap;
                        min-height: 96px;
                    }
                    if !AppState.r-feedback-sent: HorizontalLayout {
                        alignment: end;
                        M3Button {
                            text: "Invia feedback";
                            kind: 1;
                            has-icon: true;
                            icon: Icons.feedback;
                            enabled: AppState.r-rating > 0 || AppState.r-feedback != "";
                            clicked => {
                                AppState.send-session-feedback();
                            }
                        }
                    }
                }
            }

            Text {
                text: "Tocca una domanda per la spiegazione; la bandierina segna/toglie \"insicura\".";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }

            for it[i] in AppState.r-items: ResultTile {
                item: it;
                toggle-flag => {
                    AppState.result-toggle-flag(i);
                }
                open-ref => {
                    AppState.open-ref-result(i);
                }
                report => {
                    AppState.report-result(i);
                }
            }
        }

        Rectangle {
            background: M3.surface-container;
            HorizontalLayout {
                padding: 12px;
                M3Button {
                    text: "Fatto";
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.results-close();
                    }
                }
            }
        }
    }
}

export component CardsPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Flashcard";
            subtitle: AppState.c-done ? "Sessione completata" : (AppState.c-index + 1) + " di " + AppState.c-total + " · " + AppState.c-topic;
            can-back: true;
            back => {
                AppState.back();
            }
        }

        if AppState.c-done: VerticalLayout {
            vertical-stretch: 1;
            padding: 24px;
            spacing: 16px;
            alignment: center;
            Text {
                text: AppState.c-summary;
                font-size: Type.title-large;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: M3.on-surface;
            }

            M3Button {
                text: "Chiudi";
                clicked => {
                    AppState.back();
                }
            }
        }

        if !AppState.c-done: cv := VerticalLayout {
            vertical-stretch: 1;
            padding: 16px;
            spacing: 12px;
            property <float> flip: AppState.c-flipped ? 1 : 0;
            animate flip {
                duration: 420ms;
                easing: ease-in-out;
            }
            property <bool> show-back: self.flip > 0.5;
            LinearProgress {
                value: AppState.c-total > 0 ? AppState.c-index / AppState.c-total : 0;
                height: 4px;
            }

            Swap {
                key: "" + AppState.c-index;
                vertical-stretch: 1;
            Card {
                width: parent.width;
                height: parent.height;
                bg: cv.show-back ? M3.surface-container-high : M3.surface-container-low;
                transform-scale-x: max(0.02, abs(1 - 2 * cv.flip)) * 100%;
                clickable: true;
                clicked => {
                    AppState.card-flip();
                }
                Scroller {
                    pad: 24px;
                    gap: 16px;
                    align: center;
                    Text {
                        text: AppState.c-front;
                        font-size: 20px;
                        font-weight: 600;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: M3.on-surface;
                    }

                    if cv.show-back: Rectangle {
                        height: 1px;
                        background: M3.outline-variant;
                    }
                    if cv.show-back: Text {
                        text: AppState.c-back;
                        font-size: 17px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: M3.on-surface;
                    }
                    if cv.show-back && AppState.c-ref != "": RefBox {
                        label: AppState.c-ref;
                        open => {
                            AppState.open-ref-card();
                        }
                    }
                    if cv.show-back && AppState.c-note-shown != "": Rectangle {
                        border-radius: 10px;
                        background: M3.secondary-container;
                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: "La tua spiegazione: " + AppState.c-note-shown;
                                wrap: word-wrap;
                                font-size: Type.body;
                                color: M3.on-secondary-container;
                            }
                        }
                    }
                    if !cv.show-back: Text {
                        text: "Tocca per vedere la risposta";
                        font-size: Type.label;
                        horizontal-alignment: center;
                        color: M3.on-surface-variant;
                    }
                }
            }

            }

            if !cv.show-back: TextEdit {
                text <=> AppState.c-note;
                placeholder-text: "Prima di girare: spiegala a parole tue (facoltativo, resta nel tuo storico)";
                wrap: word-wrap;
                min-height: 72px;
                max-height: 120px;
            }

            HorizontalLayout {
                alignment: center;
                Chip {
                    text: "Insicura";
                    has-icon: true;
                    icon: AppState.c-unsure ? Icons.flag : Icons.flag-outline;
                    accent: M3.error;
                    selected: AppState.c-unsure;
                    clicked => {
                        AppState.card-toggle-unsure();
                    }
                }
            }

            if !AppState.c-flipped: M3Button {
                text: "Mostra risposta";
                clicked => {
                    AppState.card-flip();
                }
            }
            if AppState.c-flipped: HorizontalLayout {
                spacing: 6px;
                M3Button {
                    text: "Ancora";
                    compact: true;
                    min-width: 0px;
                    kind: 4;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.card-grade(0);
                    }
                }

                M3Button {
                    text: "Difficile";
                    compact: true;
                    min-width: 0px;
                    kind: 1;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.card-grade(1);
                    }
                }

                M3Button {
                    text: "Bene";
                    compact: true;
                    min-width: 0px;
                    kind: 1;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.card-grade(2);
                    }
                }

                M3Button {
                    text: "Facile";
                    compact: true;
                    min-width: 0px;
                    kind: 0;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.card-grade(3);
                    }
                }
            }
        }
    }
}

// riga «insicura/sbagliata» (domanda o flashcard) con la bandierina per toglierla
component FlagRow inherits Rectangle {
    in property <FlagVM> f;
    border-radius: 14px;
    background: M3.surface-container-low;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.f.text;
                wrap: word-wrap;
                color: M3.on-surface;
            }

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.f.where;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                if root.f.wrong: Pill {
                    text: "sbagliata";
                    bg: M3.error-container;
                    fg: M3.on-error-container;
                }
            }
        }

        IconButton {
            icon: root.f.flagged ? Icons.flag : Icons.flag-outline;
            tint: root.f.flagged ? M3.error : M3.on-surface-variant;
            clicked => {
                AppState.flag-toggle(root.f.id);
            }
        }
    }
}

// fila orizzontale di chip che scorre col dito se non c'è spazio
component ChipStrip inherits Flickable {
    in property <[QzOptVM]> opts;
    in property <string> kind;
    height: 40px;
    interactive: true;
    content-width: max(self.width, strip.preferred-width);
    content-height: 40px;
    strip := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: 40px;
        spacing: 8px;
        alignment: start;
        padding-top: 2px;
        padding-bottom: 2px;
        for o in root.opts: Chip {
            text: o.name + (o.count > 0 ? " · " + o.count : "");
            selected: o.sel;
            has-icon: o.sel;
            icon: Icons.check;
            clicked => {
                AppState.qz-toggle(root.kind, o.id);
            }
        }
    }
}

// riga con casella di spunta (unità del quiz)
component CheckRow inherits Rectangle {
    in property <QzOptVM> o;
    callback clicked;
    min-height: max(48px, row.preferred-height);
    border-radius: 12px;
    background: root.o.sel ? M3.secondary-container : transparent;
    animate background { duration: 150ms; }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        Rectangle {
            width: 22px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 6px;
                    border-width: root.o.sel ? 0px : 2px;
                    border-color: M3.outline;
                    background: root.o.sel ? M3.primary : transparent;
                    if root.o.sel: VIcon {
                        source: Icons.check;
                        tint: M3.on-primary;
                        size: 18px;
                    }
                }
            }
        }

        Text {
            text: root.o.name;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: M3.on-surface;
        }

        Text {
            text: root.o.count;
            vertical-alignment: center;
            font-size: Type.label;
            color: M3.on-surface-variant;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component DecksPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Flashcard";
            subtitle: AppState.due-count + " da ripassare oggi";
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;
            M3Button {
                text: "Ripassa tutte le materie";
                has-icon: true;
                icon: Icons.play;
                clicked => {
                    AppState.start-cards("all", "");
                }
            }

            for s[i] in AppState.subjects: Card {
                clickable: true;
                stagger: i + 1;
                clicked => {
                    AppState.start-cards("subject", s.id);
                }
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: M3.subject(s.id);
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: s.name;
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-surface;
                            wrap: word-wrap;
                        }

                        Text {
                            text: s.due + " da ripassare · " + s.new-cards + " nuove · " + s.learned + " in ripasso";
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                            wrap: word-wrap;
                        }
                    }

                    VIcon {
                        source: Icons.chevron;
                        tint: M3.on-surface-variant;
                    }
                }
            }

            // carte già studiate: non spariscono, si ripassano quando si vuole
            Text {
                text: "In ripasso";
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
            }
            Text {
                text: "Le carte che hai già studiato (risposte con \"Bene\" o \"Facile\") restano qui fino alla prossima scadenza: puoi ripassarle quando vuoi.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            for s[i] in AppState.subjects: HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: M3.subject(s.id);
                        }
                    }
                }
                Text {
                    text: s.name + " · " + s.learned + " carte";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    color: M3.on-surface;
                }
                M3Button {
                    small: true;
                    kind: 1;
                    text: "Ripassa";
                    enabled: s.learned > 0;
                    clicked => {
                        AppState.start-cards("learned-subject", s.id);
                    }
                }
            }

            Text {
                text: "Flashcard insicure";
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
            }
            M3Button {
                small: true;
                kind: 1;
                text: "Ripassa le insicure (" + AppState.card-flagged-count + ")";
                enabled: AppState.card-flagged-count > 0;
                clicked => {
                    AppState.start-cards("flagged", "");
                }
            }
            if AppState.card-flags.length == 0: Text {
                text: "Nessuna flashcard segnata insicura.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            for f in AppState.card-flags: FlagRow { f: f; }

            Text {
                text: "Ripetizione dilazionata: \"Ancora\" la ripropone tra 10 minuti, \"Bene\"/\"Facile\" allungano l'intervallo (max 21 giorni). Le carte segnate insicure contano come \"Difficile\".";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
    }
}

export component QuizHubPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Quiz";
            subtitle: AppState.qz-available + " domande con questi filtri";
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 10px;
            SectionTitle { text: "Materie"; }
            ChipStrip {
                opts: AppState.qz-subjects;
                kind: "subject";
            }

            SectionTitle { text: "Unità"; }
            Text {
                text: AppState.qz-units.length == 0 ? "Scegli almeno una materia." : "Apri una materia per scegliere le unità; senza unità spuntate vale tutta la materia.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }

            for u in AppState.qz-units: VerticalLayout {
                if u.head: Rectangle {
                    min-height: 44px;
                    border-radius: 12px;
                    background: M3.surface-container-low;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: u.name;
                            font-weight: 700;
                            color: M3.on-surface;
                            vertical-alignment: center;
                        }
                        Text {
                            text: u.group;
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        // freccia disegnata (i caratteri ▾/▴ mancano nei font inclusi)
                        Rectangle {
                            width: 24px;
                            Path {
                                width: 14px;
                                height: 8px;
                                viewbox-width: 14;
                                viewbox-height: 8;
                                commands: u.open ? "M 1 7 L 7 1 L 13 7" : "M 1 1 L 7 7 L 13 1";
                                stroke: M3.on-surface-variant;
                                stroke-width: 2px;
                            }
                        }
                    }
                    TouchArea {
                        clicked => {
                            AppState.qz-toggle("open", u.id);
                        }
                    }
                }
                if !u.head: CheckRow {
                    o: u;
                    clicked => {
                        AppState.qz-toggle("unit", u.id);
                    }
                }
            }

            SectionTitle { text: "Fonti"; }
            ChipStrip {
                opts: AppState.qz-sources;
                kind: "source";
            }

            SectionTitle { text: "Tipo di domanda"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Chip {
                    text: "Risposta multipla";
                    selected: AppState.qz-mcq;
                    has-icon: AppState.qz-mcq;
                    icon: Icons.check;
                    clicked => {
                        AppState.qz-toggle("kind", "mcq");
                    }
                }
                Chip {
                    text: "Completamento";
                    selected: AppState.qz-fill;
                    has-icon: AppState.qz-fill;
                    icon: Icons.check;
                    clicked => {
                        AppState.qz-toggle("kind", "fill");
                    }
                }
            }

            SectionTitle { text: "Numero di domande"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                IconButton {
                    icon: Icons.remove;
                    clicked => {
                        AppState.qz-set-n(AppState.qz-n - (AppState.qz-n > 20 ? 5 : 1));
                    }
                }
                Text {
                    text: AppState.qz-n;
                    font-size: Type.headline;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 56px;
                    color: M3.on-surface;
                }
                IconButton {
                    icon: Icons.add;
                    clicked => {
                        AppState.qz-set-n(AppState.qz-n + (AppState.qz-n >= 20 ? 5 : 1));
                    }
                }
            }
            ChipStrip {
                opts: [
                    { id: "10", name: "10", sel: AppState.qz-n == 10 },
                    { id: "20", name: "20", sel: AppState.qz-n == 20 },
                    { id: "31", name: "31 (come l'esame)", sel: AppState.qz-n == 31 },
                    { id: "50", name: "50", sel: AppState.qz-n == 50 },
                    { id: "100", name: "100", sel: AppState.qz-n == 100 },
                ];
                kind: "n";
            }

            M3Button {
                text: "Avvia quiz (" + min(AppState.qz-n, AppState.qz-available) + " domande)";
                has-icon: true;
                icon: Icons.play;
                enabled: AppState.qz-available > 0;
                clicked => {
                    AppState.qz-start();
                }
            }

            Text {
                text: "Prima le domande mai viste, sbagliate o deboli, poi le altre; l'ordine è casuale.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }

            Rectangle { height: 8px; }
            SectionTitle { text: "Insicure e sbagliate"; }
            Text {
                text: AppState.flagged-count + " segnate insicure · " + AppState.wrong-count + " sbagliate l'ultima volta";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            M3Button {
                text: "Ripassale ora";
                kind: 1;
                has-icon: true;
                icon: Icons.play;
                enabled: AppState.flags.length > 0;
                clicked => {
                    AppState.start-review("");
                }
            }

            if AppState.flags.length == 0: Text {
                text: "Niente da ripassare. Durante i quiz usa \"Insicura\" sulle domande in cui hai tirato a indovinare: finiranno qui.";
                wrap: word-wrap;
                color: M3.on-surface-variant;
            }

            for f in AppState.flags: FlagRow { f: f; }
        }
    }
}


// ---------- studio di gruppo ----------

// meccanico visto dall'alto, rivolto verso +x (verso la macchina): tuta, casco del colore
// della squadra, braccia che lavorano; in mano l'avvitatore, una gomma o il cartello
component Crew inherits Rectangle {
    in property <color> c;
    in property <color> helmet;
    in property <float> work;
    in property <bool> tool: true;
    in property <bool> tire;
    in property <bool> sign;
    width: 16px;
    height: 16px;
    // gomma: la porta via e la rimette
    if root.tire: Rectangle {
        x: 13px + 6px * (1 - root.work);
        y: 3.5px;
        width: 6px;
        height: 9px;
        border-radius: 2px;
        background: root.c.darker(0.7);
        Rectangle { x: 2px; y: 3px; width: 2px; height: 3px; border-radius: 1px; background: root.helmet; }
    }
    // braccia: si allungano a turno (avvita / svita)
    Rectangle { x: 8px; y: 3px; width: 4px + 4px * root.work; height: 3px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 8px; y: 10px; width: 4px + 4px * (1 - root.work); height: 3px; border-radius: 1.5px; background: root.c; }
    // avvitatore
    if root.tool && !root.tire: Rectangle {
        x: 12px + 4px * root.work;
        y: 5px;
        width: 4px;
        height: 6px;
        border-radius: 1px;
        background: root.c.darker(0.6);
    }
    // cartello: asta e disco nel colore della squadra
    if root.sign: Rectangle { x: 10px; y: 7px; width: 9px; height: 2px; background: root.c.darker(0.6); }
    if root.sign: Rectangle {
        x: 17px;
        y: 2.5px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: root.helmet;
        border-width: 1.5px;
        border-color: root.c.darker(0.6);
    }
    // spalle
    Rectangle { x: 3px; y: 1px; width: 8px; height: 14px; border-radius: 4px; background: root.c; }
    // casco
    Rectangle { x: 4px; y: 4.5px; width: 7px; height: 7px; border-radius: 3.5px; background: root.helmet; border-width: 1px; border-color: root.c.darker(0.6); }
}

// monoposto di Formula 1 vista dall'alto, tutta nel suo colore (muso verso destra)
component Car inherits Rectangle {
    in property <CarVM> car;
    in property <float> phase;
    in property <color> road;
    in property <color> bg-line: M3.surface;
    property <color> c: root.car.offline ? root.road.darker(0.4) : root.car.color;
    // i meccanici arrivano quando la macchina si ferma al pit stop e lavorano a ritmo
    property <float> crew: root.car.pit ? 1 : 0;
    animate crew {
        duration: 900ms;
        easing: ease-out;
    }
    property <float> w: 0;
    animate w {
        duration: 230ms;
        easing: ease-in-out;
    }
    Timer {
        interval: 260ms;
        running: root.car.pit;
        triggered => {
            root.w = root.w > 0.5 ? 0 : 1;
        }
    }
    property <color> suit: root.road.darker(0.45);
    width: 36px;
    height: 20px;
    // piazzola del box (poco più grande della macchina): fondo, stallo segnato agli angoli,
    // linea d'arresto, muro del garage con la striscia della squadra
    if root.crew > 0.01: Rectangle {
        x: -16px;
        y: -3px;
        width: 70px;
        height: 42px;
        opacity: root.crew;
        Rectangle { width: 100%; height: 100%; border-radius: 8px; background: root.road; }
        Rectangle { x: 13px; y: 1px; width: 7px; height: 1.5px; background: root.bg-line; }
        Rectangle { x: 13px; y: 1px; width: 1.5px; height: 6px; background: root.bg-line; }
        Rectangle { x: 47px; y: 1px; width: 7px; height: 1.5px; background: root.bg-line; }
        Rectangle { x: 52.5px; y: 1px; width: 1.5px; height: 6px; background: root.bg-line; }
        Rectangle { x: 13px; y: 24px; width: 7px; height: 1.5px; background: root.bg-line; }
        Rectangle { x: 13px; y: 19.5px; width: 1.5px; height: 6px; background: root.bg-line; }
        Rectangle { x: 47px; y: 24px; width: 7px; height: 1.5px; background: root.bg-line; }
        Rectangle { x: 52.5px; y: 19.5px; width: 1.5px; height: 6px; background: root.bg-line; }
        Rectangle { x: 55px; y: 6px; width: 2px; height: 14px; background: root.bg-line; }
        Rectangle { x: 3px; y: parent.height - 6px; width: parent.width - 6px; height: 4px; border-radius: 2px; background: root.suit; }
        Rectangle { x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 1.5px; background: root.c; }
    }
    // scia, solo in pista
    if root.car.racing: Rectangle {
        x: -10px - 5px * root.phase;
        y: 6px;
        width: 8px + 5px * root.phase;
        height: 2px;
        border-radius: 1px;
        background: root.c;
        opacity: 0.2 + 0.35 * root.phase;
    }
    if root.car.racing: Rectangle {
        x: -8px - 6px * (1 - root.phase);
        y: 12px;
        width: 6px + 6px * (1 - root.phase);
        height: 2px;
        border-radius: 1px;
        background: root.c;
        opacity: 0.2 + 0.35 * (1 - root.phase);
    }
    // alettone posteriore
    Rectangle { x: 0px; y: 3px; width: 3px; height: 14px; border-radius: 1px; background: root.c; }
    // ruote posteriori e anteriori
    Rectangle { x: 4px; y: 0px; width: 7px; height: 5px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 4px; y: 15px; width: 7px; height: 5px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 23px; y: 1px; width: 6px; height: 4px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 23px; y: 15px; width: 6px; height: 4px; border-radius: 1.5px; background: root.c; }
    // scocca con le pance laterali
    Rectangle { x: 6px; y: 6px; width: 16px; height: 8px; border-radius: 4px; background: root.c; }
    // muso affilato e alettone anteriore
    Rectangle { x: 20px; y: 8.5px; width: 13px; height: 3px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 32px; y: 2px; width: 3px; height: 16px; border-radius: 1px; background: root.c; }
    // abitacolo (halo): nel colore della strada; più grande sulla propria macchina
    Rectangle {
        x: root.car.me ? 15px : 16px;
        y: root.car.me ? 7.5px : 8.5px;
        width: root.car.me ? 5px : 3px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.road;
    }
    // squadra dei box: numero e posti a caso (fissi per ogni sosta), sempre sul lato esterno
    for m in root.car.crew: Crew {
        c: root.suit;
        helmet: root.c;
        work: m.alt ? 1 - root.w : root.w;
        tool: m.tool;
        tire: m.tire;
        sign: m.sign;
        x: m.x * 1px;
        y: m.y * 1px + 24px * (1 - root.crew);
        transform-rotation: m.rot * 1deg;
        transform-scale-x: 0.72;
        transform-scale-y: 0.72;
        opacity: root.crew;
        visible: root.crew > 0.01;
    }
}

// minimappa: tutto il circuito, le macchine come puntini
component MiniMap inherits Rectangle {
    in property <[CarVM]> cars;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <color> road;
    property <length> pad: 8px;
    property <length> sw: 5px;
    property <length> tw: root.width - 2 * root.pad;
    property <length> th: root.tw / root.aspect;
    height: root.th + 2 * root.pad;
    mm := Path {
        x: root.pad - root.sw / 2;
        y: root.pad - root.sw / 2;
        width: root.tw + root.sw;
        height: root.th + root.sw;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: ImageFit.fill;
        commands: root.commands;
        stroke: root.road;
        stroke-width: root.sw;
    }
    for car in root.cars: Rectangle {
        // posizione continua: ultimo valore ricevuto più la velocità per il tempo trascorso
        property <float> f0: car.f;
        property <duration> t0;
        init => {
            self.t0 = animation-tick();
        }
        changed f0 => {
            self.t0 = animation-tick();
        }
        property <float> f: car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0;
        property <Point> p: mm.point-at(self.f);
        visible: !car.parked;
        x: mm.x + self.p.x - self.width / 2;
        y: mm.y + self.p.y - self.height / 2;
        width: car.me ? 9px : 7px;
        height: self.width;
        border-radius: self.width / 2;
        background: car.offline ? root.road.darker(0.4) : car.color;
    }
}

// la gara: da vicino la telecamera segue la tua macchina; altrimenti tutto il circuito.
// Le posizioni vengono dal tracciato stesso (frazione di giro), quindi lo zoom non le sposta.
component RaceView inherits Rectangle {
    in property <[CarVM]> cars;
    in property <float> cam-f;
    in property <bool> overview;
    in property <string> hud;
    in property <int> flash;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <float> scale: 1;
    in property <float> pad-x: 0.5;
    in property <float> pad-y: 0.65;
    // la strada: un solo colore, dal tema; la mezzeria nel colore dello sfondo
    property <color> road: M3.surface-container-highest;
    property <color> bg: M3.surface;
    // il pulsante inverte la vista automatica (da vicino mentre studi, d'insieme altrimenti)
    property <bool> flip: false;
    property <bool> wide: root.overview != root.flip;
    changed overview => {
        root.flip = false;
    }
    // altezza della pista: grande da vicino (cresce con i membri), oppure tutta nella vista
    property <length> fit-th: min((root.width - 110px) / root.aspect, (root.height - 40px) / 1.78);
    property <float> zoom: root.wide ? 0 : 1;
    animate zoom {
        duration: 700ms;
        easing: ease-in-out;
    }
    property <length> near-th: 560px * root.scale;
    property <length> TH: root.fit-th + (root.near-th - root.fit-th) * root.zoom;
    property <length> TW: root.TH * root.aspect;
    property <length> P: 260px * root.scale;
    // carreggiata e corsie
    property <length> sw: root.TH * 0.13 / sqrt(root.scale);
    property <length> lane-w: root.sw * 0.33;
    // distanza dal centro della strada a cui si ferma chi fa il pit stop: metà carreggiata,
    // il lato della piazzola verso la pista (13 px della monoposto, in scala) e un margine
    property <length> pit-off: root.sw / 2 + 30px * root.k;
    // monoposto in scala con la carreggiata: larghe circa 0,3 della strada, così tre stanno
    // affiancate nelle corsie a qualunque zoom (piazzola e meccanici seguono la stessa scala)
    property <float> k: 0.3 * root.sw / 20px;
    property <float> phase: 0;
    // telecamera: la stessa animazione della propria macchina, così resta al centro
    in property <float> cam-v;
    property <float> cf0: root.cam-f;
    property <duration> ct0;
    init => {
        root.ct0 = animation-tick();
    }
    changed cf0 => {
        root.ct0 = animation-tick();
    }
    in property <bool> cam-pit;
    property <float> croll: root.cam-pit ? 0.012 : 0;
    animate croll {
        duration: 1400ms;
        easing: ease-out;
    }
    property <float> cf: (root.cam-v > 0 ? root.cf0 + root.cam-v * ((animation-tick() - root.ct0) / 1s) : root.cf0) + root.croll;
    property <Point> cp: road-path.point-at(root.cf);
    property <angle> ca: road-path.angle-at(root.cf);
    // al pit stop la telecamera si sposta sulla piazzola, fuori pista
    in property <float> cam-side: 1;
    property <float> cexit: root.cam-pit ? 1 : 0;
    animate cexit {
        duration: 1400ms;
        easing: ease-in-out;
    }
    in property <float> cam-stack;
    property <length> coff: root.cexit * root.cam-side * (root.pit-off + 10px * root.k + root.cam-stack * 50px * root.k);
    property <length> cam-px: road-path.x + root.cp.x - sin(root.ca) * root.coff;
    property <length> cam-py: road-path.y + root.cp.y + cos(root.ca) * root.coff;
    property <length> mid-x: root.P + root.TW / 2;
    property <length> mid-y: root.P + root.TH * (0.5 + 0.2 * (1 - root.zoom));
    Timer {
        interval: 120ms;
        running: true;
        triggered => {
            root.phase = root.phase > 0.5 ? 0 : 1;
        }
    }
    clip: true;
    world := Rectangle {
        x: root.width / 2 - (root.mid-x + (root.cam-px - root.mid-x) * root.zoom);
        y: root.height / 2 + 12px * (1 - root.zoom) - (root.mid-y + (root.cam-py - root.mid-y) * root.zoom);
        width: root.TW + 2 * root.P;
        height: root.TH + 2 * root.P;
        // paddock sotto il circuito, fuori pista: corsia box, muretto e garage; chi ha
        // terminato la sessione o non è collegato aspetta qui nel suo box
        Rectangle {
            width: min(root.TW * 0.5, max(root.TH * 0.9, root.TW * 0.36));
            height: root.TH * 0.24;
            x: root.P + root.pad-x * root.TW - self.width / 2;
            y: root.P + root.pad-y * root.TH - self.height / 2;
            border-radius: min(self.height / 4, 18px);
            background: root.road;
            // corsia box tratteggiata
            for i in 14: Rectangle {
                x: parent.width * (i + 0.25) / 14;
                y: parent.height * 0.12;
                width: parent.width / 28;
                height: max(1.5px, root.TH * 0.005);
                background: root.bg;
            }
            // muretto dei box e tetto dei garage
            Rectangle {
                x: parent.width * 0.05;
                y: 0px;
                width: parent.width * 0.9;
                height: max(2px, root.TH * 0.01);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
            Rectangle {
                x: parent.width * 0.05;
                y: parent.height - self.height;
                width: parent.width * 0.9;
                height: max(3px, root.TH * 0.025);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
        }
        road-path := Path {
            x: root.P - root.sw / 2;
            y: root.P - root.sw / 2;
            width: root.TW + root.sw;
            height: root.TH + root.sw;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: ImageFit.fill;
            commands: root.commands;
            stroke: root.road;
            stroke-width: root.sw;
        }
        // linea di mezzeria tratteggiata
        for i in 80: Rectangle {
            property <float> t: (i + 0.25) / 80;
            property <Point> p: road-path.point-at(self.t);
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: root.TW * root.scale * 0.006 + root.TH * 0.02;
            height: max(1.5px, root.TH * 0.006);
            background: root.bg;
            transform-rotation: road-path.angle-at(self.t);
        }
        // traguardo a scacchi, di traverso sulla strada
        Rectangle {
            property <Point> p: road-path.point-at(0);
            property <length> sq: root.sw / 8;
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: 2 * self.sq;
            height: root.sw;
            transform-rotation: road-path.angle-at(0);
            for i in 16: Rectangle {
                x: mod(i, 2) * parent.sq;
                y: floor(i / 2) * parent.sq;
                width: parent.sq;
                height: parent.sq;
                background: mod(i + floor(i / 2), 2) == 0 ? root.bg : root.road.darker(0.35);
            }
        }
        for car in root.cars: Rectangle {
            // moto continuo: ultimo valore ricevuto più velocità × tempo trascorso (calcolato a
            // ogni fotogramma, così non ci sono scatti tra un aggiornamento e l'altro)
            property <float> f0: car.f;
            property <duration> t0;
            init => {
                self.t0 = animation-tick();
            }
            changed f0 => {
                self.t0 = animation-tick();
            }
            // uscita di pista: la macchina rallenta in avanti mentre si sposta di lato e sterza
            // verso la piazzola (e al rientro fa il contrario)
            property <float> exit: car.pit ? 1 : 0;
            animate exit {
                duration: 1400ms;
                easing: ease-in-out;
            }
            property <float> roll: car.pit ? 0.012 : 0;
            animate roll {
                duration: 1400ms;
                easing: ease-out;
            }
            property <float> f: (car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0) + self.roll;
            // scostamento dal centro della strada: la corsia in gara, la piazzola al pit stop
            // (calcolata a ogni zoom: niente animazioni che rincorrono)
            property <length> off: (1 - self.exit) * car.lane * root.lane-w + self.exit * car.side * (root.pit-off + car.stack * 50px * root.k);
            property <angle> yaw: 24deg * sin(self.exit * 180deg) * (car.pit ? 1 : -1) * car.side;
            property <Point> p: road-path.point-at(self.f);
            property <angle> a: road-path.angle-at(self.f);
            property <length> cx: car.parked ? root.P + car.px * root.TW : road-path.x + self.p.x - sin(self.a) * self.off;
            property <length> cy: car.parked ? root.P + car.py * root.TH : road-path.y + self.p.y + cos(self.a) * self.off;
            x: self.cx - self.width / 2;
            y: self.cy - self.height / 2;
            width: 48px;
            height: 48px;
            // box del garage: due pareti e il fondo, aperto verso la corsia box
            if car.parked: Rectangle {
                width: 30px * root.k;
                height: 46px * root.k;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + 2px * root.k;
                Rectangle { x: 0px; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: parent.width - self.width; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: 0px; y: parent.height - self.height; width: parent.width; height: max(1.5px, 2px * root.k); background: root.bg; }
            }
            Car {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                car: car;
                phase: root.phase;
                road: root.road;
                transform-rotation: car.parked ? -90deg : parent.a + parent.yaw;
                transform-scale-x: root.k;
                transform-scale-y: root.k * (car.side < 0 ? -1 : 1);
            }
            TouchArea {
                clicked => {
                    AppState.car-tap(car.id);
                }
            }
        }
    }
    Text {
        x: 16px;
        y: 10px;
        width: root.width - 160px;
        text: root.hud;
        color: M3.on-surface-variant;
        font-weight: 700;
        font-size: 13px;
        overflow: elide;
    }
    // la minimappa serve solo da vicino
    if !root.wide: MiniMap {
        x: root.width - self.width - 12px;
        y: 10px;
        width: 120px;
        cars: root.cars;
        road: root.road;
        commands: root.commands;
        aspect: root.aspect;
    }
    // mentre studi: vista d'insieme o telecamera sulla tua macchina
    if AppState.study-state != 0: Rectangle {
        x: 12px;
        y: root.height - self.height - 12px;
        width: vt.preferred-width + 24px;
        height: 32px;
        border-radius: 16px;
        background: M3.surface-container-high;
        vt := Text {
            text: root.wide ? "Segui la tua monoposto" : "Tutto il circuito";
            color: M3.on-surface;
            font-size: Type.label;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.flip = !root.flip;
            }
        }
    }
    // giro completato: un breve lampo della strada
    lap := Rectangle {
        property <int> seen: root.flash;
        background: root.road;
        opacity: 0;
        states [
            fired when root.flash != self.seen: {
                opacity: 0.35;
                in {
                    animate opacity { duration: 120ms; }
                }
            }
        ]
    }
    Timer {
        interval: 300ms;
        running: root.flash != lap.seen;
        triggered => {
            lap.seen = root.flash;
        }
    }
    // chi è quella macchina: tempo di studio, pit stop, cosa sta studiando
    if AppState.car-sel != "": Rectangle {
        x: 12px;
        y: root.height - self.height - 12px;
        width: root.width - 24px;
        height: info.preferred-height;
        border-radius: 16px;
        background: M3.surface-container-high;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        TouchArea {
            clicked => {
                AppState.car-sel = "";
            }
        }
        info := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Text {
                text: AppState.car-info-title;
                font-weight: 800;
                color: M3.on-surface;
                overflow: elide;
            }
            Text {
                text: AppState.car-info-body;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
    }
}

export component GroupPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Studio di gruppo";
            subtitle: AppState.group-has ? AppState.group-name : "Studia insieme ad altri, ognuno dal suo dispositivo";
        }

        // la gara: striscia a tutta larghezza che separa la pista dal resto
        RaceView {
            height: min(300px, parent.height * 0.4);
            cars: AppState.cars;
            cam-f: AppState.cam-f;
            cam-side: AppState.cam-side;
            cam-stack: AppState.cam-stack;
            cam-pit: AppState.study-state == 2;
            cam-v: AppState.study-state == 1 ? AppState.lap-speed : 0;
            overview: AppState.race-overview;
            commands: AppState.track-cmd;
            aspect: AppState.track-aspect;
            scale: AppState.track-scale;
            pad-x: AppState.pad-x;
            pad-y: AppState.pad-y;
            hud: AppState.race-hud;
            flash: AppState.lap-flash;
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;

            // più gruppi: si sceglie quello attivo
            if AppState.groups.length > 1: Flickable {
                height: 40px;
                interactive: true;
                content-width: max(self.width, gstrip.preferred-width);
                content-height: 40px;
                gstrip := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: 40px;
                    spacing: 8px;
                    alignment: start;
                    for g in AppState.groups: Chip {
                        text: g.name;
                        selected: g.active;
                        clicked => {
                            AppState.group-select(g.id);
                        }
                    }
                }
            }

            if AppState.group-has: Text {
                text: AppState.group-info + "\nOgni giro = 1 minuto di studio · al pit stop (pausa) esci di pista, con «Termina» vai al paddock fino alla prossima sessione · tocca una monoposto per i dettagli";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }

            // cronometro personale
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: AppState.study-state == 1 ? "Stai studiando" : AppState.study-state == 2 ? "Pit stop" : "Pronto a partire";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: AppState.study-today;
                        color: M3.on-surface-variant;
                    }
                    LinearProgress {
                        value: AppState.study-lap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if AppState.study-state != 1: M3Button {
                            horizontal-stretch: 1;
                            text: AppState.study-state == 2 ? "Riparti" : "Inizia a studiare";
                            has-icon: true;
                            icon: Icons.play;
                            clicked => {
                                AppState.study-start();
                            }
                        }
                        if AppState.study-state == 1: M3Button {
                            horizontal-stretch: 1;
                            text: "Pit stop (pausa)";
                            kind: 1;
                            has-icon: true;
                            icon: Icons.pause;
                            clicked => {
                                AppState.study-pause();
                            }
                        }
                        if AppState.study-state != 0: M3Button {
                            text: "Termina";
                            kind: 3;
                            clicked => {
                                AppState.study-stop();
                            }
                        }
                    }
                    if AppState.focus-available: HorizontalLayout {
                        spacing: 8px;
                        Switch {
                            checked <=> AppState.focus-lock;
                        }
                        Text {
                            text: "Concentrazione: mentre studi il telefono resta bloccato sull'app (fissaggio schermo di Android)";
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Type.label;
                            color: M3.on-surface;
                        }
                    }
                }
            }

            // classifica
            if AppState.group-has: Text {
                text: "Classifica";
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
            }
            if AppState.group-has: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for p[i] in ["Oggi", "Settimana", "Totale"]: Chip {
                    text: p;
                    selected: AppState.group-period == i;
                    clicked => {
                        AppState.group-period = i;
                        AppState.group-set-period(i);
                    }
                }
            }
            if AppState.group-has: VerticalLayout {
                spacing: 6px;
                for r in AppState.ranking: Rectangle {
                    border-radius: 12px;
                    background: r.me ? M3.secondary-container : M3.surface-container-low;
                    min-height: 52px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text {
                            text: r.pos + "°";
                            font-weight: 800;
                            font-size: Type.title;
                            color: r.pos == 1 ? #c79100 : M3.on-surface-variant;
                            vertical-alignment: center;
                            min-width: 30px;
                        }
                        Rectangle {
                            width: 14px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: r.color;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: r.name;
                                font-weight: 700;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: r.status + " · " + r.laps + " giri";
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                            }
                        }
                        Text {
                            text: r.value;
                            font-weight: 700;
                            color: M3.on-surface;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // invito
            if AppState.group-has: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Invita nel gruppo";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: "Chi apre il link entra nel gruppo (dalla web app, o dall'app se è installata). Il gruppo è privato: lo vede solo chi ha l'invito.";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    if AppState.group-link != "": LineEdit {
                        text: AppState.group-link;
                        read-only: true;
                        font-size: Type.label;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "Invita";
                            has-icon: true;
                            icon: Icons.add;
                            clicked => {
                                AppState.group-invite();
                            }
                        }
                        M3Button {
                            text: "Esci dal gruppo";
                            kind: 3;
                            clicked => {
                                AppState.group-leave(AppState.group-id);
                            }
                        }
                    }
                }
            }

            // crea o entra in un gruppo
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: AppState.group-has ? "Un altro gruppo" : "Crea un gruppo";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        new-name := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-new-name;
                            placeholder-text: "Nome del gruppo (es. Anatomia 2026)";
                        }
                        M3Button {
                            text: "Crea";
                            kind: 1;
                            clicked => {
                                AppState.group-create(new-name.text);
                                AppState.group-new-name = "";
                            }
                        }
                    }
                    Text {
                        text: "Hai un invito?";
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        join := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-join-text;
                            placeholder-text: "Incolla il link o il codice";
                            accepted => {
                                AppState.group-join(self.text);
                            }
                        }
                        M3Button {
                            text: "Entra";
                            kind: 1;
                            clicked => {
                                AppState.group-join(join.text);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Page {
    property <bool> gh-open: false;
    VerticalLayout {
        TopBar {
            title: "Opzioni";
            subtitle: AppState.app-version;
            can-back: true;
            back => {
                AppState.back();
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;
            // profilo: il nome con cui ci si presenta agli altri dispositivi e nello studio di gruppo
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Profilo";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: "Il nome con cui ti vedono gli altri dispositivi quando sincronizzi i progressi o condividi un pacchetto.";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        name-edit := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.s-username;
                            placeholder-text: "Nome utente";
                            accepted => {
                                AppState.save-username(self.text);
                            }
                        }
                        M3Button {
                            text: "Salva";
                            kind: 1;
                            clicked => {
                                AppState.save-username(name-edit.text);
                            }
                        }
                    }
                    Text {
                        text: "Colore della tua monoposto (studio di gruppo)";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                    Flickable {
                        height: 44px;
                        interactive: true;
                        content-width: max(self.width, sw.preferred-width);
                        content-height: 44px;
                        sw := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            height: 44px;
                            spacing: 8px;
                            alignment: start;
                            for c in AppState.car-swatches: Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: c.color;
                                border-width: c.sel ? 3px : 0px;
                                border-color: M3.on-surface;
                                if c.auto: Text {
                                    text: "A";
                                    color: white;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        AppState.car-color(c.value);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ListRow {
                title: "Note legali";
                subtitle: "Nessuna garanzia; contenuti importati e servizi esterni sono responsabilità di chi li usa";
                clicked => {
                    AppState.legal-visible = true;
                }
            }

            // sincronizzazione tra dispositivi (telefono, web app, computer) senza GitHub
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VIcon {
                            source: Icons.sync;
                            tint: AppState.p2p-on ? M3.primary : M3.on-surface-variant;
                        }
                        Text {
                            text: "Dispositivi";
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-surface;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Sincronizza i progressi tra i tuoi dispositivi (app e web app) e passa gli esami installati da uno all'altro. Usa lo stesso nome utente e la stessa password su tutti, con l'app aperta. L'app non ha server: i dispositivi si trovano attraverso relay pubblici di terze parti (scelti qui sotto), poi i dati viaggiano cifrati direttamente tra loro quando la rete lo permette, altrimenti attraverso i relay, che di norma li inoltrano senza conservarli.";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    if !AppState.p2p-on: LineEdit {
                        text <=> AppState.p2p-password;
                        input-type: password;
                        placeholder-text: "Password della stanza (almeno 8 caratteri)";
                    }
                    if !AppState.p2p-on: HorizontalLayout {
                        spacing: 8px;
                        Switch {
                            checked <=> AppState.p2p-auto;
                        }
                        Text {
                            text: "Collegati da solo all'avvio (la password resta salvata su questo dispositivo)";
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Type.label;
                            color: M3.on-surface;
                        }
                    }
                    Text {
                        text: AppState.p2p-status;
                        wrap: word-wrap;
                        color: AppState.p2p-on ? M3.primary : M3.on-surface-variant;
                    }
                    for peer in AppState.p2p-peers: Rectangle {
                        border-radius: 12px;
                        background: M3.surface-container-high;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: peer.name;
                                font-weight: 700;
                                color: M3.on-surface;
                                wrap: word-wrap;
                            }
                            Text {
                                text: peer.info;
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                            for o in peer.offers: M3Button {
                                text: o.label;
                                kind: 1;
                                small: true;
                                clicked => {
                                    AppState.p2p-download(o.peer, o.exam);
                                }
                            }
                        }
                    }
                    M3Button {
                        text: AppState.p2p-on ? "Scollega" : "Collega";
                        kind: AppState.p2p-on ? 1 : 0;
                        has-icon: true;
                        icon: Icons.sync;
                        clicked => {
                            if AppState.p2p-on {
                                AppState.p2p-disconnect();
                            } else {
                                AppState.p2p-connect();
                            }
                        }
                    }
                    if !AppState.p2p-on: HorizontalLayout {
                        spacing: 8px;
                        Switch {
                            checked <=> AppState.p2p-direct-only;
                        }
                        Text {
                            text: "Solo collegamento diretto: i dati non passano mai dai relay (che servono solo a trovarsi). Su alcune reti il diretto non riesce.";
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Type.label;
                            color: M3.on-surface;
                        }
                    }
                    if !AppState.p2p-on: LineEdit {
                        text <=> AppState.p2p-relays;
                        placeholder-text: "Relay (wss://…, separati da virgola)";
                        font-size: Type.label;
                    }
                }
            }

            // Bluetooth: telefoni vicini, anche senza Internet (solo Android)
            if AppState.bt-available: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Vicino, via Bluetooth";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: "Due telefoni Android vicini si scambiano progressi, esami e stato del gruppo anche senza Internet. Prima collega qui sopra i Dispositivi (o apri la condivisione o il gruppo) su entrambi, poi: su uno «Rendimi visibile», sull'altro «Cerca» e scegli il primo.";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    if AppState.bt-status != "": Text {
                        text: AppState.bt-status;
                        color: M3.primary;
                        wrap: word-wrap;
                    }
                    if !AppState.bt-connected: HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "Rendimi visibile";
                            kind: 1;
                            clicked => {
                                AppState.bt-listen();
                            }
                        }
                        M3Button {
                            text: "Cerca";
                            kind: 1;
                            clicked => {
                                AppState.bt-scan();
                            }
                        }
                    }
                    if !AppState.bt-connected: VerticalLayout {
                        spacing: 4px;
                        for d in AppState.bt-devices: ListRow {
                            title: d.name;
                            subtitle: d.address;
                            clicked => {
                                AppState.bt-connect(d.address);
                            }
                        }
                    }
                    if AppState.bt-connected: M3Button {
                        text: "Scollega Bluetooth";
                        kind: 1;
                        clicked => {
                            AppState.bt-close();
                        }
                    }
                }
            }

            // condivisione di un esame con un'altra persona: codice usa e getta, solo contenuti
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VIcon {
                            source: Icons.book;
                            tint: AppState.share-on ? M3.primary : M3.on-surface-variant;
                        }
                        Text {
                            text: "Condividi con un'altra persona";
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-surface;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: "Passa un esame installato a un'altra persona con un codice usa e getta: viaggiano solo i contenuti (libri, quiz, flashcard), mai i tuoi progressi. Il codice vale finché la condivisione resta aperta.";
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }

                    // nessuna condivisione aperta: mandare o ricevere
                    if !AppState.share-on: HorizontalLayout {
                        spacing: 8px;
                        Switch {
                            checked <=> AppState.share-ok;
                        }
                        Text {
                            text: "Ho il diritto di condividere questo materiale con chi lo riceve (vedi Note legali)";
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Type.label;
                            color: M3.on-surface;
                        }
                    }
                    if !AppState.share-on: M3Button {
                        text: "Condividi «" + AppState.share-exam + "»";
                        enabled: AppState.share-ok;
                        has-icon: true;
                        icon: Icons.book;
                        clicked => {
                            AppState.share-start();
                        }
                    }
                    if !AppState.share-on: Text {
                        text: "Hai ricevuto un codice?";
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    if !AppState.share-on: HorizontalLayout {
                        spacing: 8px;
                        share-edit := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.share-input;
                            placeholder-text: "Codice (es. K7QM-4TZP-9WXR)";
                            accepted => {
                                AppState.share-join();
                            }
                        }
                        M3Button {
                            text: "Ricevi";
                            kind: 1;
                            clicked => {
                                AppState.share-join();
                            }
                        }
                    }

                    // condivisione aperta
                    if AppState.share-on && AppState.share-sending: Rectangle {
                        border-radius: 16px;
                        background: M3.primary-container;
                        min-height: code-col.preferred-height;
                        code-col := VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            Text {
                                text: "Codice da comunicare";
                                font-size: Type.label;
                                color: M3.on-primary-container;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: AppState.share-code;
                                font-size: 30px;
                                font-weight: 800;
                                letter-spacing: 2px;
                                color: M3.on-primary-container;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Chi lo inserisce in «Hai ricevuto un codice?» può scaricare «" + AppState.share-exam + "».";
                                font-size: Type.label;
                                color: M3.on-primary-container;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if AppState.share-on: Text {
                        text: AppState.share-status;
                        wrap: word-wrap;
                        color: M3.primary;
                    }
                    if AppState.share-on: VerticalLayout {
                        spacing: 8px;
                        for peer in AppState.share-peers: Rectangle {
                            border-radius: 12px;
                            background: M3.surface-container-high;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text {
                                    text: peer.name;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: peer.info;
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                                for o in peer.offers: M3Button {
                                    text: o.label;
                                    kind: 1;
                                    small: true;
                                    clicked => {
                                        AppState.share-download(o.peer, o.exam);
                                    }
                                }
                            }
                        }
                    }
                    if AppState.share-on: M3Button {
                        text: AppState.share-sending ? "Interrompi la condivisione" : "Chiudi";
                        kind: 1;
                        clicked => {
                            AppState.share-stop();
                        }
                    }
                }
            }

            if AppState.sync-configured: Card {
                clickable: true;
                bg: M3.tertiary-container;
                clicked => {
                    AppState.open-feedback();
                }
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VIcon {
                        source: Icons.feedback;
                        tint: M3.on-tertiary-container;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "Feedback";
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-tertiary-container;
                        }

                        Text {
                            text: "Proposte e segnalazioni: Claude le legge, le integra e ti risponde qui (" + AppState.feedbacks.length + " inviati)";
                            font-size: Type.label;
                            color: M3.on-tertiary-container;
                            wrap: word-wrap;
                        }
                    }

                    VIcon {
                        source: Icons.chevron;
                        tint: M3.on-tertiary-container;
                    }
                }
            }

            // repository GitHub: chiuso è solo una riga con lo stato; si apre toccandolo
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Rectangle {
                        height: gh-head.preferred-height;
                        gh-head := HorizontalLayout {
                            spacing: 12px;
                            VIcon {
                                source: Icons.sync;
                                tint: M3.on-surface-variant;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Repository GitHub";
                                    font-size: Type.title;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                }
                                if !root.gh-open: Text {
                                    text: AppState.sync-configured ? AppState.s-owner + "/" + AppState.s-repo + " · " + AppState.sync-status : "Non configurato: sincronizzazione e feedback disattivati";
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }
                            VIcon {
                                source: Icons.chevron;
                                tint: M3.on-surface-variant;
                                transform-rotation: root.gh-open ? -90deg : 90deg;
                                animate transform-rotation { duration: 200ms; }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.gh-open = !root.gh-open;
                            }
                        }
                    }

                    if root.gh-open: Text {
                        text: "Ogni quiz, simulazione, ripasso e segnalazione viene committato come file JSON in progress/sessions/. Serve un token \"fine-grained\" limitato a questo repository con permesso Contents: Read and write.";
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }

                    if root.gh-open: LineEdit {
                        text <=> AppState.s-owner;
                        placeholder-text: "Proprietario (nome utente GitHub)";
                    }

                    if root.gh-open: LineEdit {
                        text <=> AppState.s-repo;
                        placeholder-text: "Repository";
                    }

                    if root.gh-open: LineEdit {
                        text <=> AppState.s-branch;
                        placeholder-text: "Branch (vuoto = predefinito)";
                    }

                    if root.gh-open: LineEdit {
                        text <=> AppState.s-token;
                        placeholder-text: "Token GitHub (github_pat_…)";
                        input-type: password;
                    }

                    if root.gh-open: M3Button {
                        text: "Salva e sincronizza";
                        has-icon: true;
                        icon: Icons.sync;
                        enabled: !AppState.syncing;
                        clicked => {
                            AppState.save-settings();
                        }
                    }

                    if root.gh-open: Text {
                        text: AppState.sync-status;
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: "Pacchetto contenuti";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    Text {
                        text: "Quiz, flashcard e libri in un unico file (SemestreAperto-contenuti.json.gz), pubblicato nelle release «Contenuti» del repository: aggiorna i contenuti senza reinstallare l'app e senza token. I tuoi progressi non vengono toccati."
                            + (AppState.on-android
                            ? " Puoi anche aprire il file da Download o dal browser con «Apri con Tremendous Preparator»."
                            : " Il file va messo nella cartella Download.");
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }

                    M3Button {
                        text: AppState.pack-busy ? "Importazione…" : "Importa pacchetto";
                        has-icon: true;
                        icon: Icons.sync;
                        enabled: !AppState.pack-busy && !AppState.syncing;
                        clicked => {
                            AppState.import-pack();
                        }
                    }

                    Text {
                        text: AppState.pack-status;
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Promemoria";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    Text {
                        text: "Quattro notifiche al giorno: obiettivi, sessione in pausa, flashcard da ripassare e giorni all'appello, con testi diversi a seconda dell'ora. Con gli obiettivi confermati, su Android resta anche una notifica fissa con l'avanzamento.";
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }

                    Switch {
                        text: "Promemoria attivi";
                        checked <=> AppState.s-rem-on;
                    }

                    LineEdit {
                        text <=> AppState.s-rem-time;
                        placeholder-text: "08:30, 13:45, 17:30, 21:00";
                        enabled: AppState.s-rem-on;
                    }

                    Text {
                        text: "Orari: mattina, dopo pranzo, pomeriggio, sera (separati da virgola). La prima fascia propone gli obiettivi, l'ultima ti ricorda quelli non finiti.";
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }

                    M3Button {
                        text: "Salva promemoria";
                        clicked => {
                            AppState.save-reminder();
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Regole d'esame 2026/27";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    Text {
                        text: AppState.exam-rules;
                        wrap: word-wrap;
                        font-size: Type.body;
                        color: M3.on-surface-variant;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Come si calcola la barra";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    Text {
                        text: "Per ogni argomento: accuratezza recente (ultime 3 risposte, insicura = metà) × copertura (domande diverse viste, fino a 6). Unità = media degli argomenti, materia = media pesata per CFU. Quando chiedi a Claude una revisione, il file progress/assessment.json fissa un nuovo valore per argomento e la stima riparte da lì con le nuove risposte.";
                        wrap: word-wrap;
                        font-size: Type.body;
                        color: M3.on-surface-variant;
                    }

                    Text {
                        text: AppState.content-info;
                        wrap: word-wrap;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                }
            }
        }
    }
}

component BlockView inherits VerticalLayout {
    in property <BlockVM> b;
    in property <length> avail-width: 360px;
        padding-left: root.b.kind == 2 ? 12px * root.b.level : 0px;
        padding-bottom: root.b.kind == 9 ? 0px : 12px;
        if root.b.kind == 0: Text {
            text: root.b.text;
            wrap: word-wrap;
            color: M3.on-surface;
            font-weight: 700;
            font-size: root.b.level <= 1 ? 24px : root.b.level == 2 ? 20px : 17px;
        }
        if root.b.kind == 1: Text {
            text: root.b.text;
            wrap: word-wrap;
            color: M3.on-surface;
            font-size: 16px;
        }
        if root.b.kind == 2 || root.b.kind == 3: HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.b.kind == 2 ? "•" : root.b.label;
                color: M3.primary;
                font-size: 16px;
                font-weight: 700;
                min-width: 16px;
            }

            Text {
                text: root.b.text;
                wrap: word-wrap;
                color: M3.on-surface;
                font-size: 16px;
                horizontal-stretch: 1;
            }
        }
        if root.b.kind == 4: HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 3px;
                background: M3.primary;
            }

            Text {
                text: root.b.text;
                wrap: word-wrap;
                color: M3.on-surface-variant;
                font-size: 16px;
                font-italic: true;
                horizontal-stretch: 1;
            }
        }
        if root.b.kind == 5: Rectangle {
            background: M3.surface-container-high;
            border-radius: 8px;
            HorizontalLayout {
                padding: 10px;
                Text {
                    text: root.b.text;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                    color: M3.on-surface;
                }
            }
        }
        if root.b.kind == 6: HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 1px;
                y: parent.height / 2;
                background: M3.outline-variant;
                horizontal-stretch: 1;
            }

            Text {
                text: root.b.text;
                font-size: Type.label;
                color: M3.on-surface-variant;
            }
        }
        if root.b.kind == 7: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: M3.outline-variant;
            HorizontalLayout {
                padding: 10px;
                Text {
                    text: "Figura: " + root.b.text;
                    wrap: word-wrap;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                }
            }
        }
        if root.b.kind == 8: Rectangle {
            height: 1px;
            background: M3.outline-variant;
        }
        if root.b.kind == 10: HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            padding-bottom: 4px;
            Image {
                source: root.b.img;
                colorize: M3.on-surface;
                image-fit: contain;
                width: min(root.avail-width, self.source.width * 1.15px);
                height: self.width * self.source.height / max(1, self.source.width);
            }
        }
        if root.b.kind == 12: VerticalLayout {
            spacing: 6px;
            padding-top: 4px;
            Rectangle {
                border-radius: 12px;
                background: #ffffff;
                height: fig.height + 16px;
                fig := Image {
                    source: root.b.img;
                    image-fit: contain;
                    width: min(root.avail-width - 16px, max(1, self.source.width) * 1px);
                    height: self.width * self.source.height / max(1, self.source.width);
                }
            }
            Text {
                text: root.b.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-size: Type.label;
                color: M3.on-surface-variant;
            }
        }
        if root.b.kind == 11: Text {
            text: root.b.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            font-size: 17px;
            font-italic: true;
            color: M3.on-surface;
        }
        if root.b.kind == 9: Rectangle {
            background: root.b.level == 1 ? M3.secondary-container : M3.surface-container-low;
            border-width: 1px;
            border-color: M3.outline-variant;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                for c in root.b.cells: Text {
                    text: c;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    font-size: 14px;
                    font-weight: root.b.level == 1 ? 700 : 400;
                    color: M3.on-surface;
                }
            }
        }
}

export component ReaderPage inherits Page {
    VerticalLayout {
        TopBar {
            title: AppState.rd-title;
            subtitle: AppState.rd-book + (AppState.rd-page-label != "" ? " · " + AppState.rd-page-label : "");
            can-back: true;
            back => {
                AppState.back();
            }
            IconButton {
                icon: Icons.toc;
                filled: AppState.rd-toc-visible;
                clicked => {
                    AppState.rd-toc-visible = !AppState.rd-toc-visible;
                }
            }
        }

        if !AppState.rd-toc-visible: Swap {
            key: AppState.rd-title;
            vertical-stretch: 1;
        // ScrollView con altezza presa dalla fine reale del contenuto: con le tabelle (testo a capo
        // in righe orizzontali) Slint sottostima l'altezza preferita e lo scroll col dito si fermava
        rsv := ScrollView {
            mouse-drag-pan-enabled: AppState.drag-pan;
            width: parent.width;
            height: parent.height;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, endm.y + 24px);
            content-y <=> AppState.rd-scroll;
            VerticalLayout {
                x: 0px;
                y: 0px;
                width: rsv.visible-width;
                height: self.preferred-height;
                alignment: start;
                padding: 18px;
                padding-top: 4px;
                spacing: 0px;
                for b in AppState.rd-blocks: BlockView {
                    b: b;
                    avail-width: rsv.visible-width - 36px;
                }
                endm := Rectangle {
                    height: 0px;
                }
            }
        }
        }
        if AppState.rd-toc-visible: Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 8px;
            for t in AppState.rd-toc: Rectangle {
                min-height: max(44px, toc-row.preferred-height);
                border-radius: 10px;
                background: t.current ? M3.secondary-container : tta.pressed ? M3.on-surface.with-alpha(0.08) : transparent;
                toc-row := HorizontalLayout {
                    padding-left: 12px + 14px * max(0, t.level - 1);
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: t.title;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        font-weight: t.level <= 1 ? 700 : 400;
                        color: M3.on-surface;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: t.page;
                        vertical-alignment: center;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                    }
                }

                tta := TouchArea {
                    clicked => {
                        AppState.reader-goto(t.idx);
                    }
                }
            }
        }

        Rectangle {
            background: M3.surface-container;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                M3Button {
                    kind: 1;
                    text: "Precedente";
                    has-icon: true;
                    icon: Icons.chevron-left;
                    enabled: AppState.rd-has-prev;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.reader-prev();
                    }
                }

                M3Button {
                    kind: 1;
                    text: "Successiva";
                    enabled: AppState.rd-has-next;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.reader-next();
                    }
                }
            }
        }
    }
}

export component FeedbackPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Feedback";
            subtitle: "Proposte e segnalazioni: Claude le legge e le integra";
            can-back: true;
            back => {
                AppState.back();
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: "Nuovo feedback";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Chip {
                            text: "Contenuti";
                            selected: AppState.fb-category == "contenuti";
                            clicked => {
                                AppState.fb-category = "contenuti";
                            }
                        }

                        Chip {
                            text: "Domanda";
                            selected: AppState.fb-category == "domanda";
                            clicked => {
                                AppState.fb-category = "domanda";
                            }
                        }

                        Chip {
                            text: "App";
                            selected: AppState.fb-category == "app";
                            clicked => {
                                AppState.fb-category = "app";
                            }
                        }

                        Chip {
                            text: "Altro";
                            selected: AppState.fb-category == "altro";
                            clicked => {
                                AppState.fb-category = "altro";
                            }
                        }
                    }

                    if AppState.fb-item != "": Rectangle {
                        border-radius: 10px;
                        background: M3.tertiary-container;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: "Riguarda: " + AppState.fb-item-text;
                                wrap: word-wrap;
                                color: M3.on-tertiary-container;
                                font-size: Type.label;
                                horizontal-stretch: 1;
                            }

                            IconButton {
                                icon: Icons.close;
                                tint: M3.on-tertiary-container;
                                clicked => {
                                    AppState.clear-fb-item();
                                }
                            }
                        }
                    }

                    TextEdit {
                        text <=> AppState.fb-text;
                        placeholder-text: "Scrivi qui: cosa cambiare, cosa aggiungere, errori trovati…";
                        wrap: word-wrap;
                        min-height: 140px;
                    }

                    HorizontalLayout {
                        alignment: end;
                        M3Button {
                            text: "Invia";
                            has-icon: true;
                            icon: Icons.feedback;
                            enabled: AppState.fb-text != "";
                            clicked => {
                                AppState.send-feedback();
                            }
                        }
                    }
                }
            }

            if AppState.feedbacks.length > 0: SectionTitle {
                text: "Inviati";
            }
            for f in AppState.feedbacks: Rectangle {
                border-radius: 14px;
                background: M3.surface-container-low;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: f.date + " · " + f.title + (f.rating > 0 ? " · " + f.rating + "/5" : "");
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }

                        Pill {
                            text: f.status;
                            bg: f.pending ? M3.warn-container : f.reply != "" ? M3.success-container : M3.secondary-container;
                            fg: f.pending ? M3.on-warn-container : f.reply != "" ? M3.on-success-container : M3.on-secondary-container;
                        }
                    }

                    if f.text != "": Text {
                        text: f.text;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }
                    if f.reply != "": Rectangle {
                        border-radius: 10px;
                        background: M3.primary-container;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            VIcon {
                                source: Icons.ai;
                                tint: M3.on-primary-container;
                                size: 18px;
                            }

                            Text {
                                text: f.reply;
                                wrap: word-wrap;
                                color: M3.on-primary-container;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------- tavola periodica ----------

component PtProp inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> accent: M3.primary;
    spacing: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    Text {
        text: root.label;
        width: 42%;
        color: M3.on-surface-variant;
        font-size: Type.label;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    Text {
        text: root.value;
        horizontal-stretch: 1;
        color: M3.on-surface;
        font-size: Type.body;
        font-weight: 500;
        wrap: word-wrap;
    }
}

component PtSection inherits VerticalLayout {
    in property <string> title;
    in property <color> accent;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: Type.label;
        font-weight: 700;
        color: root.accent;
    }
    Rectangle {
        height: 1px;
        background: M3.outline-variant;
    }
    @children
}

export component PeriodicPage inherits Page {
    // caselle più grandi quando c'è spazio (desktop); testi in proporzione
    property <length> cell: max(46px, min(68px, (root.width - root.lab - 16px) / 18 - root.gap));
    property <float> k: root.cell / 46px;
    property <length> gap: 3px;
    property <length> lab: 22px;
    property <length> head: 24px;
    property <length> table-w: root.lab + 18 * (root.cell + root.gap) + 16px;
    property <length> table-h: root.head + 9 * (root.cell + root.gap) + 22px;
    property <[string]> cats: ["Non metalli", "Gas nobili", "Metalli alcalini", "Alcalino-terrosi", "Semimetalli", "Alogeni", "Metalli del blocco p", "Metalli di transizione", "Lantanidi", "Attinidi"];
    // pannello dei dettagli: 0 = chiuso, 1 = aperto
    // guida «come leggere la tavola», dal pulsante in alto
    in-out property <bool> info-open;
    property <float> sheet: AppState.pt-has-sel || root.info-open ? 1 : 0;
    animate sheet {
        duration: 320ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }
    VerticalLayout {
        TopBar {
            title: "Tavola periodica";
            subtitle: "Tocca un elemento per le sue proprietà";
            can-back: true;
            back => {
                AppState.back();
            }
            IconButton {
                icon: Icons.book;
                filled: root.info-open;
                clicked => {
                    root.info-open = !root.info-open;
                }
            }
        }

        // legenda: tocca una famiglia per evidenziarla. Flickable semplice: la ScrollView
        // riserva spazio alla barra anche nascosta e tagliava le etichette
        Flickable {
            height: 48px;
            interactive: true;
            content-width: max(self.width, legend.preferred-width);
            content-height: 48px;
            legend := HorizontalLayout {
                x: 0px;
                y: 0px;
                height: 48px;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: start;
                for c[i] in root.cats: Rectangle {
                    width: lt.preferred-width + 24px;
                    border-radius: 16px;
                    background: AppState.pt-filter == i ? M3.element-accent(i) : M3.element(i);
                    animate background { duration: 160ms; }
                    lt := Text {
                        text: c;
                        font-size: Type.label;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: AppState.pt-filter == i ? M3.surface : M3.on-element(i);
                    }
                    TouchArea {
                        clicked => {
                            AppState.pt-filter = AppState.pt-filter == i ? -1 : i;
                        }
                    }
                }
            }
        }

        // tavola: gruppi in alto, periodi a sinistra. È l'unica area scorrevole della pagina e
        // scorre in orizzontale e in verticale: niente aree annidate che si contendono il dito
        // (dentro una pagina scorrevole lo scorrimento laterale non partiva sul telefono)
        Flickable {
            vertical-stretch: 1;
            interactive: true;
            content-width: max(self.width, root.table-w);
            content-height: max(self.height, root.table-h);
            Rectangle {
                x: 0px;
                y: 0px;
                width: root.table-w;
                height: root.table-h;
                // disegnata una volta come immagine e poi solo spostata: con 118 caselle e
                // 354 testi ridisegnati a ogni fotogramma lo scorrimento andava a scatti
                cache-rendering-hint: true;
            for g in 18: Text {
                x: 8px + root.lab + g * (root.cell + root.gap);
                y: 2px;
                width: root.cell;
                height: root.head - 4px;
                text: g + 1;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Type.label;
                font-weight: 700;
                color: M3.on-surface-variant;
            }
            for p in 7: Text {
                x: 4px;
                y: root.head + p * (root.cell + root.gap);
                width: root.lab;
                height: root.cell;
                text: p + 1;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Type.label;
                font-weight: 700;
                color: M3.on-surface-variant;
            }
            for f in 2: Text {
                x: 4px;
                y: root.head + (7 + f) * (root.cell + root.gap) + 10px;
                width: root.lab + 2 * (root.cell + root.gap);
                height: root.cell;
                text: f == 0 ? "Lantanidi" : "Attinidi";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 10px;
                color: M3.on-surface-variant;
            }
            for e in AppState.pt-elements: Rectangle {
                property <bool> sel: AppState.pt-has-sel && AppState.pt-detail.z == e.z;
                property <bool> dim: AppState.pt-filter >= 0 && AppState.pt-filter != e.cat;
                x: 8px + root.lab + (e.col - 1) * (root.cell + root.gap) + (e.row > 7 ? 1 : 0) * 0px;
                y: root.head + (e.row > 7 ? (e.row - 2) * (root.cell + root.gap) + 10px : (e.row - 1) * (root.cell + root.gap));
                width: root.cell;
                height: root.cell;
                border-radius: sel ? 12px : 7px;
                background: M3.element(e.cat);
                border-width: sel ? 2px : 0px;
                border-color: M3.element-accent(e.cat);
                opacity: dim ? 0.22 : 1;
                animate opacity, border-radius { duration: 160ms; }
                Text {
                    x: 3px;
                    y: 1px;
                    text: e.z;
                    font-size: 8px * root.k;
                    color: M3.on-element(e.cat).with-alpha(0.75);
                }
                Text {
                    y: 9px * root.k;
                    width: parent.width;
                    text: e.sym;
                    horizontal-alignment: center;
                    font-size: 16px * root.k;
                    font-weight: 800;
                    color: M3.element-accent(e.cat);
                }
                Text {
                    y: parent.height - self.height - 2px;
                    width: parent.width;
                    text: e.mass;
                    horizontal-alignment: center;
                    font-size: 7px * root.k;
                    color: M3.on-element(e.cat).with-alpha(0.75);
                }
                TouchArea {
                    clicked => {
                        AppState.pt-select(e.z);
                    }
                }
            }
            }
        }

    }

    // velo: toccandolo il pannello si chiude
    if root.sheet > 0.01: Rectangle {
        background: M3.scrim.with-alpha(0.45 * root.sheet);
        TouchArea {
            clicked => {
                AppState.pt-has-sel = false;
                root.info-open = false;
            }
        }
    }

    // pannello dal basso con tutte le proprietà dell'elemento
    Rectangle {
        visible: root.sheet > 0.01;
        width: min(root.width, 640px);
        x: (root.width - self.width) / 2;
        height: min(root.height * 0.82, 640px);
        y: root.height - self.height * root.sheet;
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        background: M3.surface-container-low;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0005;
        // assorbe i tocchi (non arrivano alla tavola sotto)
        TouchArea { }
        // maniglia: trascinando in giù il pannello si chiude
        SwipeGestureHandler {
            y: 0px;
            height: 36px;
            handle-swipe-down: true;
            swiped => {
                if (self.current-position.y - self.pressed-position.y > 40px) {
                    AppState.pt-has-sel = false;
                    root.info-open = false;
                }
            }
            Rectangle {
                y: 12px;
                width: 36px;
                height: 4px;
                border-radius: 2px;
                background: M3.on-surface-variant.with-alpha(0.4);
            }
        }
        IconButton {
            x: parent.width - self.width - 8px;
            y: 6px;
            icon: Icons.close;
            clicked => {
                AppState.pt-has-sel = false;
                root.info-open = false;
            }
        }
        if !AppState.pt-has-sel: Scroller {
            y: 40px;
            height: parent.height - 40px;
            pad: 16px;
            pad-top: 4px;
            gap: 10px;
            Text {
                text: "Come leggere la tavola";
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
            }
            Text {
                text: "• Gruppi (colonne 1–18): stessi elettroni di valenza, proprietà chimiche simili.\n• Periodi (righe 1–7): stesso numero di gusci elettronici.\n• Da sinistra a destra lungo il periodo e salendo nel gruppo crescono elettronegatività, energia di ionizzazione e affinità elettronica; il raggio atomico e il carattere metallico invece diminuiscono.\n• A sinistra i metalli (tendono a cedere elettroni), a destra i non metalli (tendono ad acquistarli), lungo la scaletta i semimetalli.";
                wrap: word-wrap;
                color: M3.on-surface-variant;
                font-size: Type.body;
            }
        }
        if AppState.pt-has-sel: Scroller {
            y: 40px;
            height: parent.height - 40px;
            pad: 16px;
            pad-top: 4px;
            gap: 14px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                width: 92px;
                                height: 92px;
                                border-radius: 18px;
                                background: M3.element(AppState.pt-detail.cat);
                                Text {
                                    x: 8px;
                                    y: 6px;
                                    text: AppState.pt-detail.z;
                                    font-size: Type.label;
                                    color: M3.on-element(AppState.pt-detail.cat);
                                }
                                Text {
                                    text: AppState.pt-detail.sym;
                                    font-size: 38px;
                                    font-weight: 800;
                                    color: M3.element-accent(AppState.pt-detail.cat);
                                }
                                Text {
                                    y: parent.height - self.height - 6px;
                                    width: parent.width;
                                    horizontal-alignment: center;
                                    text: AppState.pt-detail.mass;
                                    font-size: 10px;
                                    color: M3.on-element(AppState.pt-detail.cat);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: AppState.pt-detail.name;
                                    font-size: Type.title-large;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: AppState.pt-detail.cat-name + (AppState.pt-detail.metal != "" ? " · " + AppState.pt-detail.metal : "");
                                    font-size: Type.body;
                                    font-weight: 600;
                                    color: M3.element-accent(AppState.pt-detail.cat);
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: AppState.pt-detail.position;
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        PtSection {
                            title: "STRUTTURA DELL'ATOMO";
                            accent: M3.element-accent(AppState.pt-detail.cat);
                            PtProp { label: "Protoni (numero atomico Z)"; value: AppState.pt-detail.protons; }
                            PtProp { label: "Elettroni (atomo neutro)"; value: AppState.pt-detail.electrons; }
                            PtProp { label: "Neutroni (isotopo più comune)"; value: AppState.pt-detail.neutrons; }
                            PtProp { label: "Massa atomica"; value: AppState.pt-detail.mass + " u"; }
                            PtProp { label: "Configurazione elettronica"; value: AppState.pt-detail.config; }
                        }

                        PtSection {
                            title: "PROPRIETÀ PERIODICHE";
                            accent: M3.element-accent(AppState.pt-detail.cat);
                            PtProp { label: "Elettronegatività (Pauling)"; value: AppState.pt-detail.en; }
                            PtProp { label: "Affinità elettronica"; value: AppState.pt-detail.ea; }
                            PtProp { label: "Energia di 1ª ionizzazione"; value: AppState.pt-detail.ie; }
                            PtProp { label: "Raggio atomico"; value: AppState.pt-detail.radius; }
                            PtProp { label: "Stato a 25 °C"; value: AppState.pt-detail.state; }
                        }

                        PtSection {
                            title: "COMPORTAMENTO CHIMICO";
                            accent: M3.element-accent(AppState.pt-detail.cat);
                            PtProp { label: "Elettroni: cede o acquista?"; value: AppState.pt-detail.tendency; }
                            PtProp { label: "Legami tipici e con chi"; value: AppState.pt-detail.bonds; }
                            PtProp { label: "Numeri di ossidazione"; value: AppState.pt-detail.ox; }
                        }
                    }
        }
    }
}
