import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, HeatVM, GHeatVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "../state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller, BigHeader, GroupLabel, OutlinedField } from "../components.slint";

// foto profilo (o iniziale) in un cerchio col bordo del colore della monoposto
export component Avatar inherits Rectangle {
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> initial;
    in property <color> ring: M3.primary;
    width: 40px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.ring;
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: self.width / 2;
        clip: true;
        background: root.has-photo ? transparent : root.ring.darker(0.25);
        if root.has-photo: Image {
            width: parent.width;
            height: parent.height;
            source: root.photo;
            image-fit: cover;
        }
        if !root.has-photo: Text {
            text: root.initial;
            color: white;
            font-weight: 800;
            font-size: parent.height * 0.45;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// meccanico visto dall'alto, rivolto verso +x (verso la macchina): tuta, casco del colore
// della squadra, braccia che lavorano; in mano l'avvitatore, una gomma o il cartello
component Crew inherits Rectangle {
    in property <color> c;
    in property <color> helmet;
    in property <float> work;
    in property <bool> tool: true;
    in property <bool> tire;
    in property <bool> sign;
    width: 16px;
    height: 16px;
    // gomma: la porta via e la rimette
    if root.tire: Rectangle {
        x: 13px + 6px * (1 - root.work);
        y: 3.5px;
        width: 6px;
        height: 9px;
        border-radius: 2px;
        background: root.c.darker(0.7);
        Rectangle { x: 2px; y: 3px; width: 2px; height: 3px; border-radius: 1px; background: root.helmet; }
    }
    // braccia: si allungano a turno (avvita / svita)
    Rectangle { x: 8px; y: 3px; width: 4px + 4px * root.work; height: 3px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 8px; y: 10px; width: 4px + 4px * (1 - root.work); height: 3px; border-radius: 1.5px; background: root.c; }
    // avvitatore
    if root.tool && !root.tire: Rectangle {
        x: 12px + 4px * root.work;
        y: 5px;
        width: 4px;
        height: 6px;
        border-radius: 1px;
        background: root.c.darker(0.6);
    }
    // cartello: asta e disco nel colore della squadra
    if root.sign: Rectangle { x: 10px; y: 7px; width: 9px; height: 2px; background: root.c.darker(0.6); }
    if root.sign: Rectangle {
        x: 17px;
        y: 2.5px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: root.helmet;
        border-width: 1.5px;
        border-color: root.c.darker(0.6);
    }
    // spalle
    Rectangle { x: 3px; y: 1px; width: 8px; height: 14px; border-radius: 4px; background: root.c; }
    // casco
    Rectangle { x: 4px; y: 4.5px; width: 7px; height: 7px; border-radius: 3.5px; background: root.helmet; border-width: 1px; border-color: root.c.darker(0.6); }
}

// monoposto di Formula 1 vista dall'alto, tutta nel suo colore (muso verso destra)
component Car inherits Rectangle {
    in property <CarVM> car;
    in property <float> phase;
    in property <color> road;
    in property <color> bg-line: M3.surface;
    property <color> c: root.car.offline ? root.road.darker(0.4) : root.car.color;
    // di nuovo sulla carreggiata (dopo un pit stop la scia normale torna solo qui)
    in property <bool> on-road: true;
    // la piazzola e i meccanici compaiono quando la macchina è ferma sulla piazzola e
    // spariscono in fretta quando riparte
    in property <bool> arrived;
    property <float> crew: 0;
    states [
        stopped when root.arrived: {
            crew: 1;
            in {
                animate crew {
                    duration: 900ms;
                    easing: ease-out;
                }
            }
            out {
                animate crew {
                    duration: 250ms;
                    easing: ease-in;
                }
            }
        }
    ]
    property <float> w: 0;
    animate w {
        duration: 230ms;
        easing: ease-in-out;
    }
    Timer {
        interval: 260ms;
        running: root.car.pit;
        triggered => {
            root.w = root.w > 0.5 ? 0 : 1;
        }
    }
    property <color> suit: root.road.darker(0.45);
    width: 36px;
    height: 20px;
    // effetti (vedi CarVM.fx), come nel mockup approvato: coordinate in unità della monoposto
    // (36 × 20), quindi in pixel prima dello zoom
    property <bool> fx-flame: root.car.racing && mod(root.car.fx, 2) == 1;
    property <bool> fx-tyres: root.car.racing && mod(floor(root.car.fx / 2), 2) == 1;
    property <bool> fx-flag: !root.car.parked && mod(floor(root.car.fx / 32), 2) == 1;
    property <bool> fx-focus: root.car.racing && mod(floor(root.car.fx / 4), 2) == 1;
    property <bool> fx-smoke: !root.car.parked && mod(floor(root.car.fx / 8), 2) == 1;
    property <bool> fx-draft: root.car.racing && mod(floor(root.car.fx / 16), 2) == 1;
    property <bool> fx-plan: root.car.racing && mod(floor(root.car.fx / 64), 2) == 1;
    property <bool> fx-pb: root.car.racing && mod(floor(root.car.fx / 128), 2) == 1;
    property <bool> fx-lead: root.car.racing && mod(floor(root.car.fx / 256), 2) == 1;
    property <bool> fx-up: mod(floor(root.car.fx / 512), 2) == 1;
    property <bool> fx-down: mod(floor(root.car.fx / 1024), 2) == 1;
    // il paddock: solo il contorno della macchina
    property <bool> outline: root.car.parked;
    property <color> wheel: root.fx-tyres ? #e8322b : root.c;
    // orologio (ms) per i movimenti continui: solo se c'è qualcosa da muovere
    property <bool> live: root.car.racing || root.fx-flag || root.fx-smoke || root.fx-up || root.fx-down;
    property <float> ms: root.live ? animation-tick() / 1ms : 0;
    property <float> tk: mod(root.ms, 1200) / 1200;
    // gradini del ritmo: una fiamma per livello (gialla, arancio, rossa)
    property <int> lv: root.car.level < 0.34 ? 1 : root.car.level < 0.67 ? 2 : 3;
    property <float> flick: mod(root.ms, 180) < 90 ? 1 : 0.84;
    // DRS: alettone posteriore che si apre e si chiude (chiuso con la bandiera gialla)
    property <float> drs-q: mod(root.ms, 2600) / 2600;
    property <length> drs: root.fx-focus && !root.fx-flag ? -1.8px * (root.drs-q < 0.12 ? 0 : root.drs-q < 0.3 ? (root.drs-q - 0.12) / 0.18 : root.drs-q < 0.85 ? 1 : (1 - root.drs-q) / 0.15) : 0px;
    // bloccaggio: la macchina trema appena
    property <float> sh: root.fx-smoke ? sin(mod(root.ms, 200) / 200 * 360deg) : 0;
    // giro completato: bandierina e numero del giro per un attimo
    property <int> lap: floor(root.car.f);
    property <float> lap-t: -10000;
    changed lap => {
        if (root.car.racing && root.lap > 0) {
            root.lap-t = animation-tick() / 1ms;
        }
    }
    property <float> lap-p: root.car.racing ? (root.ms - root.lap-t) / 2000 : 2;
    // record personale: la raggiera e la medaglia partono quando arriva l'effetto
    property <float> pb-t;
    changed fx-pb => {
        root.pb-t = animation-tick() / 1ms;
    }
    property <float> pb-p: root.fx-pb ? clamp((root.ms - root.pb-t) / 2200, 0, 1) : 1;

    // gomme soft: due strisce di gomma sull'asfalto dietro le ruote
    if root.fx-tyres: Rectangle { x: -30px; y: 1.6px; width: 34px; height: 1.6px; background: #16171a; opacity: 0.55; }
    if root.fx-tyres: Rectangle { x: -30px; y: 16.8px; width: 34px; height: 1.6px; background: #16171a; opacity: 0.55; }
    // record: raggiera viola dietro la macchina
    if root.fx-pb && root.pb-p < 1: Rectangle {
        x: 18px;
        y: 10px;
        width: 0px;
        height: 0px;
        Rectangle {
            x: -26px;
            y: -26px;
            width: 52px;
            height: 52px;
            opacity: root.pb-p < 0.2 ? root.pb-p / 0.2 * 0.55 : 0.55 * (1 - root.pb-p) / 0.8;
            transform-rotation: 40deg * root.pb-p;
            transform-scale-x: 0.2 + 0.8 * root.pb-p;
            transform-scale-y: 0.2 + 0.8 * root.pb-p;
            Path {
                width: 52px;
                height: 52px;
                viewbox-x: -26;
                viewbox-y: -26;
                viewbox-width: 52;
                viewbox-height: 52;
                fill: #c79bff;
                commands: "M0 0 L25.81 -3.11 L25.81 3.11 Z M0 0 L15.61 20.79 L10.22 23.91 Z M0 0 L-10.19 23.92 L-15.58 20.82 Z M0 0 L-25.81 3.15 L-25.82 -3.07 Z M0 0 L-15.65 -20.77 L-10.26 -23.89 Z M0 0 L10.15 -23.94 L15.55 -20.84 Z";
            }
            Path {
                width: 52px;
                height: 52px;
                viewbox-x: -26;
                viewbox-y: -26;
                viewbox-width: 52;
                viewbox-height: 52;
                fill: #a259ff;
                commands: "M0 0 L23.91 10.2 L20.8 15.6 Z M0 0 L3.13 25.81 L-3.09 25.82 Z M0 0 L-20.78 15.63 L-23.9 10.24 Z M0 0 L-23.93 -10.17 L-20.83 -15.56 Z M0 0 L-3.17 -25.81 L3.05 -25.82 Z M0 0 L20.75 -15.66 L23.88 -10.28 Z";
            }
        }
    }
    // concentrazione: due nastri blu tesi dietro l'alettone (DRS)...
    if root.fx-focus: Rectangle {
        x: -28px;
        y: 0px;
        width: 28px;
        height: 20px;
        transform-origin: { x: 28px, y: 10px };
        transform-scale-x: 1 + 0.06 * (0.5 - 0.5 * cos(root.tk * 360deg));
        Path {
            width: 28px;
            height: 20px;
            viewbox-x: -28;
            viewbox-y: 0;
            viewbox-width: 28;
            viewbox-height: 20;
            fill: #4f8df5;
            commands: "M-0.5 3 L-28 4.3 L-28 5.3 L-0.5 4.7 Z M-0.5 17 L-28 15.7 L-28 14.7 L-0.5 15.3 Z";
        }
    }
    // ...e una linea d'aria per lato che scorre liscia attorno alla macchina
    for i in (root.fx-focus ? 8 : 0): Rectangle {
        property <float> p: mod(root.ms / 1300 + mod(i, 4) / 4, 1);
        property <length> cx: 48px - 100px * self.p;
        property <float> bump: self.cx > 0px && self.cx < 32px ? sin(self.cx / 32px * 180deg) : 0;
        x: self.cx - 9px;
        y: i < 4 ? -3.4px - 1.4px * self.bump : 22.6px + 1.4px * self.bump;
        width: 18px;
        height: 0.8px;
        background: #5b9bff;
        opacity: self.cx < -36px ? 0 : 1;
    }
    // ritmo: fiamme piatte dallo scarico, una per livello, che guizzano
    if root.fx-flame: Rectangle {
        x: -20px;
        y: 0px;
        width: 20px;
        height: 20px;
        transform-origin: { x: 20px, y: 10px };
        transform-scale-x: root.flick;
        transform-scale-y: root.flick < 1 ? 0.9 : 1;
        if root.lv == 1: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ffd23f;
            commands: "M0 8.2 C-3.15 7.4 -6.75 9 -9 10 C-6.75 11 -3.15 12.6 0 11.8 Z";
        }
        if root.lv == 2: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ff8a1f;
            commands: "M0 8.2 C-4.9 7.4 -10.5 9 -14 10 C-10.5 11 -4.9 12.6 0 11.8 Z";
        }
        if root.lv == 2: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ffd23f;
            commands: "M0 7.5 C-3.15 6.8 -6.75 9 -9 10 C-6.75 11 -3.15 13.2 0 12.5 Z";
        }
        if root.lv == 3: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ff3b1f;
            commands: "M0 8.2 C-6.65 7.4 -14.25 9 -19 10 C-14.25 11 -6.65 12.6 0 11.8 Z";
        }
        if root.lv == 3: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ff8a1f;
            commands: "M0 7.5 C-4.9 6.8 -10.5 9 -14 10 C-10.5 11 -4.9 13.2 0 12.5 Z";
        }
        if root.lv == 3: Path {
            width: 20px;
            height: 20px;
            viewbox-x: -20;
            viewbox-width: 20;
            viewbox-height: 20;
            fill: #ffd23f;
            commands: "M0 6.8 C-3.15 6.2 -6.75 9 -9 10 C-6.75 11 -3.15 13.8 0 13.2 Z";
        }
    }
    // bloccaggio: sbuffi grigi dalle ruote anteriori
    for i in (root.fx-smoke ? 6 : 0): Rectangle {
        property <float> p: mod(root.ms / 1200 + i / 6, 1);
        property <length> r: 2px * (0.4 + 1.4 * self.p);
        x: 26px - 22px * self.p - self.r;
        y: (mod(i, 2) == 1 ? 20px : 0px) + (mod(i, 2) == 1 ? 1px : -1px) * (2 + i) * self.p - self.r;
        width: self.r * 2;
        height: self.r * 2;
        border-radius: self.r;
        background: #a3a8b1;
        opacity: 0.85 * (1 - self.p);
    }
    // piazzola del box: un fondo arrotondato poco più grande della monoposto, senza bordi né
    // segni; compare quando la macchina si ferma e sparisce quando riparte
    if root.crew > 0.01: Rectangle {
        x: -7px;
        y: -4px;
        width: 50px;
        height: 28px;
        border-radius: 9px;
        background: root.road;
        opacity: root.crew;
    }
    // scia: corta nel colore della macchina, d'oro per chi è primo in classifica (resta anche
    // con le fiamme e i nastri); in pista e senza la scia della concentrazione o del ritmo
    property <bool> trail: root.car.racing && root.on-road && (root.fx-lead || !(root.fx-flame || root.fx-focus));
    if root.trail: Rectangle {
        x: root.fx-lead ? -10px : -10px - 5px * root.phase;
        y: 6px;
        width: root.fx-lead ? 8px : 8px + 5px * root.phase;
        height: 2px;
        border-radius: 1px;
        background: root.fx-lead ? #f5c542 : root.c;
        opacity: root.fx-lead ? 1 : 0.2 + 0.35 * root.phase;
    }
    if root.trail: Rectangle {
        x: root.fx-lead ? -8px : -8px - 6px * (1 - root.phase);
        y: 12px;
        width: root.fx-lead ? 6px : 6px + 6px * (1 - root.phase);
        height: 2px;
        border-radius: 1px;
        background: root.fx-lead ? #f5c542 : root.c;
        opacity: root.fx-lead ? 1 : 0.2 + 0.35 * (1 - root.phase);
    }
    // la monoposto (trema appena con il bloccaggio); nel paddock solo il contorno
    Rectangle {
        x: 0.35px * root.sh;
        y: -0.3px * root.sh;
        width: 36px;
        height: 20px;
        // alettone posteriore (si apre con il DRS)
        Rectangle { x: root.drs; y: 3px; width: 3px; height: 14px; border-radius: 1px; background: root.outline ? transparent : root.c; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        // ruote posteriori e anteriori (rosse con le gomme soft)
        Rectangle { x: 4px; y: 0px; width: 7px; height: 5px; border-radius: 1.5px; background: root.outline ? transparent : root.wheel; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        Rectangle { x: 4px; y: 15px; width: 7px; height: 5px; border-radius: 1.5px; background: root.outline ? transparent : root.wheel; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        Rectangle { x: 23px; y: 1px; width: 6px; height: 4px; border-radius: 1.5px; background: root.outline ? transparent : root.wheel; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        Rectangle { x: 23px; y: 15px; width: 6px; height: 4px; border-radius: 1.5px; background: root.outline ? transparent : root.wheel; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        // scocca con le pance laterali
        Rectangle { x: 6px; y: 6px; width: 16px; height: 8px; border-radius: 4px; background: root.outline ? transparent : root.c; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        // muso affilato e alettone anteriore
        Rectangle { x: 20px; y: 8.5px; width: 13px; height: 3px; border-radius: 1.5px; background: root.outline ? transparent : root.c; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        Rectangle { x: 32px; y: 2px; width: 3px; height: 16px; border-radius: 1px; background: root.outline ? transparent : root.c; border-width: root.outline ? 0.7px : 0px; border-color: root.c; }
        // abitacolo (halo): nel colore della strada, della stessa misura su tutte le monoposto
        if !root.outline: Rectangle {
            x: 15.5px;
            y: 8px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.road;
        }
    }
    // scia dei compagni: una raffica per compagno contro l'alettone anteriore, che poi si
    // apre ai lati della macchina
    for i in (root.fx-draft ? max(1, min(3, root.car.others)) : 0): Rectangle {
        property <length> gy: i == 0 ? 4px : i == 1 ? 16px : 10px;
        property <float> g: mod(root.ms / 1400 - i * 0.25, 1);
        x: 38px + 26px * (1 - self.g * self.g);
        y: self.gy - 0.4px;
        width: 10px;
        height: 0.8px;
        border-radius: 0.4px;
        background: #9fe6ff;
        opacity: self.g < 0.15 ? self.g / 0.15 : 1;
    }
    for j in (root.fx-draft ? 2 * max(1, min(3, root.car.others)) : 0): Rectangle {
        property <int> i: floor(j / 2);
        property <float> top: self.i == 0 ? 1 : 0;
        property <length> y0: self.i == 0 ? 4px : self.i == 1 ? 16px : 10px;
        property <float> s: clamp(mod(root.ms / 1400 - (self.i * 0.35 + 0.9) / 1.4, 1) - mod(j, 2) * 0.06, 0, 1);
        property <float> u: 1 - self.s;
        // curva da (36, y) verso il lato: sopra per la raffica alta, sotto per le altre
        property <length> bx: 36px * self.u * self.u * self.u + 3 * 30px * self.u * self.u * self.s + 3 * 18px * self.u * self.s * self.s - 8px * self.s * self.s * self.s;
        property <length> by: self.y0 * self.u * self.u * self.u + 3 * (self.top > 0 ? -3px : 23px) * self.u * self.u * self.s + 3 * (self.top > 0 ? -5px : 25px) * self.u * self.s * self.s + (self.top > 0 ? -6px : 26px) * self.s * self.s * self.s;
        x: self.bx - 1.5px;
        y: self.by - 0.4px;
        width: 3.5px;
        height: 0.8px;
        border-radius: 0.4px;
        background: #9fe6ff;
        opacity: (self.s < 0.1 ? self.s / 0.1 : 1 - self.s) * (mod(j, 2) == 0 ? 1 : 0.6);
    }
    // piano fatto: ogni tanto un lancio di coriandoli nei colori delle materie
    property <float> cf: mod(root.ms, 8000) / 2400;
    for i in (root.fx-plan && root.cf < 1 ? 22 : 0): Rectangle {
        property <angle> a: i / 22 * 360deg;
        property <float> e: 1 - (1 - root.cf) * (1 - root.cf) * (1 - root.cf);
        x: 17px + cos(self.a) * (22 + mod(i, 4) * 5) * 1px * self.e;
        y: 9px + (sin(self.a) * (13 + mod(i, 3) * 3) - 6) * 1px * self.e;
        width: mod(i, 3) != 0 ? 1.4px : 2px;
        height: mod(i, 3) != 0 ? 0.8px : 1px;
        background: mod(i, 5) == 0 ? #ff4d6d : mod(i, 5) == 1 ? #ffd23f : mod(i, 5) == 2 ? #2fd27a : mod(i, 5) == 3 ? #38c6e8 : #a259ff;
        transform-rotation: (mod(i, 2) == 1 ? 1 : -1) * (240 + i * 20) * 1deg * self.e;
        opacity: root.cf < 0.06 ? root.cf / 0.06 : root.cf > 0.7 ? (1 - root.cf) / 0.3 : 1;
    }
    // bandiera gialla: pannello giallo con «!» che lampeggia sopra la macchina
    if root.fx-flag: Rectangle { x: 17.6px; y: -5px; width: 0.8px; height: 3.4px; background: #d0d4da; }
    if root.fx-flag && mod(root.ms, 700) < 350: Rectangle {
        x: 13px;
        y: -12px;
        width: 10px;
        height: 7px;
        border-radius: 1.4px;
        background: #ffd400;
        Text {
            text: "!";
            font-size: 5px;
            font-weight: 900;
            color: #2a2300;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // record: medaglia «PB» che scende sopra la macchina
    if root.fx-pb && root.pb-p < 1: Rectangle {
        property <float> k: root.pb-p < 0.12 ? root.pb-p / 0.12 : 1;
        x: 13.8px;
        y: -11.2px - 6px * (1 - self.k);
        width: 8.4px;
        height: 12px;
        opacity: root.pb-p < 0.12 ? self.k : root.pb-p < 0.8 ? 1 : (1 - root.pb-p) / 0.2;
        Rectangle { x: 1.6px; y: 7.6px; width: 0.8px; height: 3.4px; background: #a259ff; transform-rotation: 16deg; }
        Rectangle { x: 6px; y: 7.6px; width: 0.8px; height: 3.4px; background: #a259ff; transform-rotation: -16deg; }
        Rectangle {
            width: 8.4px;
            height: 8.4px;
            y: 0px;
            border-radius: 4.2px;
            background: #a259ff;
            Rectangle { width: 6.4px; height: 6.4px; border-radius: 3.2px; border-width: 0.5px; border-color: #e3ccff; }
            Text {
                text: "PB";
                font-size: 3.2px;
                font-weight: 900;
                color: #ffffff;
            }
        }
    }
    // giro completato: bandierina a scacchi con il numero del giro
    if root.lap-p >= 0 && root.lap-p < 1: Rectangle {
        x: 10px;
        y: -9px + 3px * (root.lap-p < 0.15 ? 1 - root.lap-p / 0.15 : 0);
        width: 16px;
        height: 4px;
        opacity: root.lap-p < 0.15 ? root.lap-p / 0.15 : root.lap-p < 0.7 ? 1 : (1 - root.lap-p) / 0.3;
        for q in 8: Rectangle {
            x: mod(q, 4) * 1.5px;
            y: floor(q / 4) * 1.5px;
            width: 1.5px;
            height: 1.5px;
            background: mod(mod(q, 4) + floor(q / 4), 2) == 1 ? #111111 : #f2f2f2;
        }
        Text {
            x: 7px;
            y: -0.6px;
            text: root.lap;
            font-size: 3px;
            font-weight: 800;
            color: #ffffff;
        }
    }
    // sorpasso: «+1» o «−1» sopra la propria macchina
    if root.fx-up || root.fx-down: Text {
        x: 38px;
        y: -12px;
        text: root.fx-up ? "+1" : "−1";
        font-size: 4px;
        font-weight: 800;
        color: root.fx-up ? #38c6e8 : #ff8a80;
    }
    // squadra dei box: numero e posti a caso (fissi per ogni sosta), sempre sul lato esterno
    for m in root.car.crew: Crew {
        c: root.suit;
        helmet: root.c;
        work: m.alt ? 1 - root.w : root.w;
        tool: m.tool;
        tire: m.tire;
        sign: m.sign;
        x: m.x * 1px;
        y: m.y * 1px + 24px * (1 - root.crew);
        transform-rotation: m.rot * 1deg;
        transform-scale-x: 0.72;
        transform-scale-y: 0.72;
        opacity: root.crew;
        visible: root.crew > 0.01;
    }
}

// minimappa: tutto il circuito, le macchine come puntini
component MiniMap inherits Rectangle {
    in property <[CarVM]> cars;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <color> road;
    property <length> pad: 8px;
    property <length> sw: 5px;
    property <length> tw: root.width - 2 * root.pad;
    property <length> th: root.tw / root.aspect;
    height: root.th + 2 * root.pad;
    mm := Path {
        x: root.pad - root.sw / 2;
        y: root.pad - root.sw / 2;
        width: root.tw + root.sw;
        height: root.th + root.sw;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: ImageFit.fill;
        commands: root.commands;
        stroke: root.road;
        stroke-width: root.sw;
    }
    for car in root.cars: Rectangle {
        // posizione continua: ultimo valore ricevuto più la velocità per il tempo trascorso
        property <float> f0: car.f;
        property <duration> t0;
        init => {
            self.t0 = animation-tick();
        }
        changed f0 => {
            self.t0 = animation-tick();
        }
        property <float> f: car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0;
        property <Point> p: mm.point-at(self.f);
        visible: !car.parked;
        x: mm.x + self.p.x - self.width / 2;
        y: mm.y + self.p.y - self.height / 2;
        width: car.me ? 9px : 7px;
        height: self.width;
        border-radius: self.width / 2;
        background: car.offline ? root.road.darker(0.4) : car.color;
    }
}

// la gara: da vicino la telecamera segue la tua macchina; altrimenti tutto il circuito.
// Le posizioni vengono dal tracciato stesso (frazione di giro), quindi lo zoom non le sposta.
component RaceView inherits Rectangle {
    in property <[CarVM]> cars;
    in property <float> cam-f;
    in property <bool> overview;
    in property <string> hud;
    in property <int> flash;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <float> scale: 1;
    in property <float> pad-x: 0.5;
    in property <float> pad-y: 0.65;
    // larghezza del paddock (frazione della larghezza del circuito): cresce con i membri
    in property <float> pad-w: 0.2;
    // Traguardo: il paddock sta in un riquadro flottante fuori dalla pista, non sotto il circuito
    in property <bool> paddock-float: true;
    // la strada: un solo colore, dal tema; la mezzeria nel colore dello sfondo
    property <color> road: M3.surface-container-highest;
    property <color> bg: M3.surface;
    // il pulsante inverte la vista automatica (da vicino mentre studi, d'insieme altrimenti)
    property <bool> flip: false;
    property <bool> wide: root.overview != root.flip;
    changed overview => {
        root.flip = false;
    }
    // altezza della pista: grande da vicino (cresce con i membri), oppure tutta nella vista
    property <length> fit-th: min((root.width - 110px) / root.aspect, (root.height - 40px) / 1.78);
    property <float> zoom: root.wide ? 0 : 1;
    animate zoom {
        duration: 700ms;
        easing: ease-in-out;
    }
    property <length> near-th: 560px * root.scale;
    property <length> TH: root.fit-th + (root.near-th - root.fit-th) * root.zoom;
    property <length> TW: root.TH * root.aspect;
    property <length> P: 260px * root.scale;
    // carreggiata e corsie
    property <length> sw: root.TH * 0.13 / sqrt(root.scale);
    property <length> lane-w: root.sw * 0.33;
    // distanza dal centro della strada a cui si ferma chi fa il pit stop: metà carreggiata,
    // il lato della piazzola verso la pista (13 px della monoposto, in scala) e un margine
    property <length> pit-off: root.sw / 2 + 30px * root.k;
    // monoposto in scala con la carreggiata: larghe circa 0,3 della strada, così tre stanno
    // affiancate nelle corsie a qualunque zoom (piazzola e meccanici seguono la stessa scala)
    property <float> k: 0.24 * root.sw / 20px;
    property <float> phase: 0;
    // telecamera: la stessa animazione della propria macchina, così resta al centro
    in property <float> cam-v;
    property <float> cf0: root.cam-f;
    property <duration> ct0;
    init => {
        root.ct0 = animation-tick();
        root.ctp = animation-tick() - 3600s;
        root.cl-side = root.cam-side;
        root.cl-stack = root.cam-stack;
        root.cl-run = root.cam-run;
    }
    changed cf0 => {
        root.ct0 = animation-tick();
    }
    in property <bool> cam-pit;
    // velocità di gara (giri al secondo): l'uscita di pista dura quanto basta a frenare da lì
    in property <float> lap-v: 1 / 60;
    in property <float> cam-run;
    // al pit stop la telecamera segue la stessa traiettoria della propria macchina (vedi sotto)
    property <float> cl-side: 1;
    property <float> cl-stack: 0;
    property <float> cl-run: 0;
    property <duration> ctp;
    function cam-latch() {
        if (root.cam-pit) {
            root.cl-side = root.cam-side;
            root.cl-stack = root.cam-stack;
            root.cl-run = root.cam-run;
        }
    }
    changed cam-pit => {
        root.ctp = animation-tick();
        root.cam-latch();
    }
    changed cam-run => { root.cam-latch(); }
    changed cam-side => { root.cam-latch(); }
    changed cam-stack => { root.cam-latch(); }
    property <duration> cT: max(0.5s, 2 * root.cl-run / max(0.001, root.lap-v) * 1s);
    property <float> clin: clamp((animation-tick() - root.ctp) / root.cT, 0, 1);
    property <float> cq: root.cam-pit ? 1 - (1 - root.clin) * (1 - root.clin) : (1 - root.clin) * (1 - root.clin);
    property <float> cf: (root.cam-v > 0 ? root.cf0 + root.cam-v * ((animation-tick() - root.ct0) / 1s) : root.cf0) + root.cl-run * root.cq;
    // direzione della strada nel punto `f`: dalla corda tra due punti vicini del tracciato DISEGNATO
    // (stirato in larghezza e altezza). La tangente del tracciato di partenza (angle-at) non tiene
    // conto dello stiramento e alle giunzioni delle curve può saltare: la monoposto girava su sé stessa.
    pure function heading(f: float) -> angle {
        return atan2(
            (road-path.point-at(f + 1.0015).y - road-path.point-at(f + 0.9985).y) / 1px,
            (road-path.point-at(f + 1.0015).x - road-path.point-at(f + 0.9985).x) / 1px);
    }
    property <Point> cp: road-path.point-at(root.cf);
    property <angle> ca: root.heading(root.cf);
    // al pit stop la telecamera si sposta sulla piazzola, fuori pista
    in property <float> cam-side: 1;
    in property <float> cam-stack;
    property <float> cpp: root.cam-pit ? root.cq : 1 - root.clin * root.clin;
    property <length> coff: root.cpp * root.cpp * (3 - 2 * root.cpp) * root.cl-side * (root.pit-off + 10px * root.k + root.cl-stack * 50px * root.k);
    property <length> cam-px: road-path.x + root.cp.x - sin(root.ca) * root.coff;
    property <length> cam-py: road-path.y + root.cp.y + cos(root.ca) * root.coff;
    property <length> mid-x: root.P + root.TW / 2;
    property <length> mid-y: root.P + root.TH * (0.5 + 0.2 * (1 - root.zoom));
    Timer {
        interval: 120ms;
        running: true;
        triggered => {
            root.phase = root.phase > 0.5 ? 0 : 1;
        }
    }
    clip: true;
    world := Rectangle {
        x: root.width / 2 - (root.mid-x + (root.cam-px - root.mid-x) * root.zoom);
        y: root.height / 2 + 12px * (1 - root.zoom) - (root.mid-y + (root.cam-py - root.mid-y) * root.zoom);
        width: root.TW + 2 * root.P;
        height: root.TH + 2 * root.P;
        // paddock sotto il circuito, fuori pista: corsia box, muretto e garage; chi ha
        // terminato la sessione o non è collegato aspetta qui nel suo box
        if !root.paddock-float: Rectangle {
            width: root.pad-w * root.TW;
            height: root.TH * 0.2;
            x: root.P + root.pad-x * root.TW - self.width / 2;
            y: root.P + root.pad-y * root.TH - self.height / 2;
            border-radius: min(self.height / 4, 18px);
            background: root.road;
            // corsia box tratteggiata
            for i in 14: Rectangle {
                x: parent.width * (i + 0.25) / 14;
                y: parent.height * 0.12;
                width: parent.width / 28;
                height: max(1.5px, root.TH * 0.005);
                background: root.bg;
            }
            // muretto dei box e tetto dei garage
            Rectangle {
                x: parent.width * 0.05;
                y: 0px;
                width: parent.width * 0.9;
                height: max(2px, root.TH * 0.01);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
            Rectangle {
                x: parent.width * 0.05;
                y: parent.height - self.height;
                width: parent.width * 0.9;
                height: max(3px, root.TH * 0.025);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
        }
        road-path := Path {
            x: root.P - root.sw / 2;
            y: root.P - root.sw / 2;
            width: root.TW + root.sw;
            height: root.TH + root.sw;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: ImageFit.fill;
            commands: root.commands;
            stroke: root.road;
            stroke-width: root.sw;
        }
        // linea di mezzeria tratteggiata
        for i in 80: Rectangle {
            property <float> t: (i + 0.25) / 80;
            property <Point> p: road-path.point-at(self.t);
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: root.TW * root.scale * 0.006 + root.TH * 0.02;
            height: max(1.5px, root.TH * 0.006);
            background: root.bg;
            transform-rotation: root.heading(self.t);
        }
        // traguardo a scacchi, di traverso sulla strada
        Rectangle {
            property <Point> p: road-path.point-at(0);
            property <length> sq: root.sw / 8;
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: 2 * self.sq;
            height: root.sw;
            transform-rotation: root.heading(0);
            for i in 16: Rectangle {
                x: mod(i, 2) * parent.sq;
                y: floor(i / 2) * parent.sq;
                width: parent.sq;
                height: parent.sq;
                background: mod(i + floor(i / 2), 2) == 0 ? root.bg : root.road.darker(0.35);
            }
        }
        for car in root.cars: slot := Rectangle {
            // moto continuo: ultimo valore ricevuto più velocità × tempo trascorso (calcolato a
            // ogni fotogramma, così non ci sono scatti tra un aggiornamento e l'altro)
            property <float> f0: car.f;
            property <duration> t0;
            init => {
                self.t0 = animation-tick();
                // già ferma (o già in gara) all'apertura: niente manovra da rifare
                self.tp = animation-tick() - 3600s;
                self.latch();
            }
            changed f0 => {
                self.t0 = animation-tick();
            }
            // Uscita di pista: la macchina continua dritta e scarta con una curva a S (tangente
            // alla corsia alla partenza e alla piazzola all'arrivo) lungo `run` giri, frenando
            // dalla velocità di gara fino a fermarsi; al rientro accelera da ferma e si
            // reimmette nella sua corsia alla velocità della gara. Lato, fila e tratto restano
            // quelli della sosta anche mentre riparte.
            property <float> l-side: 1;
            property <float> l-stack: 0;
            property <float> l-run: 0;
            function latch() {
                if (car.pit) {
                    self.l-side = car.side;
                    self.l-stack = car.stack;
                    self.l-run = car.run;
                }
            }
            property <bool> in-pit: car.pit;
            property <float> s-side: car.side;
            property <float> s-stack: car.stack;
            property <float> s-run: car.run;
            property <duration> tp;
            changed in-pit => {
                self.tp = animation-tick();
                self.latch();
            }
            changed s-side => { self.latch(); }
            changed s-stack => { self.latch(); }
            changed s-run => { self.latch(); }
            // durata: frenare (o accelerare) in modo uniforme su `run` alla velocità di gara
            property <duration> T: max(0.5s, 2 * self.l-run / max(0.001, root.lap-v) * 1s);
            property <float> lin: clamp((animation-tick() - self.tp) / self.T, 0, 1);
            // q: quota della manovra aggiunta alla posizione in gara (in uscita la macchina è
            // ferma, al rientro la posizione in gara riparte e la quota si esaurisce);
            // sp: punto della curva a S raggiunto (0 = corsia, 1 = piazzola), cioè la strada
            // davvero percorsa dalla piazzola o verso di essa
            property <float> q: car.pit ? 1 - (1 - self.lin) * (1 - self.lin) : (1 - self.lin) * (1 - self.lin);
            property <float> sp: car.pit ? self.q : 1 - self.lin * self.lin;
            property <float> f: (car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0) + self.l-run * self.q;
            // scostamento dal centro della strada: dalla corsia alla piazzola con uno smoothstep
            // (calcolato a ogni zoom: niente animazioni che rincorrono)
            property <length> lane-off: car.lane * root.lane-w;
            property <length> pad-off: self.l-side * (root.pit-off + self.l-stack * 50px * root.k);
            property <length> off: self.lane-off + (self.pad-off - self.lane-off) * self.sp * self.sp * (3 - 2 * self.sp);
            // muso tangente alla curva: pendenza = spostamento laterale / strada percorsa (il
            // tratto è lungo (170 + 90 × fila) px della monoposto); al rientro la curva si
            // percorre al contrario
            property <length> run-len: (170 + 90 * self.l-stack) * 1px * root.k;
            property <angle> yaw: atan((car.pit ? 1 : -1) * (self.pad-off - self.lane-off) / max(1px, self.run-len) * 6 * self.sp * (1 - self.sp));
            property <Point> p: road-path.point-at(self.f);
            property <angle> a: root.heading(self.f);
            property <length> cx: car.parked ? root.P + car.px * root.TW : road-path.x + self.p.x - sin(self.a) * self.off;
            property <length> cy: car.parked ? root.P + car.py * root.TH : road-path.y + self.p.y + cos(self.a) * self.off;
            x: self.cx - self.width / 2;
            y: self.cy - self.height / 2;
            width: 48px;
            height: 48px;
            visible: !(root.paddock-float && car.parked);
            // box del garage: due pareti e il fondo, aperto verso la corsia box
            if car.parked: Rectangle {
                width: 30px * root.k;
                height: 46px * root.k;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + 2px * root.k;
                Rectangle { x: 0px; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: parent.width - self.width; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: 0px; y: parent.height - self.height; width: parent.width; height: max(1.5px, 2px * root.k); background: root.bg; }
            }
            // rotazione e specchio su due elementi distinti: il renderer applica la scala prima
            // della rotazione, e con lo specchio sullo stesso elemento in curva il muso si
            // girava dalla parte sbagliata (rientro dal pit sul lato interno)
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 20px;
                transform-rotation: car.parked ? -90deg : parent.a + parent.yaw;
                transform-scale-x: root.k;
                transform-scale-y: root.k;
                Car {
                    x: 0px;
                    y: 0px;
                    car: car;
                    arrived: car.pit && slot.lin >= 1;
                    on-road: abs(slot.off) <= root.sw / 2;
                    phase: root.phase;
                    road: root.road;
                    // la piazzola e i meccanici dalla parte del pit
                    transform-scale-y: slot.l-side < 0 ? -1 : 1;
                }
            }
            TouchArea {
                clicked => {
                    AppState.car-tap(car.id);
                }
            }
        }
    }
    Text {
        x: 16px;
        y: 10px;
        width: root.width - 160px;
        text: root.hud;
        color: M3.on-surface-variant;
        font-weight: 700;
        font-size: 13px;
        overflow: elide;
    }
    // la minimappa serve solo da vicino
    if !root.wide: MiniMap {
        x: root.width - self.width - 12px;
        y: 10px;
        width: 120px;
        cars: root.cars;
        road: root.road;
        commands: root.commands;
        aspect: root.aspect;
    }
    // mentre studi: vista d'insieme o telecamera sulla tua macchina
    if AppState.study-state != 0: Rectangle {
        x: 12px;
        y: root.height - self.height - 12px;
        width: vt.preferred-width + 24px;
        height: 32px;
        border-radius: 16px;
        background: M3.surface-container-high;
        vt := Text {
            text: root.wide ? "Segui la tua monoposto" : "Tutto il circuito";
            color: M3.on-surface;
            font-size: Type.label;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.flip = !root.flip;
            }
        }
    }
    // giro completato: un breve lampo della strada
    lap := Rectangle {
        property <int> seen: root.flash;
        background: root.road;
        opacity: 0;
        states [
            fired when root.flash != self.seen: {
                opacity: 0.35;
                in {
                    animate opacity { duration: 120ms; }
                }
            }
        ]
    }
    Timer {
        interval: 300ms;
        running: root.flash != lap.seen;
        triggered => {
            lap.seen = root.flash;
        }
    }
}

// app da aprire (lanciatore della concentrazione): icona e nome
component AppChip inherits Rectangle {
    in property <FocusAppVM> app;
    // nel piede della gara: più bassa, con l'icona più piccola
    in property <bool> small;
    callback clicked;
    height: root.small ? 32px : 40px;
    width: chip-row.preferred-width;
    border-radius: self.height / 2;
    background: ta.pressed ? M3.secondary-container.darker(0.08) : M3.secondary-container;
    chip-row := HorizontalLayout {
        padding-left: root.app.has-icon ? 4px : 14px;
        padding-right: 14px;
        spacing: 8px;
        if root.app.has-icon: Image {
            y: (root.height - self.height) / 2;
            width: root.height - 8px;
            height: root.height - 8px;
            source: root.app.icon;
        }
        Text {
            text: root.app.label;
            vertical-alignment: center;
            color: M3.on-secondary-container;
            font-weight: 600;
            font-size: root.small ? 13px : 14px;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// riga di un permesso necessario alla concentrazione
component PermRow inherits Rectangle {
    in property <bool> ok;
    in property <string> title;
    in property <string> detail;
    callback grant;
    min-height: perm-row.preferred-height;
    perm-row := HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.ok ? M3.primary : transparent;
                    border-width: root.ok ? 0px : 2px;
                    border-color: M3.outline;
                    if root.ok: Icon {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        source: Icons.check;
                        tint: M3.on-primary;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-weight: 700;
                color: M3.on-surface;
                wrap: word-wrap;
            }
            Text {
                text: root.detail;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
        if !root.ok: M3Button {
            text: "Concedi";
            kind: 1;
            clicked => {
                root.grant();
            }
        }
    }
}

// impostazione della concentrazione: permessi, durata, app permesse, avvio
component FocusSheet inherits Rectangle {
    // durata scelta con il cursore («Altro»)
    property <bool> custom: false;
    // campo di ricerca delle app aperto
    property <bool> app-search: false;
    background: #0007;
    TouchArea { }
    // foglio dal basso: attaccato al fondo dello schermo, arrotondato solo in alto, dello stesso
    // colore della fascia di sistema sotto (così non resta sospeso)
    Rectangle {
        y: parent.height * 0.06;
        height: parent.height * 0.94;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        background: M3.surface;
        VerticalLayout {
            padding: 16px;
            padding-bottom: 20px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: "Concentrazione";
                    font-size: Type.title;
                    font-weight: 800;
                    color: M3.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    VIcon {
                        source: Icons.close;
                        tint: M3.on-surface;
                        size: 24px;
                        x: 8px;
                        y: 8px;
                    }
                    TouchArea {
                        clicked => {
                            AppState.focus-setup(false);
                        }
                    }
                }
            }
            Text {
                text: AppState.on-android
                    ? "Per il tempo scelto il telefono resta su Tremendous e sulle app spuntate qui sotto; dopo, finché non termini la sessione (anche al pit stop). Se apri altro, torni qui con un avviso. Chiamate, numeri d'emergenza e sveglia restano sempre possibili. Il blocco non si annulla prima della scadenza."
                    : "Per il tempo scelto sul computer restano aperte Tremendous e le app spuntate qui sotto (file, impostazioni e terminale sempre). Se apri un'altra app ti avviso e dopo 10 secondi la chiudo. Il tempo e le app permesse restano in una pillola in basso a destra dello schermo. Il blocco non si annulla prima della scadenza.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            if AppState.on-android: PermRow {
                ok: AppState.focus-usage-ok;
                title: "Accesso all'utilizzo";
                detail: "Per sapere quale app è aperta (resta sul telefono)";
                grant => {
                    AppState.focus-perm("usage");
                }
            }
            if AppState.on-android: PermRow {
                ok: AppState.focus-overlay-ok;
                title: "Mostra sopra altre app";
                detail: "Per l'avviso «Rimani nell'app!» e per riportarti qui";
                grant => {
                    AppState.focus-perm("overlay");
                }
            }
            // Android blocca l'accesso all'utilizzo per le app installate da un file: i passaggi
            if AppState.focus-restricted: Rectangle {
                background: M3.secondary-container;
                border-radius: 16px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: "Prima sblocca le impostazioni con limitazioni";
                        font-weight: 700;
                        color: M3.on-secondary-container;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Android blocca l'accesso all'utilizzo per le app installate da un file APK invece che da uno store. Si sblocca una volta sola, in quest'ordine:\n1. Tocca «Prova l'interruttore» e prova ad attivare quello grigio: esce «All'app è stato negato l'accesso», tocca Chiudi. Serve: solo dopo questo tentativo Android mostra l'opzione per sbloccare.\n2. Tocca «Info app»: in alto a destra ⋮ › «Consenti impostazioni con limitazioni» (su alcuni telefoni «impostazioni limitate») e conferma.\n3. Torna qui e tocca «Concedi» su Accesso all'utilizzo: ora l'interruttore si attiva.";
                        font-size: Type.label;
                        color: M3.on-secondary-container;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "1 · Prova l'interruttore";
                            kind: 0;
                            compact: true;
                            horizontal-stretch: 1;
                            clicked => {
                                AppState.focus-perm("usage");
                            }
                        }
                        M3Button {
                            text: "2 · Info app";
                            kind: 2;
                            compact: true;
                            horizontal-stretch: 1;
                            clicked => {
                                AppState.focus-perm("appinfo");
                            }
                        }
                    }
                }
            }
            if !AppState.focus-restricted && (!AppState.focus-usage-ok || !AppState.focus-overlay-ok): HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Interruttore grigio? Provalo una volta (esce «accesso negato»), poi Info app › ⋮ › «Consenti impostazioni con limitazioni» e riprova.";
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                M3Button {
                    text: "Info app";
                    kind: 2;
                    clicked => {
                        AppState.focus-perm("appinfo");
                    }
                }
            }
            Text {
                text: "Durata del blocco";
                font-size: 14px;
                font-weight: 800;
                color: M3.primary;
            }
            // durate rapide a pulsanti uniti; «Altro» mostra il cursore a passi di 5 minuti
            HorizontalLayout {
                spacing: 3px;
                for d[i] in [
                    { m: 25, t: "25′" },
                    { m: 50, t: "50′" },
                    { m: 90, t: "90′" },
                    { m: 120, t: "2 h" },
                    { m: 0, t: "Altro" },
                ]: Rectangle {
                    property <bool> on: d.m == 0 ? root.custom || (AppState.focus-minutes != 25 && AppState.focus-minutes != 50 && AppState.focus-minutes != 90 && AppState.focus-minutes != 120) : !root.custom && AppState.focus-minutes == d.m;
                    horizontal-stretch: 1;
                    height: 44px;
                    border-top-left-radius: self.on || i == 0 ? 22px : 8px;
                    border-bottom-left-radius: self.on || i == 0 ? 22px : 8px;
                    border-top-right-radius: self.on || i == 4 ? 22px : 8px;
                    border-bottom-right-radius: self.on || i == 4 ? 22px : 8px;
                    background: self.on ? M3.primary : M3.surface-container-highest;
                    Text {
                        text: d.t;
                        font-size: 14px;
                        font-weight: on ? 800 : 600;
                        color: on ? M3.on-primary : M3.on-surface;
                    }
                    TouchArea {
                        clicked => {
                            if (d.m == 0) {
                                root.custom = true;
                            } else {
                                root.custom = false;
                                AppState.focus-set-minutes(d.m);
                            }
                        }
                    }
                }
            }
            Text {
                text: AppState.focus-minutes >= 60 ? floor(AppState.focus-minutes / 60) + " h" + (Math.mod(AppState.focus-minutes, 60) > 0 ? " " + Math.mod(AppState.focus-minutes, 60) + " min" : "") : AppState.focus-minutes + " min";
                font-size: 40px;
                font-weight: 900;
                color: M3.on-surface;
                horizontal-alignment: center;
            }
            Text {
                text: AppState.focus-until-label + " · poi continui senza blocco finché non termini";
                font-size: 12px;
                color: M3.on-surface-variant;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.custom || (AppState.focus-minutes != 25 && AppState.focus-minutes != 50 && AppState.focus-minutes != 90 && AppState.focus-minutes != 120): Rectangle {
                height: 44px;
                // cursore (Material 3): traccia attiva, maniglia, traccia inattiva; da 5 minuti a
                // 4 ore, a passi di 5
                property <float> frac: (AppState.focus-minutes - 5) / 235;
                property <length> hx: 2px + (self.width - 4px) * self.frac;
                Rectangle {
                    visible: parent.frac > 0;
                    x: 0px;
                    y: (parent.height - 16px) / 2;
                    width: max(0px, parent.hx - 8px);
                    height: 16px;
                    border-top-left-radius: 8px;
                    border-bottom-left-radius: 8px;
                    border-top-right-radius: 2px;
                    border-bottom-right-radius: 2px;
                    background: M3.primary;
                }
                Rectangle {
                    visible: parent.frac < 1;
                    x: parent.hx + 8px;
                    y: (parent.height - 16px) / 2;
                    width: max(0px, parent.width - parent.hx - 8px);
                    height: 16px;
                    border-top-right-radius: 8px;
                    border-bottom-right-radius: 8px;
                    border-top-left-radius: 2px;
                    border-bottom-left-radius: 2px;
                    background: M3.secondary-container;
                }
                Rectangle {
                    x: parent.hx - 2px;
                    y: 0px;
                    width: 4px;
                    height: parent.height;
                    border-radius: 2px;
                    background: M3.primary;
                }
                TouchArea {
                    function pick(px: length) {
                        AppState.focus-set-minutes(5 + round(clamp(px / self.width, 0, 1) * 47) * 5);
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            self.pick(self.mouse-x);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.pick(self.mouse-x);
                        }
                    }
                }
            }
            HorizontalLayout {
                Text {
                    text: "App permesse durante lo studio";
                    font-weight: 700;
                    color: M3.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: root.app-search ? Icons.close : Icons.search;
                    clicked => {
                        root.app-search = !root.app-search;
                        if !root.app-search {
                            AppState.focus-search("");
                        }
                    }
                }
            }
            if root.app-search: LineEdit {
                placeholder-text: "Cerca un'app per nome";
                edited(t) => {
                    AppState.focus-search(t);
                }
            }
            Flickable {
                vertical-stretch: 1;
                interactive: true;
                content-height: app-list.preferred-height;
                app-list := VerticalLayout {
                    y: 0px;
                    width: parent.width;
                    spacing: 2px;
                    for a in AppState.focus-apps: Rectangle {
                        height: 48px;
                        border-radius: 12px;
                        background: a.allowed ? M3.secondary-container : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 12px;
                            spacing: 12px;
                            Rectangle {
                                width: 32px;
                                if a.has-icon: Image {
                                    y: 8px;
                                    width: 32px;
                                    height: 32px;
                                    source: a.icon;
                                }
                            }
                            Text {
                                text: a.label;
                                vertical-alignment: center;
                                color: M3.on-surface;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 22px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 6px;
                                        border-width: a.allowed ? 0px : 2px;
                                        border-color: M3.outline;
                                        background: a.allowed ? M3.primary : transparent;
                                        if a.allowed: Icon {
                                            x: 3px;
                                            y: 3px;
                                            width: 16px;
                                            height: 16px;
                                            source: Icons.check;
                                            tint: M3.on-primary;
                                        }
                                    }
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                AppState.focus-toggle(a.pkg);
                            }
                        }
                    }
                    if AppState.focus-apps-hidden > 0: Text {
                        text: "Altre " + AppState.focus-apps-hidden + " app: cercale per nome qui sopra";
                        font-size: 13px;
                        color: M3.on-surface-variant;
                        horizontal-alignment: center;
                        height: 40px;
                        vertical-alignment: center;
                    }
                }
            }
            M3Button {
                text: AppState.focus-confirm ? AppState.focus-confirm-text : "Scendi in pista con la concentrazione";
                enabled: AppState.focus-usage-ok && AppState.focus-overlay-ok;
                clicked => {
                    AppState.focus-start();
                }
            }
        }
    }
}

// mappa di calore di un mese: calendario a settimane (dal lunedì) con le frecce per i mesi
// precedenti; tocco su un giorno = dettagli
component Heatmap inherits VerticalLayout {
    in property <[HeatVM]> cells;
    in property <string> title;
    in property <bool> can-prev;
    in property <bool> can-next;
    callback shift(int);
    property <string> sel;
    property <length> gap: 4px;
    spacing: 6px;
    HorizontalLayout {
        alignment: space-between;
        IconButton {
            icon: Icons.chevron-left;
            tint: root.can-prev ? M3.on-surface : M3.on-surface.with-alpha(0.25);
            clicked => {
                if root.can-prev {
                    root.sel = "";
                    root.shift(1);
                }
            }
        }
        Text {
            text: root.title;
            font-weight: 700;
            color: M3.on-surface;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        IconButton {
            icon: Icons.chevron;
            tint: root.can-next ? M3.on-surface : M3.on-surface.with-alpha(0.25);
            clicked => {
                if root.can-next {
                    root.sel = "";
                    root.shift(-1);
                }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.gap;
        for l in ["L", "M", "M", "G", "V", "S", "D"]: Text {
            preferred-width: 40px;
            min-width: 20px;
            text: l;
            font-size: 10px;
            color: M3.on-surface-variant;
            horizontal-alignment: center;
        }
    }
    for w in root.cells.length / 7: HorizontalLayout {
        alignment: center;
        spacing: root.gap;
        for d in 7: Rectangle {
            property <HeatVM> c: root.cells[w * 7 + d];
            preferred-width: 40px;
            min-width: 20px;
            height: self.width;
            border-radius: 6px;
            background: c.level < 0 ? (c.level == -2 ? M3.surface-container : transparent) : c.level == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * c.level / 4);
            border-width: root.sel == c.label && c.level >= 0 ? 2px : 0;
            border-color: M3.on-surface;
            Text {
                text: c.day;
                font-size: 10px;
                color: c.level >= 3 ? M3.on-primary : c.level == -2 ? M3.on-surface-variant.with-alpha(0.5) : M3.on-surface-variant;
            }
            TouchArea {
                enabled: c.level >= 0;
                clicked => {
                    root.sel = root.sel == c.label ? "" : c.label;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.sel != "" ? root.sel : "Tocca un giorno per i dettagli";
            font-size: Type.label;
            color: M3.on-surface-variant;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: "meno";
            font-size: 10px;
            color: M3.on-surface-variant;
            vertical-alignment: center;
        }
        for k in 5: Rectangle {
            width: 10px;
            height: 10px;
            y: 3px;
            border-radius: 2px;
            background: k == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * k / 4);
        }
        Text {
            text: "più";
            font-size: 10px;
            color: M3.on-surface-variant;
            vertical-alignment: center;
        }
    }
}

// selettore a pillole affiancate (una sola scelta), compatto
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> index;
    callback picked(int);
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: M3.outline;
    clip: true;
    HorizontalLayout {
        for l[i] in root.labels: Rectangle {
            background: i == root.index ? M3.secondary-container : transparent;
            min-width: t.preferred-width + 24px;
            t := Text {
                text: l;
                font-size: Type.label;
                font-weight: i == root.index ? 700 : 500;
                color: i == root.index ? M3.on-secondary-container : M3.on-surface-variant;
            }
            TouchArea {
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// matitina tonda per modificare (nome, foto)
component EditBadge inherits Rectangle {
    callback clicked;
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.pressed ? M3.secondary-container.darker(0.1) : M3.secondary-container;
    border-width: 2px;
    border-color: M3.surface-container-low;
    VIcon {
        x: (parent.width - root.size * 0.54) / 2;
        y: (parent.height - root.size * 0.54) / 2;
        width: root.size * 0.54;
        height: root.size * 0.54;
        source: Icons.edit;
        tint: M3.on-secondary-container;
        size: root.size * 0.54;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Paddock (Traguardo, proposta A): ultima riga del piede della gara. Chi non è in gara ha un
// cerchio nel colore della sua monoposto; si tocca per vederne la scheda.
component Paddock inherits Rectangle {
    in property <[CarVM]> cars;
    // quante monoposto si vedono; le altre diventano «+N»
    property <int> shown: min(root.cars.length, 5);
    height: 44px;
    pl := HorizontalLayout {
        spacing: 10px;
        Text {
            horizontal-stretch: 1;
            text: "Paddock · " + (root.cars.length == 1 ? "1 fuori gara" : root.cars.length + " fuori gara");
            font-size: 13px;
            color: M3.on-surface-variant;
            vertical-alignment: center;
            overflow: elide;
        }
        // cerchi sovrapposti, uno per persona, nel colore della sua monoposto
        Rectangle {
            width: (root.shown - 1) * 24px + 36px;
            for c[i] in root.cars: Rectangle {
                visible: i < root.shown;
                x: i * 24px;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: M3.surface;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: c.color.with-alpha(0.22);
                    border-width: 2px;
                    border-color: c.color;
                    Car {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        car: c;
                        road: M3.surface-container-highest;
                        phase: 0;
                        transform-scale-x: 0.55;
                        transform-scale-y: 0.55;
                    }
                }
                TouchArea {
                    clicked => {
                        AppState.car-tap(c.id);
                    }
                }
            }
        }
        if root.cars.length > root.shown: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: M3.secondary-container;
                Text {
                    text: "+" + (root.cars.length - root.shown);
                    font-size: 13px;
                    font-weight: 700;
                    color: M3.on-secondary-container;
                }
            }
        }
    }
}

// simbolo in un cerchio tonale (classifica: come si fanno i punti, avvisa tutti)
component RoundIcon inherits Rectangle {
    in property <image> icon;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: rta.pressed ? M3.secondary-container.darker(0.08) : M3.secondary-container;
    Icon {
        x: 10px;
        y: 10px;
        width: 20px;
        height: 20px;
        source: root.icon;
        tint: M3.on-secondary-container;
    }
    rta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component GroupPage inherits Page {
    property <bool> rename-open: false;
    property <bool> groups-open: false;
    // nome del gruppo toccato: compare la matita; il nome nuovo
    property <bool> title-tapped: false;
    property <string> new-name: AppState.group-name;
    property <bool> cal-open: false;
    // scelta del circuito (amministratore)
    property <bool> circuit-open: false;
    // pagina che spiega pit stop ed effetti in pista (dalla legenda)
    property <bool> pit-open: false;
    property <bool> has-group: AppState.group-has && AppState.group-code != "";
    // calendario mostrato: quello del gruppo, di un altro membro, o il proprio
    property <bool> cal-group: has-group && AppState.cal-ids[AppState.cal-index] == "*";
    property <bool> cal-member: has-group && AppState.cal-ids[AppState.cal-index] != "" && !cal-group;
    VerticalLayout {
        // Traguardo: foto e nome del gruppo come testata (senza gruppo: «Squadra»), calendario e
        // condivisione. Foto: si tocca per vederla (e cambiarla); nome: un tocco mostra la matita
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 6px;
            padding-top: 12px;
            padding-bottom: 4px;
            spacing: 12px;
            if AppState.group-has: Rectangle {
                width: 60px;
                height: 60px;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 18px;
                    clip: true;
                    background: M3.primary-container;
                    if AppState.group-has-photo: Image {
                        width: parent.width;
                        height: parent.height;
                        source: AppState.group-photo;
                        image-fit: cover;
                    }
                    if !AppState.group-has-photo && AppState.group-initial == "": Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.groups;
                        tint: M3.on-primary-container;
                        width: 28px;
                        height: 28px;
                    }
                    if !AppState.group-has-photo && AppState.group-initial != "": Text {
                        text: AppState.group-initial;
                        font-size: 24px;
                        font-weight: 900;
                        color: M3.on-primary-container;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            if (AppState.group-has-photo) {
                                AppState.photo-view-img = AppState.group-photo;
                                AppState.photo-view-title = AppState.group-name;
                                AppState.photo-view-group = true;
                                AppState.photo-view = true;
                            } else if (AppState.group-admin) {
                                AppState.pick-photo("group");
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 4px;
                    // il nome si legge sempre intero: va a capo invece dei «…»
                    Text {
                        text: AppState.group-has && AppState.group-name != "" ? AppState.group-name : "Squadra";
                        font-size: self.text.character-count > 18 ? 21px : 26px;
                        font-weight: 900;
                        color: M3.on-surface;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        TouchArea {
                            clicked => {
                                if (AppState.group-can-rename && has-group) {
                                    root.title-tapped = !root.title-tapped;
                                }
                            }
                        }
                    }
                    if root.title-tapped && AppState.group-can-rename && !root.rename-open: VerticalLayout {
                        alignment: center;
                        EditBadge {
                            clicked => {
                                root.rename-open = true;
                                root.title-tapped = false;
                            }
                        }
                    }
                    // più gruppi: si sceglie quello attivo
                    if AppState.groups.length > 1: Rectangle {
                        width: 32px;
                        Icon {
                            x: 4px;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            source: Icons.chevron;
                            tint: M3.on-surface-variant;
                            transform-rotation: root.groups-open ? -90deg : 90deg;
                        }
                        TouchArea {
                            clicked => {
                                root.groups-open = !root.groups-open;
                            }
                        }
                    }
                }
                Text {
                    text: !AppState.group-has ? "Studia insieme ad altri, ognuno dal suo dispositivo" : AppState.group-info;
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    icon: Icons.calendar-month;
                    tint: root.cal-open ? M3.primary : M3.on-surface;
                    clicked => {
                        root.cal-open = !root.cal-open;
                    }
                }
            }
            if has-group: VerticalLayout {
                alignment: start;
                IconButton {
                    icon: Icons.share;
                    tint: M3.on-surface;
                    clicked => {
                        AppState.group-invite();
                    }
                }
            }
        }
        // nome del gruppo da cambiare (dopo la matita)
        if root.rename-open: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            spacing: 8px;
            OutlinedField {
                horizontal-stretch: 1;
                label: "Nome del gruppo";
                text <=> root.new-name;
                pencil: false;
                action: "Salva";
                accepted(t) => {
                    AppState.group-rename(t);
                    root.rename-open = false;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.close;
                    clicked => {
                        root.rename-open = false;
                    }
                }
            }
        }
        // più gruppi: elenco per scegliere quello attivo (dalla freccia accanto al nome)
        if AppState.groups.length > 1 && root.groups-open: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            spacing: 3px;
            for g[gi] in AppState.groups: Rectangle {
                height: 48px;
                border-top-left-radius: gi == 0 ? 20px : 6px;
                border-top-right-radius: gi == 0 ? 20px : 6px;
                border-bottom-left-radius: gi == AppState.groups.length - 1 ? 20px : 6px;
                border-bottom-right-radius: gi == AppState.groups.length - 1 ? 20px : 6px;
                background: g.active ? M3.secondary-container : M3.surface-container;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: g.name;
                        font-size: 15px;
                        font-weight: g.active ? 800 : 500;
                        color: M3.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if g.active: VIcon {
                        source: Icons.check;
                        tint: M3.primary;
                        size: 20px;
                    }
                }
                TouchArea {
                    clicked => {
                        AppState.group-select(g.id);
                        root.groups-open = false;
                    }
                }
            }
        }
        share-buf := TextInput {
            width: 0px;
            height: 0px;
            text: AppState.group-code;
            read-only: true;
            enabled: false;
            opacity: 0;
        }

        // la gara: riquadro grande con titolo, stato e il piede (tempo, pit stop, paddock)
        Rectangle {
            height: min(400px + (AppState.paddock-n > 0 ? 44px : 0px), parent.height * 0.56);
            race-box := Rectangle {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                border-radius: 32px;
                clip: true;
                background: M3.surface-container;
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        padding-top: 14px;
                        padding-bottom: 2px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: has-group ? "Gara di oggi" : "La tua gara";
                                font-size: 18px;
                                font-weight: 800;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: AppState.race-hud;
                                font-size: 13px;
                                color: M3.on-surface-variant;
                                overflow: elide;
                            }
                        }
                        // «Segui» la propria monoposto o «Tutto il circuito»
                        if AppState.race-live: VerticalLayout {
                            alignment: start;
                            Rectangle {
                                height: 34px;
                                width: vw.preferred-width + 24px;
                                border-radius: 17px;
                                background: vwa.pressed ? M3.surface-container-highest.darker(0.06) : M3.surface-container-highest;
                                vw := HorizontalLayout {
                                    x: 12px;
                                    spacing: 5px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            width: 16px;
                                            height: 16px;
                                            source: Icons.focus;
                                            tint: M3.on-surface;
                                        }
                                    }
                                    Text {
                                        text: AppState.race-overview ? "Segui" : "Tutto il circuito";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: M3.on-surface;
                                        vertical-alignment: center;
                                    }
                                }
                                vwa := TouchArea {
                                    clicked => {
                                        AppState.race-view-toggle();
                                    }
                                }
                            }
                        }
                        // l'amministratore sceglie il circuito (o la rotazione giornaliera)
                        if has-group && AppState.group-admin: VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: cta.pressed ? M3.secondary-container.darker(0.08) : M3.secondary-container;
                                Icon {
                                    x: 8px;
                                    y: 8px;
                                    width: 18px;
                                    height: 18px;
                                    source: Icons.tune;
                                    tint: M3.on-secondary-container;
                                }
                                cta := TouchArea {
                                    clicked => {
                                        root.circuit-open = true;
                                        AppState.sheet-open = true;
                                    }
                                }
                            }
                        }
                        if AppState.race-live: VerticalLayout {
                            alignment: start;
                            Rectangle {
                                height: 26px;
                                width: 66px;
                                border-radius: 13px;
                                background: M3.error;
                                live-row := HorizontalLayout {
                                    spacing: 5px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: M3.on-error;
                                        }
                                    }
                                    Text {
                                        text: "LIVE";
                                        font-size: 12px;
                                        font-weight: 900;
                                        color: M3.on-error;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    RaceView {
                        vertical-stretch: 1;
                        cars: AppState.cars;
                        cam-f: AppState.cam-f;
                        cam-side: AppState.cam-side;
                        cam-stack: AppState.cam-stack;
                        cam-run: AppState.cam-run;
                        lap-v: AppState.lap-speed;
                        cam-pit: AppState.study-state == 2;
                        cam-v: AppState.cam-speed;
                        overview: AppState.race-overview;
                        commands: AppState.track-cmd;
                        aspect: AppState.track-aspect;
                        scale: AppState.track-scale;
                        pad-x: AppState.pad-x;
                        pad-y: AppState.pad-y;
                        pad-w: AppState.pad-w;
                        hud: "";
                        flash: AppState.lap-flash;
                    }
                }
                // piede della gara (Traguardo, proposta A): tempo, punti e giro; in pista il moltiplicatore e
                // chi ti precede; con la concentrazione l'anello col tempo e «+15′». I comandi stanno
                // nel pulsante in basso
                if AppState.car-sel == "": Rectangle {
                    x: 10px;
                    width: parent.width - 20px;
                    height: foot.preferred-height;
                    y: parent.height - self.height - 10px;
                    border-radius: 22px;
                    background: M3.surface;
                    foot := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-bottom: AppState.paddock-n > 0 ? 0px : 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        // concentrazione: il tempo che manca; pit stop: i 10′ delle gomme nuove
                        if AppState.focus-active || (AppState.study-state == 2 && AppState.pit-left != ""): Rectangle {
                            width: 58px;
                            height: 58px;
                            RingProgress {
                                width: 58px;
                                height: 58px;
                                value: AppState.focus-active ? (AppState.focus-left != "" ? AppState.focus-left-frac : 1) : AppState.pit-frac;
                                thickness: 6px;
                                fill: AppState.focus-active ? M3.primary : M3.warn;
                                track: (AppState.focus-active ? M3.primary : M3.warn).with-alpha(0.18);
                            }
                            Text {
                                text: AppState.focus-active ? (AppState.focus-left != "" ? AppState.focus-left : "∞") : AppState.pit-left;
                                font-size: self.text.character-count > 5 ? 10px : 13px;
                                font-weight: 900;
                                color: M3.on-surface;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: AppState.focus-active ? "Concentrazione · DRS aperto" : AppState.study-state == 2 ? "Pit stop · gomme soft" : AppState.study-today;
                                font-size: 15px;
                                font-weight: 800;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: AppState.study-elsewhere ? "Sessione aperta su un altro tuo dispositivo"
                                    : AppState.focus-active ? (AppState.ahead-text != "" ? AppState.ahead-text : AppState.focus-until-label)
                                    : AppState.study-state == 2 ? (AppState.pit-left != "" && AppState.pit-frac > 0 ? "rientra entro " + AppState.pit-left + " per il ×1,2 · " : "") + AppState.study-today
                                    : AppState.study-state == 1 ? (AppState.ahead-text != "" ? AppState.ahead-text : "in pista")
                                    : "al paddock · «Scendi in pista» col pulsante in basso";
                                font-size: 12px;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                            if AppState.focus-active && AppState.ahead-text != "": Text {
                                text: AppState.focus-until-label;
                                font-size: 12px;
                                color: M3.on-surface-variant;
                            }
                            if !AppState.focus-active && AppState.study-state != 2: Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: M3.surface-container-highest;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * AppState.study-lap;
                                    border-radius: 3px;
                                    background: M3.primary;
                                }
                            }
                        }
                        // in pista senza concentrazione: si attiva da qui, senza fermarsi
                        if !AppState.focus-active && AppState.focus-available && AppState.study-state == 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: fcr.preferred-width + 20px;
                                height: 32px;
                                border-radius: 16px;
                                background: fca.pressed ? M3.secondary-container.darker(0.08) : M3.secondary-container;
                                fcr := HorizontalLayout {
                                    x: 10px;
                                    spacing: 4px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            width: 16px;
                                            height: 16px;
                                            source: Icons.focus;
                                            tint: M3.on-secondary-container;
                                        }
                                    }
                                    Text {
                                        text: "Concentrazione";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: M3.on-secondary-container;
                                        vertical-alignment: center;
                                    }
                                }
                                fca := TouchArea {
                                    clicked => {
                                        AppState.focus-setup(true);
                                    }
                                }
                            }
                        }
                        if AppState.focus-active && AppState.focus-left != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 52px;
                                height: 32px;
                                border-radius: 16px;
                                background: ext.pressed ? M3.secondary-container.darker(0.08) : M3.secondary-container;
                                Text {
                                    text: "+15′";
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: M3.on-secondary-container;
                                }
                                ext := TouchArea {
                                    clicked => {
                                        AppState.focus-extend(15);
                                    }
                                }
                            }
                        }
                    }
                    // concentrazione: le app permesse, da aprire senza uscire dalla gara
                    if AppState.focus-active: Flickable {
                        height: 36px;
                        interactive: true;
                        content-width: max(self.width, apps.preferred-width);
                        content-height: 36px;
                        apps := HorizontalLayout {
                            x: 0px;
                            height: 36px;
                            spacing: 6px;
                            alignment: start;
                            for a[ai] in AppState.focus-launcher: AppChip {
                                app: a;
                                small: true;
                                clicked => {
                                    AppState.focus-launch(a.pkg);
                                }
                            }
                            if AppState.on-android: AppChip {
                                app: { label: "Telefono" };
                                small: true;
                                clicked => {
                                    AppState.focus-dial();
                                }
                            }
                        }
                    }
                    // il paddock: ultima riga del piede, sotto una linea sottile
                    if AppState.paddock-n > 0: Rectangle {
                        height: 1px;
                        background: M3.outline-variant;
                    }
                    if AppState.paddock-n > 0: Paddock {
                        cars: AppState.paddock-cars;
                    }
                    }
                }
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;

            // classifica: come si fanno i punti (pagina apposta) e «Avvisa tutti»
            if has-group: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Classifica";
                    font-size: 15px;
                    font-weight: 800;
                    color: M3.primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    RoundIcon {
                        icon: Icons.info;
                        clicked => {
                            root.pit-open = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundIcon {
                        icon: Icons.bell;
                        clicked => {
                            AppState.group-ping("");
                        }
                    }
                }
            }
            if has-group: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for p[i] in ["Oggi", "Settimana", "Mese", "Totale"]: Chip {
                    text: p;
                    selected: AppState.group-period == i;
                    clicked => {
                        AppState.group-period = i;
                        AppState.group-set-period(i);
                    }
                }
            }
            if has-group: VerticalLayout {
                spacing: 3px;
                for r[ri] in AppState.ranking: Rectangle {
                    border-top-left-radius: ri == 0 ? 24px : 6px;
                    border-top-right-radius: ri == 0 ? 24px : 6px;
                    border-bottom-left-radius: ri == AppState.ranking.length - 1 ? 24px : 6px;
                    border-bottom-right-radius: ri == AppState.ranking.length - 1 ? 24px : 6px;
                    background: r.me ? M3.secondary-container : M3.surface-container;
                    min-height: 64px;
                    TouchArea {
                        clicked => {
                            AppState.member-sel = AppState.member-sel == r.id ? "" : r.id;
                        }
                    }
                    VerticalLayout {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        min-height: 64px;
                        spacing: 12px;
                        Text {
                            text: r.pos;
                            font-weight: 900;
                            font-size: 18px;
                            color: r.pos == 1 ? #c79100 : M3.on-surface-variant;
                            vertical-alignment: center;
                            min-width: 18px;
                        }
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                width: 40px;
                                photo: r.photo;
                                has-photo: r.has-photo;
                                initial: r.initial;
                                ring: r.color;
                                TouchArea {
                                    enabled: r.has-photo;
                                    clicked => {
                                        AppState.photo-view-img = r.photo;
                                        AppState.photo-view-title = r.name;
                                        AppState.photo-view-group = false;
                                        AppState.photo-view = true;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: r.name;
                                font-size: 16px;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            // si accorcia con «…» invece di spingere i punti fuori dallo schermo
                            Text {
                                text: r.status + " · " + r.time + (r.admin ? " · admin" : "");
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Text {
                                text: r.value;
                                font-size: 18px;
                                font-weight: 900;
                                color: M3.on-surface;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                            }
                            if r.boost != "": Text {
                                text: r.boost;
                                font-size: Type.label;
                                font-weight: 800;
                                color: r.color;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    // azioni sul membro toccato
                    if AppState.member-sel == r.id: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        alignment: end;
                        M3Button {
                            text: "Profilo";
                            clicked => {
                                AppState.open-profile(r.id);
                            }
                        }
                        // la telecamera segue la sua monoposto (finché è in pista)
                        if !r.me && r.racing: M3Button {
                            text: "Segui";
                            kind: 1;
                            clicked => {
                                AppState.show-in-circuit(r.id);
                            }
                        }
                        if !r.me: M3Button {
                            text: "Avvisa";
                            kind: 1;
                            clicked => {
                                AppState.group-ping(r.id);
                            }
                        }
                        if AppState.group-admin && !r.admin && !r.me: M3Button {
                            text: "Rimuovi";
                            kind: 3;
                            clicked => {
                                AppState.group-kick(r.id);
                            }
                        }
                    }
                    }
                }
            }




            // crea o entra in un gruppo
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    if has-group: HorizontalLayout {
                        alignment: end;
                        M3Button {
                            text: "Esci da questo gruppo";
                            kind: 3;
                            small: true;
                            clicked => {
                                AppState.group-leave(AppState.group-id);
                            }
                        }
                    }
                    Text {
                        text: AppState.group-has ? "Un altro gruppo" : "Crea un gruppo";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        new-name := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-new-name;
                            placeholder-text: "Nome del gruppo (es. Anatomia 2026)";
                        }
                        M3Button {
                            text: "Crea";
                            kind: 1;
                            clicked => {
                                AppState.group-create(new-name.text);
                                AppState.group-new-name = "";
                            }
                        }
                    }
                    Text {
                        text: "Entra con un codice";
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        join := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-join-text;
                            placeholder-text: "Codice del gruppo (es. K7QM-4TZP-9WXR-2HDA)";
                            accepted => {
                                AppState.group-join(self.text);
                            }
                        }
                        M3Button {
                            text: "Entra";
                            kind: 1;
                            clicked => {
                                AppState.group-join(join.text);
                            }
                        }
                    }
                }
            }
            // spazio per il pulsante della gara (e «Termina» sopra) nell'angolo in basso
            Rectangle {
                height: AppState.study-state != 0 ? 148px : 84px;
            }
        }
    }
    if AppState.focus-open: FocusSheet {
        width: 100%;
        height: 100%;
    }

    // profilo di un membro: studio, mappa di calore, numeri dell'esame
    if AppState.profile-open: Rectangle {
        background: M3.scrim.with-alpha(0.5);
        TouchArea {
            clicked => {
                AppState.open-profile("");
            }
        }
        Rectangle {
            x: 12px;
            y: max(12px, root.height - self.height - 12px);
            width: root.width - 24px;
            height: min(root.height - 24px, pl.preferred-height);
            border-radius: 24px;
            background: M3.surface-container-high;
            clip: true;
            TouchArea { }
            Flickable {
                content-height: pl.preferred-height;
                pl := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Avatar {
                            width: 56px;
                            photo: AppState.profile-photo;
                            has-photo: AppState.profile-has-photo;
                            initial: AppState.profile-initial;
                            ring: AppState.profile-color;
                            TouchArea {
                                enabled: AppState.profile-has-photo;
                                clicked => {
                                    AppState.photo-view-img = AppState.profile-photo;
                                    AppState.photo-view-title = AppState.profile-name;
                                    AppState.photo-view-group = false;
                                    AppState.photo-view = true;
                                }
                            }
                        }
                        Text {
                            text: AppState.profile-name;
                            font-size: Type.title;
                            font-weight: 800;
                            color: M3.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        IconButton {
                            icon: Icons.close;
                            clicked => {
                                AppState.open-profile("");
                            }
                        }
                    }
                    for line[k] in AppState.profile-lines: Text {
                        text: line;
                        wrap: word-wrap;
                        font-size: k < 2 ? Type.body : Type.label;
                        font-weight: k == 0 ? 700 : 400;
                        color: k < 2 ? M3.on-surface : M3.on-surface-variant;
                    }
                    if AppState.profile-heat.length > 0: Heatmap {
                        cells: AppState.profile-heat;
                        title: AppState.profile-heat-title;
                        can-prev: AppState.profile-heat-prev;
                        can-next: AppState.profile-heat-next;
                        shift(d) => {
                            AppState.heat-shift(2, d);
                        }
                    }
                    if AppState.profile-racing: M3Button {
                        text: "Mostra nel circuito";
                        clicked => {
                            AppState.show-in-circuit(AppState.profile-id);
                        }
                    }
                }
            }
        }
    }

    // foto ingrandita (del gruppo o di un membro)
    if AppState.photo-view: Rectangle {
        background: M3.scrim.with-alpha(0.75);
        TouchArea {
            clicked => {
                AppState.photo-view = false;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - 48px, root.height - 200px, 360px);
                    height: self.width;
                    border-radius: 24px;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: AppState.photo-view-img;
                        image-fit: cover;
                    }
                }
            }
            Text {
                text: AppState.photo-view-title;
                horizontal-alignment: center;
                font-size: Type.title;
                font-weight: 700;
                color: white;
            }
            if AppState.photo-view-group && AppState.group-admin: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                M3Button {
                    text: "Cambia foto";
                    clicked => {
                        AppState.photo-view = false;
                        AppState.pick-photo("group");
                    }
                }
                M3Button {
                    text: "Togli foto";
                    kind: 1;
                    clicked => {
                        AppState.photo-view = false;
                        AppState.remove-photo("group");
                    }
                }
            }
        }
    }

    // Traguardo: «Calendario» a tutta pagina, dall'icona in alto
    if root.cal-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: M3.surface;
        TouchArea { }
        VerticalLayout {
            BigHeader {
                title: "Calendario";
                subtitle: has-group ? "Tu, i membri e il gruppo in un'unica vista" : "I tuoi giorni di studio";
                back => {
                    root.cal-open = false;
                }
            }
            Scroller {
                vertical-stretch: 1;
                align: start;
                pad: 16px;
                pad-top: 4px;
                gap: 12px;
                    // calendario: il proprio, di un altro membro o di tutto il gruppo
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                // di chi è il calendario: tu, uno degli altri membri o tutto il gruppo
                                if has-group: Flickable {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    interactive: true;
                                    content-width: who.preferred-width;
                                    content-height: 34px;
                                    who := Segmented {
                                        x: 0px;
                                        y: 0px;
                                        labels: AppState.cal-labels;
                                        index: AppState.cal-index;
                                        picked(i) => {
                                            AppState.cal-pick(i);
                                        }
                                    }
                                }
                                if !has-group: Text {
                                    text: "I tuoi giorni di studio";
                                    font-size: Type.title;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                }
                                if !has-group: Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if has-group && cal-group: HorizontalLayout {
                                alignment: end;
                                Segmented {
                                    labels: ["Settimana", "Mese"];
                                    index: AppState.gcal-month ? 1 : 0;
                                    picked(i) => {
                                        AppState.gcal-mode(i == 1);
                                    }
                                }
                            }
                            // di un altro membro: le sue ultime 12 settimane, mese per mese
                            if cal-member: VerticalLayout {
                                spacing: 8px;
                                if AppState.member-heat.length == 0: Text {
                                    text: "Nessun dato di studio ricevuto finora da questo membro.";
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                                if AppState.member-heat.length > 0: Heatmap {
                                    cells: AppState.member-heat;
                                    title: AppState.member-heat-title;
                                    can-prev: AppState.member-heat-prev;
                                    can-next: AppState.member-heat-next;
                                    shift(d) => {
                                        AppState.heat-shift(1, d);
                                    }
                                }
                            }
                            // il proprio: mese per mese
                            if !cal-group && !cal-member: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: AppState.my-heat-total;
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                                Heatmap {
                                    cells: AppState.my-heat;
                                    title: AppState.my-heat-title;
                                    can-prev: AppState.my-heat-prev;
                                    can-next: AppState.my-heat-next;
                                    shift(d) => {
                                        AppState.heat-shift(0, d);
                                    }
                                }
                            }
                            // del gruppo: settimana o mese, tocco su un giorno = chi ha studiato
                            if has-group && cal-group: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    IconButton {
                                        icon: Icons.chevron-left;
                                        enabled: AppState.gcal-can-prev;
                                        clicked => {
                                            AppState.gcal-shift(-1);
                                        }
                                    }
                                    Text {
                                        text: AppState.gcal-title;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-weight: 700;
                                        color: M3.on-surface;
                                    }
                                    IconButton {
                                        icon: Icons.chevron;
                                        enabled: AppState.gcal-can-next;
                                        clicked => {
                                            AppState.gcal-shift(1);
                                        }
                                    }
                                }
                                cal := Rectangle {
                                    property <length> gap: 4px;
                                    property <length> cw: (self.width - 6 * self.gap) / 7;
                                    height: 18px + ceil(AppState.gcal-cells.length / 7) * (self.cw + self.gap);
                                    for l[k] in ["L", "M", "M", "G", "V", "S", "D"]: Text {
                                        x: k * (cal.cw + cal.gap);
                                        y: 0;
                                        width: cal.cw;
                                        text: l;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        color: M3.on-surface-variant;
                                    }
                                    for c[k] in AppState.gcal-cells: Rectangle {
                                        x: mod(k, 7) * (cal.cw + cal.gap);
                                        y: 18px + floor(k / 7) * (cal.cw + cal.gap);
                                        width: cal.cw;
                                        height: AppState.gcal-month ? cal.cw : cal.cw;
                                        border-radius: 8px;
                                        background: c.level < 0 ? transparent : c.level == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * c.level / 4);
                                        border-width: c.sel ? 2px : c.today ? 1px : 0;
                                        border-color: c.sel ? M3.on-surface : M3.primary;
                                        Text {
                                            text: c.day;
                                            font-size: 12px;
                                            font-weight: c.today ? 800 : 400;
                                            color: c.level < 0 ? M3.outline-variant : c.level >= 3 ? M3.on-primary : M3.on-surface;
                                        }
                                        TouchArea {
                                            enabled: c.idx >= 0;
                                            clicked => {
                                                AppState.gcal-select(c.idx);
                                            }
                                        }
                                    }
                                }
                                for line[k] in AppState.gcal-lines: Text {
                                    text: line;
                                    wrap: word-wrap;
                                    font-size: k == 0 ? Type.body : Type.label;
                                    font-weight: k == 0 ? 700 : 400;
                                    color: k == 0 ? M3.on-surface : M3.on-surface-variant;
                                }
                                if AppState.gcal-lines.length == 0: Text {
                                    text: "Tocca un giorno: chi ha studiato, quanto e su cosa.";
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                }
                            }
                        }
                    }
            }
        }
    }

    // Traguardo: «Pit stop», come funzionano soste ed effetti in pista
    if root.pit-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: M3.surface;
        TouchArea { }
        VerticalLayout {
            BigHeader {
                title: "Come si fanno i punti";
                subtitle: "Moltiplicatore, effetti in pista e pit stop";
                back => {
                    root.pit-open = false;
                }
            }
            Scroller {
                vertical-stretch: 1;
                align: start;
                pad: 16px;
                pad-top: 4px;
                gap: 8px;
                Rectangle {
                    border-radius: 24px;
                    background: M3.primary-container;
                    min-height: pts.preferred-height;
                    pts := VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        Text {
                            text: "Ogni secondo di studio vale punti × il moltiplicatore";
                            font-size: 17px;
                            font-weight: 800;
                            color: M3.on-primary-container;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Il moltiplicatore (al massimo ×5) è anche la velocità della monoposto: un giro vale 60 punti. Oltre 10 ore al giorno resta ×1. Tocca una monoposto o un membro per i dettagli.";
                            font-size: 13px;
                            color: M3.on-primary-container;
                            wrap: word-wrap;
                        }
                    }
                }
                GroupLabel {
                    text: "Pit stop: uscita, sosta e rientro";
                }
                for st[i] in [
                    { t: "Esce dalla pista", d: "Dopo almeno 25 minuti di studio, la pausa breve porta la monoposto nella piazzola: rallenta e si ferma accanto al rettilineo, fuori dall'asfalto." },
                    { t: "Sosta, fino a 10′", d: "I meccanici cambiano le gomme. Resti in gara: la piazzola sta sul circuito, non nel paddock." },
                    { t: "Rientra con le gomme soft", d: "Riparte con le ruote rosse: ×1,2 per 25 minuti." },
                ]: Rectangle {
                    border-radius: 24px;
                    background: i == 2 ? M3.success-container : M3.surface-container;
                    min-height: pr.preferred-height;
                    pr := HorizontalLayout {
                        padding: 16px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: M3.primary;
                                Text {
                                    text: i + 1;
                                    font-size: 15px;
                                    font-weight: 900;
                                    color: M3.on-primary;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: st.t;
                                font-size: 17px;
                                font-weight: 800;
                                color: i == 2 ? M3.on-success-container : M3.on-surface;
                                wrap: word-wrap;
                            }
                            Text {
                                text: st.d;
                                font-size: 13px;
                                color: i == 2 ? M3.on-success-container : M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Text {
                    text: "Pausa tra 10 e 30 minuti: il ritmo si dimezza. Oltre 30 minuti o «Termina»: la monoposto va nel paddock e riparte da ×1.";
                    font-size: 13px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                GroupLabel {
                    text: "Gli effetti in pista";
                }
                VerticalLayout {
                    spacing: 3px;
                    for e[i] in [
                        { c: #FF8A1F, t: "Fiamme · ritmo", d: "+0,25 ogni 25 minuti di studio senza pause lunghe, fino a ×3: una fiamma in più a ogni livello." },
                        { c: #4F8DF5, t: "DRS e nastri blu · concentrazione", d: "Blocco delle altre app attivo: +1,0 al ritmo (subito ×2); +0,1 per ogni altro tuo dispositivo in concentrazione." },
                        { c: #E8322B, t: "Ruote rosse · gomme soft ×1,2", d: "Pit stop entro 10 minuti dopo almeno 25 di studio: per 25 minuti, con le strisce di gomma dietro." },
                        { c: #9FE6FF, t: "Raffiche · scia dei compagni", d: "+0,1 per ogni compagno in pista, fino a ×1,4: il loro vento si infrange sull'alettone." },
                        { c: #2FD27A, t: "Coriandoli · piano fatto ×1,1", d: "Obiettivi di oggi completati: ×1,1 fino a mezzanotte." },
                        { c: #F5C542, t: "Scia d'oro · primo in classifica", d: "Chi è in testa oggi. Solo da vedere: il punteggio non cambia." },
                        { c: #FFD400, t: "Pannello giallo · bandiera gialla", d: "Uscito dalla concentrazione prima del tempo: bonus sospeso e DRS chiuso fino alla fine prevista o al rientro." },
                        { c: #A3A8B1, t: "Fumo davanti · bloccaggio ×0,8", d: "Più di 2 pause in 30 minuti, per 15 minuti: la macchina trema." },
                        { c: #A259FF, t: "Raggiera e «PB» · record", d: "Hai superato il tuo miglior giorno. Poi la bandierina a ogni giro e «+1»/«−1» a ogni sorpasso." },
                    ]: Rectangle {
                        border-top-left-radius: i == 0 ? 24px : 6px;
                        border-top-right-radius: i == 0 ? 24px : 6px;
                        border-bottom-left-radius: i == 8 ? 24px : 6px;
                        border-bottom-right-radius: i == 8 ? 24px : 6px;
                        background: M3.surface-container;
                        min-height: er.preferred-height;
                        er := HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: e.c;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: e.t;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                }
                                Text {
                                    text: e.d;
                                    font-size: 13px;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // chi è quella macchina: foglio dal basso su tutta la pagina (stato, tempi, pit stop, cosa sta
    // studiando; «Segui», «Avvisa» e «Profilo»)
    if AppState.car-sel != "": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000040;
        TouchArea {
            clicked => {
                AppState.car-close();
            }
        }
        Rectangle {
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: min(parent.height - 80px, card.preferred-height + 24px);
            border-top-left-radius: 28px;
            border-top-right-radius: 28px;
            background: M3.surface-container-low;
            clip: true;
            // il tocco sul foglio non lo chiude
            TouchArea { }
            Rectangle {
                x: (parent.width - 36px) / 2;
                y: 10px;
                width: 36px;
                height: 4px;
                border-radius: 2px;
                background: M3.outline-variant;
            }
            VerticalLayout {
                y: 20px;
                height: parent.height - 20px;
            card := VerticalLayout {
                padding: 20px;
            padding-top: 8px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Avatar {
                        width: 44px;
                        photo: AppState.car-info-photo;
                        has-photo: AppState.car-info-has-photo;
                        initial: AppState.car-info-initial;
                        ring: AppState.car-info-color;
                        TouchArea {
                            enabled: AppState.car-info-has-photo;
                            clicked => {
                                AppState.photo-view-img = AppState.car-info-photo;
                                AppState.photo-view-title = AppState.car-info-title;
                                AppState.photo-view-group = false;
                                AppState.photo-view = true;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: AppState.car-info-title;
                            font-weight: 900;
                            font-size: 22px;
                            color: M3.on-surface;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                height: 22px;
                                border-radius: 11px;
                                background: AppState.car-info-kind == 1 ? AppState.car-info-color.with-alpha(0.22) : AppState.car-info-kind == 2 ? M3.warn-container : M3.surface-container-highest;
                                width: state-text.preferred-width + 16px;
                                state-text := Text {
                                    text: AppState.car-info-state;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppState.car-info-kind == 2 ? M3.on-tertiary-container : M3.on-surface;
                                }
                            }
                        }
                    }
                    IconButton {
                        icon: Icons.close;
                        clicked => {
                            AppState.car-close();
                        }
                    }
                }
                // tempi di studio: tre riquadri uniti
                HorizontalLayout {
                    spacing: 3px;
                    for st[i] in [
                        { label: "oggi", value: AppState.car-info-today },
                        { label: "settimana", value: AppState.car-info-week },
                        { label: "mese", value: AppState.car-info-month },
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        border-top-left-radius: i == 0 ? 18px : 6px;
                        border-bottom-left-radius: i == 0 ? 18px : 6px;
                        border-top-right-radius: i == 2 ? 18px : 6px;
                        border-bottom-right-radius: i == 2 ? 18px : 6px;
                        background: M3.surface-container;
                        min-height: tile.preferred-height;
                        tile := VerticalLayout {
                            padding: 10px;
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: st.value;
                                font-weight: 900;
                                font-size: 17px;
                                color: M3.on-surface;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: st.label;
                                font-size: 11px;
                                color: M3.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                for line in AppState.car-info-lines: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 5px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: AppState.car-info-color;
                        }
                    }
                    Text {
                        text: line;
                        font-size: 13px;
                        color: M3.on-surface;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if !AppState.car-info-me: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if AppState.car-info-racing: M3Button {
                        kind: AppState.car-info-following ? 2 : 1;
                        has-icon: true;
                        icon: Icons.focus;
                        text: AppState.car-info-following ? "Non seguire" : "Segui";
                        clicked => {
                            AppState.car-follow(AppState.car-sel);
                        }
                    }
                    M3Button {
                        kind: 2;
                        has-icon: true;
                        icon: Icons.feedback;
                        text: "Avvisa";
                        clicked => {
                            AppState.group-ping(AppState.car-sel);
                        }
                    }
                    M3Button {
                        kind: 3;
                        text: "Profilo";
                        clicked => {
                            AppState.open-profile(AppState.car-sel);
                        }
                    }
                }
            }
            }
        }
    }

    // scelta del circuito (amministratore): uno diverso ogni giorno o sempre lo stesso
    if root.circuit-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000040;
        TouchArea {
            clicked => {
                root.circuit-open = false;
                AppState.sheet-open = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            height: csh.preferred-height;
            border-top-left-radius: 28px;
            border-top-right-radius: 28px;
            background: M3.surface-container-low;
            TouchArea { }
            csh := VerticalLayout {
                padding: 20px;
                padding-top: 14px;
                spacing: 3px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: M3.outline-variant;
                    }
                }
                Text {
                    text: "Circuito del gruppo";
                    font-size: 22px;
                    font-weight: 900;
                    color: M3.on-surface;
                }
                Text {
                    text: "Lo decidi tu per tutti; più membri, pista più grande";
                    font-size: 13px;
                    color: M3.on-surface-variant;
                    height: self.preferred-height + 10px;
                }
                for i in AppState.circuit-names.length + 1: Rectangle {
                    property <int> v: i - 1;
                    property <bool> on: AppState.circuit-fixed == self.v;
                    height: 52px;
                    border-top-left-radius: i == 0 ? 20px : 6px;
                    border-top-right-radius: i == 0 ? 20px : 6px;
                    border-bottom-left-radius: i == AppState.circuit-names.length ? 20px : 6px;
                    border-bottom-right-radius: i == AppState.circuit-names.length ? 20px : 6px;
                    background: self.on ? M3.secondary-container : M3.surface-container;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 10px;
                        Text {
                            text: v < 0 ? "Uno diverso ogni giorno" : AppState.circuit-names[v];
                            font-size: 15px;
                            font-weight: on ? 800 : 500;
                            color: M3.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if on: VerticalLayout {
                            alignment: center;
                            Icon {
                                width: 20px;
                                height: 20px;
                                source: Icons.check;
                                tint: M3.primary;
                            }
                        }
                    }
                    TouchArea {
                        clicked => {
                            AppState.group-set-circuit(v);
                            root.circuit-open = false;
                            AppState.sheet-open = false;
                        }
                    }
                }
            }
        }
    }
}
