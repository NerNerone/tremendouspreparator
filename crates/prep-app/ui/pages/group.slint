import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, HeatVM, GHeatVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "../state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller, BigHeader } from "../components.slint";

// foto profilo (o iniziale) in un cerchio col bordo del colore della monoposto
export component Avatar inherits Rectangle {
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> initial;
    in property <color> ring: M3.primary;
    width: 40px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.ring;
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: self.width / 2;
        clip: true;
        background: root.has-photo ? transparent : root.ring.darker(0.25);
        if root.has-photo: Image {
            width: parent.width;
            height: parent.height;
            source: root.photo;
            image-fit: cover;
        }
        if !root.has-photo: Text {
            text: root.initial;
            color: white;
            font-weight: 800;
            font-size: parent.height * 0.45;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// meccanico visto dall'alto, rivolto verso +x (verso la macchina): tuta, casco del colore
// della squadra, braccia che lavorano; in mano l'avvitatore, una gomma o il cartello
component Crew inherits Rectangle {
    in property <color> c;
    in property <color> helmet;
    in property <float> work;
    in property <bool> tool: true;
    in property <bool> tire;
    in property <bool> sign;
    width: 16px;
    height: 16px;
    // gomma: la porta via e la rimette
    if root.tire: Rectangle {
        x: 13px + 6px * (1 - root.work);
        y: 3.5px;
        width: 6px;
        height: 9px;
        border-radius: 2px;
        background: root.c.darker(0.7);
        Rectangle { x: 2px; y: 3px; width: 2px; height: 3px; border-radius: 1px; background: root.helmet; }
    }
    // braccia: si allungano a turno (avvita / svita)
    Rectangle { x: 8px; y: 3px; width: 4px + 4px * root.work; height: 3px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 8px; y: 10px; width: 4px + 4px * (1 - root.work); height: 3px; border-radius: 1.5px; background: root.c; }
    // avvitatore
    if root.tool && !root.tire: Rectangle {
        x: 12px + 4px * root.work;
        y: 5px;
        width: 4px;
        height: 6px;
        border-radius: 1px;
        background: root.c.darker(0.6);
    }
    // cartello: asta e disco nel colore della squadra
    if root.sign: Rectangle { x: 10px; y: 7px; width: 9px; height: 2px; background: root.c.darker(0.6); }
    if root.sign: Rectangle {
        x: 17px;
        y: 2.5px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: root.helmet;
        border-width: 1.5px;
        border-color: root.c.darker(0.6);
    }
    // spalle
    Rectangle { x: 3px; y: 1px; width: 8px; height: 14px; border-radius: 4px; background: root.c; }
    // casco
    Rectangle { x: 4px; y: 4.5px; width: 7px; height: 7px; border-radius: 3.5px; background: root.helmet; border-width: 1px; border-color: root.c.darker(0.6); }
}

// monoposto di Formula 1 vista dall'alto, tutta nel suo colore (muso verso destra)
component Car inherits Rectangle {
    in property <CarVM> car;
    in property <float> phase;
    in property <color> road;
    in property <color> bg-line: M3.surface;
    property <color> c: root.car.offline ? root.road.darker(0.4) : root.car.color;
    // di nuovo sulla carreggiata (dopo un pit stop la scia normale torna solo qui)
    in property <bool> on-road: true;
    // la piazzola e i meccanici compaiono quando la macchina è ferma sulla piazzola e
    // spariscono in fretta quando riparte
    in property <bool> arrived;
    property <float> crew: 0;
    states [
        stopped when root.arrived: {
            crew: 1;
            in {
                animate crew {
                    duration: 900ms;
                    easing: ease-out;
                }
            }
            out {
                animate crew {
                    duration: 250ms;
                    easing: ease-in;
                }
            }
        }
    ]
    property <float> w: 0;
    animate w {
        duration: 230ms;
        easing: ease-in-out;
    }
    Timer {
        interval: 260ms;
        running: root.car.pit;
        triggered => {
            root.w = root.w > 0.5 ? 0 : 1;
        }
    }
    property <color> suit: root.road.darker(0.45);
    width: 36px;
    height: 20px;
    // effetti (vedi CarVM.fx): orologi per i movimenti continui
    property <bool> fx-flame: root.car.racing && mod(root.car.fx, 2) == 1;
    property <bool> fx-tyres: root.car.racing && mod(floor(root.car.fx / 2), 2) == 1;
    property <bool> fx-focus: root.car.racing && mod(floor(root.car.fx / 4), 2) == 1;
    property <bool> fx-smoke: !root.car.parked && mod(floor(root.car.fx / 8), 2) == 1;
    property <bool> fx-draft: root.car.racing && mod(floor(root.car.fx / 16), 2) == 1;
    property <bool> fx-flag: !root.car.parked && mod(floor(root.car.fx / 32), 2) == 1;
    property <bool> fx-any: root.car.fx != 0;
    // effetti che prendono il posto della scia normale
    property <bool> fx-trail: root.fx-flame || root.fx-focus || root.fx-smoke || root.fx-draft;
    property <float> tk: root.fx-any ? mod(animation-tick() / 1ms, 1200) / 1200 : 0;
    property <float> fl: root.fx-any ? mod(animation-tick() / 1ms, 160) / 160 : 0;
    // concentrazione: alone blu che pulsa e lunga scia blu con filetti che scorrono
    if root.fx-focus: Rectangle {
        x: -7px;
        y: -6px;
        width: 50px;
        height: 32px;
        border-radius: 16px;
        background: #2979ff;
        opacity: 0.16 + 0.1 * (0.5 + 0.5 * sin(root.tk * 360deg));
    }
    if root.fx-focus: Rectangle {
        x: -34px;
        y: 4px;
        width: 34px;
        height: 12px;
        border-radius: 6px;
        background: @linear-gradient(90deg, #2979ff00 0%, #448aff88 100%);
    }
    for i in (root.fx-focus ? 4 : 0): Rectangle {
        property <float> p: mod(root.tk * 2 + i / 4, 1);
        x: -4px - 28px * self.p;
        y: 5px + mod(i * 5, 11) * 1px;
        width: 8px;
        height: 1.5px;
        border-radius: 1px;
        background: #bbdefb;
        opacity: 1 - self.p;
    }
    // ritmo: fiamme dallo scarico, più lunghe con il ritmo
    for i in (root.fx-flame ? 2 : 0): Rectangle {
        property <length> len: (7px + 20px * root.car.level) * (0.8 + 0.4 * (i == 0 ? root.fl : 1 - root.fl));
        x: 1px - self.len;
        y: i == 0 ? 5px : 11px;
        width: self.len;
        height: 4px;
        border-radius: 2px;
        background: @linear-gradient(90deg, #ff3d0000 0%, #ff6d00 45%, #ffd600 100%);
    }
    if root.fx-flame && root.car.level > 0.6: Rectangle {
        property <length> len: (14px + 18px * root.car.level) * (0.85 + 0.3 * root.fl);
        x: 1px - self.len;
        y: 7px;
        width: self.len;
        height: 6px;
        border-radius: 3px;
        background: @linear-gradient(90deg, #d5000000 0%, #ff3d00aa 60%, #fff59d 100%);
    }
    // penalità: sbuffi di fumo grigio che si allargano e svaniscono
    for i in (root.fx-smoke ? 5 : 0): Rectangle {
        property <float> p: mod(root.tk + i / 5, 1);
        property <length> r: 3px + 9px * self.p;
        x: -2px - 30px * self.p - self.r;
        y: 10px - self.r + (mod(i, 2) == 0 ? -3px : 3px) * self.p;
        width: self.r * 2;
        height: self.r * 2;
        border-radius: self.r;
        background: #757575;
        opacity: 0.55 * (1 - self.p);
    }
    // scia di gruppo: filetti di vento ai lati
    for i in (root.fx-draft ? 4 : 0): Rectangle {
        property <float> p: mod(root.tk * 1.5 + i / 4, 1);
        x: 44px - 60px * self.p;
        y: mod(i, 2) == 0 ? -5px : 24px;
        width: 14px;
        height: 1.5px;
        border-radius: 1px;
        background: #26c6da;
        opacity: 0.9 * (1 - self.p);
    }
    // piazzola del box: un fondo arrotondato poco più grande della monoposto, senza bordi né
    // segni; compare quando la macchina si ferma e sparisce quando riparte
    if root.crew > 0.01: Rectangle {
        x: -7px;
        y: -4px;
        width: 50px;
        height: 28px;
        border-radius: 9px;
        background: root.road;
        opacity: root.crew;
    }
    // scia normale, solo in pista e senza effetti (un effetto la sostituisce)
    if root.car.racing && root.on-road && !root.fx-trail: Rectangle {
        x: -10px - 5px * root.phase;
        y: 6px;
        width: 8px + 5px * root.phase;
        height: 2px;
        border-radius: 1px;
        background: root.c;
        opacity: 0.2 + 0.35 * root.phase;
    }
    if root.car.racing && root.on-road && !root.fx-trail: Rectangle {
        x: -8px - 6px * (1 - root.phase);
        y: 12px;
        width: 6px + 6px * (1 - root.phase);
        height: 2px;
        border-radius: 1px;
        background: root.c;
        opacity: 0.2 + 0.35 * (1 - root.phase);
    }
    // alettone posteriore
    Rectangle { x: 0px; y: 3px; width: 3px; height: 14px; border-radius: 1px; background: root.c; }
    // ruote posteriori e anteriori
    Rectangle { x: 4px; y: 0px; width: 7px; height: 5px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 4px; y: 15px; width: 7px; height: 5px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 23px; y: 1px; width: 6px; height: 4px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 23px; y: 15px; width: 6px; height: 4px; border-radius: 1.5px; background: root.c; }
    // scocca con le pance laterali
    Rectangle { x: 6px; y: 6px; width: 16px; height: 8px; border-radius: 4px; background: root.c; }
    // muso affilato e alettone anteriore
    Rectangle { x: 20px; y: 8.5px; width: 13px; height: 3px; border-radius: 1.5px; background: root.c; }
    Rectangle { x: 32px; y: 2px; width: 3px; height: 16px; border-radius: 1px; background: root.c; }
    // abitacolo (halo): nel colore della strada; più grande sulla propria macchina
    Rectangle {
        x: root.car.me ? 15px : 16px;
        y: root.car.me ? 7.5px : 8.5px;
        width: root.car.me ? 5px : 3px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.road;
    }
    // gomme nuove: scintille che si accendono a turno attorno alle ruote
    for i in (root.fx-tyres ? 6 : 0): Rectangle {
        property <float> p: mod(root.tk * 1.4 + i / 6, 1);
        x: (mod(i, 3) == 0 ? 2px : mod(i, 3) == 1 ? 13px : 27px) + 4px * self.p;
        y: i < 3 ? -6px - 4px * self.p : 22px + 4px * self.p;
        width: 6px;
        height: 6px;
        border-width: 1px;
        border-color: #e65100;
        background: mod(i, 2) == 0 ? #ffd600 : #fff176;
        transform-rotation: 45deg + 90deg * self.p;
        opacity: 1 - self.p;
    }
    // bandiera gialla: bonus sospeso (uscito dalla concentrazione prima del previsto)
    if root.fx-flag: Rectangle {
        x: 14px;
        y: -16px;
        width: 12px;
        height: 14px;
        Rectangle { x: 0px; y: 0px; width: 1.5px; height: 14px; background: #424242; }
        Rectangle {
            x: 1.5px;
            y: 0px;
            width: 10px;
            height: 7px;
            background: #ffd600;
            transform-rotation: 6deg * sin(root.tk * 720deg);
        }
    }
    // squadra dei box: numero e posti a caso (fissi per ogni sosta), sempre sul lato esterno
    for m in root.car.crew: Crew {
        c: root.suit;
        helmet: root.c;
        work: m.alt ? 1 - root.w : root.w;
        tool: m.tool;
        tire: m.tire;
        sign: m.sign;
        x: m.x * 1px;
        y: m.y * 1px + 24px * (1 - root.crew);
        transform-rotation: m.rot * 1deg;
        transform-scale-x: 0.72;
        transform-scale-y: 0.72;
        opacity: root.crew;
        visible: root.crew > 0.01;
    }
}

// minimappa: tutto il circuito, le macchine come puntini
component MiniMap inherits Rectangle {
    in property <[CarVM]> cars;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <color> road;
    property <length> pad: 8px;
    property <length> sw: 5px;
    property <length> tw: root.width - 2 * root.pad;
    property <length> th: root.tw / root.aspect;
    height: root.th + 2 * root.pad;
    mm := Path {
        x: root.pad - root.sw / 2;
        y: root.pad - root.sw / 2;
        width: root.tw + root.sw;
        height: root.th + root.sw;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: ImageFit.fill;
        commands: root.commands;
        stroke: root.road;
        stroke-width: root.sw;
    }
    for car in root.cars: Rectangle {
        // posizione continua: ultimo valore ricevuto più la velocità per il tempo trascorso
        property <float> f0: car.f;
        property <duration> t0;
        init => {
            self.t0 = animation-tick();
        }
        changed f0 => {
            self.t0 = animation-tick();
        }
        property <float> f: car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0;
        property <Point> p: mm.point-at(self.f);
        visible: !car.parked;
        x: mm.x + self.p.x - self.width / 2;
        y: mm.y + self.p.y - self.height / 2;
        width: car.me ? 9px : 7px;
        height: self.width;
        border-radius: self.width / 2;
        background: car.offline ? root.road.darker(0.4) : car.color;
    }
}

// la gara: da vicino la telecamera segue la tua macchina; altrimenti tutto il circuito.
// Le posizioni vengono dal tracciato stesso (frazione di giro), quindi lo zoom non le sposta.
component RaceView inherits Rectangle {
    in property <[CarVM]> cars;
    in property <float> cam-f;
    in property <bool> overview;
    in property <string> hud;
    in property <int> flash;
    in property <string> commands;
    in property <float> aspect: 2.4;
    in property <float> scale: 1;
    in property <float> pad-x: 0.5;
    in property <float> pad-y: 0.65;
    // larghezza del paddock (frazione della larghezza del circuito): cresce con i membri
    in property <float> pad-w: 0.2;
    // Traguardo: il paddock sta in un riquadro flottante fuori dalla pista, non sotto il circuito
    in property <bool> paddock-float: true;
    // la strada: un solo colore, dal tema; la mezzeria nel colore dello sfondo
    property <color> road: M3.surface-container-highest;
    property <color> bg: M3.surface;
    // il pulsante inverte la vista automatica (da vicino mentre studi, d'insieme altrimenti)
    property <bool> flip: false;
    property <bool> wide: root.overview != root.flip;
    changed overview => {
        root.flip = false;
    }
    // altezza della pista: grande da vicino (cresce con i membri), oppure tutta nella vista
    property <length> fit-th: min((root.width - 110px) / root.aspect, (root.height - 40px) / 1.78);
    property <float> zoom: root.wide ? 0 : 1;
    animate zoom {
        duration: 700ms;
        easing: ease-in-out;
    }
    property <length> near-th: 560px * root.scale;
    property <length> TH: root.fit-th + (root.near-th - root.fit-th) * root.zoom;
    property <length> TW: root.TH * root.aspect;
    property <length> P: 260px * root.scale;
    // carreggiata e corsie
    property <length> sw: root.TH * 0.13 / sqrt(root.scale);
    property <length> lane-w: root.sw * 0.33;
    // distanza dal centro della strada a cui si ferma chi fa il pit stop: metà carreggiata,
    // il lato della piazzola verso la pista (13 px della monoposto, in scala) e un margine
    property <length> pit-off: root.sw / 2 + 30px * root.k;
    // monoposto in scala con la carreggiata: larghe circa 0,3 della strada, così tre stanno
    // affiancate nelle corsie a qualunque zoom (piazzola e meccanici seguono la stessa scala)
    property <float> k: 0.24 * root.sw / 20px;
    property <float> phase: 0;
    // telecamera: la stessa animazione della propria macchina, così resta al centro
    in property <float> cam-v;
    property <float> cf0: root.cam-f;
    property <duration> ct0;
    init => {
        root.ct0 = animation-tick();
        root.ctp = animation-tick() - 3600s;
        root.cl-side = root.cam-side;
        root.cl-stack = root.cam-stack;
        root.cl-run = root.cam-run;
    }
    changed cf0 => {
        root.ct0 = animation-tick();
    }
    in property <bool> cam-pit;
    // velocità di gara (giri al secondo): l'uscita di pista dura quanto basta a frenare da lì
    in property <float> lap-v: 1 / 60;
    in property <float> cam-run;
    // al pit stop la telecamera segue la stessa traiettoria della propria macchina (vedi sotto)
    property <float> cl-side: 1;
    property <float> cl-stack: 0;
    property <float> cl-run: 0;
    property <duration> ctp;
    function cam-latch() {
        if (root.cam-pit) {
            root.cl-side = root.cam-side;
            root.cl-stack = root.cam-stack;
            root.cl-run = root.cam-run;
        }
    }
    changed cam-pit => {
        root.ctp = animation-tick();
        root.cam-latch();
    }
    changed cam-run => { root.cam-latch(); }
    changed cam-side => { root.cam-latch(); }
    changed cam-stack => { root.cam-latch(); }
    property <duration> cT: max(0.5s, 2 * root.cl-run / max(0.001, root.lap-v) * 1s);
    property <float> clin: clamp((animation-tick() - root.ctp) / root.cT, 0, 1);
    property <float> cq: root.cam-pit ? 1 - (1 - root.clin) * (1 - root.clin) : (1 - root.clin) * (1 - root.clin);
    property <float> cf: (root.cam-v > 0 ? root.cf0 + root.cam-v * ((animation-tick() - root.ct0) / 1s) : root.cf0) + root.cl-run * root.cq;
    // direzione della strada nel punto `f`: dalla corda tra due punti vicini del tracciato DISEGNATO
    // (stirato in larghezza e altezza). La tangente del tracciato di partenza (angle-at) non tiene
    // conto dello stiramento e alle giunzioni delle curve può saltare: la monoposto girava su sé stessa.
    pure function heading(f: float) -> angle {
        return atan2(
            (road-path.point-at(f + 1.0015).y - road-path.point-at(f + 0.9985).y) / 1px,
            (road-path.point-at(f + 1.0015).x - road-path.point-at(f + 0.9985).x) / 1px);
    }
    property <Point> cp: road-path.point-at(root.cf);
    property <angle> ca: root.heading(root.cf);
    // al pit stop la telecamera si sposta sulla piazzola, fuori pista
    in property <float> cam-side: 1;
    in property <float> cam-stack;
    property <float> cpp: root.cam-pit ? root.cq : 1 - root.clin * root.clin;
    property <length> coff: root.cpp * root.cpp * (3 - 2 * root.cpp) * root.cl-side * (root.pit-off + 10px * root.k + root.cl-stack * 50px * root.k);
    property <length> cam-px: road-path.x + root.cp.x - sin(root.ca) * root.coff;
    property <length> cam-py: road-path.y + root.cp.y + cos(root.ca) * root.coff;
    property <length> mid-x: root.P + root.TW / 2;
    property <length> mid-y: root.P + root.TH * (0.5 + 0.2 * (1 - root.zoom));
    Timer {
        interval: 120ms;
        running: true;
        triggered => {
            root.phase = root.phase > 0.5 ? 0 : 1;
        }
    }
    clip: true;
    world := Rectangle {
        x: root.width / 2 - (root.mid-x + (root.cam-px - root.mid-x) * root.zoom);
        y: root.height / 2 + 12px * (1 - root.zoom) - (root.mid-y + (root.cam-py - root.mid-y) * root.zoom);
        width: root.TW + 2 * root.P;
        height: root.TH + 2 * root.P;
        // paddock sotto il circuito, fuori pista: corsia box, muretto e garage; chi ha
        // terminato la sessione o non è collegato aspetta qui nel suo box
        if !root.paddock-float: Rectangle {
            width: root.pad-w * root.TW;
            height: root.TH * 0.2;
            x: root.P + root.pad-x * root.TW - self.width / 2;
            y: root.P + root.pad-y * root.TH - self.height / 2;
            border-radius: min(self.height / 4, 18px);
            background: root.road;
            // corsia box tratteggiata
            for i in 14: Rectangle {
                x: parent.width * (i + 0.25) / 14;
                y: parent.height * 0.12;
                width: parent.width / 28;
                height: max(1.5px, root.TH * 0.005);
                background: root.bg;
            }
            // muretto dei box e tetto dei garage
            Rectangle {
                x: parent.width * 0.05;
                y: 0px;
                width: parent.width * 0.9;
                height: max(2px, root.TH * 0.01);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
            Rectangle {
                x: parent.width * 0.05;
                y: parent.height - self.height;
                width: parent.width * 0.9;
                height: max(3px, root.TH * 0.025);
                border-radius: self.height / 2;
                background: root.road.darker(0.25);
            }
        }
        road-path := Path {
            x: root.P - root.sw / 2;
            y: root.P - root.sw / 2;
            width: root.TW + root.sw;
            height: root.TH + root.sw;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: ImageFit.fill;
            commands: root.commands;
            stroke: root.road;
            stroke-width: root.sw;
        }
        // linea di mezzeria tratteggiata
        for i in 80: Rectangle {
            property <float> t: (i + 0.25) / 80;
            property <Point> p: road-path.point-at(self.t);
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: root.TW * root.scale * 0.006 + root.TH * 0.02;
            height: max(1.5px, root.TH * 0.006);
            background: root.bg;
            transform-rotation: root.heading(self.t);
        }
        // traguardo a scacchi, di traverso sulla strada
        Rectangle {
            property <Point> p: road-path.point-at(0);
            property <length> sq: root.sw / 8;
            x: road-path.x + self.p.x - self.width / 2;
            y: road-path.y + self.p.y - self.height / 2;
            width: 2 * self.sq;
            height: root.sw;
            transform-rotation: root.heading(0);
            for i in 16: Rectangle {
                x: mod(i, 2) * parent.sq;
                y: floor(i / 2) * parent.sq;
                width: parent.sq;
                height: parent.sq;
                background: mod(i + floor(i / 2), 2) == 0 ? root.bg : root.road.darker(0.35);
            }
        }
        for car in root.cars: slot := Rectangle {
            // moto continuo: ultimo valore ricevuto più velocità × tempo trascorso (calcolato a
            // ogni fotogramma, così non ci sono scatti tra un aggiornamento e l'altro)
            property <float> f0: car.f;
            property <duration> t0;
            init => {
                self.t0 = animation-tick();
                // già ferma (o già in gara) all'apertura: niente manovra da rifare
                self.tp = animation-tick() - 3600s;
                self.latch();
            }
            changed f0 => {
                self.t0 = animation-tick();
            }
            // Uscita di pista: la macchina continua dritta e scarta con una curva a S (tangente
            // alla corsia alla partenza e alla piazzola all'arrivo) lungo `run` giri, frenando
            // dalla velocità di gara fino a fermarsi; al rientro accelera da ferma e si
            // reimmette nella sua corsia alla velocità della gara. Lato, fila e tratto restano
            // quelli della sosta anche mentre riparte.
            property <float> l-side: 1;
            property <float> l-stack: 0;
            property <float> l-run: 0;
            function latch() {
                if (car.pit) {
                    self.l-side = car.side;
                    self.l-stack = car.stack;
                    self.l-run = car.run;
                }
            }
            property <bool> in-pit: car.pit;
            property <float> s-side: car.side;
            property <float> s-stack: car.stack;
            property <float> s-run: car.run;
            property <duration> tp;
            changed in-pit => {
                self.tp = animation-tick();
                self.latch();
            }
            changed s-side => { self.latch(); }
            changed s-stack => { self.latch(); }
            changed s-run => { self.latch(); }
            // durata: frenare (o accelerare) in modo uniforme su `run` alla velocità di gara
            property <duration> T: max(0.5s, 2 * self.l-run / max(0.001, root.lap-v) * 1s);
            property <float> lin: clamp((animation-tick() - self.tp) / self.T, 0, 1);
            // q: quota della manovra aggiunta alla posizione in gara (in uscita la macchina è
            // ferma, al rientro la posizione in gara riparte e la quota si esaurisce);
            // sp: punto della curva a S raggiunto (0 = corsia, 1 = piazzola), cioè la strada
            // davvero percorsa dalla piazzola o verso di essa
            property <float> q: car.pit ? 1 - (1 - self.lin) * (1 - self.lin) : (1 - self.lin) * (1 - self.lin);
            property <float> sp: car.pit ? self.q : 1 - self.lin * self.lin;
            property <float> f: (car.v > 0 ? self.f0 + car.v * ((animation-tick() - self.t0) / 1s) : self.f0) + self.l-run * self.q;
            // scostamento dal centro della strada: dalla corsia alla piazzola con uno smoothstep
            // (calcolato a ogni zoom: niente animazioni che rincorrono)
            property <length> lane-off: car.lane * root.lane-w;
            property <length> pad-off: self.l-side * (root.pit-off + self.l-stack * 50px * root.k);
            property <length> off: self.lane-off + (self.pad-off - self.lane-off) * self.sp * self.sp * (3 - 2 * self.sp);
            // muso tangente alla curva: pendenza = spostamento laterale / strada percorsa (il
            // tratto è lungo (170 + 90 × fila) px della monoposto); al rientro la curva si
            // percorre al contrario
            property <length> run-len: (170 + 90 * self.l-stack) * 1px * root.k;
            property <angle> yaw: atan((car.pit ? 1 : -1) * (self.pad-off - self.lane-off) / max(1px, self.run-len) * 6 * self.sp * (1 - self.sp));
            property <Point> p: road-path.point-at(self.f);
            property <angle> a: root.heading(self.f);
            property <length> cx: car.parked ? root.P + car.px * root.TW : road-path.x + self.p.x - sin(self.a) * self.off;
            property <length> cy: car.parked ? root.P + car.py * root.TH : road-path.y + self.p.y + cos(self.a) * self.off;
            x: self.cx - self.width / 2;
            y: self.cy - self.height / 2;
            width: 48px;
            height: 48px;
            visible: !(root.paddock-float && car.parked);
            // box del garage: due pareti e il fondo, aperto verso la corsia box
            if car.parked: Rectangle {
                width: 30px * root.k;
                height: 46px * root.k;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + 2px * root.k;
                Rectangle { x: 0px; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: parent.width - self.width; y: 0px; width: max(1.5px, 2px * root.k); height: parent.height; background: root.bg; }
                Rectangle { x: 0px; y: parent.height - self.height; width: parent.width; height: max(1.5px, 2px * root.k); background: root.bg; }
            }
            // rotazione e specchio su due elementi distinti: il renderer applica la scala prima
            // della rotazione, e con lo specchio sullo stesso elemento in curva il muso si
            // girava dalla parte sbagliata (rientro dal pit sul lato interno)
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 20px;
                transform-rotation: car.parked ? -90deg : parent.a + parent.yaw;
                transform-scale-x: root.k;
                transform-scale-y: root.k;
                Car {
                    x: 0px;
                    y: 0px;
                    car: car;
                    arrived: car.pit && slot.lin >= 1;
                    on-road: abs(slot.off) <= root.sw / 2;
                    phase: root.phase;
                    road: root.road;
                    // la piazzola e i meccanici dalla parte del pit
                    transform-scale-y: slot.l-side < 0 ? -1 : 1;
                }
            }
            TouchArea {
                clicked => {
                    AppState.car-tap(car.id);
                }
            }
        }
    }
    Text {
        x: 16px;
        y: 10px;
        width: root.width - 160px;
        text: root.hud;
        color: M3.on-surface-variant;
        font-weight: 700;
        font-size: 13px;
        overflow: elide;
    }
    // la minimappa serve solo da vicino
    if !root.wide: MiniMap {
        x: root.width - self.width - 12px;
        y: 10px;
        width: 120px;
        cars: root.cars;
        road: root.road;
        commands: root.commands;
        aspect: root.aspect;
    }
    // mentre studi: vista d'insieme o telecamera sulla tua macchina
    if AppState.study-state != 0: Rectangle {
        x: 12px;
        y: root.height - self.height - 12px;
        width: vt.preferred-width + 24px;
        height: 32px;
        border-radius: 16px;
        background: M3.surface-container-high;
        vt := Text {
            text: root.wide ? "Segui la tua monoposto" : "Tutto il circuito";
            color: M3.on-surface;
            font-size: Type.label;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.flip = !root.flip;
            }
        }
    }
    // giro completato: un breve lampo della strada
    lap := Rectangle {
        property <int> seen: root.flash;
        background: root.road;
        opacity: 0;
        states [
            fired when root.flash != self.seen: {
                opacity: 0.35;
                in {
                    animate opacity { duration: 120ms; }
                }
            }
        ]
    }
    Timer {
        interval: 300ms;
        running: root.flash != lap.seen;
        triggered => {
            lap.seen = root.flash;
        }
    }
    // chi è quella macchina: stato, tempi, pit stop, cosa sta studiando; «Segui» e «Profilo»
    if AppState.car-sel != "": Rectangle {
        x: 10px;
        y: root.height - self.height - 10px;
        width: root.width - 20px;
        height: card.preferred-height;
        border-radius: 20px;
        background: M3.surface-container-high;
        drop-shadow-blur: 12px;
        drop-shadow-color: #0004;
        clip: true;
        // il tocco sulla scheda non arriva alla pista sotto
        TouchArea { }
        card := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                Avatar {
                    width: 44px;
                    photo: AppState.car-info-photo;
                    has-photo: AppState.car-info-has-photo;
                    initial: AppState.car-info-initial;
                    ring: AppState.car-info-color;
                    TouchArea {
                        enabled: AppState.car-info-has-photo;
                        clicked => {
                            AppState.photo-view-img = AppState.car-info-photo;
                            AppState.photo-view-title = AppState.car-info-title;
                            AppState.photo-view-group = false;
                            AppState.photo-view = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: AppState.car-info-title;
                        font-weight: 800;
                        font-size: Type.body + 1px;
                        color: M3.on-surface;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            height: 22px;
                            border-radius: 11px;
                            background: AppState.car-info-kind == 1 ? AppState.car-info-color.with-alpha(0.22) : AppState.car-info-kind == 2 ? M3.tertiary-container : M3.surface-container-highest;
                            width: state-text.preferred-width + 16px;
                            state-text := Text {
                                text: AppState.car-info-state;
                                font-size: 11px;
                                font-weight: 700;
                                color: AppState.car-info-kind == 2 ? M3.on-tertiary-container : M3.on-surface;
                            }
                        }
                    }
                }
                IconButton {
                    icon: Icons.close;
                    clicked => {
                        AppState.car-close();
                    }
                }
            }
            // tempi di studio
            HorizontalLayout {
                spacing: 8px;
                for st[i] in [
                    { label: "Oggi", value: AppState.car-info-today },
                    { label: "Settimana", value: AppState.car-info-week },
                    { label: "Mese", value: AppState.car-info-month },
                ]: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 12px;
                    background: M3.surface-container;
                    min-height: tile.preferred-height;
                    tile := VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: st.label;
                            font-size: 11px;
                            color: M3.on-surface-variant;
                        }
                        Text {
                            text: st.value;
                            font-weight: 700;
                            font-size: Type.label;
                            color: M3.on-surface;
                            overflow: elide;
                        }
                    }
                }
            }
            for line in AppState.car-info-lines: Text {
                text: line;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            if !AppState.car-info-me: HorizontalLayout {
                spacing: 8px;
                if AppState.car-info-racing: M3Button {
                    horizontal-stretch: 1;
                    small: true;
                    kind: AppState.car-info-following ? 2 : 1;
                    text: AppState.car-info-following ? "Smetti di seguire" : "Segui";
                    clicked => {
                        AppState.car-follow(AppState.car-sel);
                    }
                }
                M3Button {
                    horizontal-stretch: 1;
                    small: true;
                    kind: 2;
                    text: "Profilo";
                    clicked => {
                        AppState.open-profile(AppState.car-sel);
                    }
                }
            }
        }
    }
}

// app da aprire (lanciatore della concentrazione): icona e nome
component AppChip inherits Rectangle {
    in property <FocusAppVM> app;
    callback clicked;
    height: 40px;
    width: chip-row.preferred-width;
    border-radius: 20px;
    background: M3.secondary-container;
    chip-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 14px;
        spacing: 8px;
        if root.app.has-icon: Image {
            y: 6px;
            width: 28px;
            height: 28px;
            source: root.app.icon;
        }
        Text {
            text: root.app.label;
            vertical-alignment: center;
            color: M3.on-secondary-container;
            font-weight: 600;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// riga di un permesso necessario alla concentrazione
component PermRow inherits Rectangle {
    in property <bool> ok;
    in property <string> title;
    in property <string> detail;
    callback grant;
    min-height: perm-row.preferred-height;
    perm-row := HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.ok ? M3.primary : transparent;
                    border-width: root.ok ? 0px : 2px;
                    border-color: M3.outline;
                    if root.ok: VIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.check;
                        tint: M3.on-primary;
                        size: 16px;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-weight: 700;
                color: M3.on-surface;
                wrap: word-wrap;
            }
            Text {
                text: root.detail;
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
        if !root.ok: M3Button {
            text: "Concedi";
            kind: 1;
            clicked => {
                root.grant();
            }
        }
    }
}

// impostazione della concentrazione: permessi, durata, app permesse, avvio
component FocusSheet inherits Rectangle {
    // campo di ricerca delle app aperto
    property <bool> app-search: false;
    background: #0007;
    TouchArea { }
    // foglio dal basso: attaccato al fondo dello schermo, arrotondato solo in alto, dello stesso
    // colore della fascia di sistema sotto (così non resta sospeso)
    Rectangle {
        y: parent.height * 0.06;
        height: parent.height * 0.94;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        background: M3.surface;
        VerticalLayout {
            padding: 16px;
            padding-bottom: 20px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: "Concentrazione";
                    font-size: Type.title;
                    font-weight: 800;
                    color: M3.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    VIcon {
                        source: Icons.close;
                        tint: M3.on-surface;
                        size: 24px;
                        x: 8px;
                        y: 8px;
                    }
                    TouchArea {
                        clicked => {
                            AppState.focus-setup(false);
                        }
                    }
                }
            }
            Text {
                text: "Per il tempo scelto il telefono resta su Tremendous e sulle app spuntate qui sotto; dopo, finché non termini la sessione (anche al pit stop). Se apri altro, torni qui con un avviso. Chiamate, numeri d'emergenza e sveglia restano sempre possibili. Il blocco non si annulla prima della scadenza.";
                font-size: Type.label;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            PermRow {
                ok: AppState.focus-usage-ok;
                title: "Accesso all'utilizzo";
                detail: "Per sapere quale app è aperta (resta sul telefono)";
                grant => {
                    AppState.focus-perm("usage");
                }
            }
            PermRow {
                ok: AppState.focus-overlay-ok;
                title: "Mostra sopra altre app";
                detail: "Per l'avviso «Rimani nell'app!» e per riportarti qui";
                grant => {
                    AppState.focus-perm("overlay");
                }
            }
            // Android blocca l'accesso all'utilizzo per le app installate da un file: i passaggi
            if AppState.focus-restricted: Rectangle {
                background: M3.secondary-container;
                border-radius: 16px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: "Prima sblocca le impostazioni con limitazioni";
                        font-weight: 700;
                        color: M3.on-secondary-container;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Android blocca l'accesso all'utilizzo per le app installate da un file APK invece che da uno store. Si sblocca una volta sola, in quest'ordine:\n1. Tocca «Prova l'interruttore» e prova ad attivare quello grigio: esce «All'app è stato negato l'accesso», tocca Chiudi. Serve: solo dopo questo tentativo Android mostra l'opzione per sbloccare.\n2. Tocca «Info app»: in alto a destra ⋮ › «Consenti impostazioni con limitazioni» (su alcuni telefoni «impostazioni limitate») e conferma.\n3. Torna qui e tocca «Concedi» su Accesso all'utilizzo: ora l'interruttore si attiva.";
                        font-size: Type.label;
                        color: M3.on-secondary-container;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "1 · Prova l'interruttore";
                            kind: 0;
                            compact: true;
                            horizontal-stretch: 1;
                            clicked => {
                                AppState.focus-perm("usage");
                            }
                        }
                        M3Button {
                            text: "2 · Info app";
                            kind: 2;
                            compact: true;
                            horizontal-stretch: 1;
                            clicked => {
                                AppState.focus-perm("appinfo");
                            }
                        }
                    }
                }
            }
            if !AppState.focus-restricted && (!AppState.focus-usage-ok || !AppState.focus-overlay-ok): HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Interruttore grigio? Provalo una volta (esce «accesso negato»), poi Info app › ⋮ › «Consenti impostazioni con limitazioni» e riprova.";
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                M3Button {
                    text: "Info app";
                    kind: 2;
                    clicked => {
                        AppState.focus-perm("appinfo");
                    }
                }
            }
            Text {
                text: "Durata del blocco";
                font-weight: 700;
                color: M3.on-surface;
            }
            // scorre col dito su schermi stretti
            Flickable {
                height: 40px;
                interactive: true;
                content-width: max(self.width, min-strip.preferred-width);
                content-height: 40px;
                min-strip := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: 40px;
                    spacing: 6px;
                    alignment: start;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    for m in [25, 50, 90, 120, 180]: Chip {
                        text: m < 120 ? m + " min" : (m / 60) + " ore";
                        selected: AppState.focus-minutes == m;
                        clicked => {
                            AppState.focus-set-minutes(m);
                        }
                    }
                }
            }
            HorizontalLayout {
                Text {
                    text: "App permesse durante lo studio";
                    font-weight: 700;
                    color: M3.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: root.app-search ? Icons.close : Icons.search;
                    clicked => {
                        root.app-search = !root.app-search;
                        if !root.app-search {
                            AppState.focus-search("");
                        }
                    }
                }
            }
            if root.app-search: LineEdit {
                placeholder-text: "Cerca un'app per nome";
                edited(t) => {
                    AppState.focus-search(t);
                }
            }
            Flickable {
                vertical-stretch: 1;
                interactive: true;
                content-height: app-list.preferred-height;
                app-list := VerticalLayout {
                    y: 0px;
                    width: parent.width;
                    spacing: 2px;
                    for a in AppState.focus-apps: Rectangle {
                        height: 48px;
                        border-radius: 12px;
                        background: a.allowed ? M3.secondary-container : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 12px;
                            spacing: 12px;
                            Rectangle {
                                width: 32px;
                                if a.has-icon: Image {
                                    y: 8px;
                                    width: 32px;
                                    height: 32px;
                                    source: a.icon;
                                }
                            }
                            Text {
                                text: a.label;
                                vertical-alignment: center;
                                color: M3.on-surface;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 22px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 6px;
                                        border-width: a.allowed ? 0px : 2px;
                                        border-color: M3.outline;
                                        background: a.allowed ? M3.primary : transparent;
                                        if a.allowed: VIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: Icons.check;
                                            tint: M3.on-primary;
                                            size: 16px;
                                        }
                                    }
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                AppState.focus-toggle(a.pkg);
                            }
                        }
                    }
                }
            }
            M3Button {
                text: AppState.focus-confirm ? AppState.focus-confirm-text : "Avvia concentrazione e sessione";
                enabled: AppState.focus-usage-ok && AppState.focus-overlay-ok;
                clicked => {
                    AppState.focus-start();
                }
            }
        }
    }
}

// mappa di calore di un mese: calendario a settimane (dal lunedì) con le frecce per i mesi
// precedenti; tocco su un giorno = dettagli
component Heatmap inherits VerticalLayout {
    in property <[HeatVM]> cells;
    in property <string> title;
    in property <bool> can-prev;
    in property <bool> can-next;
    callback shift(int);
    property <string> sel;
    property <length> gap: 4px;
    spacing: 6px;
    HorizontalLayout {
        alignment: space-between;
        IconButton {
            icon: Icons.chevron-left;
            tint: root.can-prev ? M3.on-surface : M3.on-surface.with-alpha(0.25);
            clicked => {
                if root.can-prev {
                    root.sel = "";
                    root.shift(1);
                }
            }
        }
        Text {
            text: root.title;
            font-weight: 700;
            color: M3.on-surface;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        IconButton {
            icon: Icons.chevron;
            tint: root.can-next ? M3.on-surface : M3.on-surface.with-alpha(0.25);
            clicked => {
                if root.can-next {
                    root.sel = "";
                    root.shift(-1);
                }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.gap;
        for l in ["L", "M", "M", "G", "V", "S", "D"]: Text {
            preferred-width: 40px;
            min-width: 20px;
            text: l;
            font-size: 10px;
            color: M3.on-surface-variant;
            horizontal-alignment: center;
        }
    }
    for w in root.cells.length / 7: HorizontalLayout {
        alignment: center;
        spacing: root.gap;
        for d in 7: Rectangle {
            property <HeatVM> c: root.cells[w * 7 + d];
            preferred-width: 40px;
            min-width: 20px;
            height: self.width;
            border-radius: 6px;
            background: c.level < 0 ? (c.level == -2 ? M3.surface-container : transparent) : c.level == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * c.level / 4);
            border-width: root.sel == c.label && c.level >= 0 ? 2px : 0;
            border-color: M3.on-surface;
            Text {
                text: c.day;
                font-size: 10px;
                color: c.level >= 3 ? M3.on-primary : c.level == -2 ? M3.on-surface-variant.with-alpha(0.5) : M3.on-surface-variant;
            }
            TouchArea {
                enabled: c.level >= 0;
                clicked => {
                    root.sel = root.sel == c.label ? "" : c.label;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.sel != "" ? root.sel : "Tocca un giorno per i dettagli";
            font-size: Type.label;
            color: M3.on-surface-variant;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: "meno";
            font-size: 10px;
            color: M3.on-surface-variant;
            vertical-alignment: center;
        }
        for k in 5: Rectangle {
            width: 10px;
            height: 10px;
            y: 3px;
            border-radius: 2px;
            background: k == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * k / 4);
        }
        Text {
            text: "più";
            font-size: 10px;
            color: M3.on-surface-variant;
            vertical-alignment: center;
        }
    }
}

// selettore a pillole affiancate (una sola scelta), compatto
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> index;
    callback picked(int);
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: M3.outline;
    clip: true;
    HorizontalLayout {
        for l[i] in root.labels: Rectangle {
            background: i == root.index ? M3.secondary-container : transparent;
            min-width: t.preferred-width + 24px;
            t := Text {
                text: l;
                font-size: Type.label;
                font-weight: i == root.index ? 700 : 500;
                color: i == root.index ? M3.on-secondary-container : M3.on-surface-variant;
            }
            TouchArea {
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// codice del gruppo che si copia con un tocco (negli appunti) — comodo dal telefono
component CodeCopy inherits Rectangle {
    in property <string> code;
    in property <length> code-size: Type.body;
    // con il pulsante «Copia» sotto il codice (scheda dell'invito), o solo il codice toccabile
    in property <bool> button: false;
    min-height: lay.preferred-height;
    buf := TextInput {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        text: root.code;
        read-only: true;
        enabled: false;
        opacity: 0;
    }
    function copy() {
        buf.select-all();
        buf.copy();
        buf.clear-selection();
        AppState.notify("Codice copiato: incollalo a chi vuoi invitare");
    }
    lay := VerticalLayout {
        spacing: 8px;
        Rectangle {
            border-radius: 8px;
            background: ta.pressed ? M3.primary.with-alpha(0.12) : transparent;
            min-height: code-text.preferred-height + 4px;
            code-text := Text {
                x: 0px;
                width: parent.width;
                text: root.code;
                font-size: root.code-size;
                font-weight: 700;
                color: M3.primary;
                wrap: word-wrap;
            }
            ta := TouchArea {
                clicked => {
                    root.copy();
                }
            }
        }
        if !root.button: Text {
            text: "Tocca il codice per copiarlo";
            font-size: 11px;
            color: M3.on-surface-variant;
        }
    }
}

// matitina tonda per modificare (nome, foto)
component EditBadge inherits Rectangle {
    callback clicked;
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.pressed ? M3.secondary-container.darker(0.1) : M3.secondary-container;
    border-width: 2px;
    border-color: M3.surface-container-low;
    VIcon {
        x: (parent.width - root.size * 0.54) / 2;
        y: (parent.height - root.size * 0.54) / 2;
        width: root.size * 0.54;
        height: root.size * 0.54;
        source: Icons.edit;
        tint: M3.on-secondary-container;
        size: root.size * 0.54;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Paddock flottante (Traguardo): chi non è in gara ha un posto fisso qui, a cavallo del bordo
// basso della finestra della gara; i posti crescono e calano con le persone fuori gara.
component Paddock inherits Rectangle {
    in property <[CarVM]> cars;
    in property <length> max-w: 360px;
    // quante monoposto si vedono; le altre diventano «+N»
    property <int> shown: min(root.cars.length, 6);
    height: 48px;
    width: min(pl.preferred-width, root.max-w);
    border-radius: 24px;
    background: M3.surface-container-low;
    border-width: 1px;
    border-color: M3.outline-variant;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #0000001f;
    clip: true;
    pl := HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: "Paddock";
                font-size: 14px;
                font-weight: 700;
                color: M3.on-surface;
            }
            Text {
                text: root.cars.length == 1 ? "1 fuori gara" : root.cars.length + " fuori gara";
                font-size: 11px;
                color: M3.on-surface-variant;
            }
        }
        // cerchi sovrapposti, uno per persona, nel colore della sua monoposto
        Rectangle {
            width: root.shown * 26px + 10px;
            for c[i] in root.cars: Rectangle {
                visible: i < root.shown;
                x: i * 26px;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: M3.surface-container-low;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: c.color.with-alpha(0.22);
                    border-width: 2px;
                    border-color: c.color;
                    Car {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        car: c;
                        road: M3.surface-container-highest;
                        phase: 0;
                        transform-scale-x: 0.55;
                        transform-scale-y: 0.55;
                    }
                }
                TouchArea {
                    clicked => {
                        AppState.car-tap(c.id);
                    }
                }
            }
        }
        if root.cars.length > root.shown: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: M3.secondary-container;
                Text {
                    text: "+" + (root.cars.length - root.shown);
                    font-size: 13px;
                    font-weight: 700;
                    color: M3.on-secondary-container;
                }
            }
        }
    }
}

export component GroupPage inherits Page {
    property <bool> rename-open: false;
    property <bool> groups-open: false;
    property <bool> cal-open: false;
    property <bool> has-group: AppState.group-has && AppState.group-code != "";
    // calendario mostrato: quello del gruppo, di un altro membro, o il proprio
    property <bool> cal-group: has-group && AppState.cal-ids[AppState.cal-index] == "*";
    property <bool> cal-member: has-group && AppState.cal-ids[AppState.cal-index] != "" && !cal-group;
    VerticalLayout {
        // Traguardo: foto e nome del gruppo come testata (senza gruppo: «Squadra»), calendario e invito
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 6px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 12px;
            if AppState.group-has: Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 18px;
                clip: true;
                background: M3.primary-container;
                if AppState.group-has-photo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: AppState.group-photo;
                    image-fit: cover;
                }
                if !AppState.group-has-photo && AppState.group-initial == "": Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: Icons.groups;
                    tint: M3.on-primary-container;
                    width: 28px;
                    height: 28px;
                }
                if !AppState.group-has-photo && AppState.group-initial != "": Text {
                    text: AppState.group-initial;
                    font-size: 24px;
                    font-weight: 900;
                    color: M3.on-primary-container;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 2px;
                    Text {
                        text: AppState.group-has && AppState.group-name != "" ? AppState.group-name : "Squadra";
                        font-size: 26px;
                        font-weight: 900;
                        color: M3.on-surface;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    // più gruppi: si sceglie quello attivo
                    if AppState.groups.length > 1: Rectangle {
                        width: 32px;
                        Icon {
                            x: 4px;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            source: Icons.chevron;
                            tint: M3.on-surface-variant;
                            transform-rotation: root.groups-open ? -90deg : 90deg;
                        }
                        TouchArea {
                            clicked => {
                                root.groups-open = !root.groups-open;
                            }
                        }
                    }
                }
                if !AppState.group-has: Text {
                    text: "Studia insieme ad altri, ognuno dal suo dispositivo";
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.calendar-month;
                    tint: root.cal-open ? M3.primary : M3.on-surface;
                    clicked => {
                        root.cal-open = !root.cal-open;
                    }
                }
            }
            if has-group: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.share;
                    tint: M3.on-surface;
                    clicked => {
                        share-buf.select-all();
                        share-buf.copy();
                        share-buf.clear-selection();
                        AppState.notify("Codice del gruppo copiato: incollalo a chi vuoi invitare");
                    }
                }
            }
        }
        share-buf := TextInput {
            width: 0px;
            height: 0px;
            text: AppState.group-code;
            read-only: true;
            enabled: false;
            opacity: 0;
        }

        // la gara: riquadro grande con titolo, stato e il paddock flottante sul bordo basso
        Rectangle {
            height: min(400px, parent.height * 0.52) + (AppState.paddock-n > 0 ? 28px : 0px);
            race-box := Rectangle {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height - (AppState.paddock-n > 0 ? 28px : 0px);
                border-radius: 32px;
                clip: true;
                background: M3.surface-container;
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        padding-top: 14px;
                        padding-bottom: 2px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: has-group ? "Gara di oggi" : "La tua gara";
                                font-size: 18px;
                                font-weight: 800;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: AppState.race-hud;
                                font-size: 13px;
                                color: M3.on-surface-variant;
                                overflow: elide;
                            }
                        }
                        if AppState.race-live: VerticalLayout {
                            alignment: start;
                            Rectangle {
                                height: 26px;
                                width: 66px;
                                border-radius: 13px;
                                background: M3.error;
                                live-row := HorizontalLayout {
                                    spacing: 5px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: M3.on-error;
                                        }
                                    }
                                    Text {
                                        text: "LIVE";
                                        font-size: 12px;
                                        font-weight: 900;
                                        color: M3.on-error;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    RaceView {
                        vertical-stretch: 1;
                        cars: AppState.cars;
                        cam-f: AppState.cam-f;
                        cam-side: AppState.cam-side;
                        cam-stack: AppState.cam-stack;
                        cam-run: AppState.cam-run;
                        lap-v: AppState.lap-speed;
                        cam-pit: AppState.study-state == 2;
                        cam-v: AppState.study-state == 1 ? AppState.lap-speed : 0;
                        overview: AppState.race-overview;
                        commands: AppState.track-cmd;
                        aspect: AppState.track-aspect;
                        scale: AppState.track-scale;
                        pad-x: AppState.pad-x;
                        pad-y: AppState.pad-y;
                        pad-w: AppState.pad-w;
                        hud: "";
                        flash: AppState.lap-flash;
                    }
                }
            }
            if AppState.paddock-n > 0: Paddock {
                cars: AppState.paddock-cars;
                max-w: parent.width - 32px;
                x: (parent.width - self.width) / 2;
                y: race-box.height - 28px;
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 12px;

            // Traguardo: concentrazione in corso. La finestra della gara qui sopra segue la propria
            // monoposto (scia blu); qui il tempo che manca e chi ti precede.
            if AppState.focus-active: Rectangle {
                border-radius: 28px;
                background: M3.primary-container;
                min-height: fcol.preferred-height;
                fcol := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 16px;
                        Rectangle {
                            width: 132px;
                            height: 132px;
                            RingProgress {
                                width: 132px;
                                height: 132px;
                                value: AppState.focus-left != "" ? AppState.focus-left-frac : 1;
                                thickness: 12px;
                                fill: M3.primary;
                                track: M3.primary.with-alpha(0.18);
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: AppState.focus-left != "" ? AppState.focus-left : "∞";
                                    font-size: 32px;
                                    font-weight: 900;
                                    color: M3.on-primary-container;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: AppState.focus-left != "" ? "rimasti" : "fino a «Termina»";
                                    font-size: 12px;
                                    color: M3.on-primary-container;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: "×1,5";
                                font-size: 28px;
                                font-weight: 900;
                                color: M3.primary;
                            }
                            Text {
                                text: "Concentrazione · scia blu";
                                font-size: 15px;
                                font-weight: 700;
                                color: M3.on-primary-container;
                                wrap: word-wrap;
                            }
                            Text {
                                text: AppState.ahead-text != "" ? AppState.ahead-text : "Le altre app sono bloccate fino alla fine";
                                font-size: 13px;
                                color: M3.on-primary-container;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // app permesse: si aprono da qui
                    Flickable {
                        height: 40px;
                        interactive: true;
                        content-width: max(self.width, flaunch.preferred-width);
                        content-height: 40px;
                        flaunch := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            height: 40px;
                            spacing: 8px;
                            alignment: start;
                            for a in AppState.focus-launcher: AppChip {
                                app: a;
                                clicked => {
                                    AppState.focus-launch(a.pkg);
                                }
                            }
                            Chip {
                                text: "Telefono";
                                clicked => {
                                    AppState.focus-dial();
                                }
                            }
                        }
                    }
                    Text {
                        text: "Se esci prima del tempo il bonus resta sospeso: bandiera gialla in pista.";
                        font-size: 12px;
                        color: M3.on-primary-container.with-alpha(0.8);
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        if AppState.study-state == 1: Rectangle {
                            horizontal-stretch: 1;
                            height: 52px;
                            border-top-left-radius: 26px;
                            border-bottom-left-radius: 26px;
                            border-top-right-radius: 8px;
                            border-bottom-right-radius: 8px;
                            background: M3.surface;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                VIcon {
                                    source: Icons.pause;
                                    tint: M3.on-surface;
                                    size: 20px;
                                }
                                Text {
                                    text: "Pit stop";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    AppState.study-pause();
                                }
                            }
                        }
                        if AppState.study-state != 1: Rectangle {
                            horizontal-stretch: 1;
                            height: 52px;
                            border-top-left-radius: 26px;
                            border-bottom-left-radius: 26px;
                            border-top-right-radius: 8px;
                            border-bottom-right-radius: 8px;
                            background: M3.primary;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                VIcon {
                                    source: Icons.play;
                                    tint: M3.on-primary;
                                    size: 20px;
                                }
                                Text {
                                    text: "Riparti";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: M3.on-primary;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    AppState.study-start();
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 52px;
                            border-top-left-radius: 8px;
                            border-bottom-left-radius: 8px;
                            border-top-right-radius: 26px;
                            border-bottom-right-radius: 26px;
                            background: M3.error-container;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                VIcon {
                                    source: Icons.close;
                                    tint: M3.on-error-container;
                                    size: 20px;
                                }
                                Text {
                                    text: "Termina";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: M3.on-error-container;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    AppState.study-stop();
                                }
                            }
                        }
                    }
                }
            }


            // più gruppi: si sceglie quello attivo (dalla freccia accanto al nome)
            if AppState.groups.length > 1 && root.groups-open: Flickable {
                height: 40px;
                interactive: true;
                content-width: max(self.width, gstrip.preferred-width);
                content-height: 40px;
                gstrip := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: 40px;
                    spacing: 8px;
                    alignment: start;
                    for g in AppState.groups: Chip {
                        text: g.name;
                        selected: g.active;
                        clicked => {
                            AppState.group-select(g.id);
                        }
                    }
                }
            }

            // legenda degli effetti in pista
            if has-group: Flickable {
                height: 34px;
                interactive: true;
                content-width: max(self.width, legend.preferred-width);
                content-height: 34px;
                legend := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: 34px;
                    spacing: 6px;
                    alignment: start;
                    for l in [
                        { c: #4F8DF5, t: "scia blu · concentrazione ×1,5" },
                        { c: #F2853A, t: "fiamme · ritmo fino a ×3" },
                        { c: #F2C94C, t: "scintille · gomme nuove ×1,2" },
                        { c: #9E9E9E, t: "vento · altri in pista +0,1" },
                        { c: #6D6D6D, t: "fumo · troppe pause ×0,8" },
                    ]: Rectangle {
                        height: 34px;
                        width: lg.preferred-width + 24px;
                        border-radius: 17px;
                        background: M3.surface-container-high;
                        lg := HorizontalLayout {
                            x: 12px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: l.c;
                                }
                            }
                            Text {
                                text: l.t;
                                font-size: 12px;
                                color: M3.on-surface;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            // classifica
            if has-group: Text {
                text: "Classifica";
                font-size: 15px;
                font-weight: 800;
                color: M3.primary;
            }
            if has-group: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for p[i] in ["Oggi", "Settimana", "Mese", "Totale"]: Chip {
                    text: p;
                    selected: AppState.group-period == i;
                    clicked => {
                        AppState.group-period = i;
                        AppState.group-set-period(i);
                    }
                }
            }
            if has-group: VerticalLayout {
                spacing: 3px;
                for r[ri] in AppState.ranking: Rectangle {
                    border-top-left-radius: ri == 0 ? 24px : 6px;
                    border-top-right-radius: ri == 0 ? 24px : 6px;
                    border-bottom-left-radius: ri == AppState.ranking.length - 1 ? 24px : 6px;
                    border-bottom-right-radius: ri == AppState.ranking.length - 1 ? 24px : 6px;
                    background: r.me ? M3.secondary-container : M3.surface-container;
                    min-height: 64px;
                    TouchArea {
                        clicked => {
                            AppState.member-sel = AppState.member-sel == r.id ? "" : r.id;
                        }
                    }
                    VerticalLayout {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        min-height: 64px;
                        spacing: 12px;
                        Text {
                            text: r.pos;
                            font-weight: 900;
                            font-size: 18px;
                            color: r.pos == 1 ? #c79100 : M3.on-surface-variant;
                            vertical-alignment: center;
                            min-width: 18px;
                        }
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                width: 40px;
                                photo: r.photo;
                                has-photo: r.has-photo;
                                initial: r.initial;
                                ring: r.color;
                                TouchArea {
                                    enabled: r.has-photo;
                                    clicked => {
                                        AppState.photo-view-img = r.photo;
                                        AppState.photo-view-title = r.name;
                                        AppState.photo-view-group = false;
                                        AppState.photo-view = true;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: r.name;
                                font-size: 16px;
                                color: M3.on-surface;
                                overflow: elide;
                            }
                            // si accorcia con «…» invece di spingere i punti fuori dallo schermo
                            Text {
                                text: r.status + " · " + r.time + (r.admin ? " · admin" : "");
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Text {
                                text: r.value;
                                font-size: 18px;
                                font-weight: 900;
                                color: M3.on-surface;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                            }
                            if r.boost != "": Text {
                                text: r.boost;
                                font-size: Type.label;
                                font-weight: 800;
                                color: r.color;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    // azioni sul membro toccato
                    if AppState.member-sel == r.id: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        alignment: end;
                        M3Button {
                            text: "Profilo";
                            clicked => {
                                AppState.open-profile(r.id);
                            }
                        }
                        // la telecamera segue la sua monoposto (finché è in pista)
                        if !r.me && r.racing: M3Button {
                            text: "Segui";
                            kind: 1;
                            clicked => {
                                AppState.show-in-circuit(r.id);
                            }
                        }
                        if !r.me: M3Button {
                            text: "Avvisa";
                            kind: 1;
                            clicked => {
                                AppState.group-ping(r.id);
                            }
                        }
                        if AppState.group-admin && !r.admin && !r.me: M3Button {
                            text: "Rimuovi";
                            kind: 3;
                            clicked => {
                                AppState.group-kick(r.id);
                            }
                        }
                    }
                    }
                }
            }

            // cronometro personale (con la concentrazione attiva i comandi stanno nel riquadro in alto)
            if !AppState.focus-active: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: AppState.study-elsewhere ? "Stai studiando su un altro dispositivo" : AppState.study-state == 1 ? "Stai studiando" : AppState.study-state == 2 ? "Pit stop" : "Pronto a partire";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Text {
                        text: AppState.study-today;
                        color: M3.on-surface-variant;
                    }
                    LinearProgress {
                        value: AppState.study-lap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if AppState.study-state != 1: M3Button {
                            horizontal-stretch: 1;
                            enabled: !AppState.study-elsewhere;
                            text: AppState.study-elsewhere ? "Sessione aperta altrove" : AppState.study-state == 2 ? "Riparti" : "Inizia a studiare";
                            has-icon: true;
                            icon: Icons.play;
                            clicked => {
                                AppState.study-start();
                            }
                        }
                        if AppState.study-state == 1: M3Button {
                            horizontal-stretch: 1;
                            text: "Pit stop (pausa)";
                            kind: 1;
                            has-icon: true;
                            icon: Icons.pause;
                            clicked => {
                                AppState.study-pause();
                            }
                        }
                        if AppState.study-state != 0: M3Button {
                            text: "Termina";
                            kind: 3;
                            clicked => {
                                AppState.study-stop();
                            }
                        }
                    }
                    // concentrazione (Android): impostazione, poi stato e lanciatore delle app permesse
                    if AppState.focus-available && !AppState.focus-active: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Concentrazione: il telefono resta su Tremendous e sulle app che scegli, per il tempo che decidi";
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Type.label;
                            color: M3.on-surface;
                        }
                        M3Button {
                            text: "Imposta";
                            kind: 2;
                            clicked => {
                                AppState.focus-setup(true);
                            }
                        }
                    }
                }
            }

            // intestazione del gruppo: foto, nome, codice, amministratore
            if AppState.group-has && AppState.group-code != "": Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 56px;
                            height: 60px;
                            Avatar {
                                x: 0;
                                y: 0;
                                width: 56px;
                                photo: AppState.group-photo;
                                has-photo: AppState.group-has-photo;
                                initial: AppState.group-initial;
                                ring: M3.primary;
                                // tocco: la foto ingrandita
                                TouchArea {
                                    enabled: AppState.group-has-photo;
                                    clicked => {
                                        AppState.photo-view-img = AppState.group-photo;
                                        AppState.photo-view-title = AppState.group-name;
                                        AppState.photo-view-group = true;
                                        AppState.photo-view = true;
                                    }
                                }
                            }
                            if AppState.group-admin: EditBadge {
                                // in basso a destra, sul fondo del cerchio dell'avatar
                                size: 24px;
                                x: 32px;
                                y: 36px;
                                clicked => {
                                    AppState.pick-photo("group");
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: AppState.group-name;
                                    font-size: Type.title;
                                    font-weight: 800;
                                    color: M3.on-surface;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                if AppState.group-can-rename && !rename-open: VerticalLayout {
                                    alignment: center;
                                    EditBadge {
                                        clicked => {
                                            rename-open = true;
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            CodeCopy {
                                code: AppState.group-code;
                                code-size: Type.label + 1px;
                            }
                            Text {
                                text: AppState.group-admin-name == "" ? "Nessun amministratore noto" : "Amministratore: " + AppState.group-admin-name;
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                            }
                        }
                    }
                    Text {
                        text: AppState.group-info;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    Hint {
                        short: "Come si fanno i punti";
                        full: "La classifica è per punti: ogni secondo di studio vale punti × il moltiplicatore (al massimo ×5), che è anche la velocità della monoposto (un giro = 60 punti). Ritmo: +0,25 ogni 25 minuti di studio senza pause lunghe, fino a ×3 (fiamma). Pit stop fino a 10 minuti dopo almeno 25 di studio: gomme nuove ×1,2 per 25 minuti (scintille); pausa tra 10 e 30 minuti: il ritmo si dimezza; oltre 30 minuti o «Termina»: riparte da ×1. Più di 2 pause in 30 minuti: ×0,8 per 15 minuti (fumo). Concentrazione attiva: ×1,5 (scia blu). Altri in pista con te: +0,1 ciascuno, fino a ×1,4 (vento). Oltre 10 ore al giorno resta ×1. Tocca una monoposto o un membro per i dettagli.";
                    }
                    if rename-open: HorizontalLayout {
                        spacing: 8px;
                        rename-edit := LineEdit {
                            horizontal-stretch: 1;
                            text: AppState.group-name;
                            placeholder-text: "Nuovo nome del gruppo";
                            accepted => {
                                AppState.group-rename(self.text);
                                rename-open = false;
                            }
                        }
                        M3Button {
                            text: "Salva";
                            kind: 1;
                            clicked => {
                                AppState.group-rename(rename-edit.text);
                                rename-open = false;
                            }
                        }
                        IconButton {
                            icon: Icons.close;
                            clicked => {
                                rename-open = false;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        M3Button {
                            text: "Avvisa tutti";
                            kind: 1;
                            small: true;
                            clicked => {
                                AppState.group-ping("");
                            }
                        }
                    }
                }
            }

            // invito
            if AppState.group-has && AppState.group-code != "": Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Invita con il codice";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    Hint {
                        short: "Manda il codice a chi vuoi invitare.";
                        full: "Manda il codice a chi vuoi invitare: lo scrive in «Entra con un codice» (nell'app o nella web app). Il gruppo è privato: lo vede solo chi ha il codice.";
                    }
                    CodeCopy {
                        code: AppState.group-code;
                        code-size: 20px;
                    }
                    M3Button {
                        text: "Condividi codice";
                        has-icon: true;
                        icon: Icons.add;
                        clicked => {
                            AppState.group-invite();
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        M3Button {
                            text: "Esci dal gruppo";
                            kind: 3;
                            clicked => {
                                AppState.group-leave(AppState.group-id);
                            }
                        }
                    }
                }
            }

            // crea o entra in un gruppo
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: AppState.group-has ? "Un altro gruppo" : "Crea un gruppo";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        new-name := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-new-name;
                            placeholder-text: "Nome del gruppo (es. Anatomia 2026)";
                        }
                        M3Button {
                            text: "Crea";
                            kind: 1;
                            clicked => {
                                AppState.group-create(new-name.text);
                                AppState.group-new-name = "";
                            }
                        }
                    }
                    Text {
                        text: "Entra con un codice";
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        join := LineEdit {
                            horizontal-stretch: 1;
                            text <=> AppState.group-join-text;
                            placeholder-text: "Codice del gruppo (es. K7QM-4TZP-9WXR-2HDA)";
                            accepted => {
                                AppState.group-join(self.text);
                            }
                        }
                        M3Button {
                            text: "Entra";
                            kind: 1;
                            clicked => {
                                AppState.group-join(join.text);
                            }
                        }
                    }
                }
            }
        }
    }
    if AppState.focus-open: FocusSheet {
        width: 100%;
        height: 100%;
    }

    // profilo di un membro: studio, mappa di calore, numeri dell'esame
    if AppState.profile-open: Rectangle {
        background: M3.scrim.with-alpha(0.5);
        TouchArea {
            clicked => {
                AppState.open-profile("");
            }
        }
        Rectangle {
            x: 12px;
            y: max(12px, root.height - self.height - 12px);
            width: root.width - 24px;
            height: min(root.height - 24px, pl.preferred-height);
            border-radius: 24px;
            background: M3.surface-container-high;
            clip: true;
            TouchArea { }
            Flickable {
                content-height: pl.preferred-height;
                pl := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Avatar {
                            width: 56px;
                            photo: AppState.profile-photo;
                            has-photo: AppState.profile-has-photo;
                            initial: AppState.profile-initial;
                            ring: AppState.profile-color;
                            TouchArea {
                                enabled: AppState.profile-has-photo;
                                clicked => {
                                    AppState.photo-view-img = AppState.profile-photo;
                                    AppState.photo-view-title = AppState.profile-name;
                                    AppState.photo-view-group = false;
                                    AppState.photo-view = true;
                                }
                            }
                        }
                        Text {
                            text: AppState.profile-name;
                            font-size: Type.title;
                            font-weight: 800;
                            color: M3.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        IconButton {
                            icon: Icons.close;
                            clicked => {
                                AppState.open-profile("");
                            }
                        }
                    }
                    for line[k] in AppState.profile-lines: Text {
                        text: line;
                        wrap: word-wrap;
                        font-size: k < 2 ? Type.body : Type.label;
                        font-weight: k == 0 ? 700 : 400;
                        color: k < 2 ? M3.on-surface : M3.on-surface-variant;
                    }
                    if AppState.profile-heat.length > 0: Heatmap {
                        cells: AppState.profile-heat;
                        title: AppState.profile-heat-title;
                        can-prev: AppState.profile-heat-prev;
                        can-next: AppState.profile-heat-next;
                        shift(d) => {
                            AppState.heat-shift(2, d);
                        }
                    }
                    if AppState.profile-racing: M3Button {
                        text: "Mostra nel circuito";
                        clicked => {
                            AppState.show-in-circuit(AppState.profile-id);
                        }
                    }
                }
            }
        }
    }

    // foto ingrandita (del gruppo o di un membro)
    if AppState.photo-view: Rectangle {
        background: M3.scrim.with-alpha(0.75);
        TouchArea {
            clicked => {
                AppState.photo-view = false;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - 48px, root.height - 200px, 360px);
                    height: self.width;
                    border-radius: 24px;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: AppState.photo-view-img;
                        image-fit: cover;
                    }
                }
            }
            Text {
                text: AppState.photo-view-title;
                horizontal-alignment: center;
                font-size: Type.title;
                font-weight: 700;
                color: white;
            }
            if AppState.photo-view-group && AppState.group-admin: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                M3Button {
                    text: "Cambia foto";
                    clicked => {
                        AppState.photo-view = false;
                        AppState.pick-photo("group");
                    }
                }
                M3Button {
                    text: "Togli foto";
                    kind: 1;
                    clicked => {
                        AppState.photo-view = false;
                        AppState.remove-photo("group");
                    }
                }
            }
        }
    }

    // Traguardo: «Calendario» a tutta pagina, dall'icona in alto
    if root.cal-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: M3.surface;
        TouchArea { }
        VerticalLayout {
            BigHeader {
                title: "Calendario";
                subtitle: has-group ? "Tu, i membri e il gruppo in un'unica vista" : "I tuoi giorni di studio";
                back => {
                    root.cal-open = false;
                }
            }
            Scroller {
                vertical-stretch: 1;
                align: start;
                pad: 16px;
                pad-top: 4px;
                gap: 12px;
                    // calendario: il proprio, di un altro membro o di tutto il gruppo
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                // di chi è il calendario: tu, uno degli altri membri o tutto il gruppo
                                if has-group: Flickable {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    interactive: true;
                                    content-width: who.preferred-width;
                                    content-height: 34px;
                                    who := Segmented {
                                        x: 0px;
                                        y: 0px;
                                        labels: AppState.cal-labels;
                                        index: AppState.cal-index;
                                        picked(i) => {
                                            AppState.cal-pick(i);
                                        }
                                    }
                                }
                                if !has-group: Text {
                                    text: "I tuoi giorni di studio";
                                    font-size: Type.title;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                }
                                if !has-group: Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if has-group && cal-group: HorizontalLayout {
                                alignment: end;
                                Segmented {
                                    labels: ["Settimana", "Mese"];
                                    index: AppState.gcal-month ? 1 : 0;
                                    picked(i) => {
                                        AppState.gcal-mode(i == 1);
                                    }
                                }
                            }
                            // di un altro membro: le sue ultime 12 settimane, mese per mese
                            if cal-member: VerticalLayout {
                                spacing: 8px;
                                if AppState.member-heat.length == 0: Text {
                                    text: "Nessun dato di studio ricevuto finora da questo membro.";
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                                if AppState.member-heat.length > 0: Heatmap {
                                    cells: AppState.member-heat;
                                    title: AppState.member-heat-title;
                                    can-prev: AppState.member-heat-prev;
                                    can-next: AppState.member-heat-next;
                                    shift(d) => {
                                        AppState.heat-shift(1, d);
                                    }
                                }
                            }
                            // il proprio: mese per mese
                            if !cal-group && !cal-member: VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: AppState.my-heat-total;
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                                Heatmap {
                                    cells: AppState.my-heat;
                                    title: AppState.my-heat-title;
                                    can-prev: AppState.my-heat-prev;
                                    can-next: AppState.my-heat-next;
                                    shift(d) => {
                                        AppState.heat-shift(0, d);
                                    }
                                }
                            }
                            // del gruppo: settimana o mese, tocco su un giorno = chi ha studiato
                            if has-group && cal-group: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    IconButton {
                                        icon: Icons.chevron-left;
                                        enabled: AppState.gcal-can-prev;
                                        clicked => {
                                            AppState.gcal-shift(-1);
                                        }
                                    }
                                    Text {
                                        text: AppState.gcal-title;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-weight: 700;
                                        color: M3.on-surface;
                                    }
                                    IconButton {
                                        icon: Icons.chevron;
                                        enabled: AppState.gcal-can-next;
                                        clicked => {
                                            AppState.gcal-shift(1);
                                        }
                                    }
                                }
                                cal := Rectangle {
                                    property <length> gap: 4px;
                                    property <length> cw: (self.width - 6 * self.gap) / 7;
                                    height: 18px + ceil(AppState.gcal-cells.length / 7) * (self.cw + self.gap);
                                    for l[k] in ["L", "M", "M", "G", "V", "S", "D"]: Text {
                                        x: k * (cal.cw + cal.gap);
                                        y: 0;
                                        width: cal.cw;
                                        text: l;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        color: M3.on-surface-variant;
                                    }
                                    for c[k] in AppState.gcal-cells: Rectangle {
                                        x: mod(k, 7) * (cal.cw + cal.gap);
                                        y: 18px + floor(k / 7) * (cal.cw + cal.gap);
                                        width: cal.cw;
                                        height: AppState.gcal-month ? cal.cw : cal.cw;
                                        border-radius: 8px;
                                        background: c.level < 0 ? transparent : c.level == 0 ? M3.surface-container-highest : M3.primary.with-alpha(0.15 + 0.85 * c.level / 4);
                                        border-width: c.sel ? 2px : c.today ? 1px : 0;
                                        border-color: c.sel ? M3.on-surface : M3.primary;
                                        Text {
                                            text: c.day;
                                            font-size: 12px;
                                            font-weight: c.today ? 800 : 400;
                                            color: c.level < 0 ? M3.outline-variant : c.level >= 3 ? M3.on-primary : M3.on-surface;
                                        }
                                        TouchArea {
                                            enabled: c.idx >= 0;
                                            clicked => {
                                                AppState.gcal-select(c.idx);
                                            }
                                        }
                                    }
                                }
                                for line[k] in AppState.gcal-lines: Text {
                                    text: line;
                                    wrap: word-wrap;
                                    font-size: k == 0 ? Type.body : Type.label;
                                    font-weight: k == 0 ? 700 : 400;
                                    color: k == 0 ? M3.on-surface : M3.on-surface-variant;
                                }
                                if AppState.gcal-lines.length == 0: Text {
                                    text: "Tocca un giorno: chi ha studiato, quanto e su cosa.";
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                }
                            }
                        }
                    }
            }
        }
    }
}
