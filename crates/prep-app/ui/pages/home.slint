import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "../state.slint";
import { Avatar } from "group.slint";
import { SubjectIcon, Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller, OutlinedField } from "../components.slint";

// riga della lista «da fare» in Oggi: simbolo in un riquadro tonale, titolo e dettaglio
component NextRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> sub;
    callback clicked;
    height: nr.preferred-height;
    background: nta.pressed ? M3.on-surface.with-alpha(0.06) : transparent;
    nr := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            background: M3.primary-container;
            Icon {
                x: 8px;
                y: 8px;
                width: 24px;
                height: 24px;
                source: root.icon;
                tint: M3.on-primary-container;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 15px;
                color: M3.on-surface;
                overflow: elide;
            }
            Text {
                text: root.sub;
                font-size: Type.label;
                color: M3.on-surface-variant;
                overflow: elide;
            }
        }
    }
    nta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// riquadro piccolo con un numero (Oggi: gara, simulazioni)
component MiniStat inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> sub;
    callback clicked;
    border-radius: 24px;
    background: msta.pressed ? M3.surface-container-high : M3.surface-container;
    height: ms.preferred-height;
    min-width: 120px;
    horizontal-stretch: 1;
    ms := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        // il simbolo in un HorizontalLayout: con la larghezza fissa diretta il riquadro non si allargava
        HorizontalLayout {
            alignment: start;
            Icon {
                width: 22px;
                height: 22px;
                source: root.icon;
                tint: M3.primary;
            }
        }
        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 800;
            color: M3.on-surface;
            wrap: word-wrap;
        }
        Text {
            text: root.sub;
            font-size: Type.label;
            color: M3.on-surface-variant;
            wrap: word-wrap;
        }
    }
    msta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// pulsante del menu degli esami: contorno, simbolo e testo
component MenuChip inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    callback clicked;
    height: 40px;
    width: mc.preferred-width;
    border-radius: 12px;
    border-width: 1px;
    border-color: M3.outline;
    background: mta.pressed ? M3.on-surface.with-alpha(0.08) : transparent;
    mc := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                source: root.icon;
                tint: M3.on-surface;
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            color: M3.on-surface;
            vertical-alignment: center;
        }
    }
    mta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component HomePage inherits Page {
    // menu degli esami: esame con le azioni aperte (tre puntini), e il nome del ramo da creare
    property <string> exam-more;
    // 0 niente, 1 nuovo ramo dal modello, 2 salva l'esame in uso in un ramo nuovo
    property <int> branch-mode: 0;
    property <string> branch-name;
    // l'ingresso animato delle barre si vede solo la prima volta: tornando alla Home
    // (la pagina viene ricreata) le barre compaiono già piene, senza svuotarsi e ripartire
    Timer {
        interval: 1500ms;
        running: !AppState.home-intro-done;
        triggered => {
            AppState.home-intro-done = true;
        }
    }
    // la fascia compatta compare quando quella grande è uscita in alto
    property <bool> compact: -sv.content-y > band.height - 96px;

    sv := Scroller {
        width: 100%;
        height: 100%;
        content-y <=> AppState.home-scroll;
        align: start;
        pad: 0px;
        gap: 0px;

        // fascia dell'eroe (Traguardo): a tutta larghezza, angoli in basso
        band := Rectangle {
            background: M3.primary-container;
            border-bottom-left-radius: 32px;
            border-bottom-right-radius: 32px;
            height: hero.preferred-height;
            hero := VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 4px;
                padding-bottom: 20px;
                spacing: 0px;
                // selettore dell'esame e profilo
                HorizontalLayout {
                    height: 52px;
                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                border-radius: 20px;
                                background: sel-ta.pressed || AppState.exam-menu ? M3.on-primary-container.with-alpha(0.08) : transparent;
                                HorizontalLayout {
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Text {
                                        text: AppState.exam-name;
                                        font-size: 17px;
                                        font-weight: 700;
                                        color: M3.on-primary-container;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        max-width: root.width - 120px;
                                    }
                                    Rectangle {
                                        width: 14px;
                                        Path {
                                            width: 12px;
                                            height: 7px;
                                            viewbox-width: 14;
                                            viewbox-height: 8;
                                            commands: AppState.exam-menu ? "M 1 7 L 7 1 L 13 7" : "M 1 1 L 7 7 L 13 1";
                                            stroke: M3.on-primary-container;
                                            stroke-width: 2px;
                                        }
                                    }
                                }
                                sel-ta := TouchArea {
                                    clicked => {
                                        AppState.exam-menu = !AppState.exam-menu;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 40px;
                        Avatar {
                            width: 36px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            photo: AppState.my-photo;
                            has-photo: AppState.my-has-photo;
                            initial: AppState.my-initial;
                        }
                        TouchArea {
                            clicked => {
                                AppState.go-tab(3);
                            }
                        }
                    }
                }
                // percentuale grande a sinistra, giorni al prossimo appello a destra
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: start;
                        Text {
                            text: "PREPARAZIONE";
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            color: M3.primary;
                        }
                        Text {
                            text: round(AppState.overall * 100) + "%";
                            font-size: 88px;
                            font-weight: 900;
                            letter-spacing: -3px;
                            color: M3.on-primary-container;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if AppState.hero-days >= 0: VerticalLayout {
                        alignment: start;
                        padding-top: 20px;
                        Text {
                            horizontal-alignment: right;
                            text: AppState.hero-days == 0 ? "Oggi" : AppState.hero-days;
                            font-size: 40px;
                            font-weight: 900;
                            color: AppState.hero-days <= 7 ? M3.error : M3.on-primary-container;
                        }
                        Text {
                            horizontal-alignment: right;
                            text: AppState.hero-days-label;
                            font-size: 12px;
                            color: M3.on-primary-container;
                        }
                        if AppState.hero-days-sub != "": Text {
                            horizontal-alignment: right;
                            text: AppState.hero-days-sub;
                            font-size: 12px;
                            color: M3.on-primary-container;
                        }
                    }
                }
                // barra ondulata con la soglia
                Rectangle {
                    height: wave.height;
                    wave := WavyProgress {
                        width: parent.width;
                        intro: !AppState.home-intro-done;
                        value: AppState.overall;
                        fill: M3.primary;
                        track: M3.surface.with-alpha(0.75);
                        amp: 6px;
                        wavelength: 44px;
                        thickness: 7px;
                    }
                    if AppState.pass-frac > 0: Rectangle {
                        x: parent.width * AppState.pass-frac - 1px;
                        y: 0px;
                        width: 2px;
                        height: parent.height;
                        background: AppState.pass-ok ? M3.success : M3.on-primary-container;
                    }
                }
                Rectangle {
                    height: 22px;
                    Text {
                        x: 0px;
                        y: 4px;
                        text: "0%";
                        font-size: 11px;
                        color: M3.on-primary-container;
                    }
                    if AppState.pass-label != "": Text {
                        x: max(30px, min(parent.width - self.width - 40px, parent.width * AppState.pass-frac - self.width / 2));
                        y: 4px;
                        text: AppState.pass-label;
                        font-size: 11px;
                        font-weight: 700;
                        color: AppState.pass-ok ? M3.success : M3.on-primary-container;
                    }
                    Text {
                        x: parent.width - self.width;
                        y: 4px;
                        text: "100%";
                        font-size: 11px;
                        color: M3.on-primary-container;
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    padding-bottom: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: AppState.hero-expected != "" ? AppState.hero-expected : AppState.overall-label;
                        font-size: 12.5px;
                        color: M3.on-primary-container;
                        overflow: elide;
                    }
                    Text {
                        text: AppState.hero-time;
                        font-size: 12.5px;
                        color: M3.on-primary-container;
                    }
                }
                // una barretta per materia
                if AppState.subjects.length > 0: Rectangle {
                    border-radius: 20px;
                    background: M3.surface.with-alpha(0.72);
                    height: subj.preferred-height;
                    subj := VerticalLayout {
                        padding: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 2px;
                        for s in AppState.subjects: Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 78px;
                                    text: s.short;
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    WavyProgress {
                                        intro: !AppState.home-intro-done;
                                        value: s.mastery;
                                        fill: s.own-color ? s.color : M3.subject(s.n);
                                        track: M3.surface-container-high;
                                        amp: 3px;
                                        wavelength: 24px;
                                        thickness: 4px;
                                    }
                                }
                                Text {
                                    width: 40px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    text: s.score != "" ? s.score : round(s.mastery * 100) + "%";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: M3.on-surface;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    AppState.select-subject(s.id);
                                    AppState.go-tab(1);
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 16px;
            padding-top: 18px;
            spacing: 14px;
            // sincronizzazione con GitHub (solo se acceso)
            if AppState.sync-configured: HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: AppState.sync-status;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
                if AppState.syncing: Rectangle {
                    width: 48px;
                    MorphLoader { }
                }
                if !AppState.syncing: M3Button {
                    text: "Sincronizza";
                    kind: 1;
                    has-icon: true;
                    icon: Icons.sync;
                    clicked => {
                        AppState.sync-now();
                    }
                }
            }

            // nessun esame installato: da dove cominciare
            if AppState.no-exam: Card {
                bg: M3.primary-container;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: "Benvenuto!";
                        font-size: Type.title;
                        font-weight: 800;
                        color: M3.on-primary-container;
                    }
                    Text {
                        text: "Per iniziare installa un pacchetto di contenuti (quiz, flashcard e libri di un esame): da un file, da un altro tuo dispositivo o da un amico che lo condivide.";
                        color: M3.on-primary-container;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        M3Button {
                            text: "Importa pacchetto";
                            clicked => {
                                AppState.import-pack();
                            }
                        }
                        M3Button {
                            text: "Ricevi";
                            kind: 2;
                            clicked => {
                                AppState.settings-sec = 3;
                                AppState.open-settings();
                            }
                        }
                    }
                    M3Button {
                        text: "Crea un pacchetto con l'AI";
                        kind: 2;
                        clicked => {
                            AppState.open-creator(true);
                        }
                    }
                }
            }

            // piano di oggi: anello, stato, caselle
            if !AppState.no-exam: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 14px;
                        RingProgress {
                            width: 44px;
                            height: 44px;
                            thickness: 6px;
                            value: AppState.goals.length > 0 ? AppState.goals-done-n / AppState.goals.length : 0;
                            fill: M3.success;
                            track: M3.surface-container-highest;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "Piano di oggi";
                                font-size: 22px;
                                font-weight: 700;
                                color: M3.on-surface;
                            }
                            Text {
                                text: AppState.goals-confirmed ? AppState.goals-status : AppState.goals.length > 0 ? "Una proposta è pronta: sceglila o cambiala" : "Scegli cosa fare oggi";
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                    }
                    for g[i] in AppState.goals-confirmed ? AppState.goals : []: Rectangle {
                        height: grow.preferred-height;
                        grow := HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: g.done >= g.target ? 13px : 8px;
                                    background: g.done >= g.target ? M3.success-container : transparent;
                                    border-width: g.done >= g.target ? 0px : 2px;
                                    border-color: M3.outline;
                                    if g.done >= g.target: VIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: Icons.check;
                                        tint: M3.success;
                                        size: 18px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: g.name;
                                    font-size: 15px;
                                    color: g.done >= g.target ? M3.on-surface-variant : M3.on-surface;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: g.info;
                                    font-size: Type.label;
                                    color: M3.on-surface-variant;
                                }
                            }
                            if g.done < g.target: Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: M3.primary;
                                VIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: Icons.play;
                                    tint: M3.on-primary;
                                    size: 20px;
                                }
                                TouchArea {
                                    clicked => {
                                        AppState.goals-train(g.topic);
                                    }
                                }
                            }
                        }
                    }
                    if !AppState.goals-confirmed: M3Button {
                        text: AppState.goals.length > 0 ? "Vedi la proposta" : "Scegli gli obiettivi";
                        kind: 1;
                        clicked => {
                            AppState.open-goals();
                        }
                    }
                    if AppState.goals-confirmed: TouchArea {
                        height: 24px;
                        clicked => {
                            AppState.open-goals();
                        }
                        Text {
                            x: 0px;
                            text: "Modifica il piano";
                            font-size: Type.label;
                            font-weight: 700;
                            color: M3.primary;
                        }
                    }
                }
            }

            // prossime cose da fare (righe con il simbolo in un riquadro, come nel mockup)
            if !AppState.no-exam: Rectangle {
                border-radius: 28px;
                background: M3.surface-container;
                height: nextl.preferred-height;
                clip: true;
                nextl := VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    if AppState.flagged-count + AppState.wrong-count > 0: NextRow {
                        icon: Icons.flag;
                        title: "Ripassa le insicure e le sbagliate";
                        sub: (AppState.flagged-count + AppState.wrong-count) + " domande da rivedere";
                        clicked => {
                            AppState.start-review("");
                        }
                    }
                    NextRow {
                        icon: Icons.cards;
                        title: "Flashcard di oggi";
                        sub: AppState.due-count > 0 ? AppState.due-count + " carte da ripassare" : "nessuna in scadenza: allenati sulle nuove";
                        clicked => {
                            AppState.start-cards("all", "");
                        }
                    }
                }
            }

            // questa settimana: una barra per giorno, oggi pieno
            if !AppState.no-exam: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "Questa settimana";
                            font-size: 20px;
                            font-weight: 700;
                            color: M3.on-surface;
                        }
                        Text {
                            text: AppState.week-total;
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        height: 96px;
                        spacing: 8px;
                        for v[i] in AppState.week-bars: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            alignment: end;
                            Rectangle {
                                height: max(i <= AppState.week-today ? 6px : 3px, 70px * v);
                                border-radius: 12px;
                                background: i == AppState.week-today ? M3.primary : i < AppState.week-today ? M3.primary-container : M3.surface-container-highest;
                            }
                            Text {
                                horizontal-alignment: center;
                                text: i == 0 ? "L" : i == 1 ? "M" : i == 2 ? "M" : i == 3 ? "G" : i == 4 ? "V" : i == 5 ? "S" : "D";
                                font-size: 12px;
                                font-weight: i == AppState.week-today ? 800 : 500;
                                color: i == AppState.week-today ? M3.on-surface : M3.on-surface-variant;
                            }
                        }
                    }
                }
            }

            // serie di giorni di studio
            if AppState.streak-days > 0: Rectangle {
                border-radius: 28px;
                background: M3.success-container;
                height: streakl.preferred-height;
                streakl := HorizontalLayout {
                    padding: 18px;
                    spacing: 14px;
                    VIcon {
                        source: Icons.today;
                        tint: M3.success;
                        size: 28px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: AppState.streak-days == 1 ? "1 giorno di studio" : AppState.streak-days + " giorni di fila";
                            font-size: 22px;
                            font-weight: 800;
                            color: M3.on-surface;
                        }
                        Text {
                            text: AppState.goals-left > 0 ? "Oggi mancano " + AppState.goals-left + " obiettivi al piano" : "Studia un po' ogni giorno per allungarla";
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // gara del gruppo e simulazioni, affiancate
            if !AppState.no-exam: HorizontalLayout {
                spacing: 12px;
                MiniStat {
                    horizontal-stretch: 1;
                    icon: Icons.groups;
                    title: AppState.home-race-title != "" ? AppState.home-race-title : "Squadra";
                    sub: AppState.home-race-title != "" ? AppState.home-race-sub : "studia in gara con altri";
                    clicked => {
                        AppState.go-tab(2);
                    }
                }
                MiniStat {
                    horizontal-stretch: 1;
                    icon: Icons.timer;
                    title: AppState.sim-count == 1 ? "1 simulazione" : AppState.sim-count + " simulazioni";
                    sub: AppState.sim-count > 0 ? "media " + AppState.sim-avg : "fanne una prima dell'appello";
                    clicked => {
                        AppState.open-simlog();
                    }
                }
            }

            if AppState.ai-summary != "": Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            source: Icons.ai;
                            tint: M3.primary;
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            text: "Revisione AI";
                            font-weight: 700;
                            font-size: Type.title;
                            color: M3.on-surface;
                        }
                    }
                    Text {
                        text: AppState.ai-summary;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }
                    for p in AppState.ai-priorities: Text {
                        text: "• " + p;
                        wrap: word-wrap;
                        color: M3.on-surface-variant;
                        font-size: Type.body;
                    }
                }
            }

            Text {
                text: AppState.content-info;
                color: M3.on-surface-variant;
                font-size: Type.label;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            // spazio per «Studia ora»
            Rectangle {
                height: 72px;
            }
        }
    }

    // fascia compatta, scorrendo (Traguardo: «Preparazione · 21 g · 38 %»)
    Rectangle {
        x: 0px;
        y: root.compact ? 0px : -self.height;
        animate y {
            duration: 180ms;
            easing: ease-out;
        }
        width: root.width;
        height: 76px;
        background: M3.primary-container;
        border-bottom-left-radius: 24px;
        border-bottom-right-radius: 24px;
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: "Preparazione";
                    font-size: 16px;
                    font-weight: 700;
                    color: M3.on-primary-container;
                    vertical-alignment: center;
                }
                if AppState.hero-days >= 0: Text {
                    text: AppState.hero-days + " g";
                    font-size: 13px;
                    color: M3.on-primary-container;
                    vertical-alignment: center;
                }
                Text {
                    text: round(AppState.overall * 100) + "%";
                    font-size: 26px;
                    font-weight: 900;
                    color: M3.on-primary-container;
                }
            }
            WavyProgress {
                intro: false;
                value: AppState.overall;
                fill: M3.primary;
                track: M3.surface.with-alpha(0.75);
                amp: 3px;
                wavelength: 32px;
                thickness: 4px;
            }
        }
    }
    // menu degli esami installati (sopra a tutto)
    if AppState.exam-menu: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000040;
        TouchArea {
            clicked => {
                AppState.exam-menu = false;
                root.exam-more = "";
                root.branch-mode = 0;
            }
        }
        Rectangle {
            x: 12px;
            y: 52px;
            width: min(root.width - 24px, 520px);
            height: min(menu.preferred-height, root.height - 64px);
            border-radius: 28px;
            background: M3.surface-container-low;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            clip: true;
            TouchArea { }
            menu := VerticalLayout {
                padding: 10px;
                padding-bottom: 14px;
                spacing: 3px;
                Text {
                    text: "I tuoi esami · i progressi restano separati";
                    font-size: 13px;
                    font-weight: 600;
                    color: M3.on-surface-variant;
                    height: 30px;
                    vertical-alignment: center;
                    x: 12px;
                }
                for e[i] in AppState.exams: Rectangle {
                    border-radius: 20px;
                    background: e.active ? M3.primary-container : row-ta.pressed ? M3.surface-container-high : transparent;
                    min-height: row-col.preferred-height;
                    row-ta := TouchArea {
                        clicked => {
                            root.exam-more = "";
                            AppState.select-exam(e.id);
                        }
                    }
                    row-col := VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            padding-right: 2px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    background: e.active ? M3.surface : Math.mod(i, 3) == 0 ? M3.error-container : Math.mod(i, 3) == 1 ? M3.success-container : M3.tertiary-container;
                                    Text {
                                        text: e.initials;
                                        font-size: 16px;
                                        font-weight: 800;
                                        color: e.active ? M3.primary : Math.mod(i, 3) == 0 ? M3.on-error-container : Math.mod(i, 3) == 1 ? M3.on-success-container : M3.on-tertiary-container;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: e.name;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: e.active ? M3.on-primary-container : M3.on-surface;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: e.info;
                                    font-size: 13px;
                                    color: e.active ? M3.on-primary-container : M3.on-surface-variant;
                                    wrap: word-wrap;
                                }
                            }
                            if e.active: VIcon {
                                source: Icons.check;
                                tint: M3.primary;
                                size: 22px;
                            }
                            IconButton {
                                icon: Icons.more-vert;
                                tint: e.active ? M3.on-primary-container : M3.on-surface-variant;
                                clicked => {
                                    root.exam-more = root.exam-more == e.id ? "" : e.id;
                                    root.branch-mode = 0;
                                }
                            }
                        }
                        // azioni sull'esame toccato con i tre puntini
                        if root.exam-more == e.id: HorizontalLayout {
                            padding-left: 66px;
                            padding-right: 10px;
                            padding-bottom: 10px;
                            spacing: 6px;
                            alignment: start;
                            if e.active: M3Button {
                                text: "Modifica";
                                kind: 1;
                                small: true;
                                has-icon: true;
                                icon: Icons.edit;
                                clicked => {
                                    AppState.exam-menu = false;
                                    root.exam-more = "";
                                    AppState.open-creator(false);
                                }
                            }
                            if e.active && AppState.sync-configured: M3Button {
                                text: "Salva in un ramo";
                                kind: 1;
                                small: true;
                                has-icon: true;
                                icon: Icons.branch;
                                clicked => {
                                    root.exam-more = "";
                                    root.branch-mode = 2;
                                }
                            }
                            M3Button {
                                text: "Rimuovi";
                                kind: 3;
                                small: true;
                                clicked => {
                                    root.exam-more = "";
                                    AppState.remove-exam(e.id);
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 13px;
                    Rectangle {
                        x: 12px;
                        y: 6px;
                        width: parent.width - 24px;
                        height: 1px;
                        background: M3.outline-variant;
                    }
                }
                Text {
                    text: "Aggiungi un esame";
                    font-size: 13px;
                    font-weight: 700;
                    color: M3.on-surface;
                    x: 12px;
                    height: 28px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;
                    MenuChip {
                        icon: Icons.add;
                        text: AppState.pack-busy ? "Importazione…" : "Importa un pacchetto";
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.import-pack();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    spacing: 8px;
                    alignment: start;
                    MenuChip {
                        icon: Icons.share;
                        text: "Ricevi con un codice";
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.open-setting(3);
                        }
                    }
                    MenuChip {
                        icon: Icons.smart-toy;
                        text: "Crea con l'AI";
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.open-creator(true);
                        }
                    }
                }
                // con GitHub collegato: un ramo del repository (esistente o nuovo dal modello)
                if AppState.sync-configured: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    spacing: 8px;
                    alignment: start;
                    MenuChip {
                        icon: Icons.sync;
                        text: "Da un ramo";
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.open-setting(7);
                            AppState.gh-load-branches();
                        }
                    }
                    MenuChip {
                        icon: Icons.branch;
                        text: "Nuovo ramo";
                        clicked => {
                            root.exam-more = "";
                            root.branch-mode = root.branch-mode == 1 ? 0 : 1;
                        }
                    }
                }
                // nome del ramo: nuovo dal modello, o dove salvare l'esame in uso
                if root.branch-mode > 0: VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        OutlinedField {
                            horizontal-stretch: 1;
                            label: root.branch-mode == 1 ? "Nome del nuovo ramo" : "Ramo in cui salvare l'esame";
                            text <=> root.branch-name;
                            placeholder: root.branch-mode == 1 ? "es. anatomia-2027" : "es. semestre-aperto";
                            pencil: false;
                            accepted(t) => {
                                if (root.branch-mode == 1) {
                                    AppState.gh-new-branch(t);
                                } else {
                                    AppState.gh-save-branch(t);
                                }
                                root.branch-mode = 0;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            M3Button {
                                text: root.branch-mode == 1 ? "Crea" : "Salva";
                                enabled: root.branch-name != "";
                                clicked => {
                                    if (root.branch-mode == 1) {
                                        AppState.gh-new-branch(root.branch-name);
                                    } else {
                                        AppState.gh-save-branch(root.branch-name);
                                    }
                                    root.branch-mode = 0;
                                }
                            }
                        }
                    }
                    Text {
                        text: root.branch-mode == 1
                            ? "Parte dal ramo «modello-dati»: guida, schema, strumenti per estrarre il testo e l'OCR e le direttive per preparare il pacchetto con l'AI."
                            : "Contenuti, libri e progressi di questo esame vanno in un ramo nuovo (basato sul modello); da lì in poi l'esame si sincronizza con quel ramo.";
                        font-size: 12px;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
