import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM } from "../state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller } from "../components.slint";

component SubjectCard inherits Card {
    in property <SubjectVM> s;
    clickable: true;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: M3.subject(root.s.n);
                }
            }

            Text {
                text: root.s.name;
                font-size: Type.title;
                font-weight: 700;
                color: M3.on-surface;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: round(root.s.mastery * 100) + "%";
                font-size: Type.title;
                font-weight: 700;
                color: M3.subject(root.s.n);
            }
        }

        WavyProgress {
            intro: !AppState.home-intro-done;
            value: root.s.mastery;
            fill: M3.subject(root.s.n);
            amp: 3px;
            wavelength: 28px;
            thickness: 4px;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Punteggio atteso " + root.s.predicted + (root.s.pace != "" ? "\n" + root.s.pace : "");
                wrap: word-wrap;
                color: M3.on-surface-variant;
                font-size: Type.label;
                horizontal-stretch: 1;
            }

            if root.s.flagged > 0: Pill {
                text: root.s.flagged + " insicure";
                bg: M3.tertiary-container;
                fg: M3.on-tertiary-container;
            }
        }
    }
}

export component HomePage inherits Page {
    // intestazione grande che si comprime scorrendo (0 = aperta, 1 = compatta)
    property <length> hero-max: 288px;
    property <length> hero-min: 140px;
    property <float> t: max(0, min(1, -sv.content-y / (root.hero-max - root.hero-min)));
    property <length> hero-h: root.hero-max - (root.hero-max - root.hero-min) * root.t;
    // l'ingresso animato delle barre si vede solo la prima volta: tornando alla Home
    // (la pagina viene ricreata) le barre compaiono già piene, senza svuotarsi e ripartire
    Timer {
        interval: 1500ms;
        running: !AppState.home-intro-done;
        triggered => {
            AppState.home-intro-done = true;
        }
    }

    sv := Scroller {
        width: 100%;
        height: 100%;
        content-y <=> AppState.home-scroll;
        align: start;
        pad: 16px;
        pad-top: root.hero-max + 4px;
        gap: 14px;
        // nessun esame installato: da dove cominciare
        if AppState.no-exam: Card {
            bg: M3.primary-container;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: "Benvenuto!";
                    font-size: Type.title;
                    font-weight: 800;
                    color: M3.on-primary-container;
                }
                Text {
                    text: "Per iniziare installa un pacchetto di contenuti (quiz, flashcard e libri di un esame): da un file, da un altro tuo dispositivo o da un amico che lo condivide.";
                    color: M3.on-primary-container;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    M3Button {
                        text: "Importa pacchetto";
                        clicked => {
                            AppState.import-pack();
                        }
                    }
                    M3Button {
                        text: "Ricevi";
                        kind: 2;
                        clicked => {
                            AppState.open-settings();
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            for d in AppState.exam-dates: Pill {
                text: d.label + ": " + (d.days > 0 ? "tra " + d.days + " giorni" : d.days == 0 ? "OGGI" : "passato");
                bg: d.days >= 0 && d.days <= 7 ? M3.error-container : M3.tertiary-container;
                fg: d.days >= 0 && d.days <= 7 ? M3.on-error-container : M3.on-tertiary-container;
            }
        }

            if AppState.paused-title != "": Card {
                bg: M3.tertiary-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VIcon {
                            source: Icons.pause;
                            tint: M3.on-tertiary-container;
                            size: 20px;
                        }

                        Text {
                            text: "In pausa: " + AppState.paused-title;
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-tertiary-container;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: AppState.paused-info;
                        font-size: Type.label;
                        color: M3.on-tertiary-container;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        M3Button {
                            text: "Scarta";
                            kind: 3;
                            clicked => {
                                AppState.discard-paused();
                            }
                        }

                        M3Button {
                            text: "Riprendi";
                            has-icon: true;
                            icon: Icons.play;
                            clicked => {
                                AppState.resume-quiz();
                            }
                        }
                    }
                }
            }

            if AppState.goals.length > 0: Card {
                clickable: true;
                bg: M3.secondary-container;
                clicked => {
                    AppState.open-goals();
                }
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VIcon {
                        source: Icons.target;
                        tint: M3.on-secondary-container;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: AppState.goals-confirmed ? "Obiettivi di oggi" : "Scegli gli obiettivi di oggi";
                            font-size: Type.title;
                            font-weight: 700;
                            color: M3.on-secondary-container;
                        }

                        Text {
                            text: AppState.goals-confirmed ? AppState.goals-status : "Una proposta è pronta nella scheda Obiettivi";
                            font-size: Type.label;
                            color: M3.on-secondary-container;
                            wrap: word-wrap;
                        }
                    }

                    VIcon {
                        source: Icons.chevron;
                        tint: M3.on-secondary-container;
                    }
                }
            }

            for s[i] in AppState.subjects: SubjectCard {
                s: s;
                stagger: i + 1;
                clicked => {
                    AppState.select-subject(s.id);
                    AppState.go-tab(1);
                }
            }

            HorizontalLayout {
                spacing: 10px;
                M3Button {
                    kind: 1;
                    has-icon: true;
                    icon: Icons.flag;
                    text: "Ripasso (" + (AppState.flagged-count + AppState.wrong-count) + ")";
                    enabled: AppState.flagged-count + AppState.wrong-count > 0;
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.start-review("");
                    }
                }

                M3Button {
                    kind: 1;
                    has-icon: true;
                    icon: Icons.cards;
                    text: "Flashcard (" + AppState.due-count + ")";
                    horizontal-stretch: 1;
                    clicked => {
                        AppState.start-cards("all", "");
                    }
                }
            }

            if AppState.ai-summary != "": Card {
                bg: M3.surface-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            source: Icons.ai;
                            tint: M3.primary;
                            width: 20px;
                            height: 20px;
                        }

                        Text {
                            text: "Revisione AI";
                            font-weight: 700;
                            font-size: Type.title;
                            color: M3.on-surface;
                        }
                    }

                    Text {
                        text: AppState.ai-summary;
                        wrap: word-wrap;
                        color: M3.on-surface;
                    }

                    for p in AppState.ai-priorities: Text {
                        text: "• " + p;
                        wrap: word-wrap;
                        color: M3.on-surface-variant;
                        font-size: Type.body;
                    }
                }
            }

            Text {
                text: AppState.content-info;
                color: M3.on-surface-variant;
                font-size: Type.label;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

    // intestazione: titolo, impostazioni, percentuale grande e barra ondulata
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.hero-h;
        background: M3.surface;
        Rectangle {
            x: 12px;
            y: 56px;
            width: parent.width - 24px;
            height: parent.height - 64px;
            border-radius: Shape.xl - 8px * root.t;
            background: M3.primary-container;
            clip: true;
            // percentuale: grande e a sinistra, poi piccola a destra; «Preparazione» resta sempre
            // allineato a sinistra (prima scivolava a destra accanto alla percentuale)
            pct := Text {
                x: 20px + (parent.width - 40px - self.width) * root.t;
                y: 14px - 4px * root.t;
                text: round(AppState.overall * 100) + "%";
                font-size: Type.display-large * (1 - root.t) + 26px * root.t;
                font-weight: 800;
                color: M3.on-primary-container;
            }

            Text {
                x: 20px;
                y: 104px - 88px * root.t;
                width: parent.width - 40px - (pct.width + 12px) * root.t;
                text: "Preparazione";
                font-size: Type.title-large * (1 - root.t) + Type.title * root.t;
                font-weight: 700;
                color: M3.on-primary-container;
                overflow: elide;
            }

            Text {
                x: 20px;
                y: 134px;
                width: parent.width - 40px;
                text: AppState.overall-label + (AppState.total-time != "" ? "\n" + AppState.total-time : "");
                font-size: Type.label;
                color: M3.on-primary-container;
                opacity: max(0, 1 - root.t * 2.2);
                wrap: word-wrap;
            }

            WavyProgress {
                intro: !AppState.home-intro-done;
                x: 20px;
                y: parent.height - self.height - 18px + 4px * root.t;
                width: parent.width - 40px;
                value: AppState.overall;
                fill: M3.primary;
                track: M3.surface.with-alpha(0.7);
                amp: 6px - 3px * root.t;
                wavelength: 44px - 12px * root.t;
                thickness: 7px - 2px * root.t;
            }
        }

        // riga del titolo
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 56px;
            padding-left: 20px;
            padding-right: 4px;
            // selettore dell'esame: nome dell'esame attivo, tocca per cambiarlo o aggiungerne uno
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        border-radius: 20px;
                        background: sel-ta.pressed || AppState.exam-menu ? M3.surface-container-high : transparent;
                        animate background { duration: 150ms; }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text {
                                text: AppState.exam-name;
                                font-size: Type.title-large;
                                font-weight: 700;
                                color: M3.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: root.width - 140px;
                            }
                            Rectangle {
                                width: 16px;
                                Path {
                                    width: 14px;
                                    height: 8px;
                                    viewbox-width: 14;
                                    viewbox-height: 8;
                                    commands: AppState.exam-menu ? "M 1 7 L 7 1 L 13 7" : "M 1 1 L 7 7 L 13 1";
                                    stroke: M3.on-surface;
                                    stroke-width: 2px;
                                }
                            }
                        }
                        sel-ta := TouchArea {
                            clicked => {
                                AppState.exam-menu = !AppState.exam-menu;
                            }
                        }
                    }
                }
            }

            IconButton {
                icon: Icons.tune;
                tint: M3.on-surface;
                clicked => {
                    AppState.open-settings();
                }
            }
        }
    }

    // menu degli esami installati (sopra a tutto)
    if AppState.exam-menu: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000033;
        TouchArea {
            clicked => {
                AppState.exam-menu = false;
            }
        }
        Rectangle {
            x: 12px;
            y: 52px;
            width: min(root.width - 24px, 520px);
            height: menu.preferred-height;
            border-radius: Shape.lg;
            background: M3.surface-container;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0000004d;
            drop-shadow-offset-y: 4px;
            TouchArea { }
            menu := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: "Esami installati";
                    font-size: Type.label;
                    font-weight: 700;
                    color: M3.on-surface-variant;
                    height: 28px;
                    vertical-alignment: center;
                    x: 12px;
                }
                for e in AppState.exams: Rectangle {
                    min-height: 56px;
                    border-radius: 12px;
                    background: e.active ? M3.secondary-container : row-ta.pressed ? M3.surface-container-high : transparent;
                    row-ta := TouchArea {
                        clicked => {
                            AppState.select-exam(e.id);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        spacing: 10px;
                        Rectangle {
                            width: 22px;
                            if e.active: VIcon {
                                source: Icons.check;
                                tint: M3.on-secondary-container;
                                size: 20px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: e.name;
                                font-weight: 700;
                                color: M3.on-surface;
                                wrap: word-wrap;
                            }
                            Text {
                                text: e.info;
                                font-size: Type.label;
                                color: M3.on-surface-variant;
                                wrap: word-wrap;
                            }
                        }
                        IconButton {
                            icon: Icons.close;
                            tint: M3.on-surface-variant;
                            clicked => {
                                AppState.remove-exam(e.id);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: M3.outline-variant;
                }
                Rectangle {
                    min-height: 52px;
                    border-radius: 12px;
                    background: add-ta.pressed ? M3.surface-container-high : transparent;
                    add-ta := TouchArea {
                        clicked => {
                            AppState.exam-menu = false;
                            AppState.import-pack();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        VIcon {
                            source: Icons.add;
                            tint: M3.primary;
                            size: 22px;
                        }
                        Text {
                            text: AppState.pack-busy ? "Importazione…" : "Importa un pacchetto (nuovo esame o aggiornamento)";
                            color: M3.primary;
                            font-weight: 700;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Hint {
                    short: "Ogni esame ha contenuti e progressi suoi.";
                    full: "Ogni esame ha contenuti e progressi suoi. Un pacchetto va all'esame indicato nel suo syllabus: se è nuovo viene aggiunto qui.";
                }
            }
        }
    }
}
