import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "../state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller } from "../components.slint";

component NavCell inherits Rectangle {
    in property <int> n;
    in property <bool> answered;
    in property <bool> unsure;
    in property <bool> current;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.current ? M3.primary : root.answered ? M3.secondary-container : transparent;
    border-width: root.unsure ? 2px : 1px;
    border-color: root.unsure ? M3.error : M3.outline-variant;
    Text {
        text: root.n;
        font-size: Type.label;
        font-weight: 700;
        color: root.current ? M3.on-primary : M3.on-surface;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component QuizPage inherits Page {
    // dopo la conferma la spiegazione compare in fondo: scorre fino a mostrarla tutta
    property <bool> answered-now: AppState.q-answered;
    property <length> scroll-goal;
    property <bool> scrolling;
    property <int> settle;
    changed answered-now => {
        if (answered-now && AppState.quiz-mode != 1) {
            root.settle = 0;
            root.scrolling = true;
        }
    }
    Timer {
        interval: 16ms;
        running: root.scrolling;
        triggered => {
            // l'obiettivo si ricalcola a ogni passo: la scheda può finire di impaginarsi dopo
            root.settle += 1;
            root.scroll-goal = max(0px, min(
                fbtop.y + 4px,
                fbend.y + 16px - qsv.visible-height,
                qsv.content-height - qsv.visible-height));
            if (root.settle > 60 || (root.settle > 4 && abs(root.scroll-goal + qsv.content-y) < 1px)) {
                qsv.content-y = -max(root.scroll-goal, -qsv.content-y);
                root.scrolling = false;
            } else if (root.scroll-goal > -qsv.content-y) {
                qsv.content-y += (-root.scroll-goal - qsv.content-y) * 0.22;
            }
        }
    }
    VerticalLayout {
        // intestazione (Traguardo): chiudi, titolo, tempo in una pillola, pausa
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 8px;
            height: 60px;
            spacing: 6px;
            IconButton {
                icon: Icons.close;
                tint: M3.on-surface;
                clicked => {
                    AppState.back();
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: AppState.quiz-title;
                    font-size: 17px;
                    font-weight: 800;
                    color: M3.on-surface;
                    overflow: elide;
                }
                if AppState.quiz-mode == 1: Text {
                    text: "risposte " + AppState.answered-count + " di " + AppState.q-total;
                    font-size: 12px;
                    color: M3.on-surface-variant;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 36px;
                    width: tpill.preferred-width + 24px;
                    border-radius: 18px;
                    background: (AppState.quiz-mode == 1 && AppState.time-warning) || (AppState.quiz-mode != 1 && AppState.q-slow) ? M3.error-container : M3.surface-container-high;
                    animate background { duration: 400ms; }
                    tpill := HorizontalLayout {
                        x: 12px;
                        spacing: 6px;
                        VIcon {
                            source: Icons.timer;
                            size: 18px;
                            tint: M3.on-surface;
                        }
                        Text {
                            text: AppState.quiz-mode == 1 ? AppState.time-left : AppState.q-elapsed;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                            color: M3.on-surface;
                        }
                    }
                }
            }
            IconButton {
                icon: Icons.pause;
                tint: M3.on-surface;
                clicked => {
                    AppState.pause-quiz();
                }
            }
        }

        // avanzamento: «7/20» e barra ondulata
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 6px;
            spacing: 12px;
            Text {
                text: (AppState.q-index + 1) + "/" + AppState.q-total;
                font-size: 13px;
                font-weight: 800;
                color: M3.on-surface;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                WavyProgress {
                    intro: false;
                    value: AppState.q-total > 0 ? (AppState.q-index + 1) / AppState.q-total : 0;
                    amp: 3px;
                    wavelength: 20px;
                    thickness: 4px;
                    moving: false;
                }
            }
        }

        Swap {
            key: "" + AppState.q-index;
            vertical-stretch: 1;
        qsv := ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            mouse-drag-pan-enabled: AppState.drag-pan;
            // il layout stima un'altezza minore del reale con testo a capo (spiegazioni lunghe su
            // schermi stretti): l'area scorrevole arriva fino all'ultimo elemento effettivo
            content-height: max(self.visible-height, qend.y + 16px);
            Rectangle {
            VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                padding: 16px;
                spacing: 12px;
                // argomento in piccolo, nel colore della materia; poi la domanda grande
                Text {
                    text: (AppState.q-topic + (AppState.q-is-mcq ? "" : " · completa con una parola")).to-uppercase();
                    font-size: 12px;
                    font-weight: 800;
                    letter-spacing: 0.6px;
                    color: M3.success;
                    wrap: word-wrap;
                }

                Text {
                    text: AppState.q-text;
                    font-size: 22px;
                    font-weight: 700;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }

                // segnaposto (altezza 0) dove inizia la parte con la spiegazione, per lo scroll automatico
                fbtop := Rectangle {
                    height: 0px;
                }

                if AppState.q-is-mcq: VerticalLayout {
                    spacing: 10px;
                    for o[i] in AppState.q-options: OptionTile {
                        letter: o.letter;
                        text: o.text;
                        note: o.note;
                        state: o.state;
                        ref-label: AppState.quiz-mode != 1 ? AppState.q-ref : "";
                        open-ref => {
                            AppState.open-ref-quiz();
                        }
                        clicked => {
                            AppState.select-option(i);
                        }
                    }
                }

                // completamento: la risposta in un campo grande, in evidenza come lo spazio vuoto
                if !AppState.q-is-mcq: Rectangle {
                    height: 64px;
                    border-radius: 16px;
                    background: fill-in.has-focus ? M3.primary-container : M3.surface-container;
                    animate background { duration: 150ms; }
                    TouchArea {
                        clicked => {
                            fill-in.focus();
                        }
                    }
                    fill-in := TextInput {
                        x: 18px;
                        width: parent.width - 36px;
                        height: parent.height - 6px;
                        text <=> AppState.q-fill;
                        enabled: !AppState.q-answered;
                        single-line: true;
                        font-size: 24px;
                        font-weight: 800;
                        color: M3.on-surface;
                        vertical-alignment: center;
                        edited => {
                            AppState.fill-edited(self.text);
                        }
                        accepted => {
                            if (AppState.quiz-mode == 1) {
                                AppState.next();
                            } else if (AppState.q-can-confirm) {
                                AppState.confirm();
                            }
                        }
                    }
                    if fill-in.text == "": Text {
                        x: 18px;
                        width: parent.width - 36px;
                        height: parent.height - 6px;
                        text: "Scrivi la risposta (parola o numero)";
                        font-size: 18px;
                        color: M3.on-surface-variant;
                        vertical-alignment: center;
                    }
                    // sottolineatura, come il «___» della domanda
                    Rectangle {
                        x: 14px;
                        y: parent.height - 5px;
                        width: parent.width - 28px;
                        height: fill-in.has-focus ? 3px : 2px;
                        border-radius: 1.5px;
                        background: fill-in.has-focus ? M3.primary : M3.outline;
                    }
                }
                if !AppState.q-is-mcq && !AppState.q-answered: Text {
                    text: "Maiuscole e accenti non contano";
                    font-size: 12px;
                    color: M3.on-surface-variant;
                }

                if AppState.q-answered && AppState.quiz-mode != 1 && !AppState.q-is-mcq: Card {
                    bg: AppState.q-correct ? M3.success-container : M3.error-container;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Icon {
                                source: AppState.q-correct ? Icons.check : Icons.close;
                                tint: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                            }

                            Text {
                                text: AppState.q-correct ? "Corretto" : "Sbagliato";
                                font-size: Type.title;
                                font-weight: 700;
                                vertical-alignment: center;
                                color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                            }
                        }

                        Text {
                            text: "Risposta: " + AppState.q-correct-text;
                            wrap: word-wrap;
                            font-weight: 600;
                            color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                        }

                        if AppState.q-explanation != "": Text {
                            text: AppState.q-explanation;
                            wrap: word-wrap;
                            color: AppState.q-correct ? M3.on-success-container : M3.on-error-container;
                        }
                        if AppState.q-ref != "": RefBox {
                            label: AppState.q-ref;
                            open => {
                                AppState.open-ref-quiz();
                            }
                        }
                    }
                }

                fbend := Rectangle {
                    height: 0px;
                }

                if AppState.q-source != "" && !(AppState.q-answered && AppState.quiz-mode != 1): Text {
                    text: "Fonte: " + AppState.q-source;
                    wrap: word-wrap;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                    opacity: 0.85;
                }

                if AppState.quiz-mode == 1: VerticalLayout {
                    spacing: 6px;
                    padding-top: 8px;
                    SectionTitle {
                        text: "Vai alla domanda";
                    }

                    for row in AppState.nav-rows: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c in row.cells: NavCell {
                            n: c.n;
                            answered: c.answered;
                            unsure: c.unsure;
                            current: c.current;
                            clicked => {
                                AppState.goto(c.n - 1);
                            }
                        }
                    }
                }

                // fine reale del contenuto: l'altezza stimata dal layout con testo a capo può essere minore
                qend := Rectangle {
                    height: 0px;
                }
            }
        }
        }
        }

        // barra in basso: «Non sono sicuro», Salta, Conferma (poi fonte, Avanti)
        HorizontalLayout {
            padding: 14px;
            padding-top: 8px;
            spacing: 10px;
            if !AppState.q-answered || AppState.quiz-mode == 1: Rectangle {
                height: 36px;
                width: urow.preferred-width + 20px;
                border-radius: 10px;
                background: AppState.q-unsure ? M3.primary-container : M3.surface-container-high;
                urow := HorizontalLayout {
                    x: 10px;
                    spacing: 6px;
                    VIcon {
                        source: AppState.q-unsure ? Icons.check : Icons.flag-outline;
                        size: 16px;
                        tint: AppState.q-unsure ? M3.on-primary-container : M3.on-surface;
                    }
                    Text {
                        text: "Non sono sicuro";
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: AppState.q-unsure ? M3.on-primary-container : M3.on-surface;
                    }
                }
                TouchArea {
                    clicked => {
                        AppState.toggle-unsure();
                    }
                }
            }
            if AppState.q-answered && AppState.quiz-mode != 1: Text {
                text: AppState.q-source;
                font-size: 12px;
                color: M3.on-surface-variant;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
                max-width: 170px;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if AppState.quiz-mode == 1: IconButton {
                icon: Icons.chevron-left;
                enabled: AppState.q-index > 0;
                clicked => {
                    AppState.prev();
                }
            }
            if AppState.quiz-mode == 1 && AppState.q-index + 1 < AppState.q-total: IconButton {
                icon: Icons.chevron;
                filled: true;
                clicked => {
                    AppState.next();
                }
            }
            if AppState.quiz-mode == 1: M3Button {
                compact: true;
                min-width: 104px;
                text: "Consegna";
                clicked => {
                    AppState.finish();
                }
            }
            if AppState.quiz-mode != 1 && !AppState.q-answered: M3Button {
                text: "Salta";
                kind: 3;
                clicked => {
                    AppState.skip();
                }
            }
            if AppState.quiz-mode != 1 && !AppState.q-answered: M3Button {
                text: "Conferma";
                has-icon: true;
                icon: Icons.check;
                enabled: AppState.q-can-confirm;
                clicked => {
                    AppState.confirm();
                }
            }
            if AppState.quiz-mode != 1 && AppState.q-answered: M3Button {
                text: AppState.q-index + 1 < AppState.q-total ? "Avanti" : "Fine";
                has-icon: true;
                icon: Icons.chevron;
                clicked => {
                    AppState.next();
                }
            }
        }
    }
}

component ResultTile inherits Rectangle {
    in property <ResultItemVM> item;
    callback toggle-flag;
    callback open-ref;
    callback report;
    property <bool> expanded: false;
    background: rta.pressed ? M3.surface-container-high : M3.surface-container;
    height: rcol.preferred-height;
    rta := TouchArea {
        clicked => {
            root.expanded = !root.expanded;
        }
    }

    rcol := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 14px;
                    background: root.item.status == 0 ? M3.success-container : root.item.status == 1 ? M3.error-container : M3.surface-container-highest;
                    Icon {
                        x: 9px;
                        y: 9px;
                        width: 22px;
                        height: 22px;
                        source: root.item.status == 0 ? Icons.check : root.item.status == 1 ? Icons.close : Icons.remove;
                        tint: root.item.status == 0 ? M3.success : root.item.status == 1 ? M3.error : M3.on-surface-variant;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.item.text;
                    color: M3.on-surface;
                    font-size: 15px;
                    wrap: word-wrap;
                    overflow: elide;
                    height: root.expanded ? self.preferred-height : min(self.preferred-height, 40px);
                }
                Text {
                    text: (root.item.status == 3 ? "" : "tua: " + (root.item.given == "" ? "—" : root.item.given) + " · ") + "giusta: " + root.item.correct-text + (root.item.secs != "" ? " · " + root.item.secs : "");
                    color: root.item.slow ? M3.error : M3.on-surface-variant;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    icon: root.item.unsure ? Icons.flag : Icons.flag-outline;
                    tint: root.item.unsure ? M3.error : M3.on-surface-variant;
                    clicked => {
                        root.toggle-flag();
                    }
                }
            }
        }

        if root.expanded && root.item.explanation != "": Text {
            text: root.item.explanation;
            color: M3.on-surface;
            font-size: Type.body;
            wrap: word-wrap;
        }
        if root.expanded && root.item.ref-label != "": RefBox {
            label: root.item.ref-label;
            open => {
                root.open-ref();
            }
        }
        if root.expanded && AppState.sync-configured: HorizontalLayout {
            alignment: end;
            M3Button {
                kind: 3;
                text: "Segnala";
                has-icon: true;
                icon: Icons.flag-outline;
                clicked => {
                    root.report();
                }
            }
        }
    }
}

// riquadro dei risultati: numero grande e didascalia, su un fondo tonale
component StatBox inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> bg;
    in property <color> fg;
    horizontal-stretch: 1;
    height: 72px;
    border-radius: 20px;
    background: root.bg;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.value;
            font-size: 26px;
            font-weight: 900;
            color: root.fg;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: root.fg;
            horizontal-alignment: center;
        }
    }
}

export component ResultsPage inherits Page {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 4px;
            height: 56px;
            IconButton {
                icon: Icons.close;
                tint: M3.on-surface;
                clicked => {
                    AppState.results-close();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 0px;
            gap: 12px;
            Text {
                text: AppState.r-title + " · fatto";
                font-size: 15px;
                font-weight: 700;
                color: M3.on-surface-variant;
                horizontal-alignment: center;
                overflow: elide;
            }
            // anello grande con il risultato al centro
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 210px;
                    height: 210px;
                    RingProgress {
                        width: parent.width;
                        height: parent.height;
                        thickness: 18px;
                        value: AppState.r-frac;
                        fill: AppState.r-is-exam && !AppState.r-passed ? M3.error : M3.success;
                        track: AppState.r-is-exam && !AppState.r-passed ? M3.error-container : M3.success-container;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: AppState.r-big;
                            font-size: 64px;
                            font-weight: 900;
                            color: M3.on-surface;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: AppState.r-big-sub;
                            font-size: 14px;
                            color: M3.on-surface-variant;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            if AppState.r-is-exam: Text {
                text: AppState.r-passed ? "Prova superata" : "Sotto la soglia: riprova dopo un ripasso";
                horizontal-alignment: center;
                font-weight: 700;
                color: AppState.r-passed ? M3.success : M3.error;
            }
            HorizontalLayout {
                spacing: 6px;
                StatBox {
                    value: AppState.r-right;
                    label: "giuste";
                    bg: M3.success-container;
                    fg: M3.on-success-container;
                }
                StatBox {
                    value: AppState.r-wrong;
                    label: "sbagliate";
                    bg: M3.error-container;
                    fg: M3.on-error-container;
                }
                StatBox {
                    value: AppState.r-skipped;
                    label: "saltate";
                    bg: M3.surface-container-high;
                    fg: M3.on-surface;
                }
                StatBox {
                    value: AppState.r-avg;
                    label: "a domanda";
                    bg: M3.primary-container;
                    fg: M3.on-primary-container;
                }
            }

            // piano di oggi e serie
            if AppState.goals-confirmed: Rectangle {
                border-radius: 24px;
                background: M3.success-container;
                height: gpl.preferred-height;
                gpl := HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    VIcon {
                        source: Icons.today;
                        tint: M3.success;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "Piano di oggi: " + AppState.goals-status;
                        font-size: 14px;
                        color: M3.on-success-container;
                        wrap: word-wrap;
                    }
                }
            }
            if AppState.streak-days > 0: Rectangle {
                border-radius: 24px;
                background: M3.surface-container;
                height: srl.preferred-height;
                srl := HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    VIcon {
                        source: Icons.today;
                        tint: M3.error;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "Serie salva: " + AppState.streak-days + (AppState.streak-days == 1 ? " giorno" : " giorni") + "." + (AppState.home-race-sub != "" ? " " + AppState.home-race-sub + " in classifica." : "");
                        font-size: 14px;
                        color: M3.on-surface;
                        wrap: word-wrap;
                    }
                }
            }

            // feedback (solo con GitHub acceso: finisce nel repository)
            if AppState.sync-configured: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: AppState.r-feedback-sent ? "Grazie, feedback inviato!" : "Ti ha soddisfatto questo quiz?";
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    if !AppState.r-feedback-sent: StarRating {
                        value <=> AppState.r-rating;
                    }
                    if !AppState.r-feedback-sent: TextEdit {
                        text <=> AppState.r-feedback;
                        placeholder-text: "Proposte o modifiche (domande poco chiare, troppo facili/difficili, argomenti da aggiungere…)";
                        wrap: word-wrap;
                        min-height: 96px;
                    }
                    if !AppState.r-feedback-sent: HorizontalLayout {
                        alignment: end;
                        M3Button {
                            text: "Invia feedback";
                            kind: 1;
                            has-icon: true;
                            icon: Icons.feedback;
                            enabled: AppState.r-rating > 0 || AppState.r-feedback != "";
                            clicked => {
                                AppState.send-session-feedback();
                            }
                        }
                    }
                }
            }

            if AppState.r-items.length > 0: Text {
                text: AppState.r-wrong + AppState.r-skipped > 0 ? "Da rivedere" : "Le domande";
                font-size: 17px;
                font-weight: 700;
                color: M3.primary;
            }
            if AppState.r-items.length > 0: Rectangle {
                border-radius: 24px;
                clip: true;
                height: rlist.preferred-height;
                rlist := VerticalLayout {
                    spacing: 3px;
                    for it[i] in AppState.r-items: ResultTile {
                        item: it;
                        toggle-flag => {
                            AppState.result-toggle-flag(i);
                        }
                        open-ref => {
                            AppState.open-ref-result(i);
                        }
                        report => {
                            AppState.report-result(i);
                        }
                    }
                }
            }
            if AppState.r-sync != "" && AppState.sync-configured: Text {
                text: AppState.r-sync;
                font-size: 12px;
                color: M3.on-surface-variant;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            padding: 14px;
            padding-top: 8px;
            spacing: 10px;
            if AppState.r-wrong > 0: M3Button {
                text: "Rivedi gli errori";
                kind: 1;
                has-icon: true;
                icon: Icons.history;
                horizontal-stretch: 1;
                clicked => {
                    AppState.start-review("");
                }
            }
            M3Button {
                text: "Fatto";
                has-icon: true;
                icon: Icons.check;
                horizontal-stretch: 1;
                clicked => {
                    AppState.results-close();
                }
            }
        }
    }
}
