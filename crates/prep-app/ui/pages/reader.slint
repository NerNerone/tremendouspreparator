import { ScrollView, LineEdit, Spinner, TextEdit, Switch } from "std-widgets.slint";
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState, CarVM, CrewVM, FocusAppVM, RankVM, GroupVM, GoalVM, SubjectVM, UnitVM, TopicVM, OptionVM, NavRowVM, ResultItemVM, FlagVM, QzOptVM, BlockVM, TocVM, FeedbackVM } from "../state.slint";
import { Page, Swap, Icon, VIcon, IconButton, M3Button, Chip, LinearProgress, RingProgress, WavyProgress, MorphLoader, Card, Section, Hint, SectionTitle, TopBar, ListRow, OptionTile, Pill, RefBox, StarRating, Scroller, LlmCopy, FullScroll } from "../components.slint";

component BlockView inherits VerticalLayout {
    in property <BlockVM> b;
    in property <length> avail-width: 360px;
        padding-left: root.b.kind == 2 ? 12px * root.b.level : 0px;
        padding-bottom: root.b.kind == 9 ? 0px : 12px;
        if root.b.kind == 0: Text {
            text: root.b.text;
            wrap: word-wrap;
            color: M3.on-surface;
            font-weight: root.b.level <= 2 ? 900 : 800;
            font-size: root.b.level <= 1 ? 28px : root.b.level == 2 ? 24px : 19px;
        }
        if root.b.kind == 1: Text {
            text: root.b.text;
            wrap: word-wrap;
            color: M3.on-surface;
            font-size: 17px;
        }
        if root.b.kind == 2 || root.b.kind == 3: HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.b.kind == 2 ? "•" : root.b.label;
                color: M3.primary;
                font-size: 16px;
                font-weight: 700;
                min-width: 16px;
            }

            Text {
                text: root.b.text;
                wrap: word-wrap;
                color: M3.on-surface;
                font-size: 16px;
                horizontal-stretch: 1;
            }
        }
        // riquadri (esempi, note, regole): verde tenue, angoli grandi
        if root.b.kind == 4: Rectangle {
            border-radius: 20px;
            background: M3.success-container;
            min-height: qt.preferred-height + 28px;
            qt := Text {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                text: root.b.text;
                wrap: word-wrap;
                color: M3.on-success-container;
                font-size: 16px;
            }
        }
        if root.b.kind == 5: Rectangle {
            background: M3.surface-container-high;
            border-radius: 8px;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                code := TextInput {
                    text: root.b.text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                    color: M3.on-surface;
                    selection-background-color: M3.primary-container;
                    selection-foreground-color: M3.on-primary-container;
                }
                // i blocchi lunghi (prompt, esempi) si copiano o si condividono interi
                if root.b.text.character-count > 80: HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    M3Button {
                        text: "Copia";
                        kind: 2;
                        clicked => {
                            code.select-all();
                            code.copy();
                            code.clear-selection();
                            AppState.rd-copied();
                        }
                    }
                    M3Button {
                        text: "Condividi";
                        kind: 2;
                        clicked => {
                            AppState.rd-share(root.b.text);
                        }
                    }
                }
            }
        }
        if root.b.kind == 6: Text {
            text: root.b.text;
            font-size: 12px;
            color: M3.on-surface-variant;
            horizontal-alignment: right;
        }
        if root.b.kind == 7: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: M3.outline-variant;
            HorizontalLayout {
                padding: 10px;
                Text {
                    text: "Figura: " + root.b.text;
                    wrap: word-wrap;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                }
            }
        }
        if root.b.kind == 8: Rectangle {
            height: 1px;
            background: M3.outline-variant;
        }
        if root.b.kind == 10: HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            padding-bottom: 4px;
            Image {
                source: root.b.img;
                colorize: M3.on-surface;
                image-fit: contain;
                width: min(root.avail-width, self.source.width * 1.15px);
                height: self.width * self.source.height / max(1, self.source.width);
            }
        }
        if root.b.kind == 12: VerticalLayout {
            spacing: 6px;
            padding-top: 4px;
            Rectangle {
                border-radius: 12px;
                background: #ffffff;
                height: fig.height + 16px;
                fig := Image {
                    source: root.b.img;
                    image-fit: contain;
                    width: min(root.avail-width - 16px, max(1, self.source.width) * 1px);
                    height: self.width * self.source.height / max(1, self.source.width);
                }
            }
            Text {
                text: root.b.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-size: Type.label;
                color: M3.on-surface-variant;
            }
        }
        if root.b.kind == 11: Text {
            text: root.b.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            font-size: 17px;
            font-italic: true;
            color: M3.on-surface;
        }
        if root.b.kind == 9: Rectangle {
            background: root.b.level == 1 ? M3.secondary-container : M3.surface-container-low;
            border-width: 1px;
            border-color: M3.outline-variant;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                // colonne con la stessa larghezza in tutte le righe della tabella
                for c[i] in root.b.cells: Text {
                    text: c;
                    wrap: word-wrap;
                    width: root.b.widths.length > i ? (root.avail-width - 16px - 8px * (root.b.cells.length - 1)) * root.b.widths[i] : self.preferred-width;
                    horizontal-stretch: 1;
                    font-size: root.b.level == 1 ? 12px : 14px;
                    font-weight: root.b.level == 1 ? 700 : 400;
                    color: M3.on-surface;
                }
            }
        }
}

export component ReaderPage inherits Page {
    VerticalLayout {
        // testata: libro, posizione, indice
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            height: 60px;
            spacing: 4px;
            IconButton {
                icon: Icons.back;
                tint: M3.on-surface;
                clicked => {
                    AppState.back();
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: AppState.rd-book;
                    font-size: 17px;
                    font-weight: 800;
                    color: M3.on-surface;
                    overflow: elide;
                }
                Text {
                    text: AppState.rd-pos-label;
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    overflow: elide;
                }
            }
            IconButton {
                icon: Icons.toc;
                filled: AppState.rd-toc-visible;
                clicked => {
                    AppState.rd-toc-visible = !AppState.rd-toc-visible;
                }
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 6px;
            WavyProgress {
                intro: false;
                moving: false;
                value: AppState.rd-frac;
                fill: M3.success;
                amp: 3px;
                wavelength: 20px;
                thickness: 4px;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            if !AppState.rd-toc-visible: Swap {
                key: AppState.rd-title;
                width: parent.width;
                height: parent.height;
            // ScrollView con altezza presa dalla fine reale del contenuto: con le tabelle (testo a capo
            // in righe orizzontali) Slint sottostima l'altezza preferita e lo scroll col dito si fermava
            rsv := FullScroll {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                mouse-drag-pan-enabled: AppState.drag-pan;
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, endm.y + 96px);
                content-y <=> AppState.rd-scroll;
                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: rsv.visible-width;
                    height: self.preferred-height;
                    alignment: start;
                    padding: 20px;
                    padding-top: 10px;
                    spacing: 0px;
                    if AppState.rd-eyebrow != "": Text {
                        text: AppState.rd-eyebrow;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        color: M3.success;
                        wrap: word-wrap;
                        height: self.preferred-height + 6px;
                    }
                    if AppState.rd-llm-card: VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        LlmCopy {
                            text: AppState.guide-llm;
                            copied => {
                                AppState.rd-copied();
                            }
                            share => {
                                AppState.rd-share(AppState.guide-llm);
                            }
                        }
                        M3Button {
                            text: "Strumenti PDF";
                            kind: 1;
                            clicked => {
                                AppState.open-pdf-tools();
                            }
                        }
                    }
                    for b in AppState.rd-blocks: BlockView {
                        b: b;
                        avail-width: rsv.visible-width - 40px;
                    }
                    endm := Rectangle {
                        height: 0px;
                    }
                }
            }
            }
            if AppState.rd-toc-visible: Scroller {
                width: parent.width;
                height: parent.height;
                align: start;
                pad: 8px;
                for t in AppState.rd-toc: Rectangle {
                    min-height: max(44px, toc-row.preferred-height);
                    border-radius: 14px;
                    background: t.current ? M3.secondary-container : tta.pressed ? M3.on-surface.with-alpha(0.08) : transparent;
                    toc-row := HorizontalLayout {
                        padding-left: 12px + 14px * max(0, t.level - 1);
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: t.title;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            font-weight: t.level <= 1 ? 700 : 400;
                            color: M3.on-surface;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: t.page;
                            vertical-alignment: center;
                            font-size: Type.label;
                            color: M3.on-surface-variant;
                        }
                    }

                    tta := TouchArea {
                        clicked => {
                            AppState.reader-goto(t.idx);
                        }
                    }
                }
            }

            // barra flottante: sezione precedente, indice, successiva, quiz sull'argomento
            if !AppState.rd-toc-visible: Rectangle {
                width: min(parent.width - 32px, bar.preferred-width + 16px);
                height: 64px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 14px;
                border-radius: 32px;
                background: M3.surface-container-high;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: #00000033;
                bar := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.chevron-left;
                            tint: M3.on-surface;
                            enabled: AppState.rd-has-prev;
                            clicked => {
                                AppState.reader-prev();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.toc;
                            tint: M3.on-surface;
                            clicked => {
                                AppState.rd-toc-visible = true;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.chevron;
                            tint: M3.on-surface;
                            enabled: AppState.rd-has-next;
                            clicked => {
                                AppState.reader-next();
                            }
                        }
                    }
                    if AppState.rd-topic != "": VerticalLayout {
                        alignment: center;
                        padding-left: 6px;
                        M3Button {
                            text: AppState.rd-quiz-label;
                            has-icon: true;
                            icon: Icons.quiz;
                            clicked => {
                                AppState.start-practice("topic", AppState.rd-topic);
                            }
                        }
                    }
                }
            }
        }
    }
}
