import { M3, Icons, Type } from "../theme.slint";
import { AppState, SimRowVM } from "../state.slint";
import { Page, TopBar, Scroller, Card, Hint } from "../components.slint";

// una riga del registro: data, punteggio con barra, esito; si tocca per rivederla
component SimRow inherits Rectangle {
    in property <SimRowVM> r;
    border-radius: 16px;
    background: ta.pressed ? M3.surface-container-high : M3.surface-container;
    ta := TouchArea {
        clicked => {
            AppState.simlog-open(root.r.id);
        }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.r.title;
                    font-weight: 700;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                Text {
                    text: root.r.date;
                    font-size: Type.label;
                    color: M3.on-surface-variant;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.r.points;
                    font-size: Type.title;
                    font-weight: 700;
                    color: M3.on-surface;
                    horizontal-alignment: right;
                }
                if root.r.has-pass: Text {
                    text: root.r.passed ? "superata" : "non superata";
                    font-size: Type.label;
                    font-weight: 700;
                    color: root.r.passed ? M3.primary : M3.error;
                    horizontal-alignment: right;
                }
            }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: M3.surface-container-highest;
            Rectangle {
                x: 0;
                width: parent.width * root.r.frac;
                border-radius: 3px;
                background: root.r.has-pass && !root.r.passed ? M3.error : M3.primary;
            }
        }
        Text {
            text: root.r.detail;
            font-size: Type.label;
            color: M3.on-surface-variant;
            wrap: word-wrap;
        }
    }
}

// registro delle simulazioni: media, andamento e l'elenco da rivedere
export component SimLogPage inherits Page {
    VerticalLayout {
        TopBar {
            title: "Registro simulazioni";
            subtitle: AppState.exam-name;
            can-back: true;
            back => {
                AppState.back();
            }
        }
        Scroller {
            vertical-stretch: 1;
            align: start;
            pad: 16px;
            pad-top: 4px;
            gap: 10px;
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: AppState.sim-summary;
                        font-size: Type.title;
                        font-weight: 700;
                        color: M3.on-surface;
                        wrap: word-wrap;
                    }
                    if AppState.sim-details != "": Text {
                        text: AppState.sim-details;
                        font-size: Type.label;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    // andamento delle ultime simulazioni, dalla più vecchia; linea = soglia
                    if AppState.sim-bars.length > 1: Rectangle {
                        height: 90px;
                        chart := HorizontalLayout {
                            spacing: 4px;
                            alignment: stretch;
                            for f in AppState.sim-bars: Rectangle {
                                horizontal-stretch: 1;
                                max-width: 28px;
                                Rectangle {
                                    y: parent.height * (1 - f);
                                    height: max(2px, parent.height * f);
                                    border-radius: 4px;
                                    background: AppState.sim-pass-frac > 0 && f < AppState.sim-pass-frac ? M3.error.with-alpha(0.75) : M3.primary;
                                }
                            }
                        }
                        if AppState.sim-pass-frac > 0: Rectangle {
                            y: parent.height * (1 - AppState.sim-pass-frac);
                            height: 1px;
                            background: M3.on-surface-variant;
                        }
                    }
                }
            }
            if AppState.sim-count == 0: Hint {
                short: "Le simulazioni che fai finiscono qui.";
                full: "Ogni simulazione d'esame completata (anche le prove ufficiali) finisce in questo registro con punteggio, esito e durata; toccala per rivedere domanda per domanda le risposte e le spiegazioni.";
            }
            for r in AppState.sim-rows: SimRow {
                r: r;
            }
        }
    }
}
