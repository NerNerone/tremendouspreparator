// Traguardo: scheda «Tu». Profilo, numeri, registro e statistiche, poi le Opzioni in quattro riquadri.
import { M3, Icons, Type, Shape } from "../theme.slint";
import { AppState } from "../state.slint";
import { Page, Icon, Scroller, GRow, GroupLabel } from "../components.slint";
import { Avatar } from "group.slint";

// numero grande con didascalia
component TuStat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    horizontal-stretch: 1;
    min-width: 0px;
    height: 68px;
    border-radius: 20px;
    background: M3.surface-container;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.value;
            font-size: 24px;
            font-weight: 900;
            color: M3.on-surface;
            overflow: elide;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: M3.on-surface-variant;
            overflow: elide;
        }
    }
}

// riquadro colorato di un gruppo di Opzioni
component OptTile inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> sub;
    in property <color> bg;
    in property <color> box;
    in property <color> on-box;
    callback clicked;
    height: max(128px, ot.preferred-height);
    border-radius: ta.pressed ? 20px : 28px;
    animate border-radius { duration: 150ms; }
    background: root.bg;
    ot := VerticalLayout {
        padding: 16px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: root.box;
                Icon {
                    x: 9px;
                    y: 9px;
                    width: 22px;
                    height: 22px;
                    source: root.icon;
                    tint: root.on-box;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Text {
            text: root.title;
            font-size: 17px;
            font-weight: 800;
            color: M3.on-surface;
            wrap: word-wrap;
        }
        Text {
            text: root.sub;
            font-size: 12px;
            color: M3.on-surface-variant;
            wrap: word-wrap;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TuPage inherits Page {
    Scroller {
        pad: 16px;
        pad-top: 18px;
        gap: 14px;
        align: start;

        // profilo
        HorizontalLayout {
            spacing: 14px;
            Avatar {
                width: 64px;
                photo: AppState.my-photo;
                has-photo: AppState.my-has-photo;
                initial: AppState.my-initial;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: AppState.s-username != "" ? AppState.s-username : "Tu";
                    font-size: 26px;
                    font-weight: 900;
                    color: M3.on-surface;
                    overflow: elide;
                }
                Text {
                    text: (AppState.my-user-id != "" ? "id " + AppState.my-user-id : "Profilo, statistiche e opzioni")
                        + (AppState.p2p-peers.length > 0 ? " · " + (AppState.p2p-peers.length + 1) + " dispositivi collegati" : "");
                    font-size: 13px;
                    color: M3.on-surface-variant;
                    overflow: elide;
                }
            }
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: eta.pressed ? M3.on-surface.with-alpha(0.08) : transparent;
                Icon {
                    x: 12px;
                    y: 12px;
                    width: 24px;
                    height: 24px;
                    source: Icons.edit;
                    tint: M3.on-surface-variant;
                }
                eta := TouchArea {
                    clicked => {
                        AppState.open-setting(0);
                    }
                }
            }
        }

        // tre numeri
        HorizontalLayout {
            spacing: 8px;
            TuStat {
                value: AppState.tu-time;
                label: "studio";
            }
            TuStat {
                value: AppState.tu-answers;
                label: "risposte";
            }
            TuStat {
                value: AppState.tu-acc;
                label: "giuste";
            }
        }

        // registro delle simulazioni (solo se il pacchetto prevede una prova o ce n'è già una) e tempi
        VerticalLayout {
            spacing: 3px;
            property <bool> sim: AppState.exam-rules != "" || AppState.sim-count > 0;
            if self.sim: GRow {
                last: false;
                icon: Icons.history;
                title: "Registro simulazioni";
                sub: AppState.sim-count > 0 ? AppState.sim-count + " fatte · media " + AppState.sim-avg : "Nessuna ancora · la prima vale più di 10 quiz";
                trail: 1;
                clicked => {
                    AppState.open-simlog();
                }
            }
            GRow {
                first: !parent.sim;
                icon: Icons.bar-chart;
                title: "Statistiche e tempi";
                sub: AppState.tu-pace;
                trail: 1;
                clicked => {
                    AppState.go-tab(1);
                }
            }
        }

        GroupLabel {
            text: "Opzioni";
        }

        HorizontalLayout {
            spacing: 8px;
            OptTile {
                icon: Icons.palette;
                width: (parent.width - 8px) / 2;
                title: "Tu e l'aspetto";
                sub: "Profilo, tema, colore";
                bg: M3.primary-container;
                box: M3.primary;
                on-box: M3.on-primary;
                clicked => {
                    AppState.open-setting(0);
                }
            }
            OptTile {
                icon: Icons.devices;
                width: (parent.width - 8px) / 2;
                title: "Dispositivi";
                sub: "Sincronizza, condividi pacchetti";
                bg: M3.tertiary-container;
                box: M3.on-tertiary-container;
                on-box: M3.tertiary-container;
                clicked => {
                    AppState.open-setting(2);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            OptTile {
                icon: Icons.school;
                width: (parent.width - 8px) / 2;
                title: "Studio";
                sub: "Esame e barra, promemoria";
                bg: M3.success-container;
                box: M3.success;
                on-box: M3.success-container;
                clicked => {
                    AppState.open-setting(6);
                }
            }
            OptTile {
                icon: Icons.update;
                width: (parent.width - 8px) / 2;
                title: "App";
                sub: "Contenuti, aggiornamenti, novità, note legali";
                bg: M3.surface-container-high;
                box: M3.on-surface-variant;
                on-box: M3.surface-container-high;
                clicked => {
                    AppState.open-setting(4);
                }
            }
        }
    }
}
