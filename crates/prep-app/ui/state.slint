// Stato condiviso tra UI e Rust.

export struct SubjectVM {
    id: string,
    // posizione nel pacchetto: sceglie il colore
    n: int,
    name: string,
    // nome breve per i selettori
    short: string,
    mastery: float,
    predicted: string,
    flagged: int,
    due: int,
    new-cards: int,
    learned: int,
    questions: int,
    note: string,
    pace: string,
    // icona dal pacchetto (vedi prep_core::icons): tracciato con il suo riquadro, oppure le
    // iniziali; colore della materia se il pacchetto lo indica
    glyph: string,
    vbx: float,
    vby: float,
    vbw: float,
    vbh: float,
    mono: string,
    color: color,
    own-color: bool,
    // punteggio atteso (solo il numero, es. «9,8»)
    score: string,
}

export struct UnitVM {
    id: string,
    n: int,
    name: string,
    cfu: string,
    mastery: float,
    touched: float,
    questions: int,
    cards: int,
    flagged: int,
    note: string,
    time: string,
}

export struct TopicVM {
    id: string,
    name: string,
    mastery: float,
    detail: string,
    has-ai: bool,
    ai-text: string,
    note: string,
    questions: int,
}

export struct OptionVM {
    letter: string,
    text: string,
    state: int,
    // dopo la risposta: perché questa opzione è giusta o sbagliata
    note: string,
}

export struct NavCellVM {
    n: int,
    answered: bool,
    unsure: bool,
    current: bool,
}

export struct NavRowVM {
    cells: [NavCellVM],
}

export struct ResultItemVM {
    n: int,
    text: string,
    status: int, // 0 corretta, 1 sbagliata, 2 omessa, 3 flashcard
    unsure: bool,
    given: string,
    correct-text: string,
    explanation: string,
    ref-label: string,
    secs: string,
    slow: bool,
}

export struct BlockVM {
    kind: int, // 0 titolo, 1 paragrafo, 2 punto elenco, 3 numerato, 4 citazione, 5 mono, 6 pagina, 7 figura, 8 riga, 9 riga di tabella, 10 formula SVG, 11 formula testo
    text: string,
    level: int, // per le righe di tabella: 1 = intestazione
    label: string,
    cells: [string],
    // righe di tabella: larghezza di ogni colonna (frazioni, uguali per tutta la tabella)
    widths: [float],
    img: image,
}

export struct TocVM {
    idx: int,
    title: string,
    level: int,
    page: string,
    current: bool,
}

export struct FeedbackVM {
    date: string,
    title: string,
    text: string,
    rating: int,
    status: string,
    reply: string,
    pending: bool,
}

export struct BookVM {
    id: string,
    title: string,
    author: string,
    chapters: int,
    available: bool,
}

export struct FlagVM {
    id: string,
    text: string,
    where: string,
    flagged: bool,
    wrong: bool,
}

// opzione selezionabile del quiz personalizzato (materia, unità o fonte)
export struct QzOptVM {
    id: string,
    name: string,
    group: string,
    sel: bool,
    count: int,
    // intestazione di materia (espandibile) nell'elenco delle unità
    head: bool,
    open: bool,
}

// esame installato (selettore in Home)
// file dei contenuti dell'esame (pagina «Contenuti»)
export struct ContentFileVM {
    path: string,
    // tipo: Esame, Quiz, Flashcard, Catalogo dei libri, Capitolo, Figura
    kind: string,
    name: string,
    info: string,
    // primo file del suo tipo: sopra va l'intestazione del gruppo
    head: bool,
}

// una simulazione del registro
export struct NewsVM {
    date: string,
    items: [string],
}

export struct SimRowVM {
    id: string,
    date: string,
    title: string,
    points: string,
    // punti / massimo (0..1), per la barra
    frac: float,
    has-pass: bool,
    passed: bool,
    detail: string,
}

export struct ExamVM {
    id: string,
    name: string,
    active: bool,
    info: string,
}

// scheda informativa definita dal pacchetto dell'esame
export struct ExamSectionVM {
    title: string,
    summary: string,
    body: string,
}

// app installata, per la concentrazione (permessa o no)
export struct FocusAppVM {
    pkg: string,
    label: string,
    icon: image,
    has-icon: bool,
    allowed: bool,
}

// colore selezionabile (monoposto); auto = accento di sistema
export struct SwatchVM {
    color: color,
    value: int,
    sel: bool,
    auto: bool,
}

// telefono trovato via Bluetooth
export struct BtDevVM {
    name: string,
    address: string,
}

// sincronizzazione tra dispositivi
export struct OfferVM {
    peer: string,
    exam: string,
    label: string,
}

export struct PeerVM {
    id: string,
    name: string,
    info: string,
    offers: [OfferVM],
}

// studio di gruppo
export struct GroupVM {
    id: string,
    name: string,
    active: bool,
}

// monoposto sul circuito. In pista e al pit stop la posizione è la frazione di giro `f`
// (le parti intere sono i giri: si anima senza salti); ferma al paddock in (px, py).
// meccanico al pit stop (coordinate della monoposto, vedi prep_core::group::pit_crew)
export struct CrewVM {
    x: float,
    y: float,
    rot: float,
    tool: bool,
    tire: bool,
    sign: bool,
    alt: bool,
}

export struct CarVM {
    id: string,
    crew: [CrewVM],
    f: float,
    // velocità in giri al secondo (0 se ferma): tra un aggiornamento e l'altro la posizione
    // avanza da sola, fotogramma per fotogramma
    v: float,
    color: color,
    label: string,
    me: bool,
    racing: bool,
    pit: bool,
    parked: bool,
    offline: bool,
    // scostamento laterale (corsie; ±3,6 = fuori pista, al pit stop)
    lane: float,
    // lato del pit stop: 1 = a destra della marcia, -1 = a sinistra (la squadra si specchia)
    side: float,
    // piazzole in fila verso l'esterno quando più macchine si fermano vicine (0 = la prima)
    stack: float,
    // tratto (frazione di giro) percorso per uscire di pista fino alla piazzola
    run: float,
    px: float,
    py: float,
    // effetti in corso (bit): 1 ritmo (fiamma), 2 gomme nuove (scintille), 4 concentrazione
    // (alone e scia blu), 8 penalità (fumo), 16 scia di gruppo (vento), 32 bandiera gialla
    fx: int,
    // moltiplicatore dei punti (velocità) e intensità del ritmo (0..1)
    mult: float,
    level: float,
}

// un giorno del calendario del gruppo: numero del giorno, giorni fa (-1 = fuori dal periodo),
// intensità 0..4 (-1 = fuori), toccato, oggi
export struct GHeatVM {
    day: string,
    idx: int,
    level: int,
    sel: bool,
    today: bool,
}

// creatore di pacchetti: un file dell'esame (kind: 0 esame, 1 capitolo, 2 quiz, 3 flashcard)
export struct CrFileVM {
    path: string,
    kind: int,
    title: string,
    info: string,
}

// una riga del controllo dei contenuti (head = titolo di gruppo)
export struct QaLineVM {
    text: string,
    head: bool,
}

// creatore: una figura di un capitolo
export struct CrFigVM {
    alt: string,
    path: string,
    present: bool,
}

// creatore: un'unità tra cui scegliere gli argomenti (id vuoto = tutti)
export struct CrUnitVM {
    id: string,
    label: string,
}

// un giorno della mappa di calore: intensità 0..4 (-1 = giorno che deve ancora venire)
// un giorno della mappa di calore: livello 0..4, -1 fuori dal mese, -2 senza dati
export struct HeatVM {
    level: int,
    label: string,
    day: string,
}

export struct RankVM {
    pos: int,
    // id utente del membro
    id: string,
    name: string,
    color: color,
    value: string,
    laps: int,
    status: string,
    me: bool,
    photo: image,
    has-photo: bool,
    initial: string,
    admin: bool,
    // moltiplicatore in corso («×2.5»), vuoto se normale
    boost: string,
    // tempo di studio nel periodo della classifica
    time: string,
    // in pista adesso (si può seguire)
    racing: bool,
}

export struct ExamDateVM {
    label: string,
    date: string,
    days: int,
}

export struct ElementVM {
    z: int,
    sym: string,
    name: string,
    mass: string,
    col: int, // 1..18
    row: int, // 1..7, 9 lantanidi, 10 attinidi
    cat: int,
}

export struct ElementDetailVM {
    z: int,
    sym: string,
    name: string,
    cat: int,
    cat-name: string,
    mass: string,
    config: string,
    protons: string,
    electrons: string,
    neutrons: string,
    position: string,
    en: string,
    ea: string,
    ie: string,
    radius: string,
    state: string,
    ox: string,
    metal: string,
    tendency: string,
    bonds: string,
}

export struct GoalVM {
    topic: string,
    name: string,
    info: string,
    done: int,
    target: int,
    selected: bool,
}

export global AppState {
    // solo test desktop (PREP_DRAGPAN=1): il mouse trascina il contenuto come un dito
    in property <bool> drag-pan: false;
    // tracciato della barra ondulata (calcolato in Rust): onda da x0 a x1 centrata su cy,
    // ampiezza amp, lunghezza d'onda wl, fase 0..1; coordinate in pixel logici
    pure callback wave-path(float, float, float, float, float, float) -> string;
    // navigazione: 0 home, 1 studio, 2 unità, 3 quiz, 4 risultati, 5 flashcard, 6 insicure, 7 impostazioni, 8 mazzi, 9 lettore, 10 feedback, 11 obiettivi, 12 tavola periodica
    in-out property <int> page: 0;
    in-out property <int> tab: 0;

    // home
    in property <float> overall;
    // fascia di Oggi (Traguardo): giorni al prossimo appello, punteggio atteso, soglia, tempo
    in property <int> hero-days: -1;
    in property <string> hero-days-label;
    in property <string> hero-days-sub;
    in property <string> hero-expected;
    in property <string> hero-time;
    in property <float> pass-frac;
    in property <string> pass-label;
    in property <bool> pass-ok;
    in property <int> goals-done-n;
    // Oggi, scorrendo: settimana di studio, serie di giorni, posizione in gara
    in property <[float]> week-bars;
    in property <int> week-today;
    in property <string> week-total;
    in property <int> streak-days;
    in property <string> home-race-title;
    in property <string> home-race-sub;
    in property <string> overall-label;
    in property <string> total-time;
    in property <string> paused-title;
    in property <string> paused-info;
    // barra della sessione (Traguardo, da Notturno): domanda a cui si è arrivati e frazione fatta
    in property <int> paused-n;
    in property <float> paused-frac;
    in property <string> paused-short;
    in property <[ExamDateVM]> exam-dates;
    // obiettivi del giorno: proposta (confirmed = false) o obiettivi confermati con avanzamento
    in property <[GoalVM]> goals;
    in property <bool> goals-confirmed;
    in property <string> goals-note;
    in property <string> goals-status;
    // obiettivi di oggi ancora da completare (badge della scheda)
    in property <int> goals-left;
    // ripasso distanziato: argomenti non toccati da qualche giorno
    in property <[GoalVM]> review-goals;
    // scorrimento della Home (l'intestazione si comprime)
    in-out property <length> home-scroll;
    /// la barra ondulata della Home ha già fatto l'animazione d'ingresso in questa sessione
    in-out property <bool> home-intro-done;
    /// Obiettivi: riquadro espanso dal tocco ("g:<topic>" o "r:<topic>"), mostra Studia / Allenati / Ripassa
    in-out property <string> goals-open;
    in property <[SubjectVM]> subjects;
    in property <int> flagged-count;
    in property <int> wrong-count;
    in property <int> due-count;
    in property <string> ai-summary;
    in property <[string]> ai-priorities;
    in property <string> sync-status;
    /// proprietario, repository e token GitHub impostati
    in property <bool> sync-configured;
    // pacchetto contenuti (quiz, flashcard, libri in un file)
    in property <string> pack-status;
    in property <[ContentFileVM]> content-files;
    in property <string> contents-status;
    in property <bool> pack-busy;
    in property <bool> on-android;
    in property <bool> syncing;
    in property <string> content-info;
    // nessun esame installato (la Home invita a importare un pacchetto)
    in property <bool> no-exam;
    in property <[ExamSectionVM]> exam-sections;
    // prove ufficiali della materia scelta (tag, etichetta)
    in property <[QzOptVM]> official-tests;
    in-out property <string> toast;

    // studio
    in-out property <string> current-subject;
    in property <int> current-subject-n;
    in property <[UnitVM]> units;
    in property <UnitVM> unit;
    in property <[TopicVM]> topics;

    // quiz
    in property <int> quiz-mode; // 0 allenamento, 1 simulazione, 2 ripasso
    in property <string> quiz-title;
    in property <int> q-index;
    in property <int> q-total;
    in property <string> q-text;
    in property <string> q-topic;
    in property <bool> q-is-mcq;
    in property <[OptionVM]> q-options;
    in-out property <string> q-fill;
    in property <bool> q-unsure;
    in property <bool> q-answered;
    in property <bool> q-correct;
    in property <string> q-correct-text;
    in property <string> q-explanation;
    // testo di provenienza della domanda (libro, eserciziario, prova ufficiale)
    in property <string> q-source;
    in property <bool> q-can-confirm;
    in property <string> q-ref;
    in property <string> q-elapsed;
    in property <bool> q-slow;
    in property <string> time-left;
    in property <bool> time-warning;
    in property <[NavRowVM]> nav-rows;
    in property <int> answered-count;

    // risultati
    in property <string> r-title;
    in property <string> r-points;
    in property <string> r-summary;
    in property <bool> r-is-exam;
    in property <bool> r-passed;
    in property <[ResultItemVM]> r-items;
    in property <string> r-sync;
    in-out property <int> r-rating;
    in-out property <string> r-feedback;
    in property <bool> r-feedback-sent;

    // flashcard
    in property <string> c-front;
    in property <string> c-back;
    in property <string> c-topic;
    in property <bool> c-flipped;
    in property <bool> c-unsure;
    in property <int> c-index;
    in property <int> c-total;
    in property <bool> c-done;
    in property <string> c-summary;
    in property <string> c-ref;
    in-out property <string> c-note;
    in property <string> c-note-shown;

    // libri e lettore
    in property <[BookVM]> books;
    in property <string> rd-book;
    in property <string> rd-title;
    in property <string> rd-page-label;
    in property <[BlockVM]> rd-blocks;
    in property <bool> rd-has-prev;
    in property <bool> rd-has-next;
    in-out property <bool> rd-toc-visible;
    in property <[TocVM]> rd-toc;
    in-out property <length> rd-scroll;

    // insicure: domande (scheda Quiz) e flashcard (scheda Flashcard)
    in property <[FlagVM]> flags;
    in property <[FlagVM]> card-flags;
    in property <int> card-flagged-count;

    // note legali: da accettare al primo avvio (e quando cambiano), poi consultabili in Opzioni
    in-out property <bool> legal-visible;
    in property <bool> legal-required;
    in property <string> legal-text;
    callback legal-accept();

    // studio di gruppo
    in property <[GroupVM]> groups;
    in property <bool> group-has;
    in property <string> group-name;
    // fuori gara (paddock flottante sotto la finestra della gara)
    in property <int> paddock-n;
    // solo le monoposto nel paddock (fuori gara), per la pillola sotto la gara
    in property <[CarVM]> paddock-cars;
    // in concentrazione: chi ti precede («Marta 18 m davanti · la stai prendendo»)
    in property <string> ahead-text;
    in property <string> group-id;
    in property <string> group-info;
    in property <[CarVM]> cars;
    // telecamera: punto inquadrato (coordinate della pista) e scritte sopra la gara
    in property <float> cam-f;
    in property <float> cam-side: 1;
    in property <float> cam-stack: 0;
    in property <float> cam-run: 0;
    // aggiornamento dell'app (build privata): versione disponibile, download in corso
    in property <string> update-version;
    in property <bool> update-busy;
    callback update-install();
    // giri al secondo in pista
    in property <float> lap-speed: 0.0166667;
    in property <string> track-cmd;
    in property <float> track-aspect: 2.4;
    in property <float> track-scale: 1;
    in property <float> pad-x: 0.5;
    in property <float> pad-y: 0.65;
    in property <float> pad-w: 0.2;
    in-out property <string> car-sel;
    in property <string> car-info-title;
    in property <string> car-info-body;
    // scheda della monoposto: stato (0 non collegato, 1 in pista, 2 pit stop, 3 al paddock),
    // tempi, righe di dettaglio, seguita dalla telecamera, è la propria
    in property <int> car-info-kind;
    in property <string> car-info-state;
    in property <string> car-info-today;
    in property <string> car-info-week;
    in property <string> car-info-month;
    in property <[string]> car-info-lines;
    in property <bool> car-info-following;
    in property <bool> car-info-me;
    in property <bool> car-info-racing;
    callback car-close();
    callback car-follow(string);
    // calendario: «Tu», gli altri membri, «Gruppo» (etichette, id: "" = tu, "*" = gruppo)
    in property <[string]> cal-labels;
    in property <[string]> cal-ids;
    in property <int> cal-index;
    callback cal-pick(int);
    callback car-tap(string);
    in property <string> race-hud;
    // vista d'insieme del circuito (chi è in pausa o fermo) invece della telecamera ravvicinata
    in property <bool> race-overview: true;
    in property <[RankVM]> ranking;
    in property <int> study-state;
    in property <string> study-today;
    in property <float> study-lap;
    in property <int> lap-flash;
    in-out property <int> group-period;
    in property <string> group-link;
    in property <bool> focus-available;
    // modalità concentrazione (Android)
    in-out property <bool> focus-open;
    in property <bool> focus-usage-ok;
    in property <bool> focus-overlay-ok;
    // Android 13+: «impostazioni con limitazioni» attive (app installata da un file APK)
    in property <bool> focus-restricted;
    // sessione di studio aperta su un altro proprio dispositivo (qui non se ne apre un'altra)
    in property <bool> study-elsewhere;
    in property <bool> focus-active;
    in property <string> focus-status;
    in property <int> focus-minutes: 50;
    in property <bool> focus-confirm;
    in property <string> focus-confirm-text;
    in property <[FocusAppVM]> focus-apps;
    in property <[FocusAppVM]> focus-launcher;
    callback focus-setup(bool);
    callback focus-toggle(string);
    // ricerca per nome tra le app da permettere
    callback focus-search(string);
    // strumenti per l'AI: dividere un PDF, estrarne il testo
    callback open-pdf-tools();
    // creatore di pacchetti guidato
    // true: un pacchetto nuovo (si parte dal nome); false: quello in uso
    callback open-creator(bool);
    // registro delle simulazioni
    callback open-simlog();
    callback simlog-open(string);
    in property <int> sim-count;
    in property <string> sim-summary;
    // solo la media («2,3 / 6,0»), per le etichette corte
    in property <string> sim-avg;
    in property <string> sim-details;
    in property <[SimRowVM]> sim-rows;
    in property <[float]> sim-bars;
    // soglia di superamento (frazione del massimo), 0 se non si può disegnare
    in property <float> sim-pass-frac;
    in property <bool> cr-has-exam;
    // creatore aperto per un pacchetto nuovo: si chiede il nome anche se un esame è in uso
    in-out property <bool> cr-new;
    in property <string> cr-exam;
    in property <bool> cr-has-syllabus;
    in property <[CrFileVM]> cr-files;
    in property <[CrUnitVM]> cr-units;
    in property <string> cr-bar;
    in-out property <bool> cr-open;
    in-out property <int> cr-kind;
    in-out property <string> cr-path;
    in-out property <string> cr-title;
    in-out property <string> cr-name;
    in-out property <string> cr-text;
    in-out property <string> cr-status;
    in-out property <string> cr-prompt;
    in-out property <string> cr-unit;
    in-out property <int> cr-count: 30;
    in-out property <bool> cr-notes;
    callback cr-create-exam(string);
    callback cr-open-file(int, string);
    callback cr-refresh-prompt();
    callback cr-save();
    // figure del capitolo aperto; capitolo da cui si è aperta una figura
    in property <[CrFigVM]> cr-figs;
    in-out property <string> cr-parent;
    callback cr-open-figure(string);
    callback cr-close();
    callback pdf-split();
    callback pdf-text();
    callback pdf-ocr();
    callback pdf-stop();
    in property <bool> pdf-ocr-running;
    in property <bool> ocr-available: true;
    in-out property <float> pdf-max-mb: 20;
    // pagine da usare («25-30, 40»; vuoto = tutte)
    in-out property <string> pdf-pages;
    in property <bool> pdf-busy;
    in property <string> pdf-status;
    // «Cerca aggiornamenti»: solo nelle build che si aggiornano da sole
    in property <bool> update-can-check;
    in property <bool> update-checking;
    callback update-check();
    // novità dopo un aggiornamento (o da Opzioni)
    in-out property <bool> news-visible;
    in property <string> news-title;
    in property <[NewsVM]> news-rows;
    callback news-all();
    // tempo che manca alla fine del blocco a tempo («23:41»; vuoto dopo la scadenza)
    in property <string> focus-left;
    in property <float> focus-left-frac;
    callback focus-set-minutes(int);
    callback focus-start();
    callback focus-perm(string);
    callback focus-launch(string);
    callback focus-dial();
    in-out property <string> group-new-name;
    in-out property <string> group-join-text;
    callback group-create(string);
    callback group-join(string);
    callback group-select(string);
    callback group-leave(string);
    callback group-invite();
    callback group-set-period(int);
    // codice del gruppo (accesso principale), amministratore, foto, avvisi
    in property <string> group-code;
    in property <bool> group-admin;
    in property <string> group-admin-name;
    in property <image> group-photo;
    in property <bool> group-has-photo;
    in property <string> group-initial;
    in-out property <string> member-sel;
    // mappa di calore (ultime 12 settimane): la propria e quella del membro toccato
    in property <[HeatVM]> my-heat;
    in property <[HeatVM]> member-heat;
    in property <string> my-heat-total;
    // mese mostrato e frecce (0 = la propria, 1 = membro toccato, 2 = profilo)
    in property <string> my-heat-title;
    in property <bool> my-heat-prev;
