    callback sync-now();
    callback save-settings();
    callback import-pack();
    callback open-contents();
    callback contents-add();
    callback contents-remove(string);
    callback contents-export();
    // controllo di qualità dei contenuti: riassunto e righe («# Titolo» per i gruppi)
    callback contents-check();
    in property <string> qa-summary;
    in property <[QaLineVM]> qa-lines;
    callback save-reminder();
    callback goals-toggle(int);
    callback goals-confirm();
    callback goals-edit();
    callback goals-train(string);
    callback goals-study(string);
    callback goals-review(string);
    callback goals-add(string);
    callback goals-remove(int);
