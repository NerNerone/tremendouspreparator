    in-out property <bool> photo-view-group;
    // profilo di un membro (aperto dalla classifica)
    in property <bool> profile-open;
    in property <string> profile-id;
    in property <string> profile-name;
    in property <image> profile-photo;
    in property <bool> profile-has-photo;
