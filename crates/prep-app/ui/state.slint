    in property <color> car-info-color;
    in property <string> car-info-initial;
    callback study-start();
    callback study-pause();
    callback study-stop();
    callback open-goals();

    // esami installati
    in property <[ExamVM]> exams;
    in property <string> exam-name;
    in-out property <bool> exam-menu;
