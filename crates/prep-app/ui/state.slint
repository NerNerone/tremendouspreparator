    in property <[PeerVM]> p2p-peers;
    callback p2p-connect();
    callback p2p-disconnect();
    callback p2p-download(string, string);
    // Bluetooth tra telefoni vicini (Android)
    in property <bool> bt-available;
    in property <bool> bt-connected;
    in property <string> bt-status;
    in property <[BtDevVM]> bt-devices;
    callback bt-listen();
    callback bt-scan();
    callback bt-connect(string);
    callback bt-close();
    // condivisione di un esame con un'altra persona (codice usa e getta)
    in property <bool> share-on;
    in property <bool> share-sending;
    in property <string> share-code;
    in property <string> share-status;
    in property <string> share-exam;
