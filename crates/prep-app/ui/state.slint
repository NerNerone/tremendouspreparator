    // quiz personalizzato
    in property <[QzOptVM]> qz-subjects;
    in property <[QzOptVM]> qz-units;
    in property <[QzOptVM]> qz-sources;
    // repository GitHub dei dati (spento di default): rami, ramo dell'esame aperto
    in-out property <bool> s-github-on;
    in property <[QzOptVM]> gh-branches;
    in property <string> gh-branch-status;
    in property <string> gh-exam-branch;
