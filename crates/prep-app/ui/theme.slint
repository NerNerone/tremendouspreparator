// Token Material 3 (schema baseline, chiaro/scuro secondo il sistema).
import { Palette } from "std-widgets.slint";

export global M3 {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // colori di sistema (Material You su Android 12+): ruoli nell'ordine di `dyn_roles` in
    // src/palette.rs, per il tema chiaro e quello scuro; senza, la tavolozza viola di base
    in-out property <bool> dynamic: false;
    in-out property <[color]> dyn-light;
    in-out property <[color]> dyn-dark;
    property <[color]> dyn: dark ? dyn-dark : dyn-light;

    out property <color> primary: dynamic ? dyn[0] : (dark ? #D0BCFF : #6750A4);
    out property <color> on-primary: dynamic ? dyn[1] : (dark ? #381E72 : #FFFFFF);
    out property <color> primary-container: dynamic ? dyn[2] : (dark ? #4F378B : #EADDFF);
    out property <color> on-primary-container: dynamic ? dyn[3] : (dark ? #EADDFF : #21005D);
    out property <color> secondary: dynamic ? dyn[4] : (dark ? #CCC2DC : #625B71);
    out property <color> secondary-container: dynamic ? dyn[5] : (dark ? #4A4458 : #E8DEF8);
    out property <color> on-secondary-container: dynamic ? dyn[6] : (dark ? #E8DEF8 : #1D192B);
    out property <color> tertiary-container: dynamic ? dyn[7] : (dark ? #633B48 : #FFD8E4);
    out property <color> on-tertiary-container: dynamic ? dyn[8] : (dark ? #FFD8E4 : #31111D);
    out property <color> surface: dynamic ? dyn[9] : (dark ? #141218 : #FEF7FF);
    out property <color> surface-container-low: dynamic ? dyn[10] : (dark ? #1D1B20 : #F7F2FA);
    out property <color> surface-container: dynamic ? dyn[11] : (dark ? #211F26 : #F3EDF7);
    out property <color> surface-container-high: dynamic ? dyn[12] : (dark ? #2B2930 : #ECE6F0);
    out property <color> surface-container-highest: dynamic ? dyn[13] : (dark ? #36343B : #E6E0E9);
    out property <color> on-surface: dynamic ? dyn[14] : (dark ? #E6E0E9 : #1D1B20);
    out property <color> on-surface-variant: dynamic ? dyn[15] : (dark ? #CAC4D0 : #49454F);
    out property <color> outline: dynamic ? dyn[16] : (dark ? #938F99 : #79747E);
    out property <color> outline-variant: dynamic ? dyn[17] : (dark ? #49454F : #CAC4D0);
    out property <color> error: dark ? #F2B8B5 : #B3261E;
    out property <color> on-error: dark ? #601410 : #FFFFFF;
    out property <color> error-container: dark ? #8C1D18 : #F9DEDC;
    out property <color> on-error-container: dark ? #F9DEDC : #410E0B;
    out property <color> success: dark ? #7DD99A : #1B6B38;
    out property <color> success-container: dark ? #1F5130 : #C9F0D3;
    out property <color> on-success-container: dark ? #C9F0D3 : #062111;
    out property <color> warn-container: dark ? #5C3B00 : #FFDDB3;
    out property <color> on-warn-container: dark ? #FFDDB3 : #2A1800;
    out property <color> inverse-surface: dynamic ? dyn[18] : (dark ? #E6E0E9 : #322F35);
    out property <color> inverse-on-surface: dynamic ? dyn[19] : (dark ? #322F35 : #F5EFF7);
    out property <color> scrim: #00000099;

    /// colore della materia n-esima del pacchetto (si ripete dopo sei)
    public pure function subject(n: int) -> color {
        if (Math.mod(n, 6) == 0) { return dark ? #9ECAFF : #0061A4; }
        if (Math.mod(n, 6) == 1) { return dark ? #7DD99A : #1B6B38; }
        if (Math.mod(n, 6) == 2) { return dark ? #FFB4A8 : #A23F2F; }
        if (Math.mod(n, 6) == 3) { return dark ? #D0BCFF : #6750A4; }
        if (Math.mod(n, 6) == 4) { return dark ? #FFB870 : #8B5000; }
        return dark ? #80D5D4 : #006A6A;
    }

    /// tavola periodica: colore di fondo e del testo per famiglia di elementi
    /// (0 non metallo, 1 gas nobile, 2 alcalino, 3 alcalino-terroso, 4 semimetallo, 5 alogeno,
    /// 6 metallo del blocco p, 7 transizione, 8 lantanide, 9 attinide)
    public pure function element(cat: int) -> color {
        if (cat == 0) { return dark ? #2E5A3A : #CDEFD5; }
        if (cat == 1) { return dark ? #4A3F6B : #E4DBFF; }
        if (cat == 2) { return dark ? #6B3A2E : #FFD6CC; }
        if (cat == 3) { return dark ? #6B4E1F : #FFE3B8; }
        if (cat == 4) { return dark ? #2E5560 : #C8EEF2; }
        if (cat == 5) { return dark ? #5A5A1F : #F4F0B5; }
        if (cat == 6) { return dark ? #3B4A5C : #D6E2EF; }
        if (cat == 7) { return dark ? #24456B : #CFE2FF; }
        if (cat == 8) { return dark ? #5E2E55 : #F7D3EE; }
        if (cat == 9) { return dark ? #632A3C : #F6D0DA; }
        return surface-container-high;
    }
    public pure function on-element(cat: int) -> color {
        return dark ? #F2EEF6 : #1B1A1F;
    }
    public pure function element-accent(cat: int) -> color {
        if (cat == 0) { return dark ? #8FD9A3 : #1E6B36; }
        if (cat == 1) { return dark ? #C7B8FF : #5B45A8; }
        if (cat == 2) { return dark ? #FFB3A1 : #A0371F; }
        if (cat == 3) { return dark ? #FFC977 : #8A5600; }
        if (cat == 4) { return dark ? #85D6E0 : #146470; }
        if (cat == 5) { return dark ? #E1DA74 : #6B6400; }
        if (cat == 6) { return dark ? #A9C0DA : #3B5675; }
        if (cat == 7) { return dark ? #9DC2FF : #2659A6; }
        if (cat == 8) { return dark ? #F2A6E2 : #8E2C7C; }
        if (cat == 9) { return dark ? #F5A3B8 : #9A2B4A; }
        return primary;
    }

    /// colore in base alla padronanza (rosso → ambra → verde)
    public pure function level(v: float) -> color {
        if (v >= 0.7) { return success; }
        if (v >= 0.4) { return dark ? #FFB868 : #8A5100; }
        return error;
    }
}

export global Icons {
    out property <image> home: @image-url("icons/home.svg");
    out property <image> school: @image-url("icons/school.svg");
    out property <image> cards: @image-url("icons/cards.svg");
    out property <image> flag: @image-url("icons/flag.svg");
    out property <image> flag-outline: @image-url("icons/flag-outline.svg");
    out property <image> tune: @image-url("icons/tune.svg");
    out property <image> sync: @image-url("icons/sync.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> edit: @image-url("icons/edit.svg");
    out property <image> search: @image-url("icons/search.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> timer: @image-url("icons/timer.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> chevron: @image-url("icons/chevron.svg");
    out property <image> chevron-left: @image-url("icons/chevron-left.svg");
    out property <image> insights: @image-url("icons/insights.svg");
    out property <image> quiz: @image-url("icons/quiz.svg");
    out property <image> ai: @image-url("icons/ai.svg");
    out property <image> book: @image-url("icons/book.svg");
    out property <image> toc: @image-url("icons/toc.svg");
    out property <image> star: @image-url("icons/star.svg");
    out property <image> star-outline: @image-url("icons/star-outline.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    out property <image> target: @image-url("icons/target.svg");
    out property <image> add: @image-url("icons/add.svg");
    out property <image> remove: @image-url("icons/remove.svg");
    out property <image> person: @image-url("icons/person.svg");
    out property <image> palette: @image-url("icons/palette.svg");
    out property <image> devices: @image-url("icons/devices.svg");
    out property <image> share: @image-url("icons/share.svg");
    out property <image> package: @image-url("icons/inventory-2.svg");
    out property <image> bell: @image-url("icons/notifications.svg");
    out property <image> rule: @image-url("icons/rule.svg");
    out property <image> update: @image-url("icons/update.svg");
    out property <image> news: @image-url("icons/news.svg");
    out property <image> gavel: @image-url("icons/gavel.svg");
}

// Proposte di stile (anteprima): 0 = attuale, 1 = «Focus», 2 = «Energia», 3 = «Chiarezza».
// Stessi ruoli colore Material 3 (anche Material You), cambiano gerarchia, superfici, forme,
// densità, barre e navigazione. Vedi docs/PROPOSTE_UI.md.
export global Design {
    in-out property <int> v: 0;
    // fondo delle pagine
    out property <color> canvas: v == 2 ? M3.surface-container-low : M3.surface;
    // card: riempimento, bordo, ombra, angoli
    out property <color> card-bg: v == 1 ? M3.surface-container : v == 2 ? M3.surface : v == 3 ? M3.surface : M3.surface-container-low;
    out property <length> card-border: v == 3 ? 1px : 0px;
    out property <color> card-border-color: M3.outline-variant;
    out property <bool> card-shadow: v == 0 || v == 2;
    out property <length> card-radius: v == 1 ? 20px : v == 2 ? 32px : v == 3 ? 24px : 28px;
    out property <length> card-pad: v == 1 ? 14px : v == 2 ? 20px : v == 3 ? 20px : 16px;
    out property <length> gap: v == 1 ? 8px : v == 2 ? 14px : v == 3 ? 16px : 12px;
    // barra in alto: compatta (0, 1), grande (2), media (3)
    out property <length> top-height: v == 2 ? 104px : v == 3 ? 84px : 64px;
    out property <length> top-title: v == 2 ? 32px : v == 3 ? 28px : 22px;
    out property <int> top-weight: v == 2 ? 800 : v == 1 ? 650 : 600;
    // barra di navigazione: 0 standard, 1 compatta con solo l'attiva etichettata,
    // 2 «flottante» staccata dal bordo, 3 standard con filo superiore
    out property <bool> nav-floating: v == 2;
    out property <bool> nav-hairline: v == 3;
    out property <bool> nav-labels-active-only: v == 1;
    out property <length> nav-height: v == 1 ? 64px : v == 2 ? 76px : 80px;
    // righe di elenco (Opzioni, libri…): sfondo e divisori
    out property <color> row-bg: v == 1 ? M3.surface-container : v == 2 ? M3.surface : transparent;
    out property <bool> row-divider: v == 3;
    out property <length> row-radius: v == 2 ? 24px : v == 1 ? 14px : 16px;
    // pulsanti principali più alti nella proposta «Energia»
    out property <length> button-height: v == 2 ? 56px : 48px;
    // numeri in evidenza (preparazione, punteggi)
    out property <int> display-weight: v == 2 ? 900 : v == 1 ? 600 : v == 3 ? 500 : 700;
    out property <color> hero-bg: v == 2 ? M3.primary : v == 3 ? M3.surface : v == 1 ? M3.surface-container : M3.primary-container;
    out property <color> on-hero: v == 2 ? M3.on-primary : v == 3 ? M3.on-surface : v == 1 ? M3.on-surface : M3.on-primary-container;
    out property <color> hero-accent: v == 2 ? M3.on-primary : M3.primary;
}

export global Type {
    // Material 3 Expressive: scala "emphasized", display grande per i numeri in evidenza
    out property <length> display-large: Design.v == 2 ? 76px : Design.v == 1 ? 52px : 64px;
    out property <length> display: Design.v == 2 ? 40px : 36px;
    out property <length> headline: Design.v == 2 ? 26px : 24px;
    out property <length> title-large: Design.v == 2 ? 24px : 22px;
    out property <length> title: Design.v == 3 ? 17px : 16px;
    out property <length> body-large: 16px;
    out property <length> body: 14px;
    out property <length> label: Design.v == 3 ? 13px : 12px;
}

// Material 3 Expressive — forme: angoli più ampi, pillole, forme che cambiano alla pressione.
export global Shape {
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: Design.v == 1 ? 12px : 16px;
    out property <length> lg-inc: Design.v == 1 ? 16px : 20px;
    out property <length> xl: Design.v == 1 ? 20px : Design.v == 2 ? 32px : Design.v == 3 ? 24px : 28px;
    out property <length> xl-inc: Design.v == 1 ? 24px : 32px;
    out property <length> xxl: 48px;
}

// Material 3 Expressive — movimento a molla (token ufficiali approssimati con cubic-bezier):
// "spatial" (posizione, dimensione, forma: con un po' di rimbalzo) ed "effects" (colore, opacità).
export global Motion {
    out property <duration> fast-spatial: 350ms;
    out property <duration> spatial: 500ms;
    out property <duration> slow-spatial: 650ms;
    out property <duration> fast-effects: 150ms;
    out property <duration> effects: 200ms;
}
