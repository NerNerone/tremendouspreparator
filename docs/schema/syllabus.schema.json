{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content/syllabus.json — definizione dell'esame",
  "type": "object",
  "required": [
    "schema",
    "title",
    "subjects"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "exam": {
      "type": "object",
      "description": "facoltativo: regole della simulazione d'esame, per materia",
      "required": [
        "questions",
        "mcq",
        "fill",
        "options",
        "minutes",
        "correct",
        "wrong",
        "omitted",
        "pass"
      ],
      "properties": {
        "questions": {
          "type": "integer",
          "minimum": 0
        },
        "mcq": {
          "type": "integer",
          "minimum": 0
        },
        "fill": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "integer",
          "minimum": 0
        },
        "minutes": {
          "type": "integer",
          "minimum": 0
        },
        "correct": {
          "type": "number"
        },
        "wrong": {
          "type": "number"
        },
        "omitted": {
          "type": "number"
        },
        "pass": {
          "type": "number"
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "date"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "official": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "label"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "enum": [
                "tavola-periodica"
              ]
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "book"
              ],
              "properties": {
                "book": {
                  "type": "string"
                },
                "file": {
                  "type": "string",
                  "pattern": "^books/.+\\.md$"
                },
                "section": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "n",
                "name",
                "cfu",
                "topics"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "n": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "cfu": {
                  "type": "number",
                  "minimum": 0
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
