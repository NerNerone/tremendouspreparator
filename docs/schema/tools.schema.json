{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content/tools/<id>.json — strumento (griglia, elenco o calcolatore)",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "grid",
        "list",
        "calc"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "columns",
        "rows",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "kind": {
          "const": "grid"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        "column_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "row_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "y": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "top": {
                "type": "string"
              },
              "bottom": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "subtitle": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "kind": {
          "const": "list"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "inputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "kind": {
          "const": "calc"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {
                  "enum": [
                    "e",
                    "pi"
                  ]
                }
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              },
              "default": {
                "type": "number"
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "formula"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {
                  "enum": [
                    "e",
                    "pi"
                  ]
                }
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              },
              "formula": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "digits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              }
            }
          }
        }
      }
    }
  ]
}
