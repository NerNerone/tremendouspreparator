{
  "schema": 1,
  "id": "ph",
  "title": "pH e pOH",
  "subtitle": "Acidi e basi forti a 25 °C",
  "kind": "calc",
  "inputs": [
    {
      "id": "H",
      "label": "Concentrazione di H₃O⁺",
      "unit": "mol/L",
      "default": 0.001
    }
  ],
  "outputs": [
    {
      "id": "pH",
      "label": "pH",
      "formula": "-log(H)",
      "digits": 3
    },
    {
      "label": "pOH",
      "formula": "14 - pH",
      "digits": 3
    },
    {
      "label": "Concentrazione di OH⁻",
      "unit": "mol/L",
      "formula": "1e-14 / H",
      "digits": 3
    }
  ]
}
